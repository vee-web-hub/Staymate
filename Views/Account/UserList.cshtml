@model List<StayMate_Kavinvee_0576.Models.ViewModels.UserListItem>

@{
    Layout = null;
    ViewData["Title"] = "User List - StayMate";
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User List - StayMate</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/staymate_login_Register.css" asp-append-version="true" />
</head>
<body class="staymate-auth">
    <div class="container my-5">
        <div class="card shadow">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h3 class="mb-0">🏨 StayMate User List</h3>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex align-items-center gap-2">
                    <span class="small">@User.Identity?.Name</span>
                    <button type="submit" class="btn btn-light btn-sm">Logout</button>
                </form>
            </div>

            <div class="card-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                <div class="d-flex justify-content-between align-items-center mb-4 gap-2">
                    <form asp-controller="Account" asp-action="UserList" method="get" class="d-flex gap-2">
                        <input type="text" name="q" value="@ViewBag.Search" class="form-control"
                               placeholder="ค้นหา username / ชื่อ / email" />
                        <button type="submit" class="btn btn-outline-primary">Search</button>
                    </form>

                    <a asp-controller="Account" asp-action="Create" class="btn btn-primary">+ Add User</a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Username</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr><td colspan="8" class="text-center text-muted">ไม่พบข้อมูลผู้ใช้</td></tr>
                            }
                            @foreach (var user in Model)
                            {
                                var badge = user.RoleCode switch
                                {
                                    "MANAGER"     => "bg-danger",
                                    "OWNER"       => "bg-dark",
                                    "FINANCE"     => "bg-warning text-dark",
                                    "FRONT_ADMIN" => "bg-primary",
                                    "HOUSEKEEPING"=> "bg-secondary",
                                    _             => "bg-info text-dark"
                                };
                                <tr>
                                    <td>@user.UserId</td>
                                    <td>@user.Username</td>
                                    <td>@user.FullName</td>
                                    <td>@user.Email</td>
                                    <td>@(user.Phone ?? "-")</td>
                                    <td><span class="badge @badge">@(user.RoleName ?? "-")</span></td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1">
                                            <a asp-controller="Account" asp-action="Edit" asp-route-id="@user.UserId"
                                               class="btn btn-warning btn-sm">Edit</a>

                                            <form asp-controller="Account" asp-action="Delete" asp-route-id="@user.UserId"
                                                  method="post" onsubmit="return confirm('ต้องการลบผู้ใช้นี้หรือไม่?');">
                                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary mt-3">Back to Home</a>
            </div>
        </div>
    </div>
</body>
</html>
