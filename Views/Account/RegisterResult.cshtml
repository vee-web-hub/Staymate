@model StayMate_Kavinvee_0576.Models.ViewModels.RegisterViewModel

@{
    Layout = null;
    ViewData["Title"] = "Register Result - StayMate";
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register Result - StayMate</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <link rel="stylesheet"
          href="~/css/staymate_login_Register.css"
          asp-append-version="true" />
</head>
<body class="staymate-auth">

    <div class="container mt-5">
        <div class="card shadow mx-auto" style="max-width: 500px;">
            <div class="card-header bg-success text-white">
                <h3 class="mb-0">Register Result</h3>
            </div>

            <div class="card-body">
                <p>รับข้อมูลจาก RegisterViewModel สำเร็จ</p>

                <p>
                    <strong>Email:</strong>
                    @Model.Email
                </p>

                <p>
                    <strong>Username:</strong>
                    @Model.Username
                </p>

                <a asp-controller="Account"
                   asp-action="Register"
                   class="btn btn-primary">
                    กลับหน้า Register
                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    หน้า Home
                </a>
            </div>
        </div>
    </div>

</body>
</html>