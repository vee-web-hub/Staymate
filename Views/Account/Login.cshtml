@model StayMate_Kavinvee_0576.Models.ViewModels.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "เข้าสู่ระบบ - StayMate";
    var returnUrl = ViewBag.ReturnUrl as string ?? Context.Request.Query["returnUrl"].ToString();
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap-grid.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/staymate_login_Register.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/staymate_motion.css" asp-append-version="true" />
</head>
<body class="staymate-auth">

    <div class="auth-container" style="max-width: 940px;">
        <div class="master-auth-card" id="authCard">

            <header class="master-top-bar">
                <a class="brand-logo-group" asp-controller="Home" asp-action="Index">
                    <img src="~/images/Logo/LogoStayMate.jpg" alt="StayMate" class="brand-logo-img" />
                    <span class="brand-name-text">StayMate</span>
                </a>
                <a class="system-tagline" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-arrow-left"></i> กลับหน้าหลัก
                </a>
            </header>

            <div class="split-layout">

                <!-- Left -->
                <section class="left-showcase">
                    <div>
                        <h2 class="headline-title">
                            จองที่พักง่าย
                            <span class="cyan-highlight">จัดการได้ในที่เดียว</span>
                        </h2>
                        <p class="headline-desc">
                            เข้าสู่ระบบเพื่อจัดการการจอง ตรวจสอบสถานะการชำระเงิน
                            และดูประวัติการเข้าพักของคุณ
                        </p>

                       <div class="room-preview-box">
    <img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1000&q=80"
         alt="ห้องพักและสระว่ายน้ำของโรงแรม"
         class="room-preview-img"
         loading="lazy"
         onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1551882547-ff40c63fe5fa?auto=format&fit=crop&w=1000&q=80';" />
</div>
                    </div>

                    <ul class="trust-list">
                        <li><i class="fa-solid fa-calendar-check"></i> จองและติดตามการจองได้ตลอดเวลา</li>
                        <li><i class="fa-solid fa-receipt"></i> ดูประวัติการชำระเงินย้อนหลัง</li>
                        <li><i class="fa-solid fa-shield-halved"></i> ข้อมูลของคุณถูกเข้ารหัสและปกป้อง</li>
                    </ul>
                </section>

                <!-- Right -->
                <section class="right-form-panel">
                    <div class="form-header-center">
                        <h1 class="form-welcome-title">เข้าสู่ระบบ</h1>
                        <p class="form-welcome-sub">ยินดีต้อนรับกลับสู่ StayMate</p>
                    </div>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert-custom-success" role="status">
                            <i class="fa-solid fa-circle-check"></i>
                            <span>@TempData["Success"]</span>
                        </div>
                    }

                    <form id="loginForm" asp-controller="Account" asp-action="Login"
                          asp-route-returnUrl="@returnUrl" method="post" novalidate>

                        <div asp-validation-summary="ModelOnly" class="alert-custom-error" role="alert"></div>

                        <div class="form-field-group">
                            <label asp-for="Username" class="form-field-label">Username</label>
                            <div class="input-icon-box">
                                <input asp-for="Username" class="styled-input" placeholder="ชื่อผู้ใช้งาน"
                                       autofocus autocomplete="username" />
                                <i class="fa-regular fa-user"></i>
                            </div>
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="form-field-group">
                            <label asp-for="Password" class="form-field-label">Password</label>
                            <div class="input-icon-box">
                                <input asp-for="Password" type="password" class="styled-input has-toggle"
                                       placeholder="รหัสผ่าน" autocomplete="current-password" />
                                <i class="fa-solid fa-lock"></i>
                                <button type="button" class="toggle-password" aria-label="แสดงหรือซ่อนรหัสผ่าน"
                                        data-target="#Password">
                                    <i class="fa-regular fa-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <label class="remember-row">
                            <input asp-for="RememberMe" />
                            <span>จดจำการเข้าสู่ระบบ</span>
                        </label>

                        <button type="submit" class="btn-action-primary" id="btnLogin">
                            <span>เข้าสู่ระบบ</span>
                        </button>

                        <div class="switch-link-center">
                            <span class="muted">ยังไม่มีบัญชี?</span>
                            <a asp-controller="Account" asp-action="Register">สมัครสมาชิก</a>
                        </div>
                    </form>
                </section>
            </div>

            <footer class="master-bottom-bar">
                <div>© @DateTime.Now.Year StayMate</div>
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        $(function () {
            // แสดง/ซ่อนรหัสผ่าน
            $('.toggle-password').on('click', function () {
                const input = $($(this).data('target'));
                const show = input.attr('type') === 'password';
                input.attr('type', show ? 'text' : 'password');
                $(this).find('i').toggleClass('fa-eye', !show).toggleClass('fa-eye-slash', show);
            });

            // ป้องกันกดซ้ำ + แสดง loading
            $('#loginForm').on('submit', function () {
                if ($(this).valid()) $('#btnLogin').addClass('is-loading');
            });
        });
    </script>
</body>
</html>