@model StayMate_Kavinvee_0576.Models.User

@{
    Layout = null;
    ViewData["Title"] = "Edit User - StayMate";
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit User - StayMate</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/staymate_login_Register.css" asp-append-version="true" />
</head>
<body class="staymate-auth">
    <div class="container my-5">
        <div class="card shadow mx-auto" style="max-width: 500px;">
            <div class="card-header text-center bg-warning">
                <h3 class="mb-0">Edit User</h3>
            </div>

            <div class="card-body">
                <form asp-controller="Account" asp-action="Edit" method="post">

                    <input type="hidden" asp-for="UserId" />

                    <div class="mb-3">
                        <label class="form-label">Username</label>
                        <input asp-for="Username" class="form-control" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input asp-for="FullName" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input asp-for="Phone" class="form-control" />
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label class="form-check-label">เปิดใช้งานบัญชี</label>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="UserList" class="btn btn-secondary">Back</a>
                        <button type="submit" class="btn btn-warning">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
