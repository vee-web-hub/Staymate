@model StayMate_Kavinvee_0576.Models.ViewModels.RegisterViewModel

@{
    Layout = null;
    ViewData["Title"] = "สมัครสมาชิก - StayMate";
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap-grid.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/staymate_login_Register.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/staymate_motion.css" asp-append-version="true" />
</head>
<body class="staymate-auth">

    <div class="auth-container" style="max-width: 960px;">
        <div class="master-auth-card" id="authCard">

            <header class="master-top-bar">
                <a class="brand-logo-group" asp-controller="Home" asp-action="Index">
                    <img src="~/images/Logo/LogoStayMate.jpg" alt="StayMate" class="brand-logo-img" />
                    <span class="brand-name-text">StayMate</span>
                </a>
                <a class="system-tagline" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-arrow-left"></i> กลับหน้าหลัก
                </a>
            </header>

            <div class="split-layout">

                <!-- Left -->
                <section class="register-hero">
                    <div>
                        <h2 class="hero-title">สร้างบัญชี<br /><span class="cyan-highlight">เพื่อจองที่พักได้สะดวกขึ้น</span></h2>
                        <p class="hero-desc">
                            สมัครสมาชิกฟรี เพื่อจัดการการจองและติดตามสถานะได้ด้วยตัวเอง
                        </p>
                    </div>

                    <div class="hero-features">
                        <div class="hero-feature">
                            <div class="hero-feature-icon"><i class="fa-solid fa-calendar-check"></i></div>
                            <div>
                                <div class="hero-feature-title">จองได้ทุกที่ทุกเวลา</div>
                                <div class="hero-feature-desc">เลือกห้องพักและวันเข้าพักได้ด้วยตัวเอง</div>
                            </div>
                        </div>
                        <div class="hero-feature">
                            <div class="hero-feature-icon"><i class="fa-solid fa-clock-rotate-left"></i></div>
                            <div>
                                <div class="hero-feature-title">ดูประวัติการจอง</div>
                                <div class="hero-feature-desc">ตรวจสอบสถานะและรายละเอียดย้อนหลังได้</div>
                            </div>
                        </div>
                        <div class="hero-feature">
                            <div class="hero-feature-icon"><i class="fa-solid fa-lock"></i></div>
                            <div>
                                <div class="hero-feature-title">ปลอดภัย</div>
                                <div class="hero-feature-desc">รหัสผ่านถูกเข้ารหัสก่อนจัดเก็บเสมอ</div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Right -->
                <section class="right-form-panel register-panel">
                    <div class="register-heading">
                        <h1 class="form-welcome-title">สมัครสมาชิก</h1>
                        <p class="form-welcome-sub">กรอกข้อมูลด้านล่างเพื่อสร้างบัญชีของคุณ</p>
                    </div>

                    <form id="registerForm" asp-controller="Account" asp-action="Register" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert-custom-error" role="alert"></div>

                        <div class="row gx-3">
                            <div class="col-12 col-sm-6 form-field-group">
                                <label asp-for="Username" class="form-field-label">ชื่อผู้ใช้งาน</label>
                                <div class="input-icon-box">
                                    <input asp-for="Username" class="styled-input" placeholder="เช่น somchai.k" autocomplete="username" />
                                    <i class="fa-solid fa-user-tag"></i>
                                </div>
                                <span asp-validation-for="Username" class="text-danger"></span>
                            </div>
                            <div class="col-12 col-sm-6 form-field-group">
                                <label asp-for="FullName" class="form-field-label">ชื่อ - นามสกุล</label>
                                <div class="input-icon-box">
                                    <input asp-for="FullName" class="styled-input" placeholder="ชื่อและนามสกุลจริง" autocomplete="name" />
                                    <i class="fa-regular fa-id-card"></i>
                                </div>
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row gx-3">
    <div class="col-12 col-sm-6 form-field-group">
        <label asp-for="Email" class="form-field-label">อีเมล</label>
        <div class="input-icon-box">
            <input asp-for="Email" type="email" class="styled-input" placeholder="อีเมลของคุณ" autocomplete="email" />
            <i class="fa-regular fa-envelope"></i>
        </div>
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
                            <div class="col-12 col-sm-6 form-field-group">
                                <label asp-for="Phone" class="form-field-label">เบอร์โทรศัพท์ <span class="optional">(ไม่บังคับ)</span></label>
                                <div class="input-icon-box">
                                    <input asp-for="Phone" type="tel" class="styled-input" placeholder="0812345678" autocomplete="tel" />
                                    <i class="fa-solid fa-phone"></i>
                                </div>
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row gx-3">
    <div class="col-12 col-sm-6 form-field-group">
        <label asp-for="Password" class="form-field-label">รหัสผ่าน</label>
        <div class="input-icon-box">
            <input asp-for="Password" type="password" class="styled-input has-toggle"
                   placeholder="รหัสผ่าน" autocomplete="new-password" />
            <i class="fa-solid fa-lock"></i>
            <button type="button" class="toggle-password" aria-label="แสดงหรือซ่อนรหัสผ่าน" data-target="#Password">
                <i class="fa-regular fa-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="col-12 col-sm-6 form-field-group">
        <label asp-for="ConfirmPassword" class="form-field-label">ยืนยันรหัสผ่าน</label>
        <div class="input-icon-box">
            <input asp-for="ConfirmPassword" type="password" class="styled-input has-toggle"
                   placeholder="ยืนยันรหัสผ่าน" autocomplete="new-password" />
            <i class="fa-solid fa-shield-halved"></i>
            <button type="button" class="toggle-password" aria-label="แสดงหรือซ่อนรหัสผ่าน" data-target="#ConfirmPassword">
                <i class="fa-regular fa-eye"></i>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>
</div>
<!-- เพิ่มบรรทัดนี้ต่อจาก row รหัสผ่าน -->
<div class="field-hint">
    <i class="fa-solid fa-circle-info"></i>
    รหัสผ่านอย่างน้อย 6 ตัว ประกอบด้วยตัวอักษรและตัวเลข
</div>

                        <button type="submit" class="btn-action-primary" id="btnRegister">
                            <span>สมัครสมาชิก</span>
                        </button>
                    </form>

                    <div class="switch-link-center">
                        <span class="muted">มีบัญชีอยู่แล้ว?</span>
                        <a asp-controller="Account" asp-action="Login">เข้าสู่ระบบ</a>
                    </div>
                </section>
            </div>

            <footer class="master-bottom-bar">
                <div>© @DateTime.Now.Year StayMate</div>
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        $(function () {
            $('.toggle-password').on('click', function () {
                const input = $($(this).data('target'));
                const show = input.attr('type') === 'password';
                input.attr('type', show ? 'text' : 'password');
                $(this).find('i').toggleClass('fa-eye', !show).toggleClass('fa-eye-slash', show);
            });

            $('#registerForm').on('submit', function () {
                if ($(this).valid()) $('#btnRegister').addClass('is-loading');
            });
        });
    </script>
</body>
</html>