<!-- Modal 2: ระบบสร้างใบเสร็จใหม่ (Create Receipt Modal)                  -->
<!-- ===================================================================== -->
<div class="modal fade" id="frCreateModal" tabindex="-1" aria-labelledby="frCreateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content payment-approval-modal">
            <div class="modal-header payment-approval-modal-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="fin-chip-cyber">
                        <i class="fa-solid fa-plus-circle"></i> ISSUE OFFICIAL RECEIPT
                    </span>
                    <h5 class="modal-title fw-bold text-white mb-0" id="frCreateModalLabel">
                        สร้างใบเสร็จรับเงินใหม่ (Create Receipt)
                    </h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <div class="alert alert-info d-flex align-items-start gap-2 small mb-3">
                    <i class="fa-solid fa-shield-halved fs-5 mt-1 text-primary"></i>
                    <div>
                        <strong>กฎความปลอดภัยทางการเงิน:</strong> เลือกได้เฉพาะรายการจองที่ชำระเงินและได้รับการอนุมัติ (Approved) แล้วแต่ยังไม่มีใบเสร็จ ระบบดึงยอดเงินจริงจากฐานข้อมูลโดยไม่อนุญาตให้แก้ไขตัวเลขด้วยตนเอง และป้องกันการออกใบเสร็จซ้ำอัตโนมัติ
                    </div>
                </div>

                <!-- กรณีมีรายการชำระเงินที่รอออกใบเสร็จ -->
                <div id="frCreateFormWrap">
                    <div class="mb-3">
                        <label for="frSelectApprovedPayment" class="form-label fw-bold small text-dark">
                            เลือกรายการชำระเงินที่อนุมัติแล้วและยังไม่มีใบเสร็จ <span class="text-danger">*</span>
                        </label>
                        <select id="frSelectApprovedPayment" class="form-select fr-form-control">
                            <option value="">-- เลือกรายการ Booking / Payment ที่ต้องการออกใบเสร็จ --</option>
                        </select>
                    </div>

                    <!-- กล่องแสดงข้อมูลอัตโนมัติ (Read-only ห้ามแก้ไขยอดเงินเอง) -->
                    <div id="frCreatePreviewBox" class="p-3 rounded-3 bg-light border d-none">
                        <div class="row g-3 small mb-3">
                            <div class="col-sm-6">
                                <span class="text-muted d-block">รหัสการจอง (Booking ID):</span>
                                <strong class="text-electric fs-6" id="frCrBookingCode">-</strong>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted d-block">ชื่อลูกค้า (Customer Name):</span>
                                <strong class="text-dark fs-6" id="frCrCustomerName">-</strong>
                            </div>
                            <div class="col-sm-4">
                                <span class="text-muted d-block">รหัสการชำระเงิน:</span>
                                <strong class="text-dark" id="frCrPaymentId">-</strong>
                            </div>
                            <div class="col-sm-4">
                                <span class="text-muted d-block">ช่องทางชำระเงิน:</span>
                                <strong class="text-dark" id="frCrMethod">-</strong>
                            </div>
                            <div class="col-sm-4">
                                <span class="text-muted d-block">วันที่ออกใบเสร็จ:</span>
                                <strong class="text-dark">@DateTime.Now.ToString("dd/MM/yyyy") (วันนี้)</strong>
                            </div>
                        </div>

                        <div class="border-top pt-3">
                            <div class="row g-2 text-center">
                                <div class="col-6 col-sm-3">
                                    <span class="text-muted extra-small d-block">ค่าห้องพักรวม</span>
                                    <strong class="text-dark" id="frCrRoomAmt">฿0.00</strong>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <span class="text-muted extra-small d-block">ส่วนลดโปรโมชั่น</span>
                                    <strong class="text-danger" id="frCrDiscountAmt">-฿0.00</strong>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <span class="text-muted extra-small d-block">ยอดก่อนภาษี / VAT</span>
                                    <strong class="text-dark" id="frCrTaxAmt">฿0.00</strong>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <span class="text-muted extra-small d-block">ยอดสุทธิ (ล็อกตามจริง)</span>
                                    <strong class="text-success fs-6" id="frCrNetAmt">฿0.00</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- กรณีทุกรายการที่อนุมัติแล้วมีใบเสร็จครบทั้งหมด -->
                <div id="frCreateEmptyNotice" class="text-center py-4 d-none">
                    <div class="fin-empty-icon-ring mx-auto mb-3">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <h6 class="fw-bold text-dark">รายการชำระเงินที่อนุมัติแล้วทั้งหมดได้รับการออกใบเสร็จครบถ้วนแล้ว</h6>
                    <p class="text-muted small mb-3">
                        ระบบ StayMate ออกใบเสร็จรับเงินให้อัตโนมัติทันทีเมื่ออนุมัติสลิปโอนเงิน หากมีสลิปใหม่ที่รอการอนุมัติ กรุณาไปที่หน้าอนุมัติสลิปโอนเงิน
                    </p>
                    <a asp-controller="Finance" asp-action="PaymentApproval" class="btn fin-btn-primary-cyber btn-sm">
                        <i class="fa-solid fa-file-invoice-dollar me-1"></i> ไปหน้าอนุมัติสลิปโอนเงิน
                    </a>
                </div>
            </div>

            <div class="modal-footer payment-approval-modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิดหน้าต่าง</button>
                <button type="button" id="frBtnConfirmCreateReceipt" class="btn fin-btn-primary-cyber" disabled>
                    <i class="fa-solid fa-check-circle me-1"></i> ยืนยันการออกใบเสร็จรับเงิน
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ===================================================================== -->
<!-- Modal 3: ระบบยกเลิกใบเสร็จพร้อมระบุเหตุผล (Cancel Receipt Modal)       -->
<!-- ===================================================================== -->
<div class="modal fade" id="frCancelModal" tabindex="-1" aria-labelledby="frCancelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content payment-approval-modal">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="frCancelModalLabel">
                    <i class="fa-solid fa-ban me-2"></i>ยืนยันการยกเลิกใบเสร็จรับเงิน (Cancel Receipt)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="frCancelReceiptForm" novalidate>
                <div class="modal-body p-4">
                    <input type="hidden" id="frCancelReceiptId" />

                    <div class="p-3 rounded-3 bg-light border mb-3 small">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">เลขที่ใบเสร็จ:</span>
                            <strong class="text-dark" id="frCancelDisplayNo">-</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">ลูกค้า / การจอง:</span>
                            <strong class="text-dark" id="frCancelDisplayCustomer">-</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">จำนวนเงินตามใบเสร็จ:</span>
                            <strong class="text-danger" id="frCancelDisplayAmount">฿0.00</strong>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="frCancelReasonSelect" class="form-label fw-semibold small text-dark">
                            สาเหตุการยกเลิกใบเสร็จ <span class="text-danger">*</span>
                        </label>
                        <select id="frCancelReasonSelect" class="form-select fr-form-control mb-2">
                            <option value="">-- เลือกสาเหตุมาตรฐาน --</option>
                            <option value="ลูกค้าขอยกเลิกการจองและคืนเงิน (Booking Refund)">ลูกค้าขอยกเลิกการจองและคืนเงิน (Booking Refund)</option>
                            <option value="ข้อมูลผู้เสียภาษี/ชื่อลูกค้าในใบเสร็จไม่ถูกต้อง ต้องออกใบใหม่">ข้อมูลผู้เสียภาษี/ชื่อลูกค้าไม่ถูกต้อง</option>
                            <option value="รายการชำระเงินถูกดึงคืนจากธนาคาร (Chargeback/Reversal)">รายการชำระเงินถูกดึงคืนจากธนาคาร</option>
                            <option value="OTHER">อื่น ๆ (ระบุรายละเอียดด้านล่าง)</option>
                        </select>
                        <textarea id="frCancelReasonInput"
                                  class="form-control fr-form-control"
                                  rows="3"
                                  maxlength="255"
                                  required
                                  placeholder="ระบุเหตุผลในการยกเลิกใบเสร็จเพื่อบันทึกใน Audit Log..."></textarea>
                        <div class="invalid-feedback">กรุณาระบุเหตุผลในการยกเลิกใบเสร็จ</div>
                    </div>

                    <div class="extra-small text-muted">
                        <i class="fa-solid fa-circle-info text-danger me-1"></i>
                        ใบเสร็จที่ถูกยกเลิกจะยังคงอยู่ในประวัติระบบเพื่อการตรวจสอบทางบัญชี และจะไม่ถูกลบออกจากฐานข้อมูลถาวร
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">ปิด</button>
                    <button type="submit" id="frBtnConfirmCancelSubmit" class="btn btn-danger fw-semibold">
                        <i class="fa-solid fa-ban me-1"></i> ยืนยันยกเลิกใบเสร็จ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ส่งข้อมูลรายการชำระเงินที่ Approved แล้วแต่ยังไม่มีใบเสร็จให้ JavaScript -->
<script id="frUnissuedPaymentsData" type="application/json">
    @Html.Raw(unissuedPaymentsJson)
</script>

