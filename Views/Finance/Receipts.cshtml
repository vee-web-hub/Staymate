@model StayMate_Kavinvee_0576.Models.ViewModels.ReceiptsViewModel

@{
    Layout = "~/Views/Shared/_FinanceLayout.cshtml";
    ViewData["Title"] = "Receipt Management";

    var items = Model.Receipts?.Items ?? new List<StayMate_Kavinvee_0576.Models.ViewModels.ReceiptRow>();
    int totalCount = ViewBag.TotalReceiptsCount ?? (Model.Receipts?.TotalCount ?? 0);
    int issuedCount = ViewBag.IssuedReceiptsCount ?? totalCount;
    int pendingCount = ViewBag.PendingReceiptsCount ?? 0;
    decimal totalReceiptValue = ViewBag.TotalReceiptValue ?? items.Sum(x => x.Amount);

    var cancelledIds = ViewBag.CancelledReceiptIds as List<string> ?? new List<string>();
    string unissuedPaymentsJson = ViewBag.UnissuedPaymentsJson as string ?? "[]";

    int currentPage = Model.Receipts?.Page ?? 1;
    int totalPages = Model.Receipts?.TotalPages ?? 1;
}

<link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" />

<div class="finance-dashboard-wrapper fr-page-wrapper"
     id="frReceiptsApp"
     data-action-url="@Url.Action("Receipts", "Finance")"
     data-detail-api="@Url.Action("GetReceiptDetailJson", "Finance")"
     data-create-api="@Url.Action("CreateReceiptAjax", "Finance")"
     data-cancel-api="@Url.Action("CancelReceiptAjax", "Finance")"
     data-pdf-base-url="@Url.Action("ReceiptPdf", "Finance")">

    <form id="frCsrfForm" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <!-- ================================================================= -->
    <!-- 1. Header                                                         -->
    <!-- ================================================================= -->
    <section class="fin-welcome-banner fr-header-banner mb-4">
        <div class="fin-welcome-glow"></div>
        <div class="row align-items-center position-relative z-1 g-3">
            <div class="col-lg-7">
                <span class="fin-chip-cyber mb-2">E-RECEIPT &amp; TAX DOCUMENTS</span>
                <h1 class="fin-welcome-title mb-0">Receipt Management</h1>
            </div>

            <div class="col-lg-5 text-lg-end">
                <div class="d-inline-flex flex-wrap gap-2 justify-content-lg-end">
                    <button type="button" id="frBtnExportReport" class="btn fr-btn-export">
                        <i class="fa-solid fa-file-csv me-2"></i>Export CSV
                    </button>
                    <button type="button" id="frBtnOpenCreateModal" class="btn fr-btn-create-receipt">
                        <i class="fa-solid fa-plus me-2"></i>สร้างใบเสร็จใหม่
                        @if (pendingCount > 0)
                        {
                            <span class="badge bg-warning text-dark ms-1">@pendingCount</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- ================================================================= -->
    <!-- 2. Summary Cards (4 ใบหลัก)                                       -->
    <!-- ================================================================= -->
    <section class="row g-3 g-xl-4 mb-4">
        <!-- Total Receipts -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="fin-kpi-card kpi-revenue fr-summary-card h-100" data-filter-status="all" role="button">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="fin-kpi-label">TOTAL RECEIPTS</span>
                        <h3 class="fin-kpi-thai-title">ใบเสร็จทั้งหมด</h3>
                    </div>
                    <div class="fin-kpi-icon-wrap icon-revenue">
                        <i class="fa-solid fa-receipt"></i>
                    </div>
                </div>
                <div class="fin-kpi-amount">
                    <span id="frSummaryTotalCount">@totalCount.ToString("N0")</span>
                    <small class="fin-kpi-unit">ฉบับ</small>
                </div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="fin-kpi-note">เอกสารในระบบทั้งหมด</span>
                    <span class="fin-kpi-tag tag-blue">All</span>
                </div>
            </div>
        </div>

        <!-- Issued Receipts -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="fin-kpi-card kpi-approved fr-summary-card h-100" data-filter-status="issued" role="button">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="fin-kpi-label">ISSUED</span>
                        <h3 class="fin-kpi-thai-title">ออกใบเสร็จแล้ว</h3>
                    </div>
                    <div class="fin-kpi-icon-wrap icon-approved">
                        <i class="fa-solid fa-file-circle-check"></i>
                    </div>
                </div>
                <div class="fin-kpi-amount text-success-custom">
                    <span id="frSummaryIssuedCount">@issuedCount.ToString("N0")</span>
                    <small class="fin-kpi-unit">ฉบับ</small>
                </div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="fin-kpi-note">ดาวน์โหลด PDF / พิมพ์ได้</span>
                    <span class="fin-kpi-tag tag-green">Issued</span>
                </div>
            </div>
        </div>

        <!-- Pending Receipts -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="fin-kpi-card kpi-pending fr-summary-card h-100" data-filter-status="pending" role="button">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="fin-kpi-label">PENDING ISSUE</span>
                        <h3 class="fin-kpi-thai-title">รอออกใบเสร็จ</h3>
                    </div>
                    <div class="fin-kpi-icon-wrap icon-pending">
                        <i class="fa-solid fa-file-signature"></i>
                    </div>
                </div>
                <div class="fin-kpi-amount text-warning-custom">
                    <span id="frSummaryPendingCount">@pendingCount.ToString("N0")</span>
                    <small class="fin-kpi-unit">รายการ</small>
                </div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="fin-kpi-note">อนุมัติแล้ว รอออกเอกสาร</span>
                    <span class="fin-kpi-tag tag-orange">Pending</span>
                </div>
            </div>
        </div>

        <!-- Total Receipt Value -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="fin-kpi-card fr-kpi-violet fr-summary-card h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="fin-kpi-label">TOTAL VALUE</span>
                        <h3 class="fin-kpi-thai-title">มูลค่าใบเสร็จรวม</h3>
                    </div>
                    <div class="fin-kpi-icon-wrap fr-icon-violet">
                        <i class="fa-solid fa-coins"></i>
                    </div>
                </div>
                <div class="fin-kpi-amount text-violet">
                    ฿<span id="frSummaryTotalValue">@totalReceiptValue.ToString("N2")</span>
                </div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="fin-kpi-note">ยอดรวมสุทธิทั้งหมด</span>
                    <span class="fin-kpi-tag fr-tag-violet">THB</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ================================================================= -->
    <!-- 3. Search & Filters                                               -->
    <!-- ================================================================= -->
    <section class="fin-panel-card fr-filter-panel mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 pb-2 border-bottom">
            <h2 class="fin-panel-title mb-0">ค้นหาใบเสร็จรับเงิน</h2>
            <div class="fr-status-pills d-flex flex-wrap gap-1">
                <button type="button" class="fr-pill-btn active" data-status-pill="all">ทั้งหมด</button>
                <button type="button" class="fr-pill-btn" data-status-pill="issued">Issued</button>
                <button type="button" class="fr-pill-btn" data-status-pill="pending">Pending</button>
                <button type="button" class="fr-pill-btn" data-status-pill="cancelled">Cancelled</button>
            </div>
        </div>

        <form asp-controller="Finance" asp-action="Receipts" method="get" id="frFilterForm">
            <input type="hidden" name="keyword" id="frServerKeyword" value="@Model.Keyword" />
            <input type="hidden" name="page" value="1" />

            <div class="row g-3">
                <div class="col-12 col-sm-6 col-lg-3">
                    <label for="frInputReceiptNo" class="form-label fr-form-label">เลขที่ใบเสร็จ</label>
                    <input type="text"
                           id="frInputReceiptNo"
                           class="form-control fr-form-control"
                           value="@(Model.Keyword != null && Model.Keyword.StartsWith("RC", StringComparison.OrdinalIgnoreCase) ? Model.Keyword : "")"
                           placeholder="เช่น RC2026..." />
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <label for="frInputBookingCode" class="form-label fr-form-label">Booking Code</label>
                    <input type="text"
                           id="frInputBookingCode"
                           class="form-control fr-form-control"
                           value="@(Model.Keyword != null && Model.Keyword.StartsWith("BK", StringComparison.OrdinalIgnoreCase) ? Model.Keyword : "")"
                           placeholder="เช่น BK2026..." />
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <label for="frInputCustomerName" class="form-label fr-form-label">ชื่อลูกค้า</label>
                    <input type="text"
                           id="frInputCustomerName"
                           class="form-control fr-form-control"
                           value="@(Model.Keyword != null && !Model.Keyword.StartsWith("RC", StringComparison.OrdinalIgnoreCase) && !Model.Keyword.StartsWith("BK", StringComparison.OrdinalIgnoreCase) ? Model.Keyword : "")"
                           placeholder="ค้นหาชื่อลูกค้า..." />
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <label for="frSelectStatus" class="form-label fr-form-label">สถานะ</label>
                    <select id="frSelectStatus" class="form-select fr-form-control">
                        <option value="all" selected>ทุกสถานะ</option>
                        <option value="issued">Issued (ออกแล้ว)</option>
                        <option value="pending">Pending (รอออกใบเสร็จ)</option>
                        <option value="cancelled">Cancelled (ยกเลิกแล้ว)</option>
                    </select>
                </div>

                <div class="col-6 col-sm-6 col-lg-3">
                    <label for="frInputFromDate" class="form-label fr-form-label">ตั้งแต่วันที่</label>
                    <input type="date"
                           name="from"
                           id="frInputFromDate"
                           class="form-control fr-form-control"
                           value="@(Model.From?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="col-6 col-sm-6 col-lg-3">
                    <label for="frInputToDate" class="form-label fr-form-label">ถึงวันที่</label>
                    <input type="date"
                           name="to"
                           id="frInputToDate"
                           class="form-control fr-form-control"
                           value="@(Model.To?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <label for="frSelectSort" class="form-label fr-form-label">เรียงลำดับ</label>
                    <select id="frSelectSort" class="form-select fr-form-control">
                        <option value="date_desc" selected>วันที่ออก: ล่าสุดก่อน</option>
                        <option value="date_asc">วันที่ออก: เก่าสุดก่อน</option>
                        <option value="amount_desc">ยอดเงิน: มากไปน้อย</option>
                        <option value="amount_asc">ยอดเงิน: น้อยไปมาก</option>
                    </select>
                </div>

                <div class="col-12 col-sm-6 col-lg-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn fr-btn-search flex-grow-1">
                        <i class="fa-solid fa-magnifying-glass me-1"></i> ค้นหา
                    </button>
                    <button type="button" id="frBtnResetFilters" class="btn fr-btn-reset" title="ล้างตัวกรอง">
                        <i class="fa-solid fa-rotate-left"></i>
                    </button>
                </div>
            </div>
        </form>
    </section>

    <!-- ================================================================= -->
    <!-- 4. Receipts Table                                                 -->
    <!-- ================================================================= -->
    <section class="fin-panel-card fr-table-panel">
        <div class="d-flex align-items-center justify-content-between gap-2 mb-3 pb-3 border-bottom">
            <h2 class="fin-panel-title mb-0">รายการใบเสร็จรับเงิน</h2>
            <span class="fr-visible-pill">
                แสดง <strong id="frVisibleRowCount">@items.Count</strong> รายการ
            </span>
        </div>

        <!-- Empty State -->
        <div id="frEmptyState" class="fin-empty-state text-center py-5 px-3 @(items.Any() ? "d-none" : "")">
            <div class="fin-empty-icon-ring fr-empty-icon mx-auto mb-3">
                <i class="fa-solid fa-receipt"></i>
            </div>
            <h3 class="fin-empty-title">ไม่พบข้อมูลใบเสร็จรับเงิน</h3>
            <div class="d-flex justify-content-center gap-2 flex-wrap mt-3">
                <button type="button" id="frBtnEmptyReset" class="btn fin-btn-outline-slate btn-sm">
                    ล้างตัวกรอง
                </button>
                <button type="button" id="frBtnEmptyCreate" class="btn fin-btn-primary-cyber btn-sm">
                    <i class="fa-solid fa-plus me-1"></i> สร้างใบเสร็จใหม่
                </button>
            </div>
        </div>

        <!-- Data Table -->
        <div id="frTableWrapper" class="table-responsive @(items.Any() ? "" : "d-none")">
            <table class="table fin-table fr-receipt-table align-middle mb-0" id="frReceiptsTable">
                <thead>
                    <tr>
                        <th>เลขที่ใบเสร็จ</th>
                        <th>Booking</th>
                        <th>ลูกค้า</th>
                        <th>วันที่ออก</th>
                        <th class="text-end">ก่อนภาษี</th>
                        <th class="text-end">VAT (7%)</th>
                        <th class="text-end">ยอดสุทธิ</th>
                        <th class="text-center">สถานะ</th>
                        <th class="text-end">จัดการ</th>
                    </tr>
                </thead>
                <tbody id="frTableBody">
                    @foreach (var row in items)
                    {
                        bool isCancelled = cancelledIds.Contains(row.ReceiptId.ToString());
                        string statusKey = isCancelled ? "cancelled" : "issued";
                        string statusLabel = isCancelled ? "Cancelled" : "Issued";
                        string badgeClass = isCancelled ? "fr-badge status-cancelled" : "fr-badge status-issued";
                        string badgeIcon = isCancelled ? "fa-solid fa-ban" : "fa-solid fa-circle-check";

                        decimal totalAmt = row.Amount;
                        decimal vatAmt = Math.Round(totalAmt * 7m / 107m, 2);
                        decimal subtotalAmt = totalAmt - vatAmt;

                        var taxDict = ViewBag.BookingTaxMap as System.Collections.IDictionary;
                        if (taxDict != null && taxDict.Contains(row.BookingId))
                        {
                            dynamic? bInfo = taxDict[row.BookingId];
                            if (bInfo != null && bInfo?.TotalAmount == totalAmt && bInfo?.TaxAmount > 0)
                            {
                                vatAmt = (decimal)bInfo!.TaxAmount;
                                subtotalAmt = totalAmt - vatAmt;
                            }
                        }

                        string formattedDate = row.IssuedAt.ToString("dd/MM/yyyy");
                        string formattedTime = row.IssuedAt.ToString("HH:mm");
                        string isoDate = row.IssuedAt.ToString("yyyy-MM-dd");
                        string sortTimestamp = row.IssuedAt.ToString("yyyy-MM-dd HH:mm:ss");

                        <tr class="fr-receipt-row @(isCancelled ? "fr-row-cancelled" : "")"
                            data-receipt-id="@row.ReceiptId"
                            data-receipt-no="@row.ReceiptNo"
                            data-booking-id="@row.BookingId"
                            data-booking-code="@row.BookingCode"
                            data-payment-id="@row.PaymentId"
                            data-customer="@row.ContactName"
                            data-method="@row.Method"
                            data-issued-by="@(row.IssuedByName ?? "Finance Officer")"
                            data-date="@isoDate"
                            data-datetime-display="@formattedDate @formattedTime"
                            data-timestamp="@sortTimestamp"
                            data-subtotal="@subtotalAmt"
                            data-vat="@vatAmt"
                            data-total="@totalAmt"
                            data-status="@statusKey"
                            data-status-label="@statusLabel">

                            <td>
                                <span class="fr-receipt-no-badge">@row.ReceiptNo</span>
                            </td>

                            <td>
                                <span class="fin-booking-code">@row.BookingCode</span>
                                <span class="d-block text-muted extra-small">#@row.BookingId</span>
                            </td>

                            <td>
                                <div class="fw-semibold text-dark">@row.ContactName</div>
                                <div class="text-muted extra-small">ออกโดย: @(row.IssuedByName ?? "Finance Officer")</div>
                            </td>

                            <td>
                                <span class="d-block fw-medium text-dark">@formattedDate</span>
                                <span class="text-muted extra-small">@formattedTime</span>
                            </td>

                            <td class="text-end text-muted fw-medium">฿@subtotalAmt.ToString("N2")</td>

                            <td class="text-end text-muted">฿@vatAmt.ToString("N2")</td>

                            <td class="text-end">
                                <span class="fin-amount-cell @(isCancelled ? "text-decoration-line-through text-muted" : "text-electric")">
                                    ฿@totalAmt.ToString("N2")
                                </span>
                            </td>

                            <td class="text-center">
                                <span class="@badgeClass">
                                    <i class="@badgeIcon me-1"></i>@statusLabel
                                </span>
                            </td>

                            <td class="text-end">
                                <div class="d-inline-flex align-items-center justify-content-end gap-1 flex-wrap">
                                    <button type="button"
                                            class="btn fin-btn-view js-fr-view"
                                            data-id="@row.ReceiptId"
                                            title="ดูใบเสร็จ">
                                        <i class="fa-regular fa-eye"></i>
                                    </button>

                                    <a asp-controller="Finance"
                                       asp-action="ReceiptPdf"
                                       asp-route-id="@row.ReceiptId"
                                       class="btn fr-btn-action-pdf"
                                       title="ดาวน์โหลด PDF">
                                        <i class="fa-solid fa-file-pdf"></i>
                                    </a>

                                    <button type="button"
                                            class="btn fr-btn-action-print js-fr-print"
                                            data-id="@row.ReceiptId"
                                            title="พิมพ์">
                                        <i class="fa-solid fa-print"></i>
                                    </button>

                                    @if (!isCancelled)
                                    {
                                        <button type="button"
                                                class="btn fr-btn-action-cancel js-fr-cancel"
                                                data-id="@row.ReceiptId"
                                                data-no="@row.ReceiptNo"
                                                data-booking="@row.BookingCode"
                                                data-customer="@row.ContactName"
                                                data-amount="@totalAmt"
                                                title="ยกเลิกใบเสร็จ">
                                            <i class="fa-solid fa-ban"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (totalPages > 0)
        {
            <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 mt-4 pt-3 border-top">
                <div class="text-muted small">
                    หน้า <strong>@currentPage</strong> จาก <strong>@totalPages</strong> (ทั้งหมด <strong>@(Model.Receipts?.TotalCount ?? 0)</strong> ฉบับ)
                </div>

                <nav aria-label="Pagination">
                    <ul class="pagination pagination-sm mb-0 payment-approval-pagination">
                        <li class="page-item @((Model.Receipts?.HasPrevious ?? false) ? "" : "disabled")">
                            <a class="page-link"
                               asp-controller="Finance"
                               asp-action="Receipts"
                               asp-route-keyword="@Model.Keyword"
                               asp-route-from="@(Model.From?.ToString("yyyy-MM-dd"))"
                               asp-route-to="@(Model.To?.ToString("yyyy-MM-dd"))"
                               asp-route-page="@(currentPage - 1)">
                                <i class="fa-solid fa-chevron-left"></i>
                            </a>
                        </li>

                        @{
                            int startP = Math.Max(1, currentPage - 2);
                            int endP = Math.Min(totalPages, currentPage + 2);
                            for (int p = startP; p <= endP; p++)
                            {
                                <li class="page-item @(p == currentPage ? "active" : "")">
                                    <a class="page-link"
                                       asp-controller="Finance"
                                       asp-action="Receipts"
                                       asp-route-keyword="@Model.Keyword"
                                       asp-route-from="@(Model.From?.ToString("yyyy-MM-dd"))"
                                       asp-route-to="@(Model.To?.ToString("yyyy-MM-dd"))"
                                       asp-route-page="@p">@p</a>
                                </li>
                            }
                        }

                        <li class="page-item @((Model.Receipts?.HasNext ?? false) ? "" : "disabled")">
                            <a class="page-link"
                               asp-controller="Finance"
                               asp-action="Receipts"
                               asp-route-keyword="@Model.Keyword"
                               asp-route-from="@(Model.From?.ToString("yyyy-MM-dd"))"
                               asp-route-to="@(Model.To?.ToString("yyyy-MM-dd"))"
                               asp-route-page="@(currentPage + 1)">
                                <i class="fa-solid fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </section>

</div>

<!-- ===================================================================== -->
<!-- Modal 1: ดูใบเสร็จรับเงิน (Official Receipt Preview)                  -->
<!-- ===================================================================== -->
<div class="modal fade" id="frPreviewModal" tabindex="-1" aria-labelledby="frPreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content payment-approval-modal">
            <div class="modal-header payment-approval-modal-header">
                <h5 class="modal-title fw-bold text-white mb-0" id="frPreviewModalLabel">
                    ใบเสร็จรับเงิน <span id="frPrevHeaderNo" class="text-cyber">-</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-3 p-md-4 bg-light">
                <div id="frPreviewLoading" class="text-center py-5">
                    <div class="spinner-border text-primary mb-2" role="status"></div>
                    <div class="text-muted small">กำลังโหลดใบเสร็จ...</div>
                </div>

                <div id="frPrintableDocument" class="fr-official-paper d-none">
                    <div id="frCancelledWatermark" class="fr-cancelled-stamp d-none">CANCELLED</div>

                    <!-- หัวกระดาษ -->
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start gap-3 pb-3 mb-3 border-bottom">
                        <div class="d-flex align-items-center gap-3">
                            <img src="~/images/Logo/LogoStayMate.jpg"
                                 alt="StayMate Logo"
                                 class="fr-paper-logo"
                                 onerror="this.onerror=null; this.src='https://placehold.co/72x72/070D1E/00E5FF?text=SM';" />
                            <div>
                                <h4 class="fw-bold text-dark mb-0">STAYMATE HOTEL</h4>
                                <p class="text-muted extra-small mb-0">88 Cyber Sukhumvit Road, Bangkok 10110</p>
                                <p class="text-muted extra-small mb-0">Tax ID: 0105569000576 · Tel: 02-000-0576</p>
                            </div>
                        </div>
                        <div class="text-sm-end">
                            <span class="fr-doc-type-badge">ใบเสร็จรับเงิน / RECEIPT</span>
                            <div class="mt-2 small">
                                <div><span class="text-muted">เลขที่:</span> <strong class="text-electric" id="frDocReceiptNo">-</strong></div>
                                <div><span class="text-muted">วันที่:</span> <strong class="text-dark" id="frDocIssuedDate">-</strong></div>
                            </div>
                        </div>
                    </div>

                    <!-- ข้อมูลลูกค้าและการเข้าพัก -->
                    <div class="row g-3 mb-3 small">
                        <div class="col-sm-6">
                            <div class="p-3 rounded-3 bg-light border h-100">
                                <span class="text-muted extra-small fw-bold d-block mb-1">ลูกค้า (Billed To)</span>
                                <div class="fw-bold text-dark fs-6" id="frDocCustomerName">-</div>
                                <div class="text-muted" id="frDocCustomerContact">-</div>
                                <div class="mt-1">
                                    <span class="text-muted">Booking:</span>
                                    <strong class="text-primary" id="frDocBookingCode">-</strong>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 rounded-3 bg-light border h-100">
                                <span class="text-muted extra-small fw-bold d-block mb-1">รายละเอียดการเข้าพัก</span>
                                <div><span class="text-muted">เข้าพัก:</span> <strong class="text-dark" id="frDocStayPeriod">-</strong></div>
                                <div><span class="text-muted">ชำระโดย:</span> <strong class="text-dark" id="frDocPayMethod">-</strong></div>
                                <div><span class="text-muted">สถานะ:</span> <span id="frDocStatusBadge"></span></div>
                            </div>
                        </div>
                    </div>

                    <!-- รายการห้องพัก -->
                    <div class="table-responsive mb-3">
                        <table class="table table-bordered table-sm align-middle small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>รายการห้องพัก</th>
                                    <th class="text-center">เลขห้อง</th>
                                    <th class="text-end">ราคา/คืน</th>
                                    <th class="text-center">คืน</th>
                                    <th class="text-end">เตียงเสริม</th>
                                    <th class="text-end">รวม (THB)</th>
                                </tr>
                            </thead>
                            <tbody id="frDocRoomsBody"></tbody>
                        </table>
                    </div>

                    <!-- สรุปยอดเงิน -->
                    <div class="row justify-content-between align-items-end g-3 mt-2">
                        <div class="col-sm-6 small">
                            <div id="frDocPromotionsBox" class="p-2 rounded bg-light border mb-2 d-none">
                                <strong class="d-block extra-small text-muted">ส่วนลดโปรโมชั่น:</strong>
                                <div id="frDocPromotionsList" class="extra-small text-dark"></div>
                            </div>
                            <div class="text-muted extra-small">
                                ผู้ออกใบเสร็จ: <strong class="text-dark" id="frDocIssuedBy">-</strong>
                            </div>
                        </div>

                        <div class="col-sm-6 col-md-5">
                            <div class="fr-doc-summary-box p-3 rounded-3">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">ค่าห้องพัก:</span>
                                    <strong id="frDocRoomAmount">฿0.00</strong>
                                </div>
                                <div class="d-flex justify-content-between small mb-1 text-danger">
                                    <span>ส่วนลด:</span>
                                    <strong id="frDocDiscountAmount">-฿0.00</strong>
                                </div>
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">ยอดก่อนภาษี:</span>
                                    <strong id="frDocSubtotal">฿0.00</strong>
                                </div>
                                <div class="d-flex justify-content-between small mb-2 pb-2 border-bottom">
                                    <span class="text-muted">VAT 7%:</span>
                                    <strong id="frDocTaxAmount">฿0.00</strong>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-dark">ยอดชำระสุทธิ:</span>
                                    <span class="fs-5 fw-bold text-electric" id="frDocTotalPaid">฿0.00</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer payment-approval-modal-footer justify-content-between">
                <a href="#" id="frModalFullDetailLink" class="btn fin-btn-outline-slate btn-sm">
                    <i class="fa-solid fa-up-right-from-square me-1"></i>เปิดหน้าเต็ม
                </a>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
                    <button type="button" id="frModalBtnPrint" class="btn fr-btn-action-print px-3">
                        <i class="fa-solid fa-print me-1"></i> พิมพ์
                    </button>
                    <a href="#" id="frModalBtnDownloadPdf" class="btn fin-btn-primary-cyber px-3">
                        <i class="fa-solid fa-file-pdf me-1"></i> PDF
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===================================================================== -->
<!-- Modal 2: สร้างใบเสร็จใหม่ (Create Receipt)                            -->
<!-- ===================================================================== -->
<div class="modal fade" id="frCreateModal" tabindex="-1" aria-labelledby="frCreateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content payment-approval-modal">
            <div class="modal-header payment-approval-modal-header">
                <h5 class="modal-title fw-bold text-white mb-0" id="frCreateModalLabel">
                    สร้างใบเสร็จรับเงินใหม่
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <div id="frCreateFormWrap">
                    <div class="mb-3">
                        <label for="frSelectApprovedPayment" class="form-label fw-bold small text-dark">
                            เลือกรายการชำระเงินที่อนุมัติแล้ว <span class="text-danger">*</span>
                        </label>
                        <select id="frSelectApprovedPayment" class="form-select fr-form-control">
                            <option value="">-- เลือกรายการ Booking / Payment --</option>
                        </select>
                    </div>

                    <div id="frCreatePreviewBox" class="p-3 rounded-3 bg-light border d-none">
                        <div class="row g-3 small mb-3">
                            <div class="col-sm-6">
                                <span class="text-muted d-block">Booking Code</span>
                                <strong class="text-electric fs-6" id="frCrBookingCode">-</strong>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted d-block">ชื่อลูกค้า</span>
                                <strong class="text-dark fs-6" id="frCrCustomerName">-</strong>
                            </div>
                            <div class="col-sm-4">
                                <span class="text-muted d-block">Payment ID</span>
                                <strong class="text-dark" id="frCrPaymentId">-</strong>
                            </div>
                            <div class="col-sm-4">
                                <span class="text-muted d-block">ช่องทางชำระเงิน</span>
                                <strong class="text-dark" id="frCrMethod">-</strong>
                            </div>
                            <div class="col-sm-4">
                                <span class="text-muted d-block">วันที่ออกใบเสร็จ</span>
                                <strong class="text-dark">@DateTime.Now.ToString("dd/MM/yyyy")</strong>
                            </div>
                        </div>

                        <div class="border-top pt-3">
                            <div class="row g-2 text-center">
                                <div class="col-6 col-sm-3">
                                    <span class="text-muted extra-small d-block">ค่าห้องพัก</span>
                                    <strong class="text-dark" id="frCrRoomAmt">฿0.00</strong>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <span class="text-muted extra-small d-block">ส่วนลด</span>
                                    <strong class="text-danger" id="frCrDiscountAmt">-฿0.00</strong>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <span class="text-muted extra-small d-block">VAT</span>
                                    <strong class="text-dark" id="frCrTaxAmt">฿0.00</strong>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <span class="text-muted extra-small d-block">ยอดสุทธิ</span>
                                    <strong class="text-success fs-6" id="frCrNetAmt">฿0.00</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="frCreateEmptyNotice" class="text-center py-4 d-none">
                    <div class="fin-empty-icon-ring mx-auto mb-3">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <h6 class="fw-bold text-dark">ไม่มีรายการค้างออกใบเสร็จ</h6>
                    <a asp-controller="Finance" asp-action="PaymentApproval" class="btn fin-btn-primary-cyber btn-sm mt-2">
                        ไปหน้า Payment Approval
                    </a>
                </div>
            </div>

            <div class="modal-footer payment-approval-modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิด</button>
                <button type="button" id="frBtnConfirmCreateReceipt" class="btn fin-btn-primary-cyber" disabled>
                    ยืนยันการออกใบเสร็จ
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ===================================================================== -->
<!-- Modal 3: ยกเลิกใบเสร็จรับเงิน (Cancel Receipt)                        -->
<!-- ===================================================================== -->
<div class="modal fade" id="frCancelModal" tabindex="-1" aria-labelledby="frCancelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content payment-approval-modal">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="frCancelModalLabel">
                    <i class="fa-solid fa-ban me-2"></i>ยกเลิกใบเสร็จรับเงิน
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="frCancelReceiptForm" novalidate>
                <div class="modal-body p-4">
                    <input type="hidden" id="frCancelReceiptId" />

                    <div class="p-3 rounded-3 bg-light border mb-3 small">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">เลขที่ใบเสร็จ:</span>
                            <strong class="text-dark" id="frCancelDisplayNo">-</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">ลูกค้า / Booking:</span>
                            <strong class="text-dark" id="frCancelDisplayCustomer">-</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">จำนวนเงิน:</span>
                            <strong class="text-danger" id="frCancelDisplayAmount">฿0.00</strong>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label for="frCancelReasonSelect" class="form-label fw-semibold small text-dark">เหตุผลการยกเลิก</label>
                        <select id="frCancelReasonSelect" class="form-select fr-form-control mb-2">
                            <option value="">-- เลือกเหตุผล --</option>
                            <option value="ลูกค้าขอยกเลิกการจองและคืนเงิน">ลูกค้าขอยกเลิกการจองและคืนเงิน</option>
                            <option value="ข้อมูลลูกค้าในใบเสร็จไม่ถูกต้อง">ข้อมูลลูกค้าในใบเสร็จไม่ถูกต้อง</option>
                            <option value="รายการชำระเงินถูกดึงคืนจากธนาคาร">รายการชำระเงินถูกดึงคืนจากธนาคาร</option>
                            <option value="OTHER">อื่น ๆ (ระบุรายละเอียด)</option>
                        </select>
                        <textarea id="frCancelReasonInput"
                                  class="form-control fr-form-control"
                                  rows="3"
                                  maxlength="255"
                                  required
                                  placeholder="ระบุเหตุผลในการยกเลิก..."></textarea>
                        <div class="invalid-feedback">กรุณาระบุเหตุผลในการยกเลิก</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">ปิด</button>
                    <button type="submit" id="frBtnConfirmCancelSubmit" class="btn btn-danger fw-semibold">
                        ยืนยันยกเลิกใบเสร็จ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script id="frUnissuedPaymentsData" type="application/json">
    @Html.Raw(unissuedPaymentsJson)
</script>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/finance/finance.js" asp-append-version="true"></script>
}