@model StayMate_Kavinvee_0576.Models.ViewModels.PaymentApprovalViewModel

@{
    Layout = "~/Views/Shared/_FinanceLayout.cshtml";
    ViewData["Title"] = "อนุมัติสลิปโอนเงิน (Payment Slip Approval)";

    int pendingCount = ViewBag.SummaryPending ?? 0;
    int approvedCount = ViewBag.SummaryApproved ?? 0;
    int rejectedCount = ViewBag.SummaryRejected ?? 0;
    int totalCount = ViewBag.SummaryTotal ?? Model.Payments.TotalCount;
}

<link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" />

<div class="finance-dashboard-wrapper payment-approval-page"
     id="paymentApprovalApp"
     data-api-list="@Url.Action("GetPaymentSlipsJson", "Finance")"
     data-api-detail="@Url.Action("GetPaymentSlipDetailJson", "Finance")"
     data-api-approve="@Url.Action("ApproveAjax", "Finance")"
     data-api-reject="@Url.Action("RejectAjax", "Finance")"
     data-initial-status="@(Model.Status ?? "pending")"
     data-initial-keyword="@(Model.Keyword ?? "")">

    <!-- Anti-Forgery Token สำหรับการส่ง POST Approve / Reject -->
    <form id="paymentApprovalCsrfForm" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <!-- ================================================================= -->
    <!-- 1. Header Section                                                 -->
    <!-- ================================================================= -->
    <section class="fin-welcome-banner payment-approval-header mb-4">
        <div class="fin-welcome-glow"></div>
        <div class="row align-items-center position-relative z-1 g-3">
            <div class="col-lg-8">
                <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                    <span class="fin-chip-cyber">
                        <i class="fa-solid fa-shield-halved"></i> FINANCIAL AUDIT &amp; SLIP VERIFICATION
                    </span>
                    <span class="fin-date-badge">
                        <i class="fa-solid fa-scale-balanced me-1"></i> Separation of Duties Enforced
                    </span>
                </div>
                <h1 class="fin-welcome-title mb-1">ระบบอนุมัติสลิปการเงิน (Payment Slip Approval)</h1>
                <p class="fin-welcome-subtitle mb-0">
                    ตรวจสอบหลักฐานการโอนเงิน เทียบยอดชำระจริงกับยอดจอง และบันทึกผลการอนุมัติพร้อมออกใบเสร็จอัตโนมัติ
                </p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <div class="d-inline-flex flex-wrap gap-2">
                    <button type="button" id="paBtnSwitchHistory" class="btn payment-approval-btn-history">
                        <i class="fa-solid fa-clock-rotate-left me-2"></i>ประวัติการตรวจสอบ
                    </button>
                    <button type="button" id="paBtnReloadTable" class="btn fin-btn-refresh">
                        <i class="fa-solid fa-arrows-rotate me-2" id="paReloadIcon"></i>รีเฟรชข้อมูล
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- ================================================================= -->
    <!-- 2. Dashboard Summary Cards (4 รายการ อัปเดตแบบ Real-time)          -->
    <!-- ================================================================= -->
    <section class="row g-3 g-xl-4 mb-4">
        <!-- Card 1: Pending Approval (สีส้ม) -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="fin-kpi-card kpi-pending payment-approval-summary-card h-100" data-filter-trigger="pending" role="button">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="fin-kpi-label">PENDING APPROVAL</span>
                        <h3 class="fin-kpi-thai-title">รอตรวจสอบสลิป</h3>
                    </div>
                    <div class="fin-kpi-icon-wrap icon-pending">
                        <i class="fa-solid fa-hourglass-half"></i>
                    </div>
                </div>
                <div class="fin-kpi-amount text-warning-custom">
                    <span id="paSummaryPending">@pendingCount.ToString("N0")</span>
                    <small class="fin-kpi-unit">รายการ</small>
                </div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="fin-kpi-note">เรียงตามคิวส่งก่อน-หลัง (FIFO)</span>
                    <span class="fin-kpi-tag tag-orange">Pending</span>
                </div>
            </div>
        </div>

        <!-- Card 2: Approved (สีเขียว) -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="fin-kpi-card kpi-approved payment-approval-summary-card h-100" data-filter-trigger="approved" role="button">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="fin-kpi-label">APPROVED</span>
                        <h3 class="fin-kpi-thai-title">อนุมัติแล้ว</h3>
                    </div>
                    <div class="fin-kpi-icon-wrap icon-approved">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                </div>
                <div class="fin-kpi-amount text-success-custom">
                    <span id="paSummaryApproved">@approvedCount.ToString("N0")</span>
                    <small class="fin-kpi-unit">รายการ</small>
                </div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="fin-kpi-note">ยืนยันห้องพัก &amp; ออกใบเสร็จแล้ว</span>
                    <span class="fin-kpi-tag tag-green">Approved</span>
                </div>
            </div>
        </div>

        <!-- Card 3: Rejected (สีแดง) -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="fin-kpi-card kpi-rejected payment-approval-summary-card h-100" data-filter-trigger="rejected" role="button">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="fin-kpi-label">REJECTED</span>
                        <h3 class="fin-kpi-thai-title">ปฏิเสธสลิป</h3>
                    </div>
                    <div class="fin-kpi-icon-wrap icon-rejected">
                        <i class="fa-solid fa-circle-xmark"></i>
                    </div>
                </div>
                <div class="fin-kpi-amount text-danger-custom">
                    <span id="paSummaryRejected">@rejectedCount.ToString("N0")</span>
                    <small class="fin-kpi-unit">รายการ</small>
                </div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="fin-kpi-note">ส่งคืนสถานะให้ลูกค้าแนบสลิปใหม่</span>
                    <span class="fin-kpi-tag tag-red">Rejected</span>
                </div>
            </div>
        </div>

        <!-- Card 4: Total Transactions -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="fin-kpi-card kpi-revenue payment-approval-summary-card h-100" data-filter-trigger="all" role="button">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="fin-kpi-label">TOTAL TRANSACTIONS</span>
                        <h3 class="fin-kpi-thai-title">รายการสลิปทั้งหมด</h3>
                    </div>
                    <div class="fin-kpi-icon-wrap icon-revenue">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>
                </div>
                <div class="fin-kpi-amount">
                    <span id="paSummaryTotal">@totalCount.ToString("N0")</span>
                    <small class="fin-kpi-unit">รายการ</small>
                </div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="fin-kpi-note">ธุรกรรมการแจ้งชำระเงินทั้งหมด</span>
                    <span class="fin-kpi-tag tag-blue">All Records</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ================================================================= -->
    <!-- 3. Search & Filter Bar                                            -->
    <!-- ================================================================= -->
    <section class="fin-panel-card payment-approval-filter-card mb-4">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-3 pb-3 border-bottom">
            <div class="payment-approval-status-tabs" role="tablist">
                <button type="button" class="payment-approval-tab active" data-status="pending">
                    <span class="dot dot-pending"></span> Pending (รอตรวจสอบ)
                </button>
                <button type="button" class="payment-approval-tab" data-status="approved">
                    <span class="dot dot-approved"></span> Approved (อนุมัติแล้ว)
                </button>
                <button type="button" class="payment-approval-tab" data-status="rejected">
                    <span class="dot dot-rejected"></span> Rejected (ปฏิเสธ)
                </button>
                <button type="button" class="payment-approval-tab" data-status="history">
                    <i class="fa-solid fa-clock-rotate-left me-1"></i> ประวัติการตรวจสอบแล้ว
                </button>
                <button type="button" class="payment-approval-tab" data-status="all">
                    ทั้งหมด
                </button>
            </div>

            <div class="d-flex align-items-center gap-2">
                <label for="paPageSizeSelect" class="text-muted small text-nowrap mb-0">แสดงต่อหน้า:</label>
                <select id="paPageSizeSelect" class="form-select form-select-sm payment-approval-page-size">
                    <option value="10" selected>10 รายการ</option>
                    <option value="20">20 รายการ</option>
                    <option value="50">50 รายการ</option>
                </select>
            </div>
        </div>

        <form id="paFilterForm" class="row g-3 align-items-end">
            <div class="col-12 col-md-6 col-xl-4">
                <label for="paKeywordInput" class="form-label payment-approval-label">
                    <i class="fa-solid fa-magnifying-glass me-1 text-primary"></i>ค้นหาข้อมูล
                </label>
                <input type="text"
                       id="paKeywordInput"
                       class="form-control payment-approval-input"
                       value="@Model.Keyword"
                       placeholder="ชื่อผู้ใช้, อีเมล, Transaction ID (#), Booking Code..." />
            </div>

            <div class="col-6 col-md-3 col-xl-2">
                <label for="paFromDateInput" class="form-label payment-approval-label">
                    <i class="fa-regular fa-calendar me-1 text-primary"></i>ตั้งแต่วันที่ส่งสลิป
                </label>
                <input type="date" id="paFromDateInput" class="form-control payment-approval-input" />
            </div>

            <div class="col-6 col-md-3 col-xl-2">
                <label for="paToDateInput" class="form-label payment-approval-label">
                    <i class="fa-regular fa-calendar-check me-1 text-primary"></i>ถึงวันที่
                </label>
                <input type="date" id="paToDateInput" class="form-control payment-approval-input" />
            </div>

            <div class="col-12 col-md-6 col-xl-2">
                <label for="paSortSelect" class="form-label payment-approval-label">
                    <i class="fa-solid fa-arrow-down-wide-short me-1 text-primary"></i>เรียงลำดับ
                </label>
                <select id="paSortSelect" class="form-select payment-approval-input">
                    <option value="fifo" selected>ตามสถานะ (Pending เก่าสุดก่อน)</option>
                    <option value="newest">วันที่ส่งสลิป: ล่าสุดก่อน</option>
                    <option value="oldest">วันที่ส่งสลิป: เก่าสุดก่อน</option>
                    <option value="reviewed_desc">วันที่ตรวจสอบ: ล่าสุดก่อน</option>
                </select>
            </div>

            <div class="col-12 col-md-6 col-xl-2 d-flex gap-2">
                <button type="submit" class="btn fin-btn-primary-cyber flex-grow-1">
                    <i class="fa-solid fa-filter me-1"></i> กรองข้อมูล
                </button>
                <button type="button" id="paBtnResetFilter" class="btn fin-btn-outline-slate" title="ล้างตัวกรอง">
                    <i class="fa-solid fa-rotate-left"></i>
                </button>
            </div>
        </form>
    </section>

    <!-- ================================================================= -->
    <!-- 4. Table & States (Loading / Empty / Data Table / Pagination)     -->
    <!-- ================================================================= -->
    <section class="fin-panel-card payment-approval-table-card">
        <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 mb-3 pb-2 border-bottom">
            <div>
                <h2 class="fin-panel-title mb-0" id="paTableHeading">
                    <i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i>รายการสลิปการเงิน (Payment Slips)
                </h2>
                <p class="fin-panel-subtitle mb-0 mt-1" id="paTableSubheading">
                    คลิกที่รูปสลิปเพื่อขยายดูขนาดใหญ่ หรือกด View Details เพื่อตรวจสอบข้อมูลการจองเทียบกับยอดโอน
                </p>
            </div>
            <div class="text-muted small">
                พบทั้งหมด <strong class="text-dark" id="paTotalRecordsBadge">@Model.Payments.TotalCount</strong> รายการ
            </div>
        </div>

        <!-- Loading State -->
        <div id="paLoadingState" class="payment-approval-loading text-center py-5 d-none">
            <div class="spinner-border text-primary mb-3" role="status">
                <span class="visually-hidden">กำลังโหลด...</span>
            </div>
            <h4 class="h6 fw-semibold text-dark mb-1">กำลังโหลดรายการสลิปการเงิน...</h4>
            <p class="text-muted small mb-0">กรุณารอสักครู่ ระบบกำลังดึงข้อมูลล่าสุดจากฐานข้อมูล StayMate</p>
        </div>

        <!-- Empty State -->
        <div id="paEmptyState" class="fin-empty-state text-center py-5 px-3 d-none">
            <div class="fin-empty-icon-ring mx-auto mb-3">
                <i class="fa-solid fa-folder-open"></i>
            </div>
            <h3 class="fin-empty-title">ไม่พบรายการสลิปการเงินตามเงื่อนไขที่เลือก</h3>
            <p class="fin-empty-desc mx-auto mb-3">
                ลองเปลี่ยนคำค้นหา ช่วงวันที่ หรือสลับแท็บสถานะเพื่อดูรายการอื่น ๆ ในระบบ
            </p>
            <button type="button" id="paEmptyResetBtn" class="btn fin-btn-outline-slate btn-sm">
                <i class="fa-solid fa-arrows-rotate me-1"></i> แสดงรายการทั้งหมด
            </button>
        </div>

        <!-- Data Table -->
        <div id="paTableContainer" class="table-responsive">
            <table class="table fin-table payment-approval-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 60px;">ลำดับ</th>
                        <th>Transaction ID</th>
                        <th>Booking ID</th>
                        <th>ชื่อผู้ใช้ &amp; อีเมล</th>
                        <th>วันที่ส่งสลิป</th>
                        <th class="text-end">จำนวนเงิน</th>
                        <th class="text-center">รูปภาพสลิป</th>
                        <th class="text-center">สถานะ</th>
                        <th>วันที่ตรวจสอบ</th>
                        <th>ผู้ตรวจสอบ / เหตุผล</th>
                        <th class="text-end">ปุ่มจัดการ</th>
                    </tr>
                </thead>
                <tbody id="paTableBody">
                    <!-- ข้อมูลจะถูกเรนเดอร์และอัปเดตผ่าน finance.js โดยดึงจาก FinanceController -->
                </tbody>
            </table>
        </div>

        <!-- Pagination Bar -->
        <div id="paPaginationBar" class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 mt-4 pt-3 border-top">
            <div class="text-muted small" id="paPaginationInfo">
                แสดงหน้า 1 จาก 1
            </div>
            <nav aria-label="Payment Approval Pagination">
                <ul class="pagination pagination-sm mb-0 payment-approval-pagination" id="paPaginationControls"></ul>
            </nav>
        </div>
    </section>

</div>

<!-- ===================================================================== -->
<!-- Modal 1: แสดงรายละเอียดสลิปและเทียบยอด (View Details Modal)            -->
<!-- ===================================================================== -->
<div class="modal fade" id="paDetailModal" tabindex="-1" aria-labelledby="paDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content payment-approval-modal">
            <div class="modal-header payment-approval-modal-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="fin-chip-cyber">
                        <i class="fa-solid fa-magnifying-glass-dollar"></i> SLIP VERIFICATION
                    </span>
                    <h5 class="modal-title fw-bold text-white mb-0" id="paDetailModalLabel">
                        รายละเอียดการชำระเงิน #<span id="paModalHeaderTxnId">-</span>
                    </h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <!-- Loading ภายใน Modal -->
                <div id="paDetailModalLoading" class="text-center py-5">
                    <div class="spinner-border text-primary mb-2" role="status"></div>
                    <p class="text-muted small mb-0">กำลังดึงรายละเอียดใบจองและสลิปโอนเงิน...</p>
                </div>

                <!-- เนื้อหาหลักภายใน Modal -->
                <div id="paDetailModalContent" class="d-none">
                    <!-- แจ้งเตือนกรณีติดเงื่อนไขห้ามอนุมัติ (เช่น ยอดไม่ตรง หรือเป็นเจ้าของ Booking เอง) -->
                    <div id="paModalBlockAlert" class="alert alert-warning d-flex align-items-center gap-2 mb-4 d-none" role="alert">
                        <i class="fa-solid fa-triangle-exclamation fs-5"></i>
                        <div id="paModalBlockReasonText" class="small fw-medium"></div>
                    </div>

                    <div class="row g-4">
                        <!-- คอลัมน์ซ้าย: ข้อมูล User + ข้อมูลการชำระเงิน + รายการห้องพัก -->
                        <div class="col-12 col-lg-7">
                            <!-- ข้อมูล User -->
                            <div class="payment-approval-info-box mb-3">
                                <h6 class="payment-approval-box-title">
                                    <i class="fa-solid fa-user-check text-primary me-2"></i>ข้อมูลผู้ใช้ (User Information)
                                </h6>
                                <div class="row g-2 small">
                                    <div class="col-sm-6">
                                        <span class="text-muted d-block">ชื่อผู้ใช้ (Customer Name):</span>
                                        <strong class="text-dark fs-6" id="paDetUserName">-</strong>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="text-muted d-block">User ID:</span>
                                        <strong class="text-dark" id="paDetUserId">-</strong>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="text-muted d-block">อีเมล (Email):</span>
                                        <strong class="text-dark" id="paDetUserEmail">-</strong>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="text-muted d-block">เบอร์โทรศัพท์:</span>
                                        <strong class="text-dark" id="paDetUserPhone">-</strong>
                                    </div>
                                </div>
                            </div>

                            <!-- ข้อมูลการชำระเงินและเทียบยอด -->
                            <div class="payment-approval-info-box mb-3">
                                <h6 class="payment-approval-box-title">
                                    <i class="fa-solid fa-money-check-dollar text-primary me-2"></i>ข้อมูลการชำระเงิน (Payment &amp; Booking Comparison)
                                </h6>
                                <div class="row g-3 small mb-3">
                                    <div class="col-6 col-sm-4">
                                        <span class="text-muted d-block">Transaction ID:</span>
                                        <strong class="text-dark" id="paDetTxnId">-</strong>
                                    </div>
                                    <div class="col-6 col-sm-4">
                                        <span class="text-muted d-block">Booking ID / Code:</span>
                                        <strong class="text-electric" id="paDetBookingCode">-</strong>
                                    </div>
                                    <div class="col-6 col-sm-4">
                                        <span class="text-muted d-block">สถานะปัจจุบัน:</span>
                                        <span id="paDetStatusBadge"></span>
                                    </div>
                                    <div class="col-6 col-sm-4">
                                        <span class="text-muted d-block">วันที่ส่งสลิป:</span>
                                        <strong class="text-dark" id="paDetSubmittedAt">-</strong>
                                    </div>
                                    <div class="col-6 col-sm-4">
                                        <span class="text-muted d-block">ช่องทางชำระเงิน:</span>
                                        <strong class="text-dark" id="paDetMethod">-</strong>
                                    </div>
                                    <div class="col-6 col-sm-4">
                                        <span class="text-muted d-block">วันเข้าพัก - เช็คเอาท์:</span>
                                        <strong class="text-dark" id="paDetStayDates">-</strong>
                                    </div>
                                </div>

                                <!-- กล่องเปรียบเทียบยอดเงิน -->
                                <div class="payment-approval-amount-compare p-3 rounded-3">
                                    <div class="row g-2 align-items-center text-center text-sm-start">
                                        <div class="col-sm-4">
                                            <span class="text-muted extra-small d-block">จำนวนเงินที่ต้องชำระ (Amount Due)</span>
                                            <span class="fs-5 fw-bold text-dark" id="paDetAmountDue">฿0.00</span>
                                        </div>
                                        <div class="col-sm-4 border-start-sm ps-sm-3">
                                            <span class="text-muted extra-small d-block">จำนวนเงินที่แจ้งชำระ (Slip Amount)</span>
                                            <span class="fs-5 fw-bold text-electric" id="paDetAmountPaid">฿0.00</span>
                                        </div>
                                        <div class="col-sm-4 border-start-sm ps-sm-3">
                                            <span class="text-muted extra-small d-block">ผลการเทียบยอด</span>
                                            <span id="paDetMatchStatus" class="fw-bold small">-</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- ข้อมูลผู้ตรวจสอบ (แสดงเมื่อตรวจสอบแล้ว) -->
                            <div id="paDetReviewAuditBox" class="payment-approval-info-box d-none">
                                <h6 class="payment-approval-box-title">
                                    <i class="fa-solid fa-user-shield text-primary me-2"></i>ข้อมูลการตรวจสอบ (Audit Trail)
                                </h6>
                                <div class="row g-2 small">
                                    <div class="col-sm-6">
                                        <span class="text-muted d-block">ผู้ตรวจสอบ:</span>
                                        <strong class="text-dark" id="paDetReviewedBy">-</strong>
                                    </div>
                                    <div class="col-sm-6">
                                        <span class="text-muted d-block">วันที่ตรวจสอบ:</span>
                                        <strong class="text-dark" id="paDetReviewedAt">-</strong>
                                    </div>
                                    <div class="col-12" id="paDetRejectReasonRow">
                                        <span class="text-muted d-block">เหตุผลการปฏิเสธ:</span>
                                        <strong class="text-danger" id="paDetRejectReason">-</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- คอลัมน์ขวา: รูปภาพสลิป + ปุ่ม Zoom / Fullscreen -->
                        <div class="col-12 col-lg-5">
                            <div class="payment-approval-slip-viewer h-100 d-flex flex-column justify-content-between">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="fw-semibold small text-dark">
                                        <i class="fa-regular fa-image text-primary me-1"></i>หลักฐานการโอนเงิน (Slip Image)
                                    </span>
                                    <div class="btn-group btn-group-sm" id="paModalSlipToolbar">
                                        <button type="button" class="btn btn-outline-secondary" id="paBtnModalZoomIn" title="ขยายรูป">
                                            <i class="fa-solid fa-magnifying-glass-plus"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary" id="paBtnModalZoomOut" title="ย่อรูป">
                                            <i class="fa-solid fa-magnifying-glass-minus"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary" id="paBtnModalZoomReset" title="ขนาดปกติ">
                                            <i class="fa-solid fa-compress"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-primary" id="paBtnModalFullscreen" title="ดูเต็มจอ">
                                            <i class="fa-solid fa-expand"></i> Fullscreen
                                        </button>
                                    </div>
                                </div>

                                <div class="payment-approval-slip-stage" id="paModalSlipStage">
                                    <img id="paDetSlipImg" src="" alt="Payment Slip" class="payment-approval-slip-img d-none" />
                                    <div id="paDetSlipMissing" class="payment-approval-no-slip d-none">
                                        <i class="fa-regular fa-file-excel fs-1 text-muted mb-2"></i>
                                        <p class="fw-semibold text-dark mb-0">ไม่พบรูปภาพสลิป</p>
                                        <span class="text-muted extra-small">รายการนี้ไม่มีไฟล์แนบหรือไฟล์ไม่พร้อมใช้งาน</span>
                                    </div>
                                </div>

                                <div class="text-center mt-2">
                                    <small class="text-muted extra-small">
                                        คลิกที่รูปภาพเพื่อเปิดโหมดดูรูปขนาดใหญ่ (Lightbox)
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer payment-approval-modal-footer justify-content-between">
                <a href="#" id="paModalFullPageLink" class="btn fin-btn-outline-slate btn-sm">
                    <i class="fa-solid fa-up-right-from-square me-1"></i>เปิดหน้าตรวจสอบแบบเต็ม
                </a>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ปิดหน้าต่าง</button>
                    <button type="button" id="paModalBtnReject" class="btn payment-approval-btn-reject d-none">
                        <i class="fa-solid fa-xmark me-1"></i> Reject (ปฏิเสธ)
                    </button>
                    <button type="button" id="paModalBtnApprove" class="btn payment-approval-btn-approve d-none">
                        <i class="fa-solid fa-check me-1"></i> Approve (อนุมัติสลิป)
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===================================================================== -->
<!-- Modal 2: ดูรูปสลิปขนาดใหญ่ (Zoom & Fullscreen Lightbox Modal)          -->
<!-- ===================================================================== -->
<div class="modal fade" id="paSlipPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content payment-approval-lightbox">
            <div class="modal-header border-0 pb-2">
                <h6 class="modal-title text-white fw-semibold" id="paPreviewModalTitle">
                    <i class="fa-solid fa-receipt text-cyber me-2"></i>รูปภาพสลิปโอนเงิน
                </h6>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-light" id="paLightboxZoomIn" title="Zoom In">
                        <i class="fa-solid fa-plus"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light" id="paLightboxZoomOut" title="Zoom Out">
                        <i class="fa-solid fa-minus"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light" id="paLightboxZoomReset" title="Reset">
                        100%
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-info" id="paLightboxFullscreen" title="Fullscreen">
                        <i class="fa-solid fa-expand"></i>
                    </button>
                    <button type="button" class="btn-close btn-close-white ms-2" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body text-center p-3 payment-approval-lightbox-body" id="paLightboxContainer">
                <img id="paLightboxImg" src="" alt="Slip Full Preview" class="payment-approval-lightbox-img" />
                <div id="paLightboxNoImg" class="text-white py-5 d-none">
                    <i class="fa-regular fa-image fs-1 mb-2 d-block"></i>
                    ไม่พบรูปภาพสลิป
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===================================================================== -->
<!-- Modal 3: ปฏิเสธสลิปพร้อมระบุเหตุผล (Reject Slip Modal)                  -->
<!-- ===================================================================== -->
<div class="modal fade" id="paRejectModal" tabindex="-1" aria-labelledby="paRejectModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content payment-approval-modal">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="paRejectModalLabel">
                    <i class="fa-solid fa-circle-xmark me-2"></i>ปฏิเสธสลิปการชำระเงิน (Reject Payment)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="paRejectForm" novalidate>
                <div class="modal-body p-4">
                    <input type="hidden" id="paRejectPaymentId" name="PaymentId" />

                    <div class="p-3 rounded-3 bg-light border mb-3 small">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Transaction ID:</span>
                            <strong class="text-dark" id="paRejectTxnDisplay">-</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">ผู้จอง / Booking:</span>
                            <strong class="text-dark" id="paRejectCustomerDisplay">-</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">จำนวนเงินที่แจ้งโอน:</span>
                            <strong class="text-danger" id="paRejectAmountDisplay">-</strong>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="paRejectReasonPreset" class="form-label fw-semibold small text-dark">
                            เลือกหัวข้อเหตุผลมาตรฐาน <span class="text-danger">*</span>
                        </label>
                        <select id="paRejectReasonPreset" class="form-select payment-approval-input">
                            <option value="">-- เลือกเหตุผลการปฏิเสธ --</option>
                            <option value="จำนวนเงินไม่ถูกต้อง">จำนวนเงินไม่ถูกต้อง</option>
                            <option value="รูปสลิปไม่ชัดเจน">รูปสลิปไม่ชัดเจน</option>
                            <option value="ไม่พบรายการโอนเงิน">ไม่พบรายการโอนเงิน</option>
                            <option value="สลิปไม่ตรงกับ Booking">สลิปไม่ตรงกับ Booking</option>
                            <option value="สลิปซ้ำ">สลิปซ้ำ</option>
                            <option value="หลักฐานการชำระเงินไม่ถูกต้อง">หลักฐานการชำระเงินไม่ถูกต้อง</option>
                            <option value="OTHER">อื่น ๆ (ระบุรายละเอียดด้านล่าง)</option>
                        </select>
                    </div>

                    <div class="mb-2">
                        <label for="paRejectReasonText" class="form-label fw-semibold small text-dark">
                            เหตุผลที่บันทึกในระบบ (สูงสุด 255 ตัวอักษร) <span class="text-danger">*</span>
                        </label>
                        <textarea id="paRejectReasonText"
                                  name="Reason"
                                  rows="3"
                                  maxlength="255"
                                  required
                                  class="form-control payment-approval-input"
                                  placeholder="ระบุเหตุผลที่ต้องการแจ้งให้ลูกค้าทราบเพื่ออัปโหลดสลิปใหม่..."></textarea>
                        <div class="invalid-feedback">กรุณาระบุเหตุผลในการปฏิเสธสลิป</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" id="paBtnConfirmRejectSubmit" class="btn btn-danger fw-semibold">
                        <i class="fa-solid fa-ban me-1"></i> ยืนยันการปฏิเสธสลิป
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/finance/finance.js" asp-append-version="true"></script>
}
