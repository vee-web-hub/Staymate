@model StayMate_Kavinvee_0576.Models.ViewModels.FinanceDashboardViewModel
@using System.Text.Json
@using System.Globalization

@{
    Layout = "~/Views/Shared/_FinanceLayout.cshtml";
    ViewData["Title"] = "Finance Dashboard";

    var thaiCulture = new CultureInfo("th-TH");
    var currentDateStr = DateTime.Now.ToString("d MMMM yyyy", thaiCulture);
    var totalTransactionsCount = Model.PendingCount + Model.ApprovedCount + Model.RejectedCount;

    var chartPayload = new
    {
        last7Days = Model.Last7Days.Select(d => new
        {
            label = d.Date.ToString("dd MMM", thaiCulture),
            income = d.Income,
            refund = d.Refund,
            expense = d.Expense,
            net = d.Net
        }),
        last6Months = Model.Last6Months.Select(m => new
        {
            label = new DateTime(m.Year, m.Month, 1).ToString("MMM yy", thaiCulture),
            income = m.Income,
            refund = m.Refund,
            expense = m.Expense,
            net = m.Net
        }),
        monthIncome = Model.MonthIncome,
        todayIncome = Model.TodayIncome,
        totalIncome = Model.TotalIncome,
        statusCounts = new
        {
            pending = Model.PendingCount,
            approved = Model.ApprovedCount,
            rejected = Model.RejectedCount
        },
        statusAmounts = new
        {
            pending = Model.PendingAmount,
            approved = Model.ApprovedAmount,
            rejected = Model.RejectedAmount
        }
    };

    var serializedChartData = JsonSerializer.Serialize(chartPayload);
}

<link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" />

<div class="finance-dashboard-wrapper">

    <!-- ================================================================= -->
    <!-- 1. Header Bar                                                     -->
    <!-- ================================================================= -->
    <section class="fin-welcome-banner mb-4">
        <div class="fin-welcome-glow"></div>
        <div class="row align-items-center position-relative z-1 g-3">
            <div class="col-lg-6">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="fin-chip-cyber">STAYMATE FINANCE</span>
                    <span class="fin-date-badge">
                        <i class="fa-regular fa-calendar me-1"></i>@currentDateStr
                    </span>
                </div>
                <h1 class="fin-welcome-title mb-0">Financial Overview</h1>
            </div>
            <div class="col-lg-6">
                <div class="d-flex flex-wrap align-items-center justify-content-lg-end gap-3">
                    <div class="fin-mini-stat-glass">
                        <span class="fin-mini-label">รายรับสุทธิวันนี้</span>
                        <span class="fin-mini-value text-cyber">฿@Model.TodayIncome.ToString("N2")</span>
                    </div>
                    <div class="fin-mini-stat-glass">
                        <span class="fin-mini-label">กำไรสุทธิสะสม</span>
                        <span class="fin-mini-value text-white">฿@Model.NetProfit.ToString("N2")</span>
                    </div>
                    <button type="button" id="btnRefreshDashboard" class="btn fin-btn-refresh" title="รีเฟรชข้อมูล">
                        <i class="fa-solid fa-arrows-rotate" id="refreshIcon"></i>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- ================================================================= -->
    <!-- 2. Pending Action Alert (แสดงเฉพาะเมื่อมีรายการรอตรวจสอบ)         -->
    <!-- ================================================================= -->
    @if (Model.PendingCount > 0)
    {
        <section class="fin-pending-alert mb-4" role="alert">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="fin-alert-icon-box">
                        <i class="fa-solid fa-bell"></i>
                        <span class="fin-alert-ping"></span>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <h2 class="fin-alert-title mb-0">
                                รอตรวจสอบการชำระเงิน <span class="fin-highlight-count">@Model.PendingCount รายการ</span>
                            </h2>
                            <span class="fin-badge-pending-sum">฿@Model.PendingAmount.ToString("N2")</span>
                        </div>
                    </div>
                </div>
                <a asp-controller="Finance" asp-action="PaymentApproval" asp-route-status="pending" class="btn fin-btn-warning-action flex-shrink-0">
                    <i class="fa-solid fa-magnifying-glass-dollar me-2"></i>ตรวจสอบสลิปทันที
                </a>
            </div>
        </section>
    }

    <!-- ================================================================= -->
    <!-- 3. KPI Cards (4 ใบหลัก)                                           -->
    <!-- ================================================================= -->
    <section class="row g-3 g-xl-4 mb-4">
        <!-- Total Revenue -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="fin-kpi-card kpi-revenue h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="fin-kpi-label">TOTAL REVENUE</span>
                        <h3 class="fin-kpi-thai-title">รายรับสุทธิทั้งหมด</h3>
                    </div>
                    <div class="fin-kpi-icon-wrap icon-revenue">
                        <i class="fa-solid fa-arrow-trend-up"></i>
                    </div>
                </div>
                <div class="fin-kpi-amount">฿@Model.TotalIncome.ToString("N2")</div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="fin-kpi-note">เดือนนี้ <strong>฿@Model.MonthIncome.ToString("N2")</strong></span>
                    <span class="fin-kpi-tag tag-blue">Net Income</span>
                </div>
            </div>
        </div>

        <!-- Total Expenses -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="fin-kpi-card kpi-rejected h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="fin-kpi-label">TOTAL EXPENSES</span>
                        <h3 class="fin-kpi-thai-title">รายจ่ายทั้งหมด</h3>
                    </div>
                    <div class="fin-kpi-icon-wrap icon-rejected">
                        <i class="fa-solid fa-arrow-trend-down"></i>
                    </div>
                </div>
                <div class="fin-kpi-amount text-danger-custom">฿@Model.TotalExpense.ToString("N2")</div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="fin-kpi-note">เดือนนี้ <strong>฿@Model.MonthExpense.ToString("N2")</strong></span>
                    <span class="fin-kpi-tag tag-red">Expense</span>
                </div>
            </div>
        </div>

        <!-- Pending Payments -->
        <div class="col-12 col-sm-6 col-xl-3">
            <a asp-controller="Finance" asp-action="PaymentApproval" asp-route-status="pending" class="text-decoration-none d-block h-100">
                <div class="fin-kpi-card kpi-pending h-100">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="fin-kpi-label">PENDING PAYMENTS</span>
                            <h3 class="fin-kpi-thai-title">รอตรวจสอบ</h3>
                        </div>
                        <div class="fin-kpi-icon-wrap icon-pending">
                            <i class="fa-solid fa-clock"></i>
                        </div>
                    </div>
                    <div class="fin-kpi-amount text-warning-custom">
                        @Model.PendingCount.ToString("N0") <small class="fin-kpi-unit">รายการ</small>
                    </div>
                    <div class="fin-kpi-footer mt-3 pt-2">
                        <span class="fin-kpi-note">ยอดรวม <strong>฿@Model.PendingAmount.ToString("N2")</strong></span>
                        <span class="fin-kpi-tag tag-orange">Pending</span>
                    </div>
                </div>
            </a>
        </div>

        <!-- Approved & Rejected Summary -->
        <div class="col-12 col-sm-6 col-xl-3">
            <a asp-controller="Finance" asp-action="PaymentApproval" asp-route-status="approved" class="text-decoration-none d-block h-100">
                <div class="fin-kpi-card kpi-approved h-100">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="fin-kpi-label">APPROVED / REJECTED</span>
                            <h3 class="fin-kpi-thai-title">อนุมัติแล้ว</h3>
                        </div>
                        <div class="fin-kpi-icon-wrap icon-approved">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                    </div>
                    <div class="fin-kpi-amount text-success-custom">
                        @Model.ApprovedCount.ToString("N0") <small class="fin-kpi-unit">รายการ</small>
                    </div>
                    <div class="fin-kpi-footer mt-3 pt-2">
                        <span class="fin-kpi-note">ปฏิเสธ <strong>@Model.RejectedCount.ToString("N0") รายการ</strong></span>
                        <span class="fin-kpi-tag tag-green">฿@Model.ApprovedAmount.ToString("N0")</span>
                    </div>
                </div>
            </a>
        </div>
    </section>

    <!-- ================================================================= -->
    <!-- 4. Quick Navigation                                               -->
    <!-- ================================================================= -->
    <section class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-lg-3">
            <a asp-controller="Finance" asp-action="PaymentApproval" class="fin-quick-action-card">
                <div class="fin-qa-icon qa-blue"><i class="fa-solid fa-file-invoice-dollar"></i></div>
                <div class="fin-qa-content">
                    <span class="fin-qa-title">Payment Approval</span>
                    <span class="fin-qa-sub">ตรวจสอบและอนุมัติสลิป</span>
                </div>
                <i class="fa-solid fa-chevron-right fin-qa-arrow"></i>
            </a>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <a asp-controller="Finance" asp-action="Transactions" class="fin-quick-action-card">
                <div class="fin-qa-icon qa-cyan"><i class="fa-solid fa-clock-rotate-left"></i></div>
                <div class="fin-qa-content">
                    <span class="fin-qa-title">Transaction History</span>
                    <span class="fin-qa-sub">ประวัติธุรกรรมทั้งหมด</span>
                </div>
                <i class="fa-solid fa-chevron-right fin-qa-arrow"></i>
            </a>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <a asp-controller="Finance" asp-action="Receipts" class="fin-quick-action-card">
                <div class="fin-qa-icon qa-violet"><i class="fa-solid fa-receipt"></i></div>
                <div class="fin-qa-content">
                    <span class="fin-qa-title">Receipt Management</span>
                    <span class="fin-qa-sub">ออกใบเสร็จและพิมพ์ PDF</span>
                </div>
                <i class="fa-solid fa-chevron-right fin-qa-arrow"></i>
            </a>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <a asp-controller="Finance" asp-action="Reports" class="fin-quick-action-card">
                <div class="fin-qa-icon qa-green"><i class="fa-solid fa-chart-pie"></i></div>
                <div class="fin-qa-content">
                    <span class="fin-qa-title">Financial Reports</span>
                    <span class="fin-qa-sub">รายงานและส่งออก Excel/PDF</span>
                </div>
                <i class="fa-solid fa-chevron-right fin-qa-arrow"></i>
            </a>
        </div>
    </section>

    <!-- ================================================================= -->
    <!-- 5. Charts: Revenue Analytics & Payment Status                     -->
    <!-- ================================================================= -->
    <section class="row g-4 mb-4">
        <!-- Monthly / Daily Revenue Chart -->
        <div class="col-12 col-xl-8">
            <div class="fin-panel-card h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 pb-3 border-bottom">
                        <div>
                            <h2 class="fin-panel-title mb-0" id="chartPeriodLabel">รายรับสุทธิ (6 เดือนล่าสุด)</h2>
                            <span class="fin-stat-number text-electric" id="chartPeriodNetTotal">
                                ฿@Model.Last6Months.Sum(x => x.Net).ToString("N2")
                            </span>
                        </div>
                        <div class="fin-period-switcher" role="group" aria-label="Revenue Period">
                            <button type="button" class="fin-period-btn" data-period="7d">7 วันล่าสุด</button>
                            <button type="button" class="fin-period-btn active" data-period="12m">6 เดือนล่าสุด</button>
                        </div>
                    </div>
                </div>

                <div class="fin-chart-container">
                    <canvas id="revenueAnalyticsChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Payment Status Breakdown -->
        <div class="col-12 col-xl-4">
            <div class="fin-panel-card h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
                        <h2 class="fin-panel-title mb-0">Payment Status</h2>
                        <span class="fin-total-pill">@totalTransactionsCount รายการ</span>
                    </div>

                    <div class="fin-donut-wrapper position-relative my-3">
                        <canvas id="paymentStatusDonutChart"></canvas>
                        <div class="fin-donut-center">
                            <span class="fin-donut-total-num">@totalTransactionsCount</span>
                            <span class="fin-donut-total-txt">รายการ</span>
                        </div>
                    </div>
                </div>

                <div class="fin-status-legend-list mt-3">
                    <div class="fin-status-legend-item">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fin-legend-dot dot-pending"></span>
                            <span class="fin-legend-name">Pending</span>
                        </div>
                        <div class="text-end">
                            <span class="fin-legend-count">@Model.PendingCount รายการ</span>
                            <span class="fin-legend-amount d-block">฿@Model.PendingAmount.ToString("N2")</span>
                        </div>
                    </div>

                    <div class="fin-status-legend-item">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fin-legend-dot dot-approved"></span>
                            <span class="fin-legend-name">Approved</span>
                        </div>
                        <div class="text-end">
                            <span class="fin-legend-count">@Model.ApprovedCount รายการ</span>
                            <span class="fin-legend-amount d-block">฿@Model.ApprovedAmount.ToString("N2")</span>
                        </div>
                    </div>

                    <div class="fin-status-legend-item">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fin-legend-dot dot-rejected"></span>
                            <span class="fin-legend-name">Rejected</span>
                        </div>
                        <div class="text-end">
                            <span class="fin-legend-count">@Model.RejectedCount รายการ</span>
                            <span class="fin-legend-amount d-block">฿@Model.RejectedAmount.ToString("N2")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ================================================================= -->
    <!-- 6. Pending Payment Queue (คิวรอตรวจสอบเรียงตามเวลาเก่าสุดก่อน)   -->
    <!-- ================================================================= -->
    <section class="fin-panel-card">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 pb-3 border-bottom">
            <div class="d-flex align-items-center gap-2">
                <h2 class="fin-panel-title mb-0">Pending Verification Queue</h2>
                @if (Model.PendingCount > 0)
                {
                    <span class="fin-status-badge status-pending">@Model.PendingCount รอตรวจสอบ</span>
                }
            </div>
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Finance" asp-action="PaymentApproval" asp-route-status="pending" class="btn fin-btn-primary-cyber btn-sm">
                    จัดการคิวทั้งหมด
                </a>
                <a asp-controller="Finance" asp-action="Transactions" class="btn fin-btn-outline-slate btn-sm">
                    ประวัติธุรกรรม
                </a>
            </div>
        </div>

        @if (Model.OldestPending != null && Model.OldestPending.Any())
        {
            <div class="table-responsive">
                <table class="table fin-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Booking</th>
                            <th>Customer</th>
                            <th>Submitted At</th>
                            <th class="text-end">Amount</th>
                            <th>Method</th>
                            <th class="text-center">Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OldestPending)
                        {
                            var payDate = item.PaidAt ?? item.CreatedAt;

                            string methodLabel = item.Method?.ToLowerInvariant() switch
                            {
                                "promptpay" => "PromptPay QR",
                                "bank_transfer" => "Bank Transfer",
                                "credit_card" => "Credit Card",
                                "cash" => "Cash",
                                _ => string.IsNullOrWhiteSpace(item.Method) ? "-" : item.Method
                            };

                            string methodIcon = item.Method?.ToLowerInvariant() switch
                            {
                                "promptpay" => "fa-solid fa-qrcode text-primary",
                                "bank_transfer" => "fa-solid fa-building-columns text-info",
                                "credit_card" => "fa-regular fa-credit-card text-violet",
                                _ => "fa-solid fa-money-bill-wave text-success"
                            };

                            <tr>
                                <td>
                                    <span class="fin-booking-code">@item.BookingCode</span>
                                    <span class="d-block text-muted extra-small">#@item.BookingId</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.ContactName</div>
                                    <div class="text-muted extra-small">Payment #@item.PaymentId</div>
                                </td>
                                <td>
                                    <span class="d-block fw-medium text-dark">@payDate.ToString("dd/MM/yyyy")</span>
                                    <span class="text-muted extra-small">@payDate.ToString("HH:mm")</span>
                                </td>
                                <td class="text-end">
                                    <span class="fin-amount-cell">฿@item.Amount.ToString("N2")</span>
                                    @if (item.Amount != item.BookingTotal)
                                    {
                                        <span class="d-block extra-small text-danger">
                                            <i class="fa-solid fa-triangle-exclamation"></i> ยอดจอง ฿@item.BookingTotal.ToString("N2")
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="fin-method-chip">
                                        <i class="@methodIcon me-1"></i>@methodLabel
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="fin-status-badge status-pending">
                                        <i class="fa-solid fa-clock me-1"></i>Pending
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Finance"
                                       asp-action="PaymentDetail"
                                       asp-route-id="@item.PaymentId"
                                       class="btn fin-btn-view">
                                        <i class="fa-regular fa-eye me-1"></i>ตรวจสอบ
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4 text-muted">
                <i class="fa-regular fa-circle-check fs-3 text-success mb-2 d-block"></i>
                <span>ไม่มีรายการชำระเงินค้างตรวจสอบ</span>
            </div>
        }
    </section>

</div>

<script id="financeDashboardData" type="application/json">
    @Html.Raw(serializedChartData)
</script>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/finance/finance.js" asp-append-version="true"></script>
}