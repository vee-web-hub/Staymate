@model StayMate_Kavinvee_0576.Models.ViewModels.ReceiptDetailViewModel

@{
    Layout = "~/Views/Shared/_FinanceLayout.cshtml";
    ViewData["Title"] = $"Receipt {Model.ReceiptNo}";

    decimal subtotalBeforeTax = Math.Max(0m, Model.TotalAmount - Model.TaxAmount);

    string methodDisplay = (Model.Method ?? "").ToLowerInvariant() switch
    {
        "promptpay" => "PromptPay QR",
        "bank_transfer" => "Bank Transfer",
        "credit_card" => "Credit Card",
        "cash" => "Cash",
        _ => string.IsNullOrWhiteSpace(Model.Method) ? "-" : Model.Method
    };
}

<link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" />

<div class="finance-dashboard-wrapper frd-page-wrapper" id="frdReceiptDetailApp">

    <!-- ================================================================= -->
    <!-- 1. Action Header (ซ่อนอัตโนมัติเวลาสั่งพิมพ์)                         -->
    <!-- ================================================================= -->
    <section class="fin-welcome-banner frd-header-banner mb-4 d-print-none">
        <div class="fin-welcome-glow"></div>
        <div class="row align-items-center position-relative z-1 g-3">
            <div class="col-lg-7">
                <nav aria-label="breadcrumb" class="mb-2">
                    <ol class="breadcrumb fr-breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a asp-controller="Finance" asp-action="Index">Dashboard</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a asp-controller="Finance" asp-action="Receipts">Receipts</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">@Model.ReceiptNo</li>
                    </ol>
                </nav>

                <div class="d-flex align-items-center flex-wrap gap-2">
                    <h1 class="fin-welcome-title mb-0">
                        Receipt <span class="text-cyber">@Model.ReceiptNo</span>
                    </h1>
                    <span class="fr-badge status-issued">
                        <i class="fa-solid fa-circle-check me-1"></i>Issued
                    </span>
                </div>
            </div>

            <div class="col-lg-5 text-lg-end">
                <div class="d-inline-flex flex-wrap gap-2 justify-content-lg-end">
                    <a asp-controller="Finance" asp-action="Receipts" class="btn fr-btn-export">
                        <i class="fa-solid fa-arrow-left me-2"></i>กลับหน้ารายการ
                    </a>
                    <button type="button" id="frdBtnPrintDocument" class="btn fin-btn-refresh">
                        <i class="fa-solid fa-print me-2"></i>พิมพ์
                    </button>
                    <a asp-controller="Finance"
                       asp-action="ReceiptPdf"
                       asp-route-id="@Model.ReceiptId"
                       class="btn fr-btn-create-receipt">
                        <i class="fa-solid fa-file-pdf me-2"></i>ดาวน์โหลด PDF
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ================================================================= -->
    <!-- 2. Official Receipt Paper                                         -->
    <!-- ================================================================= -->
    <section class="frd-document-container mx-auto" id="frdPrintableReceiptArea">
        <div class="fr-official-paper frd-paper-sheet">

            <!-- Brand Header -->
            <div class="row align-items-start justify-content-between g-3 pb-4 mb-4 border-bottom">
                <div class="col-sm-7">
                    <div class="d-flex align-items-center gap-3">
                        <img src="~/images/Logo/LogoStayMate.jpg"
                             alt="StayMate Logo"
                             class="fr-paper-logo"
                             onerror="this.onerror=null; this.src='https://placehold.co/76x76/070D1E/00E5FF?text=SM';" />
                        <div>
                            <h2 class="h4 fw-bold text-dark mb-1">STAYMATE HOTEL</h2>
                            <p class="text-muted small mb-0">
                                88 Cyber Sukhumvit Road, Khlong Toei, Bangkok 10110
                            </p>
                            <p class="text-muted extra-small mb-0">
                                Tax ID: 0105569000576 (สำนักงานใหญ่) · โทร. 02-000-0576
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-sm-5 text-sm-end">
                    <span class="fr-doc-type-badge mb-2">ใบเสร็จรับเงิน / RECEIPT</span>
                    <div class="small mt-1">
                        <div>
                            <span class="text-muted">เลขที่ใบเสร็จ:</span>
                            <strong class="text-electric fs-6">@Model.ReceiptNo</strong>
                        </div>
                        <div>
                            <span class="text-muted">วันที่ออก:</span>
                            <strong class="text-dark">@Model.IssuedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                        </div>
                        <div>
                            <span class="text-muted">อ้างอิงการชำระเงิน:</span>
                            <strong class="text-dark">#@Model.PaymentId</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Customer & Booking Info -->
            <div class="row g-3 mb-4 small">
                <div class="col-md-6">
                    <div class="p-3 rounded-3 bg-light border h-100">
                        <span class="text-muted extra-small text-uppercase fw-bold d-block mb-1">
                            ข้อมูลผู้ชำระเงิน (Billed To)
                        </span>
                        <div class="fw-bold text-dark fs-6 mb-1">@Model.ContactName</div>
                        <div class="text-muted">โทรศัพท์: <strong class="text-dark">@Model.ContactPhone</strong></div>
                        <div class="text-muted">อีเมล: <strong class="text-dark">@Model.ContactEmail</strong></div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 rounded-3 bg-light border h-100">
                        <span class="text-muted extra-small text-uppercase fw-bold d-block mb-1">
                            ข้อมูลการจองและการชำระเงิน
                        </span>
                        <div class="mb-1">
                            <span class="text-muted">Booking:</span>
                            <strong class="text-electric">@Model.BookingCode</strong>
                            <span class="text-muted extra-small">(#@Model.BookingId)</span>
                        </div>
                        <div class="mb-1">
                            <span class="text-muted">เข้าพัก:</span>
                            <strong class="text-dark">@Model.CheckInDate.ToString("dd/MM/yyyy") - @Model.CheckOutDate.ToString("dd/MM/yyyy") (@Model.Nights คืน)</strong>
                        </div>
                        <div>
                            <span class="text-muted">ชำระโดย:</span>
                            <strong class="text-dark">@methodDisplay</strong>
                            <span class="text-muted extra-small">(@((Model.PaidAt ?? Model.IssuedAt).ToString("dd/MM/yyyy HH:mm")))</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Room Lines Table -->
            <div class="mb-4">
                <div class="table-responsive">
                    <table class="table table-bordered align-middle small mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 48px;" class="text-center">#</th>
                                <th>รายการห้องพัก</th>
                                <th class="text-center">เลขห้อง</th>
                                <th class="text-end">ราคา/คืน</th>
                                <th class="text-center">คืน</th>
                                <th class="text-end">เตียงเสริม</th>
                                <th class="text-end">จำนวนเงิน (THB)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Rooms.Any())
                            {
                                int lineNo = 1;
                                foreach (var room in Model.Rooms)
                                {
                                    <tr>
                                        <td class="text-center text-muted">@lineNo</td>
                                        <td class="fw-semibold text-dark">@room.RoomTypeName</td>
                                        <td class="text-center">@(room.RoomNumber ?? "-")</td>
                                        <td class="text-end">฿@room.PricePerNight.ToString("N2")</td>
                                        <td class="text-center">@room.Nights</td>
                                        <td class="text-end">
                                            @(room.ExtraBedAmount > 0 ? $"฿{room.ExtraBedAmount:N2} ({room.ExtraBedQty})" : "-")
                                        </td>
                                        <td class="text-end fw-bold text-dark">฿@room.LineTotal.ToString("N2")</td>
                                    </tr>
                                    lineNo++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td class="text-center">1</td>
                                    <td colspan="5">ค่าบริการห้องพัก (@Model.BookingCode)</td>
                                    <td class="text-end fw-bold text-dark">฿@Model.RoomAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Promotions Table -->
            @if (Model.Promotions.Any())
            {
                <div class="mb-4">
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm align-middle small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>รหัสโปรโมชั่น</th>
                                    <th>รายการส่วนลด</th>
                                    <th class="text-end">ส่วนลด (%)</th>
                                    <th class="text-end">จำนวนเงินที่ลด (THB)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var promo in Model.Promotions)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary">@promo.PromoCode</td>
                                        <td>@promo.PromoName</td>
                                        <td class="text-end">@promo.AppliedPercent.ToString("N2")%</td>
                                        <td class="text-end text-danger fw-semibold">-฿@promo.AppliedAmount.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <!-- Summary Totals & Sign-off -->
            <div class="row justify-content-between align-items-end g-4 pt-2">
                <div class="col-md-6 small">
                    <div class="p-3 rounded-3 bg-light border">
                        <div class="d-flex justify-content-between extra-small text-muted mb-1">
                            <span>ผู้ออกใบเสร็จ:</span>
                            <strong class="text-dark">@(Model.IssuedByName ?? "Finance Officer")</strong>
                        </div>
                        <div class="d-flex justify-content-between extra-small text-muted">
                            <span>สถานะการชำระเงิน:</span>
                            <strong class="text-success"><i class="fa-solid fa-shield-halved me-1"></i>PAID / VERIFIED</strong>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-5">
                    <div class="fr-doc-summary-box p-3 rounded-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-muted">ค่าห้องพัก:</span>
                            <strong class="text-dark">฿@Model.RoomAmount.ToString("N2")</strong>
                        </div>
                        <div class="d-flex justify-content-between small mb-1 text-danger">
                            <span>ส่วนลด (@Model.DiscountPercent.ToString("N0")%):</span>
                            <strong>-฿@Model.DiscountAmount.ToString("N2")</strong>
                        </div>
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-muted">ยอดก่อนภาษี:</span>
                            <strong class="text-dark">฿@subtotalBeforeTax.ToString("N2")</strong>
                        </div>
                        <div class="d-flex justify-content-between small mb-2 pb-2 border-bottom">
                            <span class="text-muted">ภาษีมูลค่าเพิ่ม (VAT):</span>
                            <strong class="text-dark">฿@Model.TaxAmount.ToString("N2")</strong>
                        </div>
                        <div class="d-flex justify-content-between small mb-2">
                            <span class="fw-semibold text-dark">ยอดรวมใบจอง:</span>
                            <strong class="text-dark">฿@Model.TotalAmount.ToString("N2")</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <span class="fw-bold text-dark">ยอดที่ชำระตามใบเสร็จ:</span>
                            <span class="fs-4 fw-bold text-electric">฿@Model.Amount.ToString("N2")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="text-center mt-4 pt-3 border-top text-muted extra-small">
                ขอบคุณที่ใช้บริการ StayMate Hotel · Thank you for choosing StayMate
            </div>

        </div>
    </section>

</div>

@section Scripts {
    <script src="~/js/finance/finance.js" asp-append-version="true"></script>
}