@model StayMate_Kavinvee_0576.Models.ViewModels.ReportsViewModel
@using System.Globalization
@using System.Text.Json

@{
    Layout = "~/Views/Shared/_FinanceLayout.cshtml";
    ViewData["Title"] = "รายงานรายรับ-รายจ่าย (Financial Reports)";

    var thaiCulture = new CultureInfo("th-TH");
    var txns = Model.Transactions ?? new List<StayMate_Kavinvee_0576.Models.ViewModels.TransactionRow>();
    var dailyRows = Model.Daily ?? new List<StayMate_Kavinvee_0576.Models.ViewModels.DailyIncomeRow>();
    var monthlyRows = Model.Monthly ?? new List<StayMate_Kavinvee_0576.Models.ViewModels.MonthlyIncomeRow>();
    var roomTypeRows = Model.RoomTypes ?? new List<StayMate_Kavinvee_0576.Models.ViewModels.RoomTypeRevenueRow>();
    var promoRows = Model.Promotions ?? new List<StayMate_Kavinvee_0576.Models.ViewModels.PromotionDiscountRow>();

    // -------------------------------------------------------------------------
    // 1. คำนวณตัวเลข KPI ทางการเงินจากข้อมูลธุรกรรมที่เกิดขึ้นจริงเท่านั้น (ไม่นับ Pending)
    // -------------------------------------------------------------------------
    decimal grossRevenue = Model.TotalIncome;
    decimal totalRefund = Model.TotalRefund;
    decimal totalRevenue = Model.NetIncome; // รายรับสุทธิ = TotalIncome - TotalRefund
    decimal totalExpenses = Model.TotalExpense;
    decimal netProfit = totalRevenue - totalExpenses;
    decimal netProfitMargin = totalRevenue > 0m
        ? Math.Round((netProfit / totalRevenue) * 100m, 2)
        : 0m;

    int incomeTxnCount = txns.Count(t => string.Equals(t.TxnType, "income", StringComparison.OrdinalIgnoreCase));
    int expenseTxnCount = txns.Count(t => string.Equals(t.TxnType, "expense", StringComparison.OrdinalIgnoreCase));
    int refundTxnCount = txns.Count(t => string.Equals(t.TxnType, "refund", StringComparison.OrdinalIgnoreCase));
    int totalTxnCount = txns.Count;

    int completedTxnCount = txns.Count(t =>
        string.Equals(t.TxnType, "income", StringComparison.OrdinalIgnoreCase) &&
        (string.IsNullOrEmpty(t.PaymentStatus) || string.Equals(t.PaymentStatus, "approved", StringComparison.OrdinalIgnoreCase)));

    int cancelledOrRefundedCount = refundTxnCount + txns.Count(t =>
        string.Equals(t.PaymentStatus, "rejected", StringComparison.OrdinalIgnoreCase));

    // คำนวณแนวโน้มเปรียบเทียบครึ่งแรก vs ครึ่งหลังของช่วงเวลาที่เลือกจากข้อมูลจริงใน Daily
    decimal revTrendPercent = 0m;
    decimal expTrendPercent = 0m;
    bool hasTrendComparison = dailyRows.Count >= 2;
    if (hasTrendComparison)
    {
        int mid = dailyRows.Count / 2;
        decimal firstHalfRev = dailyRows.Take(mid).Sum(d => d.Net);
        decimal secondHalfRev = dailyRows.Skip(mid).Sum(d => d.Net);
        if (firstHalfRev > 0m)
            revTrendPercent = Math.Round(((secondHalfRev - firstHalfRev) / firstHalfRev) * 100m, 1);

        decimal firstHalfExp = dailyRows.Take(mid).Sum(d => d.Expense);
        decimal secondHalfExp = dailyRows.Skip(mid).Sum(d => d.Expense);
        if (firstHalfExp > 0m)
            expTrendPercent = Math.Round(((secondHalfExp - firstHalfExp) / firstHalfExp) * 100m, 1);
    }

    // -------------------------------------------------------------------------
    // 2. แยกสัดส่วนรายรับ (Revenue Breakdown) จากข้อมูลจริงใน Transactions
    // -------------------------------------------------------------------------
    var incomeTransactions = txns.Where(t => string.Equals(t.TxnType, "income", StringComparison.OrdinalIgnoreCase)).ToList();

    decimal roomBookingRev = incomeTransactions
        .Where(t => t.Category.Contains("Room", StringComparison.OrdinalIgnoreCase) ||
                    t.Category.Contains("Booking", StringComparison.OrdinalIgnoreCase) ||
                    t.Category.Contains("ห้องพัก", StringComparison.OrdinalIgnoreCase))
        .Sum(t => t.Amount);

    decimal extraBedRev = incomeTransactions
        .Where(t => t.Category.Contains("Extra Bed", StringComparison.OrdinalIgnoreCase) ||
                    t.Category.Contains("เตียงเสริม", StringComparison.OrdinalIgnoreCase) ||
                    (t.Description != null && t.Description.Contains("เตียงเสริม", StringComparison.OrdinalIgnoreCase)))
        .Sum(t => t.Amount);

    decimal otherServiceRev = incomeTransactions
        .Where(t => t.Category.Contains("Service", StringComparison.OrdinalIgnoreCase) ||
                    t.Category.Contains("บริการ", StringComparison.OrdinalIgnoreCase) ||
                    t.Category.Contains("Food", StringComparison.OrdinalIgnoreCase) ||
                    t.Category.Contains("Spa", StringComparison.OrdinalIgnoreCase))
        .Sum(t => t.Amount);

    decimal otherIncomeRev = Math.Max(0m, grossRevenue - (roomBookingRev + extraBedRev + otherServiceRev));

    var revenueBreakdownList = new List<(string Label, decimal Amount, string Color)>
    {
        ("Room Booking Revenue (รายได้ค่าห้องพัก)", roomBookingRev, "#2563EB"),
        ("Extra Bed Revenue (รายได้เตียงเสริม)", extraBedRev, "#00E5FF"),
        ("Other Services Revenue (บริการอื่น ๆ)", otherServiceRev, "#16A34A"),
        ("Other Income (รายรับประเภทอื่น)", otherIncomeRev, "#8B5CF6")
    };

    // -------------------------------------------------------------------------
    // 3. แยกสัดส่วนรายจ่าย (Expense Breakdown) จากข้อมูลจริงใน Transactions
    // -------------------------------------------------------------------------
    var expenseTransactions = txns.Where(t => string.Equals(t.TxnType, "expense", StringComparison.OrdinalIgnoreCase)).ToList();

    decimal housekeepingExp = expenseTransactions
        .Where(t => t.Category.Contains("Housekeeping", StringComparison.OrdinalIgnoreCase) ||
                    t.Category.Contains("แม่บ้าน", StringComparison.OrdinalIgnoreCase) ||
                    t.Category.Contains("Cleaning", StringComparison.OrdinalIgnoreCase))
        .Sum(t => t.Amount);

    decimal utilitiesExp = expenseTransactions
        .Where(t => t.Category.Contains("Utilities", StringComparison.OrdinalIgnoreCase) ||
                    t.Category.Contains("Water", StringComparison.OrdinalIgnoreCase) ||
                    t.Category.Contains("Electric", StringComparison.OrdinalIgnoreCase) ||
                    t.Category.Contains("น้ำ", StringComparison.OrdinalIgnoreCase) ||
                    t.Category.Contains("ไฟ", StringComparison.OrdinalIgnoreCase))
        .Sum(t => t.Amount);

    decimal maintenanceExp = expenseTransactions
        .Where(t => t.Category.Contains("Maintenance", StringComparison.OrdinalIgnoreCase) ||
                    t.Category.Contains("Repair", StringComparison.OrdinalIgnoreCase) ||
                    t.Category.Contains("ซ่อมบำรุง", StringComparison.OrdinalIgnoreCase))
        .Sum(t => t.Amount);

    decimal staffExp = expenseTransactions
        .Where(t => t.Category.Contains("Staff", StringComparison.OrdinalIgnoreCase) ||
                    t.Category.Contains("Salary", StringComparison.OrdinalIgnoreCase) ||
                    t.Category.Contains("Payroll", StringComparison.OrdinalIgnoreCase) ||
                    t.Category.Contains("พนักงาน", StringComparison.OrdinalIgnoreCase))
        .Sum(t => t.Amount);

    decimal otherExp = Math.Max(0m, totalExpenses - (housekeepingExp + utilitiesExp + maintenanceExp + staffExp));

    var expenseBreakdownList = new List<(string Label, decimal Amount, string Color)>
    {
        ("Housekeeping Expenses (ค่าใช้จ่ายแม่บ้าน)", housekeepingExp, "#DC2626"),
        ("Utilities (ค่าน้ำและค่าไฟ)", utilitiesExp, "#F59E0B"),
        ("Maintenance (ค่าบำรุงรักษา)", maintenanceExp, "#8B5CF6"),
        ("Staff Expenses (ค่าใช้จ่ายพนักงาน)", staffExp, "#2563EB"),
        ("Other Expenses (ค่าใช้จ่ายอื่น ๆ)", otherExp, "#64748B")
    };

    // จัดกลุ่มรายสัปดาห์จาก DailyRows เพื่อให้กราฟสลับดูได้ทั้ง รายวัน / รายสัปดาห์ / รายเดือน
    var weeklyRows = dailyRows
        .Select((d, idx) => new { Row = d, WeekIndex = idx / 7 })
        .GroupBy(x => x.WeekIndex)
        .Select(g => new
        {
            label = $"{g.First().Row.Date.ToString("dd MMM", thaiCulture)} - {g.Last().Row.Date.ToString("dd MMM", thaiCulture)}",
            income = g.Sum(x => x.Row.Net),
            grossIncome = g.Sum(x => x.Row.Income),
            expense = g.Sum(x => x.Row.Expense),
            refund = g.Sum(x => x.Row.Refund)
        })
        .ToList();

    var reportChartPayload = new
    {
        daily = dailyRows.Select(d => new
        {
            label = d.Date.ToString("dd MMM yyyy", thaiCulture),
            income = d.Net,
            grossIncome = d.Income,
            expense = d.Expense,
            refund = d.Refund
        }),
        weekly = weeklyRows,
        monthly = monthlyRows.Select(m => new
        {
            label = new DateTime(m.Year, m.Month, 1).ToString("MMM yyyy", thaiCulture),
            income = m.Net,
            grossIncome = m.Income,
            expense = m.Expense,
            refund = m.Refund
        }),
        revenueBreakdown = revenueBreakdownList.Select(r => new
        {
            label = r.Label,
            amount = r.Amount,
            color = r.Color
        }),
        expenseBreakdown = expenseBreakdownList.Select(e => new
        {
            label = e.Label,
            amount = e.Amount,
            color = e.Color
        }),
        totals = new
        {
            grossRevenue,
            totalRevenue,
            totalExpenses,
            totalRefund,
            netProfit
        }
    };

    string serializedReportJson = JsonSerializer.Serialize(reportChartPayload);
    string fromDateIso = Model.From.ToString("yyyy-MM-dd");
    string toDateIso = Model.To.ToString("yyyy-MM-dd");
    string reportPeriodDisplay = $"{Model.From.ToString("dd/MM/yyyy")} – {Model.To.ToString("dd/MM/yyyy")}";
    string generatedAtDisplay = DateTime.Now.ToString("dd/MM/yyyy เวลา HH:mm น.");
}

<link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" />

<div class="finance-dashboard-wrapper frep-page-wrapper"
     id="frepReportsApp"
     data-reports-url="@Url.Action("Reports", "Finance")"
     data-export-url="@Url.Action("ExportReport", "Finance")"
     data-from="@fromDateIso"
     data-to="@toDateIso">

    <!-- ================================================================= -->
    <!-- ส่วนหัวสำหรับเอกสารเมื่อสั่งพิมพ์ (แสดงเฉพาะตอน Print A4 เท่านั้น)      -->
    <!-- ================================================================= -->
    <div class="frep-print-only-header d-none d-print-block mb-4 pb-3 border-bottom">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h2 class="fw-bold mb-1">STAYMATE HOTEL BOOKING SYSTEM</h2>
                <h4 class="h6 fw-semibold text-secondary mb-0">รายงานวิเคราะห์รายรับ-รายจ่าย และผลประกอบการทางการเงิน (Official Financial Report)</h4>
            </div>
            <div class="text-end small">
                <div><strong>ช่วงวันที่ของรายงาน:</strong> @reportPeriodDisplay</div>
                <div><strong>วันที่จัดทำรายงาน:</strong> @generatedAtDisplay</div>
                <div><strong>ผู้จัดทำรายงาน:</strong> @(User.Identity?.Name ?? "Finance Officer")</div>
            </div>
        </div>
    </div>

    <!-- ================================================================= -->
    <!-- 1. Page Header & Breadcrumb                                       -->
    <!-- ================================================================= -->
    <section class="fin-welcome-banner frep-header-banner mb-4 d-print-none">
        <div class="fin-welcome-glow"></div>
        <div class="row align-items-center position-relative z-1 g-3">
            <div class="col-lg-7">
                <nav aria-label="breadcrumb" class="mb-2">
                    <ol class="breadcrumb frep-breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a asp-controller="Finance" asp-action="Index">
                                <i class="fa-solid fa-wallet me-1"></i>Finance Portal
                            </a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Financial Reports</li>
                    </ol>
                </nav>

                <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                    <h1 class="fin-welcome-title mb-0">รายงานรายรับ-รายจ่าย</h1>
                    <span class="fin-chip-cyber">
                        <i class="fa-solid fa-chart-line"></i> EXECUTIVE P&amp;L ANALYTICS
                    </span>
                </div>
                <p class="fin-welcome-subtitle mb-0">
                    วิเคราะห์ภาพรวมรายได้ ค่าใช้จ่าย และผลประกอบการทางการเงินของ StayMate (@reportPeriodDisplay)
                </p>
            </div>

            <div class="col-lg-5 text-lg-end">
                <div class="d-inline-flex flex-wrap gap-2 justify-content-lg-end">
                    <!-- Dropdown เลือกรูปแบบ Export Report (CSV / Excel / Server PDF) -->
                    <div class="btn-group">
                        <button type="button"
                                class="btn frep-btn-export dropdown-toggle"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            <i class="fa-solid fa-download me-2"></i>Export Report
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                            <li>
                                <button type="button" class="dropdown-item py-2" id="frepBtnExportCsv">
                                    <i class="fa-solid fa-file-csv text-primary me-2"></i>Export CSV (ตารางธุรกรรม)
                                </button>
                            </li>
                            <li>
                                <a class="dropdown-item py-2"
                                   asp-controller="Finance"
                                   asp-action="ExportReport"
                                   asp-route-from="@fromDateIso"
                                   asp-route-to="@toDateIso"
                                   asp-route-format="excel">
                                    <i class="fa-solid fa-file-excel text-success me-2"></i>Export Excel (.xlsx ครบทุกชีต)
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2"
                                   asp-controller="Finance"
                                   asp-action="ExportReport"
                                   asp-route-from="@fromDateIso"
                                   asp-route-to="@toDateIso"
                                   asp-route-format="pdf">
                                    <i class="fa-solid fa-file-pdf text-danger me-2"></i>Export Official PDF (QuestPDF)
                                </a>
                            </li>
                        </ul>
                    </div>

                    <button type="button" id="frepBtnPrintReport" class="btn fin-btn-refresh">
                        <i class="fa-solid fa-print me-2"></i>Print Report
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- ================================================================= -->
    <!-- 2. Report Filters (เลือกช่วงเวลารายงาน)                             -->
    <!-- ================================================================= -->
    <section class="fin-panel-card frep-filter-panel mb-4 d-print-none">
        <form asp-controller="Finance" asp-action="Reports" method="get" id="frepPeriodForm">
            <div class="d-flex flex-column flex-xl-row align-items-xl-center justify-content-between gap-3 mb-3 pb-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <span class="fin-dot-indicator bg-electric"></span>
                    <h2 class="fin-panel-title mb-0">เลือกช่วงเวลารายงาน (Report Period Selection)</h2>
                </div>

                <!-- ปุ่มเลือกช่วงเวลามาตรฐาน: Today / This Week / This Month / This Year / Custom Range -->
                <div class="frep-preset-group d-flex flex-wrap gap-1" role="group" aria-label="Report Period Presets">
                    <button type="button" class="frep-preset-btn" data-range="today">
                        <i class="fa-solid fa-calendar-day me-1"></i>Today (วันนี้)
                    </button>
                    <button type="button" class="frep-preset-btn" data-range="week">
                        <i class="fa-solid fa-calendar-week me-1"></i>This Week (สัปดาห์นี้)
                    </button>
                    <button type="button" class="frep-preset-btn" data-range="month">
                        <i class="fa-regular fa-calendar me-1"></i>This Month (เดือนนี้)
                    </button>
                    <button type="button" class="frep-preset-btn" data-range="year">
                        <i class="fa-solid fa-calendar-days me-1"></i>This Year (ปีนี้)
                    </button>
                    <button type="button" class="frep-preset-btn active" data-range="custom">
                        <i class="fa-solid fa-sliders me-1"></i>Custom Range (กำหนดเอง)
                    </button>
                </div>
            </div>

            <div class="row g-3 align-items-end">
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <label for="frepStartDate" class="form-label frep-form-label">
                        <i class="fa-regular fa-calendar text-primary me-1"></i>Start Date (วันที่เริ่มต้น)
                    </label>
                    <input type="date"
                           name="from"
                           id="frepStartDate"
                           class="form-control frep-form-control"
                           value="@fromDateIso"
                           required />
                </div>

                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <label for="frepEndDate" class="form-label frep-form-label">
                        <i class="fa-regular fa-calendar-check text-primary me-1"></i>End Date (วันที่สิ้นสุด)
                    </label>
                    <input type="date"
                           name="to"
                           id="frepEndDate"
                           class="form-control frep-form-control"
                           value="@toDateIso"
                           required />
                </div>

                <div class="col-12 col-md-4 col-lg-3">
                    <div class="frep-period-info-box">
                        <span class="extra-small text-muted d-block">ช่วงเวลาที่กำลังแสดงผล</span>
                        <strong class="text-dark small">@reportPeriodDisplay</strong>
                    </div>
                </div>

                <div class="col-12 col-lg-3 d-flex gap-2">
                    <button type="submit" id="frepBtnApplyFilter" class="btn frep-btn-apply flex-grow-1">
                        <i class="fa-solid fa-check me-2"></i>Apply Filter
                    </button>
                    <button type="button" id="frepBtnResetPeriod" class="btn frep-btn-reset">
                        <i class="fa-solid fa-rotate-left me-1"></i>Reset
                    </button>
                </div>
            </div>
        </form>
    </section>

    <!-- ================================================================= -->
    <!-- 3. Financial Summary Cards (KPI 4 ใบ)                             -->
    <!-- ================================================================= -->
    <section class="row g-3 g-xl-4 mb-4">
        <!-- Card 1: Total Revenue -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="fin-kpi-card kpi-approved frep-kpi-card h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="fin-kpi-label">TOTAL REVENUE</span>
                        <h3 class="fin-kpi-thai-title">รายรับสุทธิรวม</h3>
                    </div>
                    <div class="fin-kpi-icon-wrap icon-approved">
                        <i class="fa-solid fa-sack-dollar"></i>
                    </div>
                </div>
                <div class="fin-kpi-amount text-success-custom">
                    ฿@totalRevenue.ToString("N2")
                </div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="fin-kpi-note">
                        รายรับรวม ฿@grossRevenue.ToString("N2") (หักคืนเงิน ฿@totalRefund.ToString("N2"))
                    </span>
                    @if (hasTrendComparison)
                    {
                        <span class="fin-kpi-tag @(revTrendPercent >= 0 ? "tag-green" : "tag-orange")">
                            <i class="fa-solid @(revTrendPercent >= 0 ? "fa-arrow-trend-up" : "fa-arrow-trend-down") me-1"></i>
                            @(revTrendPercent >= 0 ? "+" : "")@revTrendPercent%
                        </span>
                    }
                    else
                    {
                        <span class="fin-kpi-tag tag-green">Verified Income</span>
                    }
                </div>
            </div>
        </div>

        <!-- Card 2: Total Expenses -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="fin-kpi-card kpi-rejected frep-kpi-card h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="fin-kpi-label">TOTAL EXPENSES</span>
                        <h3 class="fin-kpi-thai-title">รายจ่ายรวมทั้งหมด</h3>
                    </div>
                    <div class="fin-kpi-icon-wrap icon-rejected">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                    </div>
                </div>
                <div class="fin-kpi-amount text-danger-custom">
                    ฿@totalExpenses.ToString("N2")
                </div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="fin-kpi-note">
                        ส่วนลดโปรโมชั่นรวม: <strong>฿@Model.TotalDiscount.ToString("N2")</strong>
                    </span>
                    @if (hasTrendComparison && totalExpenses > 0)
                    {
                        <span class="fin-kpi-tag tag-red">
                            @(expTrendPercent >= 0 ? "+" : "")@expTrendPercent%
                        </span>
                    }
                    else
                    {
                        <span class="fin-kpi-tag tag-red">@expenseTxnCount รายการจ่าย</span>
                    }
                </div>
            </div>
        </div>

        <!-- Card 3: Net Profit -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="fin-kpi-card @(netProfit >= 0 ? "kpi-approved" : "kpi-rejected") frep-kpi-card h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="fin-kpi-label">NET PROFIT</span>
                        <h3 class="fin-kpi-thai-title">กำไรสุทธิ (รายรับ - รายจ่าย)</h3>
                    </div>
                    <div class="fin-kpi-icon-wrap @(netProfit >= 0 ? "icon-approved" : "icon-rejected")">
                        <i class="fa-solid @(netProfit >= 0 ? "fa-chart-line" : "fa-triangle-exclamation")"></i>
                    </div>
                </div>
                <div class="fin-kpi-amount @(netProfit >= 0 ? "text-success-custom" : "text-danger-custom")">
                    @(netProfit < 0 ? "-" : "")฿@Math.Abs(netProfit).ToString("N2")
                </div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="fin-kpi-note">
                        อัตรากำไรสุทธิ (Margin): <strong>@netProfitMargin.ToString("N2")%</strong>
                    </span>
                    <span class="fin-kpi-tag @(netProfit >= 0 ? "tag-green" : "tag-red")">
                        @(netProfit >= 0 ? "Profitable" : "Net Loss")
                    </span>
                </div>
            </div>
        </div>

        <!-- Card 4: Total Transactions -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="fin-kpi-card kpi-revenue frep-kpi-card h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="fin-kpi-label">TOTAL TRANSACTIONS</span>
                        <h3 class="fin-kpi-thai-title">จำนวนธุรกรรมในช่วงเวลา</h3>
                    </div>
                    <div class="fin-kpi-icon-wrap icon-revenue">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>
                </div>
                <div class="fin-kpi-amount">
                    @totalTxnCount.ToString("N0") <small class="fin-kpi-unit">รายการ</small>
                </div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="fin-kpi-note">
                        รับ <strong class="text-success">@incomeTxnCount</strong> · จ่าย <strong class="text-danger">@expenseTxnCount</strong> · คืนเงิน <strong>@refundTxnCount</strong>
                    </span>
                    <span class="fin-kpi-tag tag-blue">Actual Ledger</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ================================================================= -->
    <!-- 4. Revenue & Expenses Comparison Chart                            -->
    <!-- ================================================================= -->
    <section class="fin-panel-card mb-4">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-3 pb-3 border-bottom">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="fin-dot-indicator bg-electric"></span>
                    <h2 class="fin-panel-title mb-0">Revenue &amp; Expenses Analytics · กราฟเปรียบเทียบรายรับและรายจ่าย</h2>
                </div>
                <p class="fin-panel-subtitle mb-0 mt-1">
                    เปรียบเทียบแนวโน้มรายรับสุทธิ (สีน้ำเงิน/เขียว) และรายจ่าย (สีแดง/ม่วง) ตามช่วงวันที่ของรายงาน (@reportPeriodDisplay)
                </p>
            </div>

            <!-- สลับมุมมองกราฟ: รายวัน / รายสัปดาห์ / รายเดือน (ไม่กระทบตอนพิมพ์) -->
            <div class="fin-period-switcher d-print-none" role="group" aria-label="Chart Granularity">
                <button type="button" class="fin-period-btn active" data-chart-mode="daily">รายวัน (Daily)</button>
                <button type="button" class="fin-period-btn" data-chart-mode="weekly">รายสัปดาห์ (Weekly)</button>
                <button type="button" class="fin-period-btn" data-chart-mode="monthly">รายเดือน (Monthly)</button>
            </div>
        </div>

        <!-- สรุปยอดรวมของกราฟ -->
        <div class="row g-3 mb-3">
            <div class="col-sm-4">
                <div class="fin-analytic-stat-box">
                    <span class="fin-stat-label">ยอดรายรับสุทธิในช่วงกราฟ</span>
                    <span class="fin-stat-number text-success-custom" id="frepChartSumIncome">฿@totalRevenue.ToString("N2")</span>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="fin-analytic-stat-box">
                    <span class="fin-stat-label">ยอดรายจ่ายรวมในช่วงกราฟ</span>
                    <span class="fin-stat-number text-danger-custom" id="frepChartSumExpense">฿@totalExpenses.ToString("N2")</span>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="fin-analytic-stat-box">
                    <span class="fin-stat-label">ส่วนต่างกำไรสุทธิ (Net Profit)</span>
                    <span class="fin-stat-number @(netProfit >= 0 ? "text-electric" : "text-danger-custom")" id="frepChartSumNet">
                        @(netProfit < 0 ? "-" : "")฿@Math.Abs(netProfit).ToString("N2")
                    </span>
                </div>
            </div>
        </div>

        @if (dailyRows.Any() || monthlyRows.Any())
        {
            <div class="frep-main-chart-wrap">
                <canvas id="frepRevExpChart"></canvas>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="fa-solid fa-chart-column fs-2 mb-2 d-block"></i>
                ไม่มีข้อมูลธุรกรรมในช่วงวันที่ @reportPeriodDisplay สำหรับแสดงกราฟ
            </div>
        }
    </section>

    <!-- ================================================================= -->
    <!-- 5. Revenue Breakdown & Expense Breakdown (Donut Charts + Tables)  -->
    <!-- ================================================================= -->
    <section class="row g-4 mb-4">
        <!-- 5.1 Revenue Breakdown (แยกรายรับ) -->
        <div class="col-12 col-xl-6">
            <div class="fin-panel-card h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="fin-dot-indicator bg-cyber"></span>
                                <h2 class="fin-panel-title mb-0">Revenue Breakdown · สัดส่วนรายรับตามประเภท</h2>
                            </div>
                            <p class="fin-panel-subtitle mb-0 mt-1">วิเคราะห์แหล่งที่มาของรายได้จริงที่ผ่านการอนุมัติแล้ว</p>
                        </div>
                        <span class="fin-kpi-tag tag-green">รวม ฿@grossRevenue.ToString("N2")</span>
                    </div>

                    @if (grossRevenue > 0m)
                    {
                        <div class="row align-items-center g-3 my-2">
                            <div class="col-md-5">
                                <div class="frep-donut-box position-relative">
                                    <canvas id="frepRevenueDonutChart"></canvas>
                                    <div class="fin-donut-center">
                                        <span class="extra-small text-muted">รายรับรวม</span>
                                        <strong class="small text-dark">฿@grossRevenue.ToString("N0")</strong>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-7">
                                <div class="fin-status-legend-list">
                                    @foreach (var item in revenueBreakdownList)
                                    {
                                        decimal pct = grossRevenue > 0m ? Math.Round((item.Amount / grossRevenue) * 100m, 1) : 0m;
                                        <div class="fin-status-legend-item">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="fin-legend-dot" style="background-color: @item.Color;"></span>
                                                <span class="fin-legend-name small">@item.Label</span>
                                            </div>
                                            <div class="text-end">
                                                <span class="fin-legend-count">฿@item.Amount.ToString("N2")</span>
                                                <span class="fin-legend-amount d-block">@pct.ToString("N1")%</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="frep-empty-breakdown text-center py-5">
                            <i class="fa-solid fa-coins fs-2 text-muted mb-2 d-block"></i>
                            <h3 class="h6 fw-bold text-dark mb-1">ยังไม่มีข้อมูลรายรับในช่วงเวลานี้</h3>
                            <p class="text-muted extra-small mb-0">ไม่มีธุรกรรมรายรับที่ได้รับการอนุมัติในช่วงวันที่ที่เลือก</p>
                        </div>
                    }
                </div>

                <!-- ตารางย่อยแสดงรายรับตามประเภทห้องพักจริงจาก Model.RoomTypes -->
                @if (roomTypeRows.Any())
                {
                    <div class="mt-3 pt-3 border-top">
                        <h3 class="h6 fw-bold text-dark mb-2">
                            <i class="fa-solid fa-bed text-primary me-1"></i>รายได้แยกตามประเภทห้องพัก (Room Type Performance)
                        </h3>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle small mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>ประเภทห้องพัก</th>
                                        <th class="text-center">จำนวนห้อง</th>
                                        <th class="text-center">จำนวนคืนรวม</th>
                                        <th class="text-end">รายรับรวม (THB)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rt in roomTypeRows)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-dark">@rt.RoomTypeName</td>
                                            <td class="text-center">@rt.Rooms</td>
                                            <td class="text-center">@rt.Nights</td>
                                            <td class="text-end fw-bold text-electric">฿@rt.Revenue.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- 5.2 Expense Breakdown (แยกรายจ่าย) -->
        <div class="col-12 col-xl-6">
            <div class="fin-panel-card h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="fin-dot-indicator bg-violet"></span>
                                <h2 class="fin-panel-title mb-0">Expense Breakdown · สัดส่วนรายจ่ายตามหมวดหมู่</h2>
                            </div>
                            <p class="fin-panel-subtitle mb-0 mt-1">ติดตามต้นทุนและค่าใช้จ่ายในการดำเนินงานของโรงแรม</p>
                        </div>
                        <span class="fin-kpi-tag tag-red">รวม ฿@totalExpenses.ToString("N2")</span>
                    </div>

                    @if (totalExpenses > 0m)
                    {
                        <div class="row align-items-center g-3 my-2">
                            <div class="col-md-5">
                                <div class="frep-donut-box position-relative">
                                    <canvas id="frepExpenseDonutChart"></canvas>
                                    <div class="fin-donut-center">
                                        <span class="extra-small text-muted">รายจ่ายรวม</span>
                                        <strong class="small text-danger">฿@totalExpenses.ToString("N0")</strong>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-7">
                                <div class="fin-status-legend-list">
                                    @foreach (var item in expenseBreakdownList)
                                    {
                                        decimal pct = totalExpenses > 0m ? Math.Round((item.Amount / totalExpenses) * 100m, 1) : 0m;
                                        <div class="fin-status-legend-item">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="fin-legend-dot" style="background-color: @item.Color;"></span>
                                                <span class="fin-legend-name small">@item.Label</span>
                                            </div>
                                            <div class="text-end">
                                                <span class="fin-legend-count">฿@item.Amount.ToString("N2")</span>
                                                <span class="fin-legend-amount d-block">@pct.ToString("N1")%</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- หากระบบยังไม่มีข้อมูลรายจ่ายจริง แสดงข้อความตามข้อกำหนดโดยไม่สร้างตัวเลขสมมติ -->
                        <div class="frep-empty-breakdown text-center py-5">
                            <div class="fin-empty-icon-ring mx-auto mb-3" style="background: rgba(100,116,139,0.1); color: #64748B;">
                                <i class="fa-solid fa-file-circle-Check"></i>
                            </div>
                            <h3 class="h6 fw-bold text-dark mb-1">ยังไม่มีข้อมูลรายจ่ายในช่วงเวลานี้</h3>
                            <p class="text-muted extra-small mx-auto mb-0" style="max-width: 380px;">
                                ระบบไม่พบรายการธุรกรรมประเภทรายจ่าย (Expense) ในช่วงวันที่ @reportPeriodDisplay (ข้อมูลแสดงตามธุรกรรมจริงในฐานข้อมูลเท่านั้น)
                            </p>
                        </div>
                    }
                </div>

                <!-- ตารางย่อยแสดงส่วนลดจากโปรโมชั่นจริงจาก Model.Promotions (ถ้ามี) -->
                @if (promoRows.Any())
                {
                    <div class="mt-3 pt-3 border-top">
                        <h3 class="h6 fw-bold text-dark mb-2">
                            <i class="fa-solid fa-tags text-violet me-1"></i>สรุปส่วนลดจากโปรโมชั่น (Promotion Discounts)
                        </h3>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle small mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>รหัส</th>
                                        <th>ชื่อโปรโมชั่น</th>
                                        <th class="text-center">จำนวนครั้งที่ใช้</th>
                                        <th class="text-end">ส่วนลดรวม (THB)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in promoRows)
                                    {
                                        <tr>
                                            <td><span class="fin-booking-code">@p.PromoCode</span></td>
                                            <td class="fw-medium">@p.PromoName</td>
                                            <td class="text-center">@p.UsedCount</td>
                                            <td class="text-end fw-bold text-danger">-฿@p.TotalDiscount.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- ================================================================= -->
    <!-- 6. Financial Transaction Summary Table                            -->
    <!-- ================================================================= -->
    <section class="fin-panel-card mb-4">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-3 pb-3 border-bottom">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="fin-dot-indicator bg-electric"></span>
                    <h2 class="fin-panel-title mb-0">Financial Transaction Summary · ตารางสรุปรายการทางการเงิน</h2>
                </div>
                <p class="fin-panel-subtitle mb-0 mt-1">
                    รายการธุรกรรมที่เกิดขึ้นจริงในช่วงวันที่ @reportPeriodDisplay (จำกัดเฉพาะข้อมูลจริงที่ผ่านการบันทึกบัญชี)
                </p>
            </div>

            <!-- แถบค้นหาและตัวกรองตารางธุรกรรม -->
            <div class="d-flex flex-wrap align-items-center gap-2 d-print-none">
                <div class="input-group input-group-sm" style="width: 240px;">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="fa-solid fa-magnifying-glass text-muted"></i>
                    </span>
                    <input type="text"
                           id="frepTableSearch"
                           class="form-control border-start-0 ps-0"
                           placeholder="ค้นหา ID, Booking, หมวดหมู่..." />
                </div>

                <select id="frepTableTypeFilter" class="form-select form-select-sm" style="width: auto;">
                    <option value="all">ทุกประเภท (All Types)</option>
                    <option value="income">Income (รายรับ +)</option>
                    <option value="expense">Expense (รายจ่าย -)</option>
                    <option value="refund">Refund (คืนเงิน -)</option>
                </select>

                <select id="frepTableSort" class="form-select form-select-sm" style="width: auto;">
                    <option value="date_desc" selected>วันที่: ใหม่ไปเก่า</option>
                    <option value="date_asc">วันที่: เก่าไปใหม่</option>
                    <option value="amount_desc">จำนวนเงิน: มากไปน้อย</option>
                    <option value="amount_asc">จำนวนเงิน: น้อยไปมาก</option>
                </select>

                <select id="frepTablePageSize" class="form-select form-select-sm" style="width: auto;">
                    <option value="10" selected>10 / หน้า</option>
                    <option value="25">25 / หน้า</option>
                    <option value="50">50 / หน้า</option>
                    <option value="9999">แสดงทั้งหมด</option>
                </select>
            </div>
        </div>

        <!-- Empty State -->
        <div id="frepTableEmpty" class="fin-empty-state text-center py-5 px-3 @(txns.Any() ? "d-none" : "")">
            <div class="fin-empty-icon-ring mx-auto mb-3">
                <i class="fa-solid fa-folder-open"></i>
            </div>
            <h3 class="fin-empty-title">ไม่พบรายการธุรกรรมในช่วงเวลานี้</h3>
            <p class="fin-empty-desc mx-auto mb-0">
                ไม่มีข้อมูลธุรกรรมที่ตรงกับเงื่อนไขการค้นหาหรือช่วงวันที่ที่เลือก
            </p>
        </div>

        <!-- Table -->
        <div id="frepTableContainer" class="table-responsive @(txns.Any() ? "" : "d-none")">
            <table class="table fin-table align-middle mb-0" id="frepSummaryTable">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Transaction ID</th>
                        <th>Description</th>
                        <th>Category</th>
                        <th>Type</th>
                        <th>Payment Method</th>
                        <th class="text-end">Amount</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>
                <tbody id="frepTableBody">
                    @foreach (var t in txns.OrderByDescending(x => x.TxnDate).ThenByDescending(x => x.CreatedAt))
                    {
                        var tType = (t.TxnType ?? "income").ToLowerInvariant();
                        var pStatus = (t.PaymentStatus ?? "approved").ToLowerInvariant();

                        bool isPositive = tType == "income";
                        string sign = isPositive ? "+" : "-";
                        string amtClass = isPositive ? "text-success-custom" : "text-danger-custom";

                        string typeBadge = tType switch
                        {
                            "expense" => "ft-type-chip type-expense",
                            "refund" => "ft-type-chip type-refund",
                            _ => "ft-type-chip type-payment"
                        };

                        string typeDisplay = tType switch
                        {
                            "expense" => "Expense",
                            "refund" => "Refund",
                            _ => "Income"
                        };

                        string statusBadge;
                        string statusDisplay;
                        if (tType == "refund")
                        {
                            statusBadge = "ft-badge status-refunded";
                            statusDisplay = "Refunded";
                        }
                        else if (pStatus == "pending")
                        {
                            statusBadge = "ft-badge status-pending";
                            statusDisplay = "Pending";
                        }
                        else if (pStatus == "rejected")
                        {
                            statusBadge = "ft-badge status-rejected";
                            statusDisplay = "Rejected";
                        }
                        else
                        {
                            statusBadge = "ft-badge status-approved";
                            statusDisplay = "Completed";
                        }

                        string methodText = t.PaymentId.HasValue
                            ? $"Verified Payment #{t.PaymentId}"
                            : "Direct Ledger";

                        string descText = !string.IsNullOrWhiteSpace(t.Description)
                            ? t.Description
                            : (t.BookingCode != null ? $"Booking {t.BookingCode}" : t.Category);

                        <tr class="frep-txn-row"
                            data-id="@t.TxnId"
                            data-date="@t.TxnDate.ToString("dd/MM/yyyy")"
                            data-timestamp="@t.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")"
                            data-type="@tType"
                            data-type-label="@typeDisplay"
                            data-category="@t.Category"
                            data-description="@descText"
                            data-booking="@(t.BookingCode ?? "-")"
                            data-method="@methodText"
                            data-amount="@t.Amount"
                            data-signed-amount="@(isPositive ? t.Amount : -t.Amount)"
                            data-status="@statusDisplay"
                            data-search="@($"{t.TxnId} {t.BookingCode} {t.Category} {t.Description} {t.RecordedByName}".ToLowerInvariant())">

                            <td>
                                <span class="fw-medium text-dark d-block">@t.TxnDate.ToString("dd/MM/yyyy")</span>
                                <span class="text-muted extra-small">@t.CreatedAt.ToString("HH:mm") น.</span>
                            </td>
                            <td>
                                <span class="ft-txn-id-badge">#TXN-@t.TxnId.ToString("D5")</span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@descText</div>
                                @if (!string.IsNullOrWhiteSpace(t.BookingCode))
                                {
                                    <span class="extra-small text-electric">Booking: @t.BookingCode</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@t.Category</span>
                            </td>
                            <td>
                                <span class="@typeBadge">@typeDisplay</span>
                            </td>
                            <td>
                                <span class="fin-method-chip">@methodText</span>
                            </td>
                            <td class="text-end">
                                <span class="fin-amount-cell @amtClass">
                                    @sign฿@t.Amount.ToString("N2")
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="@statusBadge">@statusDisplay</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Client-Side Pagination Bar -->
        <div id="frepPaginationWrap" class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 mt-3 pt-3 border-top d-print-none">
            <div class="text-muted small" id="frepPaginationInfo">
                แสดงรายการธุรกรรม
            </div>
            <nav aria-label="Report Table Pagination">
                <ul class="pagination pagination-sm mb-0 payment-approval-pagination" id="frepPaginationControls"></ul>
            </nav>
        </div>
    </section>

    <!-- ================================================================= -->
    <!-- 7. Financial Performance Summary (สรุปผลประกอบการด้านล่าง)          -->
    <!-- ================================================================= -->
    <section class="fin-panel-card frep-performance-card">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 pb-3 border-bottom">
            <div class="d-flex align-items-center gap-2">
                <span class="fin-dot-indicator bg-cyber"></span>
                <h2 class="fin-panel-title mb-0">Financial Performance Summary · สรุปผลประกอบการทางการเงินสุทธิ</h2>
            </div>
            <span class="fin-chip-cyber bg-dark">
                <i class="fa-solid fa-shield-check"></i> ACTUAL VERIFIED SETTLEMENT ONLY
            </span>
        </div>

        <div class="row g-3">
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="frep-perf-box">
                    <span class="frep-perf-label">1. รายรับสุทธิรวม (Total Net Revenue)</span>
                    <div class="frep-perf-value text-success-custom">฿@totalRevenue.ToString("N2")</div>
                    <span class="frep-perf-sub">หักยอดคืนเงิน (Refund) ฿@totalRefund.ToString("N2") แล้ว</span>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-4">
                <div class="frep-perf-box">
                    <span class="frep-perf-label">2. รายจ่ายรวม (Total Expenses)</span>
                    <div class="frep-perf-value text-danger-custom">฿@totalExpenses.ToString("N2")</div>
                    <span class="frep-perf-sub">รวมค่าใช้จ่ายดำเนินงานที่บันทึกจริงในช่วงเวลา</span>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-4">
                <div class="frep-perf-box @(netProfit >= 0 ? "perf-profit" : "perf-loss")">
                    <span class="frep-perf-label">3. กำไรสุทธิ (Net Profit = Revenue - Expenses)</span>
                    <div class="frep-perf-value @(netProfit >= 0 ? "text-success-custom" : "text-danger-custom")">
                        @(netProfit < 0 ? "-" : "")฿@Math.Abs(netProfit).ToString("N2")
                    </div>
                    <span class="frep-perf-sub">ผลประกอบการสุทธิหลังหักค่าใช้จ่ายและเงินคืน</span>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-4">
                <div class="frep-perf-box">
                    <span class="frep-perf-label">4. อัตรากำไรสุทธิ (Net Profit Margin)</span>
                    <div class="frep-perf-value text-electric">@netProfitMargin.ToString("N2")%</div>
                    <span class="frep-perf-sub">สูตร: (Net Profit ÷ Total Revenue) × 100</span>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-4">
                <div class="frep-perf-box">
                    <span class="frep-perf-label">5. จำนวนธุรกรรมรายรับที่สำเร็จ (Completed)</span>
                    <div class="frep-perf-value text-dark">@completedTxnCount.ToString("N0") รายการ</div>
                    <span class="frep-perf-sub">นับเฉพาะรายการที่ชำระเงินและอนุมัติแล้วเท่านั้น</span>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-4">
                <div class="frep-perf-box">
                    <span class="frep-perf-label">6. รายการคืนเงิน / ยกเลิก (Refunded / Cancelled)</span>
                    <div class="frep-perf-value text-violet">@cancelledOrRefundedCount.ToString("N0") รายการ</div>
                    <span class="frep-perf-sub">แยกออกจากรายรับสุทธิเพื่อป้องกันการนับยอดซ้ำ</span>
                </div>
            </div>
        </div>
    </section>

</div>

<!-- ส่งข้อมูลจริงจาก ReportsViewModel ให้ Chart.js ใน finance.js -->
<script id="frepChartDataJson" type="application/json">
    @Html.Raw(serializedReportJson)
</script>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/finance/finance.js" asp-append-version="true"></script>
}
