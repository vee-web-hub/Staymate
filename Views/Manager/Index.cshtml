@model StayMate_Kavinvee_0576.Models.ViewModels.ManagerDashboardViewModel
@{
    ViewData["Title"] = "ภาพรวมการดำเนินงาน";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";

    var rtList = ViewBag.RoomTypes as List<StayMate_Kavinvee_0576.Models.RoomType>
                 ?? new List<StayMate_Kavinvee_0576.Models.RoomType>();
    var rtCounts = ViewBag.RoomCounts as Dictionary<byte, int>
                   ?? new Dictionary<byte, int>();
    var hotel = ViewBag.Hotel as StayMate_Kavinvee_0576.Models.HotelSetting
                ?? StayMate_Kavinvee_0576.Models.HotelSetting.Default();
}

<div class="manager-portal-wrapper"
     data-manager-dashboard
     data-endpoint="@Url.Action("DashboardData", "Manager")">

    <form id="managerGlobalTokenForm" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <!-- ═══════════════════════ การแจ้งเตือนสถานะ ═══════════════════════ -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="manager-alert manager-alert-success" role="alert">
            <div class="manager-alert-content">
                <i class="fa-solid fa-circle-check manager-alert-icon"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="manager-alert-close" data-bs-dismiss="alert" aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="manager-alert manager-alert-danger" role="alert">
            <div class="manager-alert-content">
                <i class="fa-solid fa-triangle-exclamation manager-alert-icon"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" class="manager-alert-close" data-bs-dismiss="alert" aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    <!-- ═══════════════════════ ส่วนหัวและแถบสลับหมวดหมู่ ═══════════════════════ -->
    <div class="manager-hero-card">
        <div class="manager-hero-top">
            <div class="manager-hero-title-group">
                <span class="manager-hero-eyebrow">
                    <i class="fa-solid fa-building-user"></i>
                    STAYMATE HOTEL MANAGEMENT
                </span>
                <h1 class="manager-hero-title">ภาพรวมการดำเนินงาน (Manager Dashboard)</h1>
                <p class="manager-hero-subtitle">
                    ติดตามสถิติการจอง รายรับ อัตราการเข้าพัก และสถานะห้องพักของโรงแรม
                </p>
            </div>
            <div class="manager-hero-meta">
                <div class="manager-meta-pill">
                    <i class="fa-regular fa-calendar-check"></i>
                    <span>ช่วงวันที่: <strong>@Model.StartDate.ToString("dd/MM/yyyy") - @Model.EndDate.ToString("dd/MM/yyyy")</strong></span>
                </div>
                <div class="manager-meta-pill manager-meta-pill-accent">
                    <i class="fa-solid fa-star"></i>
                    <span>คะแนนรีวิวเฉลี่ย: <strong data-kpi="averageRating" data-format="rating">@(Model.AverageRating.HasValue ? Model.AverageRating.Value.ToString("0.00") : "-")</strong> / 5.00</span>
                </div>
            </div>
        </div>

        <nav class="manager-section-nav" aria-label="เมนูภาพรวมการบริหาร">
            <button type="button" class="manager-nav-tab active" data-manager-tab-target="tab-dashboard">
                <i class="fa-solid fa-chart-pie"></i>
                <span>ภาพรวมการดำเนินงาน</span>
            </button>
            <button type="button" class="manager-nav-tab" data-manager-tab-target="tab-rooms-summary">
                <i class="fa-solid fa-bed"></i>
                <span>ห้องพักและราคา</span>
            </button>
            <button type="button" class="manager-nav-tab" data-manager-tab-target="tab-promo-summary">
                <i class="fa-solid fa-tags"></i>
                <span>โปรโมชั่นและเทศกาล</span>
                <span class="manager-nav-badge" data-kpi="activePromotions" data-format="number">@Model.ActivePromotions</span>
            </button>
            <button type="button" class="manager-nav-tab" data-manager-tab-target="tab-review-summary">
                <i class="fa-solid fa-star-half-stroke"></i>
                <span>รีวิวผู้เข้าพัก</span>
                <span class="manager-nav-badge" data-kpi="totalReviews" data-format="number">@Model.TotalReviews</span>
            </button>
            <button type="button" class="manager-nav-tab" data-manager-tab-target="tab-staff-summary">
                <i class="fa-solid fa-user-shield"></i>
                <span>บัญชีพนักงาน</span>
            </button>
            <button type="button" class="manager-nav-tab" data-manager-tab-target="tab-hotel-settings">
                <i class="fa-solid fa-hotel"></i>
                <span>ตั้งค่าข้อมูลโรงแรม</span>
            </button>
        </nav>
    </div>

    <!-- ═════════════════════════════════════════════════════════════════════════════
         TAB 1: ภาพรวมการดำเนินงาน (Manager Dashboard)
         ═════════════════════════════════════════════════════════════════════════════ -->
    <div id="tab-dashboard" class="manager-tab-content active">

        <!-- ตัวกรองช่วงเวลา -->
        <div class="manager-card manager-filter-card">
            <form method="get"
                  asp-controller="Manager"
                  asp-action="Index"
                  data-manager-range-form
                  class="manager-range-form">
                <div class="manager-range-title">
                    <i class="fa-solid fa-calendar-days text-primary"></i>
                    <div>
                        <h2 class="manager-card-title">ช่วงเวลาที่แสดงผล</h2>
                        <p class="manager-card-subtitle">เลือกช่วงวันที่เพื่อดูแนวโน้มรายรับและยอดการจอง</p>
                    </div>
                </div>

                <div class="manager-range-controls">
                    <div class="manager-preset-group" role="group" aria-label="ตัวเลือกช่วงเวลาด่วน">
                        <button type="button" class="manager-btn manager-btn-ghost" data-range-preset="today">วันนี้</button>
                        <button type="button" class="manager-btn manager-btn-ghost" data-range-preset="7">7 วันล่าสุด</button>
                        <button type="button" class="manager-btn manager-btn-ghost" data-range-preset="30">30 วันล่าสุด</button>
                        <button type="button" class="manager-btn manager-btn-ghost" data-range-preset="month">เดือนนี้</button>
                    </div>

                    <div class="manager-date-inputs">
                        <div class="manager-input-group">
                            <label for="dashboardStartDate" class="manager-label">ตั้งแต่</label>
                            <input type="date"
                                   id="dashboardStartDate"
                                   name="startDate"
                                   value="@Model.StartDate.ToString("yyyy-MM-dd")"
                                   class="manager-input" />
                        </div>
                        <div class="manager-input-group">
                            <label for="dashboardEndDate" class="manager-label">ถึงวันที่</label>
                            <input type="date"
                                   id="dashboardEndDate"
                                   name="endDate"
                                   value="@Model.EndDate.ToString("yyyy-MM-dd")"
                                   class="manager-input" />
                        </div>
                        <button type="submit" class="manager-btn manager-btn-primary">
                            <i class="fa-solid fa-rotate"></i>
                            <span>แสดงข้อมูล</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- การ์ดตัวชี้วัดหลัก 6 รายการ -->
        <div class="manager-kpi-grid">
            <!-- 1. การจองทั้งหมด -->
            <article class="manager-kpi-card manager-kpi-blue">
                <div class="manager-kpi-header">
                    <span class="manager-kpi-label">การจองทั้งหมด</span>
                    <div class="manager-kpi-icon">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>
                </div>
                <div class="manager-kpi-value" data-kpi="totalBookings" data-format="number">
                    @Model.TotalBookings.ToString("N0")
                </div>
                <div class="manager-kpi-footer">
                    <span>ในช่วงที่เลือก: <strong data-kpi="periodBookings" data-format="number">@Model.PeriodBookings.ToString("N0")</strong> รายการ</span>
                    <span class="manager-badge manager-badge-info">รอเช็คอิน <span data-kpi="pendingCheckInBookings" data-format="number">@Model.PendingCheckInBookings</span></span>
                </div>
            </article>

            <!-- 2. รายได้รวม -->
            <article class="manager-kpi-card manager-kpi-cyan">
                <div class="manager-kpi-header">
                    <span class="manager-kpi-label">รายได้รวมทั้งหมด</span>
                    <div class="manager-kpi-icon">
                        <i class="fa-solid fa-sack-dollar"></i>
                    </div>
                </div>
                <div class="manager-kpi-value" data-kpi="totalRevenue" data-format="currency">
                    ฿@Model.TotalRevenue.ToString("N2")
                </div>
                <div class="manager-kpi-footer">
                    <span>ในช่วงที่เลือก: <strong data-kpi="periodRevenue" data-format="currency">฿@Model.PeriodRevenue.ToString("N2")</strong></span>
                    <span class="manager-badge manager-badge-cyan"><span data-kpi="periodPaymentCount" data-format="number">@Model.PeriodPaymentCount</span> รายการชำระ</span>
                </div>
            </article>

            <!-- 3. อัตราการเข้าพัก -->
            <article class="manager-kpi-card manager-kpi-navy">
                <div class="manager-kpi-header">
                    <span class="manager-kpi-label">อัตราการเข้าพัก (Occupancy Rate)</span>
                    <div class="manager-kpi-icon">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                </div>
                <div class="manager-kpi-value" data-kpi="occupancyRate" data-format="percent">
                    @Model.OccupancyRate.ToString("0.00")%
                </div>
                <div class="manager-kpi-footer">
                    <div class="manager-progress-track" aria-hidden="true">
                        <div class="manager-progress-fill" data-occupancy-bar="@Model.OccupancyRate"></div>
                    </div>
                    <span class="manager-badge manager-badge-primary">รอตรวจสลิป <span data-kpi="pendingApprovalBookings" data-format="number">@Model.PendingApprovalBookings</span></span>
                </div>
            </article>

            <!-- 4. ห้องว่างพร้อมพัก -->
            <article class="manager-kpi-card manager-kpi-emerald">
                <div class="manager-kpi-header">
                    <span class="manager-kpi-label">ห้องว่างพร้อมเข้าพัก</span>
                    <div class="manager-kpi-icon">
                        <i class="fa-solid fa-door-open"></i>
                    </div>
                </div>
                <div class="manager-kpi-value" data-kpi="availableRooms" data-format="number">
                    @Model.AvailableRooms.ToString("N0")
                </div>
                <div class="manager-kpi-footer">
                    <span>จากห้องที่เปิดบริการ: <strong data-kpi="totalRooms" data-format="number">@Model.TotalRooms.ToString("N0")</strong> ห้อง</span>
                    <span class="manager-badge manager-badge-success">พร้อมให้บริการ</span>
                </div>
            </article>

            <!-- 5. ห้องที่มีผู้เข้าพัก -->
            <article class="manager-kpi-card manager-kpi-violet">
                <div class="manager-kpi-header">
                    <span class="manager-kpi-label">ห้องที่มีผู้เข้าพัก</span>
                    <div class="manager-kpi-icon">
                        <i class="fa-solid fa-bed"></i>
                    </div>
                </div>
                <div class="manager-kpi-value" data-kpi="occupiedRooms" data-format="number">
                    @Model.OccupiedRooms.ToString("N0")
                </div>
                <div class="manager-kpi-footer">
                    <span>กำลังซ่อมบำรุง: <strong data-kpi="maintenanceRooms" data-format="number">@Model.MaintenanceRooms</strong> ห้อง</span>
                    <span class="manager-badge manager-badge-violet">กำลังเข้าพัก</span>
                </div>
            </article>

            <!-- 6. ห้องรอทำความสะอาด -->
            <article class="manager-kpi-card manager-kpi-amber">
                <div class="manager-kpi-header">
                    <span class="manager-kpi-label">ห้องรอทำความสะอาด</span>
                    <div class="manager-kpi-icon">
                        <i class="fa-solid fa-broom"></i>
                    </div>
                </div>
                <div class="manager-kpi-value" data-kpi="needsCleaningRooms" data-format="number">
                    @Model.NeedsCleaningRooms.ToString("N0")
                </div>
                <div class="manager-kpi-footer">
                    <span>โปรโมชั่นที่เปิดอยู่: <strong data-kpi="activePromotions" data-format="number">@Model.ActivePromotions</strong> รายการ</span>
                    <span class="manager-badge manager-badge-warning">รอดำเนินการ</span>
                </div>
            </article>
        </div>

        <!-- กราฟสรุปผลการดำเนินงาน -->
        <div class="manager-charts-grid">
            <div class="manager-card manager-chart-card manager-chart-wide">
                <div class="manager-card-header">
                    <div>
                        <h3 class="manager-card-title">
                            <i class="fa-solid fa-coins text-success"></i>
                            แนวโน้มรายรับรายวัน
                        </h3>
                        <p class="manager-card-subtitle">ยอดรับชำระเงินที่ได้รับการอนุมัติแล้วในแต่ละวัน</p>
                    </div>
                    <span class="manager-badge manager-badge-success">
                        รวมในช่วงนี้: <strong data-kpi="periodRevenue" data-format="currency">฿@Model.PeriodRevenue.ToString("N2")</strong>
                    </span>
                </div>
                <div class="manager-chart-container">
                    <canvas id="managerRevenueChart" data-height="250"></canvas>
                </div>
            </div>

            <div class="manager-card manager-chart-card">
                <div class="manager-card-header">
                    <div>
                        <h3 class="manager-card-title">
                            <i class="fa-solid fa-calendar-day text-primary"></i>
                            จำนวนการจองรายวัน
                        </h3>
                        <p class="manager-card-subtitle">จำนวนรายการจองใหม่ที่เกิดขึ้นในแต่ละวัน</p>
                    </div>
                </div>
                <div class="manager-chart-container">
                    <canvas id="managerBookingChart" data-height="220"></canvas>
                </div>
            </div>

            <div class="manager-card manager-chart-card">
                <div class="manager-card-header">
                    <div>
                        <h3 class="manager-card-title">
                            <i class="fa-solid fa-circle-dot text-info"></i>
                            สัดส่วนสถานะห้องพัก
                        </h3>
                        <p class="manager-card-subtitle">จำแนกตามสถานะห้องที่เปิดให้บริการปัจจุบัน</p>
                    </div>
                </div>
                <div class="manager-chart-container">
                    <canvas id="managerRoomChart" data-height="200"></canvas>
                </div>
            </div>

            <div class="manager-card manager-chart-card">
                <div class="manager-card-header">
                    <div>
                        <h3 class="manager-card-title">
                            <i class="fa-solid fa-check-double text-warning"></i>
                            สัดส่วนสถานะการจอง
                        </h3>
                        <p class="manager-card-subtitle">ภาพรวมสถานะใบจองทั้งหมดในระบบ</p>
                    </div>
                </div>
                <div class="manager-chart-container">
                    <canvas id="managerBookingStatusChart" data-height="200"></canvas>
                </div>
            </div>
        </div>

        <!-- ตารางรายการจองล่าสุด 10 รายการ -->
        <div class="manager-card">
            <div class="manager-card-header manager-card-header-responsive">
                <div>
                    <h3 class="manager-card-title">
                        <i class="fa-solid fa-clock-rotate-left text-primary"></i>
                        รายการจองล่าสุด
                    </h3>
                    <p class="manager-card-subtitle">แสดงรายการจองห้องพัก 10 รายการล่าสุด</p>
                </div>
                <div class="manager-table-tools d-flex flex-wrap gap-2">
                    <div class="manager-search-box">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="search"
                               class="manager-input"
                               placeholder="ค้นหารหัสการจอง หรือชื่อผู้ติดต่อ..."
                               data-manager-search="#recentBookingsDashboardTable" />
                    </div>
                    <select class="manager-input"
                            style="width: auto; min-width: 180px;"
                            aria-label="กรองตามสถานะการจอง"
                            data-manager-filter="#recentBookingsDashboardTable"
                            data-filter-key="status">
                        <option value="">ทุกสถานะการจอง</option>
                        @foreach (var s in Model.BookingsByStatus)
                        {
                            <option value="@s.Key">@s.Label (@s.Count)</option>
                        }
                    </select>
                </div>
            </div>

            <div class="manager-table-responsive">
                <table class="manager-table" id="recentBookingsDashboardTable">
                    <thead>
                        <tr>
                            <th>รหัสการจอง</th>
                            <th>ชื่อผู้ติดต่อ</th>
                            <th>ประเภทห้องพัก</th>
                            <th>วันที่เช็คอิน - เช็คเอาท์</th>
                            <th class="text-center">จำนวนคืน / ผู้เข้าพัก</th>
                            <th class="text-end">ยอดสุทธิ</th>
                            <th class="text-center">สถานะ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentBookings != null && Model.RecentBookings.Any())
                        {
                            foreach (var b in Model.RecentBookings)
                            {
                                <tr data-status="@b.Status">
                                    <td>
                                        <span class="manager-code-badge">@b.BookingCode</span>
                                    </td>
                                    <td>
                                        <div class="manager-user-cell">
                                            <span class="manager-avatar-sm">@(string.IsNullOrEmpty(b.ContactName) ? "G" : b.ContactName.Substring(0, 1).ToUpper())</span>
                                            <strong>@b.ContactName</strong>
                                        </div>
                                    </td>
                                    <td>
                                        @if (b.RoomTypeNames != null && b.RoomTypeNames.Any())
                                        {
                                            <div class="manager-tag-group">
                                                @foreach (var rt in b.RoomTypeNames)
                                                {
                                                    <span class="manager-room-tag">@rt</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="manager-text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="manager-date-range-cell">
                                            <span>@b.CheckInDate.ToString("dd/MM/yyyy")</span>
                                            <i class="fa-solid fa-arrow-right-long manager-text-muted"></i>
                                            <span>@b.CheckOutDate.ToString("dd/MM/yyyy")</span>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="manager-pill-neutral">@b.Nights คืน</span>
                                        <span class="manager-pill-neutral">@b.NumGuests ท่าน</span>
                                    </td>
                                    <td class="text-end">
                                        <strong class="manager-amount">฿@b.TotalAmount.ToString("N2")</strong>
                                    </td>
                                    <td class="text-center">
                                        <span class="manager-status-badge manager-booking-status-@b.Status">
                                            @b.StatusLabel
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr data-manager-empty-row>
                                <td colspan="7" class="manager-empty-state">
                                    <i class="fa-regular fa-folder-open"></i>
                                    <p>ยังไม่มีรายการจองในระบบ</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="manager-empty-state d-none" data-manager-empty-for="#recentBookingsDashboardTable">
                    <i class="fa-solid fa-filter-circle-xmark"></i>
                    <p>ไม่พบรายการจองที่ตรงกับเงื่อนไขการค้นหา</p>
                </div>
            </div>
        </div>
    </div>

    <!-- ═════════════════════════════════════════════════════════════════════════════
         TAB 2: สรุปห้องพักและราคา (Room & Rate Management)
         ═════════════════════════════════════════════════════════════════════════════ -->
    <div id="tab-rooms-summary" class="manager-tab-content">
        <div class="manager-card">
            <div class="manager-card-header manager-card-header-responsive">
                <div>
                    <h2 class="manager-card-title">
                        <i class="fa-solid fa-bed text-primary"></i>
                        ประเภทห้องพักและอัตราค่าบริการพื้นฐาน
                    </h2>
                    <p class="manager-card-subtitle">
                        จัดการข้อมูลห้องพักทั้ง 4 ประเภท กำหนดจำนวนผู้เข้าพัก ราคาพื้นฐาน และราคาตามช่วงเวลา
                    </p>
                </div>
                <a asp-controller="Manager" asp-action="RoomManagement" class="manager-btn manager-btn-primary">
                    <i class="fa-solid fa-sliders"></i>
                    <span>จัดการห้องพักและราคา</span>
                </a>
            </div>

            <div class="manager-grid-2col">
                @foreach (var rt in rtList)
                {
                    <div class="manager-card manager-roomtype-card">
                        <div class="manager-roomtype-top">
                            <div>
                                <span class="manager-code-badge">@rt.TypeCode</span>
                                <h3 class="manager-roomtype-name">@rt.TypeName</h3>
                            </div>
                            <span class="manager-badge manager-badge-info">
                                @(rtCounts.TryGetValue(rt.RoomTypeId, out var c) ? c : 0) ห้องที่เปิดบริการ
                            </span>
                        </div>
                        <div class="manager-roomtype-specs">
                            <div class="manager-spec-item">
                                <span class="manager-spec-label"><i class="fa-solid fa-users"></i> ประเภทเตียงและจำนวนผู้เข้าพัก</span>
                                <span class="manager-spec-val">@(string.IsNullOrWhiteSpace(rt.BedType) ? "-" : rt.BedType) · @rt.MinGuests–@rt.MaxGuests ท่าน</span>
