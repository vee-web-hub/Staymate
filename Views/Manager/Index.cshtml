    <!-- ═════════════════════════════════════════════════════════════════════════════
         TAB 6: ตั้งค่าข้อมูลโรงแรม (Hotel Settings)
         ═════════════════════════════════════════════════════════════════════════════ -->
    <div id="tab-hotel-settings" class="manager-tab-content">
        <div class="manager-card">
            <div class="manager-card-header">
                <div>
                    <h2 class="manager-card-title">
                        <i class="fa-solid fa-hotel text-primary"></i>
                        ข้อมูลพื้นฐานของโรงแรม
                    </h2>
                    <p class="manager-card-subtitle">แก้ไขชื่อโรงแรม โลโก้ ที่อยู่ ช่องทางติดต่อ และเวลาเช็คอิน/เช็คเอาท์มาตรฐาน</p>
                </div>
            </div>

            <form asp-controller="Manager"
                  asp-action="SaveHotelSettings"
                  method="post"
                  enctype="multipart/form-data"
                  class="p-3">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="manager-label" for="hsName">ชื่อโรงแรม *</label>
                        <input id="hsName" name="hotelName" class="manager-input" maxlength="150" required value="@hotel.HotelName" />
                    </div>
                    <div class="col-md-6">
                        <label class="manager-label" for="hsLogo">โลโก้โรงแรม (.jpg, .png, .webp ขนาดไม่เกิน 2 MB)</label>
                        <input id="hsLogo" name="logo" type="file" accept=".jpg,.jpeg,.png,.webp" class="manager-input" />
                        <img src="@(hotel.LogoPath ?? "/images/Logo/LogoStayMate.jpg")"
                             alt="โลโก้โรงแรม"
                             style="height:56px;margin-top:8px;border-radius:8px;" />
                    </div>
                    <div class="col-12">
                        <label class="manager-label" for="hsAddr">ที่อยู่ *</label>
                        <textarea id="hsAddr" name="address" class="manager-input" rows="2" maxlength="500" required>@hotel.Address</textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="manager-label" for="hsPhone">เบอร์โทรศัพท์ *</label>
                        <input id="hsPhone" name="phone" class="manager-input" maxlength="30" required value="@hotel.Phone" />
                    </div>
                    <div class="col-md-6">
                        <label class="manager-label" for="hsEmail">อีเมล *</label>
                        <input id="hsEmail" name="email" type="email" class="manager-input" maxlength="120" required value="@hotel.Email" />
                    </div>
                    <div class="col-md-6">
                        <label class="manager-label" for="hsIn">เวลาเช็คอินมาตรฐาน *</label>
                        <input id="hsIn" name="checkInTime" type="time" class="manager-input" required value="@hotel.CheckInTime.ToString("HH:mm")" />
                    </div>
                    <div class="col-md-6">
                        <label class="manager-label" for="hsOut">เวลาเช็คเอาท์มาตรฐาน *</label>
                        <input id="hsOut" name="checkOutTime" type="time" class="manager-input" required value="@hotel.CheckOutTime.ToString("HH:mm")" />
                    </div>
                </div>
                <div class="mt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <small class="manager-text-muted">อัปเดตล่าสุด: @hotel.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                    <button type="submit" class="manager-btn manager-btn-primary">
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span>บันทึกข้อมูลโรงแรม</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            // อัปเดตความกว้างแถบอัตราการเข้าพัก
            function updateOccupancyBar() {
                var occBars = document.querySelectorAll('[data-occupancy-bar]');
                var kpiEl = document.querySelector('[data-kpi="occupancyRate"]');
                occBars.forEach(function (bar) {
                    var raw = kpiEl ? parseFloat(kpiEl.textContent) : parseFloat(bar.getAttribute('data-occupancy-bar'));
                    var val = isNaN(raw) ? 0 : raw;
                    bar.style.width = Math.min(100, Math.max(0, val)) + '%';
                });
            }

            updateOccupancyBar();

            // สังเกตการเปลี่ยนแปลงค่า Occupancy Rate เมื่อ manager.js โหลดข้อมูลผ่าน AJAX
            var occKpi = document.querySelector('[data-kpi="occupancyRate"]');
            if (occKpi && window.MutationObserver) {
                new MutationObserver(updateOccupancyBar).observe(occKpi, { childList: true, characterData: true, subtree: true });
            }

            // ระบบสลับแท็บภายในหน้า Dashboard
            var tabButtons = document.querySelectorAll('[data-manager-tab-target]');
            var tabPanes = document.querySelectorAll('.manager-tab-content');

            tabButtons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var targetId = btn.getAttribute('data-manager-tab-target');
                    if (!targetId) return;

                    tabButtons.forEach(function (b) {
                        b.classList.toggle('active', b.getAttribute('data-manager-tab-target') === targetId);
                    });

                    tabPanes.forEach(function (pane) {
                        pane.classList.toggle('active', pane.id === targetId);
                    });
                });
            });
        })();
    </script>
}
