<!-- โมดอล 1: เพิ่ม / แก้ไข รายละเอียดแคมเปญโปรโมชั่น (POST /Manager/SavePromotion) -->
<div class="modal fade manager-modal manager-promo-modal" id="managerSavePromotionModal" tabindex="-1" aria-labelledby="managerSavePromotionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content manager-modal-content">
            <form id="savePromotionModalForm"
                  asp-controller="Manager"
                  asp-action="SavePromotion"
                  method="post"
                  data-manager-ajax>
                @Html.AntiForgeryToken()
                <input type="hidden" name="PromotionId" value="" />

                <div class="modal-header manager-modal-header">
                    <h5 class="modal-title" id="managerSavePromotionModalLabel">
                        <i class="fa-solid fa-tags text-info"></i>
                        สร้าง / แก้ไข ข้อมูลแคมเปญโปรโมชั่นพิเศษ
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body manager-modal-body">
                    <div class="manager-alert manager-alert-info mb-3">
                        <i class="fa-solid fa-circle-info"></i>
                        <span>เงื่อนไขการสะสมส่วนลดรวมของทุกโปรโมชั่นเมื่อสแต็คสิทธิ์รวมกัน จะมีเพดานสูงสุดไม่เกิน 20% โดยอัตโนมัติ</span>
                    </div>

                    <div class="manager-form-row mb-3">
                        <div class="manager-form-group">
                            <label class="manager-label">รหัสส่งเสริมการขาย (ระบุเป็นอักษรภาษาอังกฤษ ตัวเลข และเครื่องหมาย _ หรือ -) <span class="manager-req">*</span></label>
                            <input type="text" name="PromoCode" class="manager-input" maxlength="30" placeholder="ตัวอย่างเช่น STAY_3PLUS" required />
                        </div>
                        <div class="manager-form-group">
                            <label class="manager-label">ชื่อแคมเปญหลัก (ใช้แสดงผลสำหรับการเลือกจองของฝั่งลูกค้า) <span class="manager-req">*</span></label>
                            <input type="text" name="PromoName" class="manager-input" maxlength="150" placeholder="ตัวอย่างเช่น แคมเปญเที่ยวช่วงเทศกาล" required />
                        </div>
                    </div>

                    <div class="manager-form-group mb-3">
                        <label class="manager-label">คำอธิบายและเงื่อนไขเพิ่มเติม (เพื่อใช้แสดงเป็นคำชี้แจงสำหรับลูกค้า)</label>
                        <textarea name="Description" class="manager-textarea" rows="2" placeholder="กรอกรายละเอียดสิทธิประโยชน์เพื่อแสดงชี้แจงลูกค้า..."></textarea>
                    </div>

                    <div class="manager-form-row mb-3">
