@section Scripts {
    <script>
        (function () {
            'use strict';

            // 1. ระบบจัดการ Switch Tabs ของฐานข้อมูล (Promotions / Holidays)
            var dbTabButtons = document.querySelectorAll('[data-manager-dbtab-target]');
            var dbTabPanes = document.querySelectorAll('.manager-promo-dbtab-pane');

            dbTabButtons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var targetId = btn.getAttribute('data-manager-dbtab-target');
                    if (!targetId) return;

                    dbTabButtons.forEach(function (b) {
                        b.classList.toggle('active', b.getAttribute('data-manager-dbtab-target') === targetId);
                    });

                    dbTabPanes.forEach(function (pane) {
                        pane.classList.toggle('active', pane.id === targetId);
                    });
                });
            });

            // 2. ดึงข้อมูลวันหยุดจากฐานข้อมูลจริง และ Normalize ชื่อฟิลด์ให้ปลอดภัย (ป้องกันปัญหา PascalCase / camelCase)
            var rawHolidays = @Html.Raw(JsonSerializer.Serialize(Model.Holidays)) || [];
            var holidayList = rawHolidays.map(function (h) {
                return {
                    HolidayId: h.HolidayId || h.holidayId,
                    HolidayName: h.HolidayName || h.holidayName || '',
                    StartDate: (h.StartDate || h.startDate || '').substring(0, 10),
                    EndDate: (h.EndDate || h.endDate || '').substring(0, 10),
                    EventNote: h.EventNote || h.eventNote || '',
                    Status: h.Status || h.status || 'upcoming',
                    StatusLabel: h.StatusLabel || h.statusLabel || ''
                };
            });

            // 3. ตัวแปรปฏิทิน
            var monthsTH = ["มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน", "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม"];
            
            // ตั้งต้นที่เดือนพฤศจิกายน 2026 ตามวันที่ระบบ
            var currentDate = new Date(2026, 10, 1);

            var calTitle = document.getElementById('calendarTitle');
            var calGrid = document.getElementById('calendarGrid');
            var monthlySummaryLabel = document.getElementById('monthlySummaryLabel');
            var monthlyHolidayList = document.getElementById('monthlyHolidayList');

            function padZero(num) {
                return num < 10 ? '0' + num : '' + num;
            }

            function formatDateString(isoStr) {
                if (!isoStr) return "--";
                var parts = isoStr.split('-');
                if (parts.length === 3) {
                    return parts[2] + "/" + parts[1] + "/" + parts[0];
                }
                return isoStr;
            }

            // ค้นหาวันหยุดที่ตรงกับวันที่ระบุ (YYYY-MM-DD)
            function findHolidaysForDate(dateStr) {
                return holidayList.filter(function (h) {
                    return h.StartDate && h.EndDate && dateStr >= h.StartDate && dateStr <= h.EndDate;
                });
            }

            function renderCalendar() {
                if (!calTitle || !calGrid) return;

                var year = currentDate.getFullYear();
                var month = currentDate.getMonth();

                calTitle.textContent = monthsTH[month] + " " + year;
                if (monthlySummaryLabel) monthlySummaryLabel.textContent = monthsTH[month];

                calGrid.innerHTML = "";

                var firstDayIndex = new Date(year, month, 1).getDay();
                var totalDays = new Date(year, month + 1, 0).getDate();

                // ช่องว่างต้นเดือน
                for (var i = 0; i < firstDayIndex; i++) {
                    var emptyDiv = document.createElement('div');
                    emptyDiv.className = 'manager-promo-calendar-day-empty';
                    calGrid.appendChild(emptyDiv);
                }

                // วันที่ในเดือน
                for (var d = 1; d <= totalDays; d++) {
                    var dayDiv = document.createElement('div');
                    dayDiv.className = 'manager-promo-calendar-day';
                    dayDiv.textContent = d;

                    var dateStr = year + "-" + padZero(month + 1) + "-" + padZero(d);
                    var matched = findHolidaysForDate(dateStr);

                    if (matched.length > 0) {
                        var h = matched[0];
                        dayDiv.classList.add('manager-promo-calendar-day-has-event');
                        if (h.Status === 'ongoing') {
                            dayDiv.classList.add('manager-promo-calendar-day-ongoing');
                        } else {
                            dayDiv.classList.add('manager-promo-calendar-day-upcoming');
                        }
                        dayDiv.title = h.HolidayName;
                        dayDiv.setAttribute('data-holiday-id', h.HolidayId);

                        dayDiv.addEventListener('click', (function (item) {
                            return function () {
                                showHolidayDetail(item);
                            };
                        })(h));
                    }

                    calGrid.appendChild(dayDiv);
                }

                // อัปเดตรายชื่อวันหยุดของเดือนนั้นๆ
                renderMonthlyHolidays(year, month);
            }

            // สรุปวันหยุดประจำเดือนที่เลือก
            function renderMonthlyHolidays(year, month) {
                if (!monthlyHolidayList) return;
                monthlyHolidayList.innerHTML = "";

                var monthStartStr = year + "-" + padZero(month + 1) + "-01";
                var monthEndStr = year + "-" + padZero(month + 1) + "-" + padZero(new Date(year, month + 1, 0).getDate());

                // กรองหาวันหยุดที่คาบเกี่ยวกับเดือนนี้
                var currentMonthHolidays = holidayList.filter(function (h) {
                    if (!h.StartDate || !h.EndDate) return false;
                    return h.StartDate <= monthEndStr && h.EndDate >= monthStartStr;
                });

                if (currentMonthHolidays.length === 0) {
                    var emptyItem = document.createElement('div');
                    emptyItem.style.cssText = "font-size: 13px; color: #888; text-align: center; padding: 12px 0;";
                    emptyItem.innerHTML = '<i class="fa-solid fa-calendar-minus"></i> เดือนนี้ไม่มีแคมเปญวันหยุดหรือเทศกาลในฐานข้อมูล';
                    monthlyHolidayList.appendChild(emptyItem);
                    return;
                }

                currentMonthHolidays.forEach(function (h) {
                    var item = document.createElement('div');
                    item.style.cssText = "display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; background: #fff; border-radius: 6px; border-left: 4px solid " + (h.Status === 'ongoing' ? '#198754' : '#ffc107') + "; box-shadow: 0 1px 2px rgba(0,0,0,0.05); cursor: pointer;";

                    var dateRangeText = formatDateString(h.StartDate) + " - " + formatDateString(h.EndDate);

                    item.innerHTML = `
                        <div style="display: flex; flex-direction: column; gap: 2px;">
                            <strong style="font-size: 13px; color: #333;">${h.HolidayName}</strong>
                            <span style="font-size: 11px; color: #666;"><i class="fa-regular fa-clock"></i> ${dateRangeText}</span>
                        </div>
                        <span class="manager-badge manager-promo-holiday-badge-${h.Status}" style="font-size: 11px; padding: 2px 6px;">
                            ${h.Status === 'ongoing' ? 'กำลังดำเนินอยู่' : (h.Status === 'upcoming' ? 'กำลังจะมาถึง' : 'ผ่านมาแล้ว')}
                        </span>
                    `;

                    item.addEventListener('click', function () {
                        showHolidayDetail(h);
                    });

                    monthlyHolidayList.appendChild(item);
                });
            }

            function showHolidayDetail(h) {
                var placeholder = document.getElementById('holidayDetailPlaceholder');
                var content = document.getElementById('holidayDetailContent');
                var detName = document.getElementById('detHolidayName');
                var detStatus = document.getElementById('detHolidayStatus');
                var detNote = document.getElementById('detHolidayNote');
                var detStart = document.getElementById('detStartDate');
                var detEnd = document.getElementById('detEndDate');
                var actionWrap = document.getElementById('holidayActionWrap');

                if (!content || !placeholder) return;

                placeholder.classList.add('d-none');
                content.classList.remove('d-none');

                detName.textContent = h.HolidayName;
                detNote.textContent = h.EventNote || "ไม่มีการบันทึกกิจกรรมเสริมสำหรับช่วงเวลาพิเศษนี้";
                detStart.textContent = formatDateString(h.StartDate);
                detEnd.textContent = formatDateString(h.EndDate);

                detStatus.className = 'manager-badge manager-promo-holiday-badge-' + h.Status;
                detStatus.textContent = h.Status === 'ongoing' ? 'กำลังดำเนินอยู่' : (h.Status === 'upcoming' ? 'กำลังจะมาถึง' : 'ผ่านมาแล้ว');

                var editDataJson = JSON.stringify({
                    HolidayId: h.HolidayId,
                    HolidayName: h.HolidayName,
                    StartDate: h.StartDate,
                    EndDate: h.EndDate,
                    EventNote: h.EventNote || ""
                });

                actionWrap.innerHTML = `
                    <button type="button" class="manager-btn manager-btn-outline manager-btn-sm" 
                            data-manager-fill="#saveHolidayModalForm" 
                            data-manager-fill-data='${editDataJson}'>
                        <i class="fa-solid fa-pen-to-square"></i> แก้ไขข้อมูลวันหยุด
                    </button>
                    <form action="/Manager/DeleteHoliday" method="post" data-manager-ajax data-manager-confirm="คุณต้องการยืนยันการลบเทศกาลพิเศษ '${h.HolidayName}' ออกจากระบบหรือไม่?" class="d-inline">
                        <input type="hidden" name="holidayId" value="${h.HolidayId}" />
                        <button type="submit" class="manager-btn manager-btn-danger manager-btn-sm">
                            <i class="fa-solid fa-trash"></i> ลบวันหยุด
                        </button>
                    </form>
                `;
            }

            // ปุ่มเปลี่ยนเดือน < และ >
            var btnPrev = document.getElementById('btnPrevMonth');
            var btnNext = document.getElementById('btnNextMonth');

            if (btnPrev && btnNext) {
                btnPrev.addEventListener('click', function () {
                    currentDate.setMonth(currentDate.getMonth() - 1);
                    renderCalendar();
                });
                btnNext.addEventListener('click', function () {
                    currentDate.setMonth(currentDate.getMonth() + 1);
                    renderCalendar();
                });
            }

            // เรนเดอร์เริ่มต้น
            renderCalendar();
        })();
    </script>
}
