@model StayMate_Kavinvee_0576.Models.ViewModels.ManagerPromotionManagementViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "จัดการโปรโมชั่นและปฏิทินเทศกาล";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<div class="manager-portal-wrapper manager-promo-page">

    <!-- Anti-Forgery Token สำหรับคำสั่งปุ่ม AJAX -->
    <form id="managerPromoGlobalTokenForm" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <!-- ═══════════════════════ การแจ้งเตือนสถานะ ═══════════════════════ -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="manager-alert manager-alert-success" role="alert">
            <div class="manager-alert-content">
                <i class="fa-solid fa-circle-check"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="manager-alert-close" data-bs-dismiss="alert" aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="manager-alert manager-alert-danger" role="alert">
            <div class="manager-alert-content">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" class="manager-alert-close" data-bs-dismiss="alert" aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    <!-- ═══════════════════════ ส่วนหัวของหน้าจอ ═══════════════════════ -->
    <section class="manager-promo-header">
        <div class="manager-promo-header-top">
            <div class="manager-promo-title-wrap">
                <nav class="manager-promo-breadcrumb" aria-label="Breadcrumb">
                    <a asp-controller="Manager" asp-action="Index" class="manager-promo-breadcrumb-link">
                        <i class="fa-solid fa-chart-pie"></i> ภาพรวมระบบ
                    </a>
                    <span class="manager-promo-breadcrumb-sep">/</span>
                    <span class="manager-promo-breadcrumb-current">จัดการโปรโมชั่นและวันหยุด</span>
                </nav>
                <h1 class="manager-promo-title">จัดการโปรโมชั่นและวันหยุด</h1>
                <p class="manager-promo-desc">
                    บริหารจัดการแคมเปญส่งเสริมการขาย มอบส่วนลดพิเศษ และกำหนดปฏิทินเทศกาลประจำปีของโรงแรม
                </p>
            </div>

            <div class="manager-promo-header-meta">
                <div class="manager-promo-date-pill">
                    <i class="fa-regular fa-calendar-check"></i>
                    <span>วันที่อ้างอิงระบบ: <strong>@Model.Today.ToString("dd/MM/yyyy")</strong></span>
                </div>
                <div class="manager-promo-header-btns">
                    <button type="button"
                            class="manager-btn manager-btn-primary"
                            data-manager-fill="#savePromotionModalForm"
                            data-manager-fill-data='{"PromotionId":"","PromoCode":"","PromoName":"","Description":"","DiscountType":"percent_room","DiscountPercent":10,"DiscountPercentMax":20,"MinGuests":"","MinNights":"","MaxDiscountNights":"","ApplicableRoomTypeId":"","RequiresHoliday":false,"VoucherMinValue":"","VoucherMaxValue":"","IsActive":true,"ValidFrom":"","ValidTo":""}'>
                        <i class="fa-solid fa-plus-circle"></i>
                        <span>สร้างแคมเปญโปรโมชั่นใหม่</span>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ ส่วนที่ 1: สรุปผลการดำเนินงานแคมเปญ ═══════════════════════ -->
    <section class="manager-promo-section">
        <div class="manager-promo-section-head">
            <div>
                <h2 class="manager-promo-section-title">
                    <i class="fa-solid fa-chart-line text-primary"></i>
                    1. สรุปผลการดำเนินงานแคมเปญ (Promotion Overview)
                </h2>
                <p class="manager-promo-section-subtitle">สถิติจำนวนแคมเปญโปรโมชั่นส่งเสริมการขายในระบบจำแนกตามสถานะปัจจุบัน</p>
            </div>
        </div>

        <div class="manager-promo-summary-grid">
            <article class="manager-promo-summary-card manager-promo-card-active">
                <div class="manager-promo-card-icon">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div class="manager-promo-card-data">
                    <span class="manager-promo-card-label">เปิดใช้งานอยู่</span>
                    <strong class="manager-promo-card-val">@Model.ActiveCount</strong>
                    <span class="manager-promo-card-sub">แคมเปญที่ลูกค้าสามารถใช้สิทธิ์จองได้วันนี้</span>
                </div>
            </article>

            <article class="manager-promo-summary-card manager-promo-card-scheduled">
                <div class="manager-promo-card-icon">
                    <i class="fa-solid fa-clock"></i>
                </div>
                <div class="manager-promo-card-data">
                    <span class="manager-promo-card-label">เตรียมเปิดตัว</span>
                    <strong class="manager-promo-card-val">@Model.ScheduledCount</strong>
                    <span class="manager-promo-card-sub">แคมเปญที่วางกำหนดการเตรียมเปิดตัวล่วงหน้า</span>
                </div>
            </article>

            <article class="manager-promo-summary-card manager-promo-card-expired">
                <div class="manager-promo-card-icon">
                    <i class="fa-solid fa-calendar-xmark"></i>
                </div>
                <div class="manager-promo-card-data">
                    <span class="manager-promo-card-label">สิ้นสุดแคมเปญ</span>
                    <strong class="manager-promo-card-val">@Model.ExpiredCount</strong>
                    <span class="manager-promo-card-sub">แคมเปญที่ครบกำหนดเวลาจองในระบบแล้ว</span>
                </div>
            </article>

            <article class="manager-promo-summary-card manager-promo-card-inactive">
                <div class="manager-promo-card-icon">
                    <i class="fa-solid fa-ban"></i>
                </div>
                <div class="manager-promo-card-data">
                    <span class="manager-promo-card-label">ปิดระบบชั่วคราว</span>
                    <strong class="manager-promo-card-val">@Model.InactiveCount</strong>
                    <span class="manager-promo-card-sub">แคมเปญที่ผู้จัดการสั่งระงับการเปิดจอง</span>
                </div>
            </article>
        </div>
    </section>

    <!-- ═══════════════════════ ส่วนที่ 2: แคมเปญโปรโมชั่นหลัก 5 ประเภท ═══════════════════════ -->
    <section class="manager-promo-section">
        <div class="manager-promo-section-head">
            <div>
                <h2 class="manager-promo-section-title">
                    <i class="fa-solid fa-gift text-primary"></i>
                    2. แคมเปญโปรโมชั่นหลัก 5 ประเภทมาตรฐาน
                </h2>
                <p class="manager-promo-section-subtitle">
                    ต้นแบบเงื่อนไขโปรโมชั่นของทางโรงแรมที่ช่วยอำนวยความสะดวกในการเปิดใช้สิทธิ์โปรโมชั่นใหม่ได้อย่างรวดเร็ว
                </p>
            </div>
        </div>

        <div class="manager-promo-grid">
            <!-- 1. 3 Pay 2 -->
            <article class="manager-promo-card">
                <div class="manager-promo-card-top">
                    <span class="manager-code-badge">3_PAY_2</span>
                    <span class="manager-badge manager-badge-cyan">ลดราคาคืนพิเศษ</span>
                </div>
                <h3 class="manager-promo-title">1. แคมเปญ 3 Pay 2</h3>
                <p class="manager-promo-desc">จองห้องพักประเภท Deluxe สำหรับ 3 ท่าน พักต่อเนื่องครบ 3 คืน รับส่วนลดมูลค่าเท่าค่าห้อง 1 คืนฟรีทันที</p>
                <div class="manager-promo-meta-box">
                    <span><i class="fa-solid fa-moon"></i> เข้าพักขั้นต่ำ: <strong>3 คืน</strong></span>
                    <span><i class="fa-solid fa-percent"></i> ส่วนลดสูงสุด: <strong>ไม่เกิน 20%</strong></span>
                </div>
                <button type="button"
                        class="manager-btn manager-btn-outline w-100"
                        data-manager-fill="#savePromotionModalForm"
                        data-manager-fill-data='{"PromoCode":"STAY3_PAY2","PromoName":"3 Pay 2 (พัก 3 จ่าย 2)","Description":"จองห้องพักประเภท Deluxe สำหรับ 3 ท่าน พักต่อเนื่องครบ 3 คืน รับสิทธิ์พักฟรี 1 คืนพิเศษ","DiscountType":"percent_extra_nights","DiscountPercent":15,"DiscountPercentMax":20,"MinNights":3,"MinGuests":3,"MaxDiscountNights":1,"IsActive":true}'>
                    <i class="fa-solid fa-wand-magic-sparkles"></i> เปิดใช้งานแคมเปญ 3 Pay 2
                </button>
            </article>

            <!-- 2. Family & Gang -->
            <article class="manager-promo-card">
                <div class="manager-promo-card-top">
                    <span class="manager-code-badge">FAMILY_GANG</span>
                    <span class="manager-badge manager-badge-violet">สิทธิ์เตียงเสริมฟรี</span>
                </div>
                <h3 class="manager-promo-title">2. แคมเปญ Family &amp; Gang</h3>
                <p class="manager-promo-desc">จองห้องพักประเภท Family Room ตั้งแต่ 5 ท่านขึ้นไป รับบริการเสริมเตียงนอนเสริมฟรีไม่มีค่าใช้จ่าย</p>
                <div class="manager-promo-meta-box">
                    <span><i class="fa-solid fa-user-group"></i> ผู้เข้าพักขั้นต่ำ: <strong>5 ท่าน</strong></span>
                    <span><i class="fa-solid fa-bed"></i> ประเภทสิทธิ์: <strong>เตียงเสริมฟรี</strong></span>
                </div>
                <button type="button"
                        class="manager-btn manager-btn-outline w-100"
                        data-manager-fill="#savePromotionModalForm"
                        data-manager-fill-data='{"PromoCode":"FAMILY_GANG","PromoName":"Family & Gang (จองเป็นกลุ่มฟรีเตียงเสริม)","Description":"จองห้องพักประเภท Family Room ตั้งแต่ 5 ท่านขึ้นไป รับสิทธิ์จัดหาเตียงนอนเสริมฟรีไม่มีค่าใช้จ่าย","DiscountType":"free_extra_bed","MinGuests":5,"ApplicableRoomTypeId":3,"IsActive":true}'>
                    <i class="fa-solid fa-wand-magic-sparkles"></i> เปิดใช้งาน Family &amp; Gang
                </button>
            </article>

            <!-- 3. Stay 3+ Nights -->
            <article class="manager-promo-card">
                <div class="manager-promo-card-top">
                    <span class="manager-code-badge">STAY_3PLUS</span>
                    <span class="manager-badge manager-badge-info">ส่วนลดห้องพักปกติ</span>
                </div>
                <h3 class="manager-promo-title">3. แคมเปญ Stay 3+ Nights</h3>
                <p class="manager-promo-desc">สิทธิประโยชน์สำหรับผู้เข้าพักต่อเนื่องตั้งแต่ 3 คืนขึ้นไป รับส่วนลดพิเศษสูงสุด 10% ต่อคืนทันที</p>
                <div class="manager-promo-meta-box">
                    <span><i class="fa-solid fa-calendar-day"></i> เข้าพักต่อเนื่อง: <strong>3 คืนขึ้นไป</strong></span>
                    <span><i class="fa-solid fa-percent"></i> ส่วนลดรวม: <strong>10% (สูงสุดไม่เกิน 20%)</strong></span>
                </div>
                <button type="button"
                        class="manager-btn manager-btn-outline w-100"
                        data-manager-fill="#savePromotionModalForm"
                        data-manager-fill-data='{"PromoCode":"STAY_3PLUS","PromoName":"Stay 3+ Nights (พักต่อเนื่องรับส่วนลด)","Description":"สิทธิประโยชน์สำหรับผู้เข้าพักต่อเนื่องตั้งแต่ 3 คืนขึ้นไป รับส่วนลดค่าห้องพักทันที 10% ต่อคืน","DiscountType":"percent_room","DiscountPercent":10,"DiscountPercentMax":20,"MinNights":3,"IsActive":true}'>
                    <i class="fa-solid fa-wand-magic-sparkles"></i> เปิดใช้งาน Stay 3+ Nights
                </button>
            </article>

            <!-- 4. Weekly Escape -->
            <article class="manager-promo-card">
                <div class="manager-promo-card-top">
                    <span class="manager-code-badge">WEEKLY_ESCAPE</span>
                    <span class="manager-badge manager-badge-success">ส่วนลดพักระยะยาว</span>
                </div>
                <h3 class="manager-promo-title">4. แคมเปญ Weekly Escape</h3>
                <p class="manager-promo-desc">แคมเปญกระตุ้นยอดจองพักต่อเนื่องระยะยาวรายสัปดาห์ (7 คืนขึ้นไป) มอบส่วนลดพิเศษสูงสุด 20%</p>
                <div class="manager-promo-meta-box">
                    <span><i class="fa-solid fa-suitcase-rolling"></i> เข้าพักต่อเนื่อง: <strong>7 คืนขึ้นไป</strong></span>
                    <span><i class="fa-solid fa-percent"></i> อัตราส่วนลด: <strong>20% ของยอดจอง</strong></span>
                </div>
                <button type="button"
                        class="manager-btn manager-btn-outline w-100"
                        data-manager-fill="#savePromotionModalForm"
                        data-manager-fill-data='{"PromoCode":"WEEKLY_ESCAPE","PromoName":"Weekly Escape (จองพักรายสัปดาห์)","Description":"แคมเปญพักระยะยาวรายสัปดาห์ (7 คืนขึ้นไป) มอบส่วนลดพิเศษสูงสุด 20% ของยอดจองรวม","DiscountType":"percent_room","DiscountPercent":20,"DiscountPercentMax":20,"MinNights":7,"IsActive":true}'>
                    <i class="fa-solid fa-wand-magic-sparkles"></i> เปิดใช้งาน Weekly Escape
                </button>
            </article>

            <!-- 5. Festival & Long Weekend -->
            <article class="manager-promo-card">
                <div class="manager-promo-card-top">
                    <span class="manager-code-badge">FESTIVAL_WKND</span>
                    <span class="manager-badge manager-badge-warning">วันหยุดเทศกาล</span>
                </div>
                <h3 class="manager-promo-title">5. Festival &amp; Long Weekend</h3>
                <p class="manager-promo-desc">แคมเปญพิเศษสำหรับการจองในช่วงวันหยุดยาว ผูกกับวันเทศกาล พร้อมรับสิทธิ์แจกบัตรกำนัลเสริม</p>
                <div class="manager-promo-meta-box">
                    <span><i class="fa-solid fa-calendar-star"></i> อ้างอิงวันหยุด: <strong>ตรวจสอบปฏิทินเทศกาล</strong></span>
                    <span><i class="fa-solid fa-ticket"></i> บัตรกำนัล (E-Voucher): <strong>รองรับการแจกสิทธิ์</strong></span>
                </div>
                <button type="button"
                        class="manager-btn manager-btn-outline w-100"
                        data-manager-fill="#savePromotionModalForm"
                        data-manager-fill-data='{"PromoCode":"FESTIVAL_PROMO","PromoName":"Festival & Long Weekend Promotion","Description":"มอบสิทธิพิเศษเฉพาะผู้จองตรงวันหยุดเทศกาลตามเงื่อนไข พร้อมรับสิทธิ์แจกบัตรกำนัลเสริม","DiscountType":"percent_room","DiscountPercent":10,"DiscountPercentMax":20,"RequiresHoliday":true,"VoucherMinValue":100,"VoucherMaxValue":300,"IsActive":true}'>
                    <i class="fa-solid fa-wand-magic-sparkles"></i> เปิดใช้งาน Festival &amp; Weekend
                </button>
            </article>
        </div>
    </section>

    <!-- ═══════════════════════ ส่วนที่ 3: สรุปแคมเปญใช้งานอยู่ และปฏิทินวันเทศกาล ═══════════════════════ -->
    <section class="manager-promo-section">
        <div class="manager-promo-split-layout">
            
            <!-- A. แผงควบคุมแคมเปญโปรโมชั่นที่ใช้งานอยู่ -->
            <div class="manager-promo-split-panel">
                <div class="manager-card h-100">
                    <div class="manager-card-header">
                        <div>
                            <h3 class="manager-card-title">
                                <span class="manager-promo-section-dot"></span>
                                แคมเปญโปรโมชั่นที่เปิดใช้งานในปัจจุบัน
                            </h3>
                            <p class="manager-card-subtitle">รายการแคมเปญส่งเสริมการขายที่เปิดใช้งานและลูกค้าใช้งานจองได้จริงวันนี้</p>
                        </div>
                    </div>
                    <div class="manager-promo-active-list">
                        @{
                            var activeCampaigns = Model.Promotions?.Where(p => p.Status == "active").ToList() ?? new List<StayMate_Kavinvee_0576.Models.ViewModels.ManagerPromotionRow>();
                        }
                        @if (activeCampaigns.Any())
                        {
                            foreach (var p in activeCampaigns)
                            {
                                var fillDataJson = JsonSerializer.Serialize(new
                                {
                                    PromotionId = p.PromotionId,
                                    PromoCode = p.PromoCode,
                                    PromoName = p.PromoName,
                                    Description = p.Description ?? "",
                                    DiscountType = p.DiscountType,
                                    DiscountPercent = p.DiscountPercent,
                                    DiscountPercentMax = p.DiscountPercentMax,
                                    MinGuests = p.MinGuests,
                                    MinNights = p.MinNights,
                                    MaxDiscountNights = p.MaxDiscountNights,
                                    ApplicableRoomTypeId = p.ApplicableRoomTypeId,
                                    RequiresHoliday = p.RequiresHoliday,
                                    VoucherMinValue = p.VoucherMinValue,
                                    VoucherMaxValue = p.VoucherMaxValue,
                                    IsActive = p.IsActive,
                                    ValidFrom = p.ValidFrom?.ToString("yyyy-MM-dd") ?? "",
                                    ValidTo = p.ValidTo?.ToString("yyyy-MM-dd") ?? ""
                                });

                                <div class="manager-promo-active-item">
                                    <div class="manager-promo-item-header">
                                        <div>
                                            <span class="manager-code-badge">@p.PromoCode</span>
                                            <h4 class="manager-promo-item-title">@p.PromoName</h4>
                                        </div>
                                        <span class="manager-badge manager-badge-success">
                                            <i class="fa-solid fa-circle"></i> กำลังแสดงสิทธิ์
                                        </span>
                                    </div>
                                    <p class="manager-promo-item-desc">@(string.IsNullOrWhiteSpace(p.Description) ? "ไม่มีข้อมูลข้อกำหนดและเงื่อนไขเพิ่มเติม" : p.Description)</p>
                                    <div class="manager-promo-item-details">
                                        <div class="manager-promo-detail-badge">
                                            <span class="manager-promo-detail-lbl">รูปแบบสิทธิ์:</span>
                                            <strong>@p.DiscountTypeLabel</strong>
                                        </div>
                                        @if (p.DiscountPercent.HasValue)
                                        {
                                            <div class="manager-promo-detail-badge">
                                                <span class="manager-promo-detail-lbl">สัดส่วนลด:</span>
                                                <strong class="text-primary">@p.DiscountPercent.Value.ToString("0.00")%</strong>
                                            </div>
                                        }
                                        @if (p.VoucherMinValue.HasValue || p.VoucherMaxValue.HasValue)
                                        {
                                            <div class="manager-promo-detail-badge">
                                                <span class="manager-promo-detail-lbl">สิทธิ์บัตรกำนัล:</span>
                                                <strong class="text-violet">฿@(p.VoucherMinValue ?? 0) - ฿@(p.VoucherMaxValue ?? 0)</strong>
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(p.ApplicableRoomTypeName))
                                        {
                                            <div class="manager-promo-detail-badge">
                                                <span class="manager-promo-detail-lbl">ประเภทห้อง:</span>
                                                <strong>@p.ApplicableRoomTypeName</strong>
                                            </div>
                                        }
                                    </div>
                                    <div class="manager-promo-item-dates">
                                        <span><i class="fa-solid fa-calendar-day"></i> เริ่มต้นโปรโมชั่น: <strong>@(p.ValidFrom?.ToString("dd/MM/yyyy") ?? "ไม่มีกำหนดอายุ")</strong></span>
                                        <span><i class="fa-solid fa-calendar-xmark"></i> สิ้นสุดโปรโมชั่น: <strong>@(p.ValidTo?.ToString("dd/MM/yyyy") ?? "ไม่มีกำหนดอายุ")</strong></span>
                                    </div>
                                    <div class="manager-promo-item-actions">
                                        <button type="button"
                                                class="manager-btn manager-btn-outline manager-btn-sm"
                                                data-manager-fill="#savePromotionModalForm"
                                                data-manager-fill-data='@Html.Raw(fillDataJson)'>
                                            <i class="fa-solid fa-pen-to-square"></i> แก้ไขเงื่อนไข
                                        </button>
                                        <form asp-controller="Manager"
                                              asp-action="TogglePromotion"
                                              method="post"
                                              data-manager-ajax
                                              data-manager-confirm="คุณแน่ใจหรือไม่ว่าต้องการปิดใช้งานระบบสิทธิ์โปรโมชั่นของแคมเปญ '@p.PromoName' ชั่วคราว?"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="promotionId" value="@p.PromotionId" />
                                            <input type="hidden" name="isActive" value="false" />
                                            <button type="submit" class="manager-btn manager-btn-danger manager-btn-sm">
                                                <i class="fa-solid fa-power-off"></i> สั่งปิดโปรโมชั่น
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="manager-empty-state">
                                <i class="fa-regular fa-folder-open"></i>
                                <p>ไม่พบรายการแคมเปญส่งเสริมการขายที่เปิดใช้งานในระบบปัจจุบันขณะนี้</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

                        <!-- B. Holiday & Festival Interactive Calendar -->
            <div class="manager-promo-split-panel">
                <div class="manager-card h-100">
                    <div class="manager-card-header">
                        <div>
                            <h3 class="manager-card-title">
                                <i class="fa-solid fa-calendar-days text-primary"></i>
                                ปฏิทินวันเทศกาลประจำปี (Holiday &amp; Festival Calendar)
                            </h3>
                            <p class="manager-card-subtitle">แสดงรายการวันหยุดประจำปีที่ใช้อ้างอิงการจัดแคมเปญราคาและบัตรกำนัลพิเศษ</p>
                        </div>
                    </div>
                    
                    <div class="manager-promo-calendar">
                        <div class="manager-promo-calendar-header">
                            <button type="button" class="manager-promo-calendar-btn" id="btnPrevMonth">
                                <i class="fa-solid fa-chevron-left"></i>
                            </button>
                            <h4 class="manager-promo-calendar-title" id="calendarTitle">พฤศจิกายน 2026</h4>
                            <button type="button" class="manager-promo-calendar-btn" id="btnNextMonth">
                                <i class="fa-solid fa-chevron-right"></i>
                            </button>
                        </div>
                        <div class="manager-promo-calendar-weekdays">
                            <div>อา</div><div>จ</div><div>อ</div><div>พ</div><div>พฤ</div><div>ศ</div><div>ส</div>
                        </div>
                        <div class="manager-promo-calendar-grid" id="calendarGrid">
                            <!-- เรนเดอร์ช่องวันหยุดผ่านสคริปต์ JavaScript -->
                        </div>
                    </div>

                    <!-- เพิ่มส่วนสรุปรายชื่อวันหยุดประจำเดือน (Monthly Holiday Summary List) -->
                    <div class="manager-promo-monthly-summary p-3 border-top" style="background-color: var(--manager-bg-light, #f8f9fa);">
                        <h5 class="text-sm font-semibold mb-2" style="color: var(--manager-primary, #070D1E); font-size: 14px;">
                            <i class="fa-solid fa-list-ul text-primary"></i> 
                            สรุปวันหยุดเทศกาลประจำเดือน <span id="monthlySummaryLabel">พฤศจิกายน</span>
                        </h5>
                        <div id="monthlyHolidayList" class="d-flex flex-column gap-2" style="max-height: 150px; overflow-y: auto;">
                            <!-- รายการวันหยุดของเดือนนั้นๆ จะถูกสร้างผ่าน JavaScript -->
                        </div>
                    </div>

                    <div class="manager-promo-holiday-detail-panel" id="holidayDetailPanel">
                        <div class="manager-promo-detail-placeholder" id="holidayDetailPlaceholder">
                            <i class="fa-solid fa-circle-info"></i>
                            <span>เลือกคลิกวันที่มีแถบสีในช่องปฏิทินเทศกาล หรือเลือกจากรายการประจำเดือน เพื่อตรวจสอบรายละเอียด</span>
                        </div>
                        <div class="manager-promo-detail-content d-none" id="holidayDetailContent">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h4 class="manager-promo-holiday-name" id="detHolidayName">เทศกาล</h4>
                                <span class="manager-badge" id="detHolidayStatus">Ongoing</span>
                            </div>
                            <p class="manager-promo-holiday-note" id="detHolidayNote">ไม่มีคำอธิบายหรือหมายเหตุกิจกรรมเพิ่มเติม</p>
                            <div class="manager-promo-holiday-dates">
                                <span><i class="fa-solid fa-hourglass-start text-success"></i> เริ่มต้นแคมเปญวันหยุด: <strong id="detStartDate">01/01/2026</strong></span>
                                <span><i class="fa-solid fa-hourglass-end text-danger"></i> สิ้นสุดแคมเปญวันหยุด: <strong id="detEndDate">01/01/2026</strong></span>
                            </div>
                            <div class="manager-promo-holiday-actions mt-3" id="holidayActionWrap">
                                <!-- เติมสวิตช์ฟอร์มปุ่มแก้ไขหรือลบผ่าน JavaScript -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </section>

    <!-- ═══════════════════════ ส่วนที่ 4: กฎควบคุมแคมเปญส่วนลดสูงสุด ═══════════════════════ -->
    <section class="manager-promo-section">
        <div class="manager-card">
            <div class="manager-card-header">
                <div>
                    <h2 class="manager-card-title">
                        <i class="fa-solid fa-scale-balanced text-primary"></i>
                        3. นโยบายการคำนวณและควบคุมส่วนลดของโรงแรม
                    </h2>
                    <p class="manager-card-subtitle">กฎเกณฑ์ความปลอดภัยเพื่อรักษาสมดุลต้นทุนห้องพักและกำไรจากการจองผ่านระบบ</p>
                </div>
            </div>
            <div class="manager-promo-rules-box">
                <article class="manager-promo-rule-card">
                    <div class="manager-promo-rule-icon">
                        <i class="fa-solid fa-shield-cat"></i>
                    </div>
                    <div>
                        <h4 class="manager-promo-rule-title">เพดานส่วนลดรวมสูงสุด 20% ของค่าห้อง</h4>
                        <p class="manager-promo-rule-desc">ในกรณีที่ผู้เข้าพักตรงวันหยุดยาวและใช้สิทธิ์แคมเปญพักระยะยาวร่วมด้วย ระบบจองห้องของฝั่งลูกค้าจะจำกัดและลดส่วนต่างยอดเงินรวมสูงสุดไม่เกิน 20% เสมอ</p>
                    </div>
                </article>

                <article class="manager-promo-rule-card">
                    <div class="manager-promo-rule-icon">
                        <i class="fa-solid fa-calculator"></i>
                    </div>
                    <div>
                        <h4 class="manager-promo-rule-title">ระบบสแต็คส่วนลดเพิ่ม 5% แบบมีเงื่อนไข</h4>
                        <p class="manager-promo-rule-desc">เมื่อลูกค้าจองตรงเงื่อนไขของโปรโมชั่นหลายประเภท ระบบจะสแต็คสิทธิ์ลดแคมเปญหลัก (ที่ให้ส่วนลดมากที่สุด) และลดราคาเสริมเพิ่มรายการอื่นให้อีกชิ้นละ 5%</p>
                    </div>
                </article>

                <article class="manager-promo-rule-card">
                    <div class="manager-promo-rule-icon">
                        <i class="fa-solid fa-hotel"></i>
                    </div>
                    <div>
                        <h4 class="manager-promo-rule-title">การควบคุมและผูกเงื่อนไขเฉพาะระดับประเภทห้อง</h4>
                        <p class="manager-promo-rule-desc">ผู้จัดการสามารถเจาะจงบังคับแคมเปญลดราคาให้มีผลใช้ได้กับประเภทห้องห้องใดห้องหนึ่งโดยเฉพาะได้ (เช่น เปิดส่วนลดเตียงเสริมฟรีเฉพาะผู้จองห้องประเภทครอบครัวเท่านั้น)</p>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ ส่วนที่ 5: ตารางรายละเอียดข้อมูลจากฐานข้อมูลจริง ═══════════════════════ -->
    <section class="manager-promo-section">
        <div class="manager-card">
            <div class="manager-card-header manager-card-header-responsive">
                <div>
                    <h2 class="manager-card-title">
                        <i class="fa-solid fa-database text-primary"></i>
                        4. สรุปรายละเอียดแคมเปญและตารางปฏิทินวันหยุด (Database Sync)
                    </h2>
                    <p class="manager-card-subtitle">
                        ค้นหาเปรียบเทียบข้อกำหนด ปริมาณการนำไปใช้งาน และเครื่องมือเปลี่ยนสถานะเปิด-ปิด หรือลบเทศกาลพิเศษออกจากระบบ
                    </p>
                </div>

                <form method="get"
                      asp-controller="Manager"
                      asp-action="PromotionManagement"
                      data-manager-autosubmit
                      class="manager-promo-filter-bar">
                    <div class="manager-search-box">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="search"
                               name="q"
                               value="@Model.Search"
                               class="manager-input"
                               placeholder="ค้นหารหัส หรือชื่อแคมเปญ..."
                               data-manager-search="#dbPromotionsTable" />
                    </div>

                    <select name="status"
                            class="manager-select"
                            data-manager-filter="#dbPromotionsTable"
                            data-filter-key="status"
                            aria-label="กรองสถานะแคมเปญ">
                        <option value="">ทุกสถานะแคมเปญ</option>
                        @foreach (var opt in Model.StatusOptions)
                        {
                            <option value="@opt.Value" selected="@(Model.Status == opt.Value ? "selected" : null)">
                                @opt.Label
                            </option>
                        }
                    </select>

                    <select name="discountType"
                            class="manager-select"
                            data-manager-filter="#dbPromotionsTable"
                            data-filter-key="distype"
                            aria-label="กรองประเภทส่วนลด">
                        <option value="">ทุกประเภทส่วนลด</option>
                        @foreach (var opt in Model.DiscountTypeOptions)
                        {
                            <option value="@opt.Value" selected="@(Model.DiscountType == opt.Value ? "selected" : null)">
                                @opt.Label
                            </option>
                        }
                    </select>

                    <button type="submit" class="manager-btn manager-btn-primary">
                        <i class="fa-solid fa-arrows-rotate"></i> อัปเดตข้อมูลสด
                    </button>

                    @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Status) || !string.IsNullOrWhiteSpace(Model.DiscountType))
                    {
                        <a asp-controller="Manager" asp-action="PromotionManagement" class="manager-btn manager-btn-ghost">
                            <i class="fa-solid fa-rotate-left"></i> ล้างการกรอง
                        </a>
                    }
                </form>
            </div>

            <!-- เมนูย่อยสำหรับสลับตาราง -->
            <div class="manager-promo-subtabs mt-2" role="tablist" aria-label="Database Tables">
                <button type="button" class="manager-promo-subtab-btn active" data-manager-dbtab-target="dbtab-promotions">
                    <i class="fa-solid fa-tags"></i> แคมเปญโปรโมชั่นในระบบทั้งหมด (@(Model.Promotions?.Count ?? 0) รายการ)
                </button>
                <button type="button" class="manager-promo-subtab-btn" data-manager-dbtab-target="dbtab-holidays">
                    <i class="fa-solid fa-calendar-days"></i> ปฏิทินวันเทศกาลทั้งหมด (@(Model.Holidays?.Count ?? 0) วันหยุด)
                </button>
            </div>

            <!-- ตารางที่ 1: แคมเปญโปรโมชั่นทั้งหมด -->
            <div id="dbtab-promotions" class="manager-promo-dbtab-pane active">
                <div class="manager-table-responsive">
                    <table class="manager-table manager-promo-table" id="dbPromotionsTable">
                        <thead>
                            <tr>
                                <th>รหัสโปรโมชั่น</th>
                                <th>ชื่อแคมเปญ</th>
                                <th>ประเภทข้อตกลงส่วนลด</th>
                                <th class="text-end">ส่วนลด (%)</th>
                                <th class="text-center">เงื่อนไขผู้เข้าพัก / คืน</th>
                                <th>กรอบช่วงเวลาที่ร่วมรายการ</th>
                                <th class="text-center">ยอดจำนวนผู้ใช้สิทธิ์</th>
                                <th class="text-center">สถานะแคมเปญ</th>
                                <th class="text-end">การจัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Promotions != null && Model.Promotions.Any())
                            {
                                foreach (var p in Model.Promotions)
                                {
                                    var editJson = JsonSerializer.Serialize(new
                                    {
                                        PromotionId = p.PromotionId,
                                        PromoCode = p.PromoCode,
                                        PromoName = p.PromoName,
                                        Description = p.Description ?? "",
                                        DiscountType = p.DiscountType,
                                        DiscountPercent = p.DiscountPercent,
                                        DiscountPercentMax = p.DiscountPercentMax,
                                        MinGuests = p.MinGuests,
                                        MinNights = p.MinNights,
                                        MaxDiscountNights = p.MaxDiscountNights,
                                        ApplicableRoomTypeId = p.ApplicableRoomTypeId,
                                        RequiresHoliday = p.RequiresHoliday,
                                        VoucherMinValue = p.VoucherMinValue,
                                        VoucherMaxValue = p.VoucherMaxValue,
                                        IsActive = p.IsActive,
                                        ValidFrom = p.ValidFrom?.ToString("yyyy-MM-dd") ?? "",
                                        ValidTo = p.ValidTo?.ToString("yyyy-MM-dd") ?? ""
                                    });

                                    <tr data-status="@p.Status" data-distype="@p.DiscountType">
                                        <td>
                                            <span class="manager-code-badge">@p.PromoCode</span>
                                        </td>
                                        <td>
                                            <strong>@p.PromoName</strong>
                                            @if (p.RequiresHoliday)
                                            {
                                                <div class="manager-promo-holiday-req">
                                                    <i class="fa-solid fa-calendar-day"></i> ต้องตรงวันหยุดปฏิทินเทศกาล
                                                </div>
                                            }
                                        </td>
                                        <td>@p.DiscountTypeLabel</td>
                                        <td class="text-end font-monospace">
                                            @(p.DiscountPercent.HasValue ? p.DiscountPercent.Value.ToString("0.00") + "%" : "--")
                                        </td>
                                        <td class="text-center">
                                            <span class="manager-pill-neutral">จองขั้นต่ำ: @(p.MinNights?.ToString() ?? "0") คืน</span>
                                            <span class="manager-pill-neutral">จำนวนแขก: @(p.MinGuests?.ToString() ?? "0") ท่าน</span>
                                        </td>
                                        <td>
                                            <div class="manager-promo-table-dates">
                                                <span>@(p.ValidFrom?.ToString("dd/MM/yyyy") ?? "ไม่มีกำหนดเริ่มต้น")</span>
                                                <i class="fa-solid fa-arrow-right"></i>
                                                <span>@(p.ValidTo?.ToString("dd/MM/yyyy") ?? "ไม่มีกำหนดสิ้นสุด")</span>
                                            </div>
                                        </td>
                                        <td class="text-center font-monospace">@p.UsageCount ครั้ง</td>
                                        <td class="text-center">
                                            <span class="manager-promo-badge-status manager-promo-badge-status-@p.Status">
                                                @p.StatusLabel
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <div class="manager-promo-item-actions justify-content-end">
                                                <button type="button"
                                                        class="manager-btn manager-btn-outline manager-btn-sm"
                                                        data-manager-fill="#savePromotionModalForm"
                                                        data-manager-fill-data='@Html.Raw(editJson)'>
                                                    <i class="fa-solid fa-pen-to-square"></i> แก้ไข
                                                </button>
                                                <form asp-controller="Manager"
                                                      asp-action="TogglePromotion"
                                                      method="post"
                                                      data-manager-ajax
                                                      class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="promotionId" value="@p.PromotionId" />
                                                    <input type="hidden" name="isActive" value="@(p.IsActive ? "false" : "true")" />
                                                    <button type="submit" class="manager-btn manager-btn-ghost manager-btn-sm" title="@(p.IsActive ? "ระงับการเปิดจอง" : "เปิดสิทธิ์จองใหม่")">
                                                        <i class="fa-solid @(p.IsActive ? "fa-toggle-on text-success" : "fa-toggle-off text-muted")"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="manager-empty-state">
                                        <i class="fa-solid fa-tags"></i>
                                        <p>ไม่พบรายการแคมเปญโปรโมชั่นใดๆ ในระบบ</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ตารางที่ 2: วันหยุดเทศกาลทั้งหมด -->
            <div id="dbtab-holidays" class="manager-promo-dbtab-pane">
                <div class="manager-table-responsive">
                    <table class="manager-table manager-promo-table" id="dbHolidaysTable">
                        <thead>
                            <tr>
                                <th>รหัสวันหยุดเทศกาล</th>
                                <th>ชื่อวันเทศกาลสำคัญ</th>
                                <th>วันเริ่มต้นตามปีปฏิทิน</th>
                                <th>วันสิ้นสุดตามปีปฏิทิน</th>
                                <th class="text-center">จำนวนวันรวม</th>
                                <th>บันทึกกิจกรรมประจำปีเพิ่มเติม</th>
                                <th class="text-center">สถานะเทศกาล</th>
                                <th class="text-end">การจัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Holidays != null && Model.Holidays.Any())
                            {
                                foreach (var h in Model.Holidays)
                                {
                                    var hEditJson = JsonSerializer.Serialize(new
                                    {
                                        HolidayId = h.HolidayId,
                                        HolidayName = h.HolidayName,
                                        StartDate = h.StartDate.ToString("yyyy-MM-dd"),
                                        EndDate = h.EndDate.ToString("yyyy-MM-dd"),
                                        EventNote = h.EventNote ?? ""
                                    });

                                    <tr>
                                        <td>
                                            <span class="manager-code-badge">ID: @h.HolidayId</span>
                                        </td>
                                        <td>
                                            <strong>@h.HolidayName</strong>
                                        </td>
                                        <td>@h.StartDate.ToString("dd/MM/yyyy")</td>
                                        <td>@h.EndDate.ToString("dd/MM/yyyy")</td>
                                        <td class="text-center">@h.DayCount วัน</td>
                                        <td>@(string.IsNullOrWhiteSpace(h.EventNote) ? "-- ไม่มีบันทึกกิจกรรมเสริม --" : h.EventNote)</td>
                                        <td class="text-center">
                                            <span class="manager-promo-holiday-badge manager-promo-holiday-badge-@h.Status">
                                                @h.StatusLabel
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <div class="manager-promo-item-actions justify-content-end">
                                                <button type="button"
                                                        class="manager-btn manager-btn-outline manager-btn-sm"
                                                        data-manager-fill="#saveHolidayModalForm"
                                                        data-manager-fill-data='@Html.Raw(hEditJson)'>
                                                    <i class="fa-solid fa-pen-to-square"></i> แก้ไขเทศกาล
                                                </button>
                                                <form asp-controller="Manager"
                                                      asp-action="DeleteHoliday"
                                                      method="post"
                                                      data-manager-ajax
                                                      data-manager-confirm="คุณต้องการยืนยันการลบวันเทศกาลสำคัญประจำปี '@h.HolidayName' ออกจากระบบหรือไม่?"
                                                      class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="holidayId" value="@h.HolidayId" />
                                                    <button type="submit" class="manager-btn manager-btn-danger manager-btn-sm">
                                                        <i class="fa-solid fa-trash-can"></i> ลบรายการ
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="manager-empty-state">
                                        <i class="fa-regular fa-calendar-xmark"></i>
                                        <p>ยังไม่มีการระบุหรือบันทึกเทศกาลพิเศษลงบนปฏิทิน</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (Model.DataNotes != null && Model.DataNotes.Any())
            {
                <div class="manager-notes-box">
                    <div class="manager-notes-title">
                        <i class="fa-solid fa-circle-info"></i>
                        <span>เงื่อนไขข้อบังคับด้านแคมเปญส่งเสริมการขายของระบบ</span>
                    </div>
                    <ul class="manager-notes-list">
                        @foreach (var note in Model.DataNotes)
                        {
                            <li>@note</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </section>
</div>

