@model StayMate_Kavinvee_0576.Models.ViewModels.ManagerPromotionManagementViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "จัดการโปรโมชั่น";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<div class="manager-portal-wrapper manager-promo-page">

    <!-- Anti-Forgery Token หลักสำหรับปุ่ม AJAX -->
    <form id="managerPromoGlobalTokenForm" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <!-- ═══════════════════════ Alerts (TempData & Validation) ═══════════════════════ -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="manager-alert manager-alert-success" role="alert">
            <div class="manager-alert-content">
                <i class="fa-solid fa-circle-check"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="manager-alert-close" data-bs-dismiss="alert" aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="manager-alert manager-alert-danger" role="alert">
            <div class="manager-alert-content">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" class="manager-alert-close" data-bs-dismiss="alert" aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    <!-- ═══════════════════════ Page Header ═══════════════════════ -->
    <section class="manager-promo-header">
        <div class="manager-promo-header-top">
            <div class="manager-promo-title-wrap">
                <nav class="manager-promo-breadcrumb" aria-label="Breadcrumb">
                    <a asp-controller="Manager" asp-action="Index" class="manager-promo-breadcrumb-link">
                        <i class="fa-solid fa-chart-pie"></i> Manager
                    </a>
                    <span class="manager-promo-breadcrumb-sep">/</span>
                    <span class="manager-promo-breadcrumb-current">Promotion Management</span>
                </nav>
                <h1 class="manager-promo-title">Promotion Management</h1>
                <p class="manager-promo-desc">
                    Manage hotel promotions and holiday periods — บริหารจัดการแคมเปญส่งเสริมการขายและปฏิทินเทศกาล
                </p>
            </div>

            <div class="manager-promo-header-meta">
                <div class="manager-promo-date-pill">
                    <i class="fa-regular fa-calendar-check"></i>
                    <span>วันที่อ้างอิงระบบ: <strong>@Model.Today.ToString("dd/MM/yyyy")</strong></span>
                </div>
                <div class="manager-promo-header-btns">
                    <button type="button"
                            class="manager-btn manager-btn-primary"
                            data-manager-fill="#savePromotionModalForm"
                            data-manager-fill-data='{"PromotionId":"","PromoCode":"","PromoName":"","Description":"","DiscountType":"percent_room","DiscountPercent":10,"DiscountPercentMax":20,"MinGuests":"","MinNights":"","MaxDiscountNights":"","ApplicableRoomTypeId":"","RequiresHoliday":false,"VoucherMinValue":"","VoucherMaxValue":"","IsActive":true,"ValidFrom":"","ValidTo":""}'>
                        <i class="fa-solid fa-plus-circle"></i>
                        <span>สร้างแคมเปญโปรโมชั่น</span>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ SECTION 1: PROMOTION OVERVIEW (Summary Cards) ═══════════════════════ -->
    <section class="manager-promo-section">
        <div class="manager-promo-section-head">
            <div>
                <h2 class="manager-promo-section-title">
                    <i class="fa-solid fa-chart-line text-primary"></i>
                    1. Promotion Overview (สรุปผลการดำเนินงานแคมเปญ)
                </h2>
                <p class="manager-promo-section-subtitle">สถิติปริมาณโปรโมชั่นสะสมแยกตามสถานะที่คำนวณจากระบบ</p>
            </div>
        </div>

        <div class="manager-promo-summary-grid">
            <article class="manager-promo-summary-card manager-promo-card-active">
                <div class="manager-promo-card-icon">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div class="manager-promo-card-data">
                    <span class="manager-promo-card-label">Active Promotions</span>
                    <strong class="manager-promo-card-val">@Model.ActiveCount</strong>
                    <span class="manager-promo-card-sub">เปิดใช้งานจริงวันนี้</span>
                </div>
            </article>

            <article class="manager-promo-summary-card manager-promo-card-scheduled">
                <div class="manager-promo-card-icon">
                    <i class="fa-solid fa-clock"></i>
                </div>
                <div class="manager-promo-card-data">
                    <span class="manager-promo-card-label">Scheduled Promotions</span>
                    <strong class="manager-promo-card-val">@Model.ScheduledCount</strong>
                    <span class="manager-promo-card-sub">แคมเปญที่วางแผนไว้ล่วงหน้า</span>
                </div>
            </article>

            <article class="manager-promo-summary-card manager-promo-card-expired">
                <div class="manager-promo-card-icon">
                    <i class="fa-solid fa-calendar-xmark"></i>
                </div>
                <div class="manager-promo-card-data">
                    <span class="manager-promo-card-label">Expired Promotions</span>
                    <strong class="manager-promo-card-val">@Model.ExpiredCount</strong>
                    <span class="manager-promo-card-sub">หมดอายุการร่วมรายการ</span>
                </div>
            </article>

            <article class="manager-promo-summary-card manager-promo-card-inactive">
                <div class="manager-promo-card-icon">
                    <i class="fa-solid fa-ban"></i>
                </div>
                <div class="manager-promo-card-data">
                    <span class="manager-promo-card-label">Disabled Promotions</span>
                    <strong class="manager-promo-card-val">@Model.InactiveCount</strong>
                    <span class="manager-promo-card-sub">โปรโมชั่นที่สั่งปิดระบบไว้</span>
                </div>
            </article>
        </div>
    </section>

    <!-- ═══════════════════════ SECTION 2: PROMOTION TYPES (5 Preset Templates) ═══════════════════════ -->
    <section class="manager-promo-section">
        <div class="manager-promo-section-head">
            <div>
                <h2 class="manager-promo-section-title">
                    <i class="fa-solid fa-gift text-primary"></i>
                    2. Predefined Promotion Campaigns (โปรโมชั่นและแคมเปญหลัก 5 ประเภท)
                </h2>
                <p class="manager-promo-section-subtitle">
                    แคมเปญมาตรฐานของโรงแรม StayMate ที่ผู้บริหารสามารถปรับแต่งเงื่อนไขได้อย่างสะดวกรวดเร็ว
                </p>
            </div>
        </div>

        <div class="manager-promo-grid">
            <!-- 1. 3 Pay 2 -->
            <article class="manager-promo-card">
                <div class="manager-promo-card-top">
                    <span class="manager-code-badge">3_PAY_2</span>
                    <span class="manager-badge manager-badge-cyan">percent_extra_nights</span>
                </div>
                <h3 class="manager-promo-title">1. แคมเปญ 3 Pay 2</h3>
                <p class="manager-promo-desc">เข้าพักครบ 3 คืน สิทธิ์รับส่วนลดคืนพิเศษทันที (พัก 3 จ่าย 2) เหมาะสำหรับช่วง Low-Season</p>
                <div class="manager-promo-meta-box">
                    <span><i class="fa-solid fa-moon"></i> คืนพักขั้นต่ำ: <strong>3 คืน</strong></span>
                    <span><i class="fa-solid fa-percent"></i> เพดานส่วนลดสูงสุด: <strong>20%</strong></span>
                </div>
                <button type="button"
                        class="manager-btn manager-btn-outline w-100"
                        data-manager-fill="#savePromotionModalForm"
                        data-manager-fill-data='{"PromoCode":"STAY3_PAY2","PromoName":"3 Pay 2 (พัก 3 จ่าย 2)","Description":"พักต่อเนื่อง 3 คืนขึ้นไปรับส่วนลดคืนพิเศษ","DiscountType":"percent_extra_nights","DiscountPercent":15,"DiscountPercentMax":20,"MinNights":3,"MaxDiscountNights":1,"IsActive":true}'>
                    <i class="fa-solid fa-wand-magic-sparkles"></i> ตั้งค่าแคมเปญ 3 Pay 2
                </button>
            </article>

            <!-- 2. Family & Gang -->
            <article class="manager-promo-card">
                <div class="manager-promo-card-top">
                    <span class="manager-code-badge">FAMILY_GANG</span>
                    <span class="manager-badge manager-badge-violet">free_extra_bed</span>
                </div>
                <h3 class="manager-promo-title">2. Family &amp; Gang</h3>
                <p class="manager-promo-desc">จองห้องพักประเภทครอบครัว (Family Room) ตั้งแต่ 5 คนขึ้นไป รับบริการเสริมเตียงฟรี</p>
                <div class="manager-promo-meta-box">
                    <span><i class="fa-solid fa-user-group"></i> ผู้เข้าพักขั้นต่ำ: <strong>5 ท่าน</strong></span>
                    <span><i class="fa-solid fa-bed"></i> ประเภทสิทธิ์: <strong>เสริมเตียงฟรี</strong></span>
                </div>
                <button type="button"
                        class="manager-btn manager-btn-outline w-100"
                        data-manager-fill="#savePromotionModalForm"
                        data-manager-fill-data='{"PromoCode":"FAMILY_GANG","PromoName":"Family & Gang (จองเป็นกลุ่มฟรีเตียงเสริม)","Description":"จองห้องพักตั้งแต่ 5 ท่านขึ้นไปฟรีค่าเตียงเสริม","DiscountType":"free_extra_bed","MinGuests":5,"ApplicableRoomTypeId":3,"IsActive":true}'>
                    <i class="fa-solid fa-wand-magic-sparkles"></i> ตั้งค่าแคมเปญ Family &amp; Gang
                </button>
            </article>

            <!-- 3. Stay 3+ Nights -->
            <article class="manager-promo-card">
                <div class="manager-promo-card-top">
                    <span class="manager-code-badge">STAY_3PLUS</span>
                    <span class="manager-badge manager-badge-info">percent_room</span>
                </div>
                <h3 class="manager-promo-title">3. Stay 3+ Nights</h3>
                <p class="manager-promo-desc">เข้าพักต่อเนื่องตั้งแต่ 3 คืนขึ้นไป รับส่วนลดค่าห้องพักทันทีสูงสุดไม่เกินเกณฑ์ 20%</p>
                <div class="manager-promo-meta-box">
                    <span><i class="fa-solid fa-calendar-day"></i> คืนพักขั้นต่ำ: <strong>3 คืน</strong></span>
                    <span><i class="fa-solid fa-percent"></i> ส่วนลดห้องพัก: <strong>10% (Max 20%)</strong></span>
                </div>
                <button type="button"
                        class="manager-btn manager-btn-outline w-100"
                        data-manager-fill="#savePromotionModalForm"
                        data-manager-fill-data='{"PromoCode":"STAY_3PLUS","PromoName":"Stay 3+ Nights (พัก 3 คืนรับส่วนลด)","Description":"เข้าพักต่อเนื่อง 3 คืนขึ้นไป รับส่วนลดพิเศษค่าห้องพักสูงสุด 20%","DiscountType":"percent_room","DiscountPercent":10,"DiscountPercentMax":20,"MinNights":3,"IsActive":true}'>
                    <i class="fa-solid fa-wand-magic-sparkles"></i> ตั้งค่าแคมเปญ Stay 3+ Nights
                </button>
            </article>

            <!-- 4. Weekly Escape -->
            <article class="manager-promo-card">
                <div class="manager-promo-card-top">
                    <span class="manager-code-badge">WEEKLY_ESCAPE</span>
                    <span class="manager-badge manager-badge-success">percent_room</span>
                </div>
                <h3 class="manager-promo-title">4. Weekly Escape</h3>
                <p class="manager-promo-desc">สิทธิพิเศษสำหรับผู้เข้าพักระยะยาวรายสัปดาห์ (7 คืนขึ้นไป) มอบส่วนลดพิเศษสูงสุด 20%</p>
                <div class="manager-promo-meta-box">
                    <span><i class="fa-solid fa-suitcase-rolling"></i> คืนพักขั้นต่ำ: <strong>7 คืน</strong></span>
                    <span><i class="fa-solid fa-percent"></i> ส่วนลดห้องพัก: <strong>15% - 20%</strong></span>
                </div>
                <button type="button"
                        class="manager-btn manager-btn-outline w-100"
                        data-manager-fill="#savePromotionModalForm"
                        data-manager-fill-data='{"PromoCode":"WEEKLY_ESCAPE","PromoName":"Weekly Escape (พักรายสัปดาห์)","Description":"เข้าพัก 7 คืนขึ้นไปรับส่วนลดแบบพรีเมียมสูงสุด 20%","DiscountType":"percent_room","DiscountPercent":20,"DiscountPercentMax":20,"MinNights":7,"IsActive":true}'>
                    <i class="fa-solid fa-wand-magic-sparkles"></i> ตั้งค่าแคมเปญ Weekly Escape
                </button>
            </article>

            <!-- 5. Festival & Long Weekend -->
            <article class="manager-promo-card">
                <div class="manager-promo-card-top">
                    <span class="manager-code-badge">FESTIVAL_WKND</span>
                    <span class="manager-badge manager-badge-warning">RequiresHoliday</span>
                </div>
                <h3 class="manager-promo-title">5. Festival &amp; Long Weekend</h3>
                <p class="manager-promo-desc">แคมเปญผูกมัดกับตารางปฏิทินวันหยุดเทศกาลเพื่อสร้างสีสัน พร้อมแจกสิทธิ์ E-Voucher</p>
                <div class="manager-promo-meta-box">
                    <span><i class="fa-solid fa-calendar-star"></i> ผูกตารางเทศกาล: <strong>RequiresHoliday</strong></span>
                    <span><i class="fa-solid fa-ticket"></i> E-Voucher: <strong>รองรับ (Min-Max)</strong></span>
                </div>
                <button type="button"
                        class="manager-btn manager-btn-outline w-100"
                        data-manager-fill="#savePromotionModalForm"
                        data-manager-fill-data='{"PromoCode":"FESTIVAL_PROMO","PromoName":"Festival & Long Weekend Promotion","Description":"รับสิทธิประโยชน์และ E-Voucher พิเศษเฉพาะการเข้าพักตรงวันหยุดเทศกาล","DiscountType":"percent_room","DiscountPercent":10,"DiscountPercentMax":20,"RequiresHoliday":true,"VoucherMinValue":100,"VoucherMaxValue":300,"IsActive":true}'>
                    <i class="fa-solid fa-wand-magic-sparkles"></i> ตั้งค่า Festival &amp; Weekend
                </button>
            </article>
        </div>
    </section>

    <!-- ═══════════════════════ SECTION 3: ACTIVE PROMOTIONS & HOLIDAY CALENDAR ═══════════════════════ -->
    <section class="manager-promo-section">
        <div class="manager-promo-split-layout">

            <!-- A. Active Promotions Container -->
            <div class="manager-promo-split-panel">
                <div class="manager-card h-100">
                    <div class="manager-card-header">
                        <div>
                            <h3 class="manager-card-title">
                                <span class="manager-promo-section-dot"></span>
                                Active Promotions (แคมเปญที่เปิดใช้งานปัจจุบัน)
                            </h3>
                            <p class="manager-card-subtitle">แคมเปญที่มีสถานะ IsActive = true และยังไม่หมดอายุการใช้งานจริงในวันนี้</p>
                        </div>
                    </div>

                    <div class="manager-promo-active-list">
                        @{
                            var activeCampaigns = Model.Promotions?.Where(p => p.Status == "active").ToList() ?? new List<StayMate_Kavinvee_0576.Models.ViewModels.ManagerPromotionRow>();
                        }

                        @if (activeCampaigns.Any())
                        {
                            @foreach (var p in activeCampaigns)
                            {
                                var fillDataJson = JsonSerializer.Serialize(new
                                {
                                    PromotionId = p.PromotionId,
                                    PromoCode = p.PromoCode,
                                    PromoName = p.PromoName,
                                    Description = p.Description ?? "",
                                    DiscountType = p.DiscountType,
                                    DiscountPercent = p.DiscountPercent,
                                    DiscountPercentMax = p.DiscountPercentMax,
                                    MinGuests = p.MinGuests,
                                    MinNights = p.MinNights,
                                    MaxDiscountNights = p.MaxDiscountNights,
                                    ApplicableRoomTypeId = p.ApplicableRoomTypeId,
                                    RequiresHoliday = p.RequiresHoliday,
                                    VoucherMinValue = p.VoucherMinValue,
                                    VoucherMaxValue = p.VoucherMaxValue,
                                    IsActive = p.IsActive,
                                    ValidFrom = p.ValidFrom?.ToString("yyyy-MM-dd") ?? "",
                                    ValidTo = p.ValidTo?.ToString("yyyy-MM-dd") ?? ""
                                });

                                <div class="manager-promo-active-item">
                                    <div class="manager-promo-item-header">
                                        <div>
                                            <span class="manager-code-badge">@p.PromoCode</span>
                                            <h4 class="manager-promo-item-title">@p.PromoName</h4>
                                        </div>
                                        <span class="manager-badge manager-badge-success">
                                            <i class="fa-solid fa-circle"></i> Active
                                        </span>
                                    </div>

                                    <p class="manager-promo-item-desc">@(string.IsNullOrWhiteSpace(p.Description) ? "ไม่มีข้อมูลเงื่อนไขเพิ่มเติม" : p.Description)</p>

                                    <div class="manager-promo-item-details">
                                        <div class="manager-promo-detail-badge">
                                            <span class="manager-promo-detail-lbl">รูปแบบ:</span>
                                            <strong>@p.DiscountTypeLabel</strong>
                                        </div>
                                        @if (p.DiscountPercent.HasValue)
                                        {
                                            <div class="manager-promo-detail-badge">
                                                <span class="manager-promo-detail-lbl">ส่วนลด:</span>
                                                <strong class="text-primary">@p.DiscountPercent.Value.ToString("0.00")%</strong>
                                            </div>
                                        }
                                        @if (p.VoucherMinValue.HasValue || p.VoucherMaxValue.HasValue)
                                        {
                                            <div class="manager-promo-detail-badge">
                                                <span class="manager-promo-detail-lbl">E-Voucher:</span>
                                                <strong class="text-violet">฿@(p.VoucherMinValue ?? 0) - ฿@(p.VoucherMaxValue ?? 0)</strong>
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(p.ApplicableRoomTypeName))
                                        {
                                            <div class="manager-promo-detail-badge">
                                                <span class="manager-promo-detail-lbl">ประเภทห้อง:</span>
                                                <strong>@p.ApplicableRoomTypeName</strong>
                                            </div>
                                        }
                                    </div>

                                    <div class="manager-promo-item-dates">
                                        <span><i class="fa-solid fa-calendar-day"></i> เริ่มต้น: <strong>@(p.ValidFrom?.ToString("dd/MM/yyyy") ?? "ไม่มีกำหนด")</strong></span>
                                        <span><i class="fa-solid fa-calendar-xmark"></i> สิ้นสุด: <strong>@(p.ValidTo?.ToString("dd/MM/yyyy") ?? "ไม่มีกำหนด")</strong></span>
                                    </div>

                                    <div class="manager-promo-item-actions">
                                        <button type="button"
                                                class="manager-btn manager-btn-outline manager-btn-sm"
                                                data-manager-fill="#savePromotionModalForm"
                                                data-manager-fill-data='@Html.Raw(fillDataJson)'>
                                            <i class="fa-solid fa-pen-to-square"></i> แก้ไขแคมเปญ
                                        </button>

                                        <form asp-controller="Manager"
                                              asp-action="TogglePromotion"
                                              method="post"
                                              data-manager-ajax
                                              data-manager-confirm="คุณแน่ใจหรือไม่ว่าต้องการปิดการใช้งานโปรโมชั่น '@p.PromoName'?"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="promotionId" value="@p.PromotionId" />
                                            <input type="hidden" name="isActive" value="false" />
                                            <button type="submit" class="manager-btn manager-btn-danger manager-btn-sm">
                                                <i class="fa-solid fa-power-off"></i> สั่งปิดโปรโมชั่น
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="manager-empty-state">
                                <i class="fa-regular fa-folder-open"></i>
                                <p>ไม่พบแคมเปญโปรโมชั่นที่เปิดใช้งานและตรงเงื่อนไขปัจจุบันในวันนี้</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- B. Holiday & Festival Interactive Calendar -->
            <div class="manager-promo-split-panel">
                <div class="manager-card h-100">
                    <div class="manager-card-header">
                        <div>
                            <h3 class="manager-card-title">
                                <i class="fa-solid fa-calendar-days text-primary"></i>
                                Holiday &amp; Festival Calendar (ปฏิทินเทศกาลและวันหยุด)
                            </h3>
                            <p class="manager-card-subtitle">แสดงรายการวันหยุดประจำปีที่ใช้อ้างอิงอัตราพิเศษและ E-Voucher</p>
                        </div>
                    </div>

                    <!-- Interactive Calendar Widget -->
                    <div class="manager-promo-calendar">
                        <div class="manager-promo-calendar-header">
                            <button type="button" class="manager-promo-calendar-btn" id="btnPrevMonth">
                                <i class="fa-solid fa-chevron-left"></i>
                            </button>
                            <h4 class="manager-promo-calendar-title" id="calendarTitle">พฤศจิกายน 2026</h4>
                            <button type="button" class="manager-promo-calendar-btn" id="btnNextMonth">
                                <i class="fa-solid fa-chevron-right"></i>
                            </button>
                        </div>

                        <div class="manager-promo-calendar-weekdays">
                            <div>อา</div><div>จ</div><div>อ</div><div>พ</div><div>พฤ</div><div>ศ</div><div>ส</div>
                        </div>

                        <div class="manager-promo-calendar-grid" id="calendarGrid">
                            <!-- วันที่ในปฏิทินจะเรนเดอร์ผ่าน JavaScript -->
                        </div>
                    </div>

                    <!-- Detail Panel of Selected Date's Holiday -->
                    <div class="manager-promo-holiday-detail-panel" id="holidayDetailPanel">
                        <div class="manager-promo-detail-placeholder" id="holidayDetailPlaceholder">
                            <i class="fa-solid fa-circle-info"></i>
                            <span>คลิกเลือกวันหยุดที่เป็นสีบนปฏิทิน เพื่อตรวจสอบรายละเอียดเทศกาล</span>
                        </div>
                        <div class="manager-promo-detail-content d-none" id="holidayDetailContent">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h4 class="manager-promo-holiday-name" id="detHolidayName">เทศกาล</h4>
                                <span class="manager-badge" id="detHolidayStatus">Ongoing</span>
                            </div>
                            <p class="manager-promo-holiday-note" id="detHolidayNote">ไม่มีรายละเอียดพิเศษสำหรับวันหยุดนี้</p>
                            <div class="manager-promo-holiday-dates">
                                <span><i class="fa-solid fa-hourglass-start text-success"></i> เริ่มต้น: <strong id="detStartDate">01/01/2026</strong></span>
                                <span><i class="fa-solid fa-hourglass-end text-danger"></i> สิ้นสุด: <strong id="detEndDate">01/01/2026</strong></span>
                            </div>
                            <div class="manager-promo-holiday-actions mt-3" id="holidayActionWrap">
                                <!-- ปุ่มคำสั่งลบ/แก้ไขจะเติมผ่าน JS -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- ═══════════════════════ SECTION 4: PROMOTION RULES INFORMATION ═══════════════════════ -->
    <section class="manager-promo-section">
        <div class="manager-card">
            <div class="manager-card-header">
                <div>
                    <h2 class="manager-card-title">
                        <i class="fa-solid fa-scale-balanced text-primary"></i>
                        3. Predefined Promotion Rules (กฎเหล็กการใช้โปรโมชั่นของระบบ)
                    </h2>
                    <p class="manager-card-subtitle">นโยบายและการคำนวณส่วนลดรวมบนระบบ StayMate เพื่อป้องกันความเสี่ยงด้านกำไรของทางโรงแรม</p>
                </div>
            </div>

            <div class="manager-promo-rules-box">
                <article class="manager-promo-rule-card">
                    <div class="manager-promo-rule-icon">
                        <i class="fa-solid fa-shield-cat"></i>
                    </div>
                    <div>
                        <h4 class="manager-promo-rule-title">เพดานส่วนลดรวมสูงสุดไม่เกิน 20% (Max Cap)</h4>
                        <p class="manager-promo-rule-desc">ในกรณีที่ลูกค้าสแต็คสิทธิ์ใช้งานโปรโมชั่นหลายแคมเปญ ระบบจะสแต็คสิทธิ์ให้อัตโนมัติโดยคิดส่วนลดค่าห้องรวมสุทธิไม่เกิน 20% ของอัตราเข้าพักจริง</p>
                    </div>
                </article>

                <article class="manager-promo-rule-card">
                    <div class="manager-promo-rule-icon">
                        <i class="fa-solid fa-calculator"></i>
                    </div>
                    <div>
                        <h4 class="manager-promo-rule-title">ระบบคำนวณส่วนลดอัตโนมัติ (Auto Calculation)</h4>
                        <p class="manager-promo-rule-desc">การทำรายการจองผ่านฝั่ง Customer จะถูกประเมินเทียบเงื่อนไข (MinGuests, MinNights, RequiresHoliday) จากฐานข้อมูลโดยไม่ต้องบันทึกสิทธิ์ด้วยพนักงาน</p>
                    </div>
                </article>

                <article class="manager-promo-rule-card">
                    <div class="manager-promo-rule-icon">
                        <i class="fa-solid fa-hotel"></i>
                    </div>
                    <div>
                        <h4 class="manager-promo-rule-title">สิทธิ์การจองแยกประเภทห้อง (Room Restriction)</h4>
                        <p class="manager-promo-rule-desc">สามารถจำกัดโปรโมชั่นให้มีผลใช้งานได้เฉพาะประเภทห้องพักที่กำหนดได้ เช่น กำหนดให้แคมเปญ Family &amp; Gang ส่งผลใช้งานเฉพาะกับห้อง Family Room (ID: 3)</p>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ SECTION 5: LIVE DATABASE DATA LIST ═══════════════════════ -->
    <section class="manager-promo-section">
        <div class="manager-card">
            <div class="manager-card-header manager-card-header-responsive">
                <div>
                    <h2 class="manager-card-title">
                        <i class="fa-solid fa-database text-primary"></i>
                        4. Promotions &amp; Holidays Database Sync (ตารางข้อมูลจริงจากฐานข้อมูล)
                    </h2>
                    <p class="manager-card-subtitle">
                        ค้นหาตัวกรอง และตรวจสอบรายการทำธุรกรรมโปรโมชั่นและปฏิทินเทศกาลจริงจาก Database
                    </p>
                </div>

                <!-- GET Form Filter (Connected to GET /Manager/PromotionManagement) -->
                <form method="get"
                      asp-controller="Manager"
                      asp-action="PromotionManagement"
                      data-manager-autosubmit
                      class="manager-promo-filter-bar">

                    <div class="manager-search-box">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="search"
                               name="q"
                               value="@Model.Search"
                               class="manager-input"
                               placeholder="ค้นหารหัส หรือชื่อโปรโมชั่น..."
                               data-manager-search="#dbPromotionsTable" />
                    </div>

                    <select name="status"
                            class="manager-select"
                            data-manager-filter="#dbPromotionsTable"
                            data-filter-key="status"
                            aria-label="กรองสถานะโปรโมชั่น">
                        <option value="">ทุกสถานะแคมเปญ</option>
                        @foreach (var opt in Model.StatusOptions)
                        {
                            <option value="@opt.Value" selected="@(Model.Status == opt.Value ? "selected" : null)">
                                @opt.Label
                            </option>
                        }
                    </select>

                    <select name="discountType"
                            class="manager-select"
                            data-manager-filter="#dbPromotionsTable"
                            data-filter-key="distype"
                            aria-label="กรองตามประเภทส่วนลด">
                        <option value="">ทุกประเภทส่วนลด</option>
                        @foreach (var opt in Model.DiscountTypeOptions)
                        {
                            <option value="@opt.Value" selected="@(Model.DiscountType == opt.Value ? "selected" : null)">
                                @opt.Label
                            </option>
                        }
                    </select>

                    <button type="submit" class="manager-btn manager-btn-primary">
                        <i class="fa-solid fa-arrows-rotate"></i> Sync Data
                    </button>

                    @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Status) || !string.IsNullOrWhiteSpace(Model.DiscountType))
                    {
                        <a asp-controller="Manager" asp-action="PromotionManagement" class="manager-btn manager-btn-ghost">
                            <i class="fa-solid fa-rotate-left"></i> Clear Filter
                        </a>
                    }
                </form>
            </div>

            <!-- Tabs Inside Database View -->
            <div class="manager-promo-subtabs mt-2" role="tablist" aria-label="Database Tables">
                <button type="button" class="manager-promo-subtab-btn active" data-manager-dbtab-target="dbtab-promotions">
                    <i class="fa-solid fa-tags"></i> ตารางแคมเปญโปรโมชั่นจริง (@(Model.Promotions?.Count ?? 0) แคมเปญ)
                </button>
                <button type="button" class="manager-promo-subtab-btn" data-manager-dbtab-target="dbtab-holidays">
                    <i class="fa-solid fa-calendar-days"></i> ตารางปฏิทินวันเทศกาลประจำปี (@(Model.Holidays?.Count ?? 0) วันหยุด)
                </button>
            </div>

            <!-- Tab 5.1: Promotions Table -->
            <div id="dbtab-promotions" class="manager-promo-dbtab-pane active">
                <div class="manager-table-responsive">
                    <table class="manager-table manager-promo-table" id="dbPromotionsTable">
                        <thead>
                            <tr>
                                <th>รหัสโปรโมชั่น (Promo Code)</th>
                                <th>ชื่อโปรโมชั่น (Promo Name)</th>
                                <th>ประเภทส่วนลด</th>
                                <th class="text-end">ส่วนลด (%)</th>
                                <th class="text-center">Min Nights / Guests</th>
                                <th>ช่วงวันที่ใช้งาน</th>
                                <th class="text-center">ใช้ไปแล้ว</th>
                                <th class="text-center">สถานะระบบ</th>
                                <th class="text-end">การจัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Promotions != null && Model.Promotions.Any())
                            {
                                foreach (var p in Model.Promotions)
                                {
                                    var editJson = JsonSerializer.Serialize(new
                                    {
                                        PromotionId = p.PromotionId,
                                        PromoCode = p.PromoCode,
                                        PromoName = p.PromoName,
                                        Description = p.Description ?? "",
                                        DiscountType = p.DiscountType,
                                        DiscountPercent = p.DiscountPercent,
                                        DiscountPercentMax = p.DiscountPercentMax,
                                        MinGuests = p.MinGuests,
                                        MinNights = p.MinNights,
                                        MaxDiscountNights = p.MaxDiscountNights,
                                        ApplicableRoomTypeId = p.ApplicableRoomTypeId,
                                        RequiresHoliday = p.RequiresHoliday,
                                        VoucherMinValue = p.VoucherMinValue,
                                        VoucherMaxValue = p.VoucherMaxValue,
                                        IsActive = p.IsActive,
                                        ValidFrom = p.ValidFrom?.ToString("yyyy-MM-dd") ?? "",
                                        ValidTo = p.ValidTo?.ToString("yyyy-MM-dd") ?? ""
                                    });

                                    <tr data-status="@p.Status" data-distype="@p.DiscountType">
                                        <td>
                                            <span class="manager-code-badge">@p.PromoCode</span>
                                        </td>
                                        <td>
                                            <strong>@p.PromoName</strong>
                                            @if (p.RequiresHoliday)
                                            {
                                                <div class="manager-promo-holiday-req">
                                                    <i class="fa-solid fa-calendar-day"></i> ต้องตรงกับวันหยุด
                                                </div>
                                            }
                                        </td>
                                        <td>@p.DiscountTypeLabel</td>
                                        <td class="text-end font-monospace">
                                            @(p.DiscountPercent.HasValue ? p.DiscountPercent.Value.ToString("0.00") + "%" : "--")
                                        </td>
                                        <td class="text-center">
                                            <span class="manager-pill-neutral">คืน: @(p.MinNights?.ToString() ?? "0")</span>
                                            <span class="manager-pill-neutral">คน: @(p.MinGuests?.ToString() ?? "0")</span>
                                        </td>
                                        <td>
                                            <div class="manager-promo-table-dates">
                                                <span>@(p.ValidFrom?.ToString("dd/MM/yyyy") ?? "ไม่มีกำหนด")</span>
                                                <i class="fa-solid fa-arrow-right"></i>
                                                <span>@(p.ValidTo?.ToString("dd/MM/yyyy") ?? "ไม่มีกำหนด")</span>
                                            </div>
                                        </td>
                                        <td class="text-center font-monospace">@p.UsageCount ครั้ง</td>
                                        <td class="text-center">
                                            <span class="manager-promo-badge-status manager-promo-badge-status-@p.Status">
                                                @p.StatusLabel
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <div class="manager-promo-item-actions justify-content-end">
                                                <button type="button"
                                                        class="manager-btn manager-btn-outline manager-btn-sm"
                                                        data-manager-fill="#savePromotionModalForm"
                                                        data-manager-fill-data='@Html.Raw(editJson)'>
                                                    <i class="fa-solid fa-pen-to-square"></i> แก้ไข
                                                </button>

                                                <form asp-controller="Manager"
                                                      asp-action="TogglePromotion"
                                                      method="post"
                                                      data-manager-ajax
                                                      class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="promotionId" value="@p.PromotionId" />
                                                    <input type="hidden" name="isActive" value="@(p.IsActive ? "false" : "true")" />
                                                    <button type="submit" class="manager-btn manager-btn-ghost manager-btn-sm" title="@(p.IsActive ? "ปิดใช้งาน" : "เปิดใช้งาน")">
                                                        <i class="fa-solid @(p.IsActive ? "fa-toggle-on text-success" : "fa-toggle-off text-muted")"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="manager-empty-state">
                                        <i class="fa-solid fa-tags"></i>
                                        <p>ไม่พบรายการแคมเปญโปรโมชั่นในฐานข้อมูล</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tab 5.2: Holidays Table -->
            <div id="dbtab-holidays" class="manager-promo-dbtab-pane">
                <div class="manager-table-responsive">
                    <table class="manager-table manager-promo-table" id="dbHolidaysTable">
                        <thead>
                            <tr>
                                <th>รหัสวันหยุด</th>
                                <th>ชื่อวันเทศกาล (Holiday Name)</th>
                                <th>วันที่เริ่มต้น (Start Date)</th>
                                <th>วันที่สิ้นสุด (End Date)</th>
                                <th class="text-center">จำนวนวันหยุด</th>
                                <th>บันทึกกิจกรรมเพิ่มเติม (Event Note)</th>
                                <th class="text-center">สถานะเทศกาล</th>
                                <th class="text-end">การจัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Holidays != null && Model.Holidays.Any())
                            {
                                foreach (var h in Model.Holidays)
                                {
                                    var hEditJson = JsonSerializer.Serialize(new
                                    {
                                        HolidayId = h.HolidayId,
                                        HolidayName = h.HolidayName,
                                        StartDate = h.StartDate.ToString("yyyy-MM-dd"),
                                        EndDate = h.EndDate.ToString("yyyy-MM-dd"),
                                        EventNote = h.EventNote ?? ""
                                    });

                                    <tr>
                                        <td>
                                            <span class="manager-code-badge">ID: @h.HolidayId</span>
                                        </td>
                                        <td>
                                            <strong>@h.HolidayName</strong>
                                        </td>
                                        <td>@h.StartDate.ToString("dd/MM/yyyy")</td>
                                        <td>@h.EndDate.ToString("dd/MM/yyyy")</td>
                                        <td class="text-center">@h.DayCount วัน</td>
                                        <td>@(string.IsNullOrWhiteSpace(h.EventNote) ? "--" : h.EventNote)</td>
                                        <td class="text-center">
                                            <span class="manager-promo-holiday-badge manager-promo-holiday-badge-@h.Status">
                                                @h.StatusLabel
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <div class="manager-promo-item-actions justify-content-end">
                                                <button type="button"
                                                        class="manager-btn manager-btn-outline manager-btn-sm"
                                                        data-manager-fill="#saveHolidayModalForm"
                                                        data-manager-fill-data='@Html.Raw(hEditJson)'>
                                                    <i class="fa-solid fa-pen-to-square"></i> แก้ไข
                                                </button>

                                                <form asp-controller="Manager"
                                                      asp-action="DeleteHoliday"
                                                      method="post"
                                                      data-manager-ajax
                                                      data-manager-confirm="คุณแน่ใจหรือไม่ว่าต้องการลบวันหยุดเทศกาล '@h.HolidayName' ออกจากระบบ?"
                                                      class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="holidayId" value="@h.HolidayId" />
                                                    <button type="submit" class="manager-btn manager-btn-danger manager-btn-sm">
                                                        <i class="fa-solid fa-trash-can"></i> ลบ
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="manager-empty-state">
                                        <i class="fa-regular fa-calendar-xmark"></i>
                                        <p>ยังไม่มีบันทึกข้อมูลวันหยุดเทศกาลในปฏิทิน</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Notes Panel -->
            @if (Model.DataNotes != null && Model.DataNotes.Any())
            {
                <div class="manager-notes-box">
                    <div class="manager-notes-title">
                        <i class="fa-solid fa-circle-info"></i>
                        <span>หมายเหตุกฎเกณฑ์และความสัมพันธ์แคมเปญ (System Database Notes)</span>
                    </div>
                    <ul class="manager-notes-list">
                        @foreach (var note in Model.DataNotes)
                        {
                            <li>@note</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </section>

</div>

<!-- ═════════════════════════════════════════════════════════════════════════════
     MODALS (Connected to Real Controller Actions: SavePromotion & SaveHoliday)
     ═════════════════════════════════════════════════════════════════════════════ -->

<!-- Modal 1: Create / Edit Promotion Campaign (POST /Manager/SavePromotion) -->
<div class="modal fade manager-modal manager-promo-modal" id="managerSavePromotionModal" tabindex="-1" aria-labelledby="managerSavePromotionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content manager-modal-content">
            <form id="savePromotionModalForm"
                  asp-controller="Manager"
                  asp-action="SavePromotion"
                  method="post"
                  data-manager-ajax>
                @Html.AntiForgeryToken()
                <input type="hidden" name="PromotionId" value="" />

                <div class="modal-header manager-modal-header">
                    <h5 class="modal-title" id="managerSavePromotionModalLabel">
                        <i class="fa-solid fa-tags text-info"></i>
                        เพิ่ม / แก้ไขแคมเปญโปรโมชั่น (`SavePromotion`)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body manager-modal-body">
                    <div class="manager-alert manager-alert-info mb-3">
                        <i class="fa-solid fa-circle-info"></i>
                        <span>แคมเปญทุกประเภทจะได้รับการคำนวณและอยู่ภายใต้กฎจำกัดส่วนลดสูงสุดไม่เกิน 20% โดยอัตโนมัติ</span>
                    </div>

                    <div class="manager-form-row mb-3">
                        <div class="manager-form-group">
                            <label class="manager-label">รหัสโปรโมชั่น (PromoCode: A-Z, 0-9, _, - เท่านั้น) <span class="manager-req">*</span></label>
                            <input type="text" name="PromoCode" class="manager-input" maxlength="30" placeholder="เช่น FESTIVAL_WKND" required />
                        </div>
                        <div class="manager-form-group">
                            <label class="manager-label">ชื่อโปรโมชั่น (PromoName) <span class="manager-req">*</span></label>
                            <input type="text" name="PromoName" class="manager-input" maxlength="150" placeholder="เช่น โปรโมชั่นวันหยุดยาว" required />
                        </div>
                    </div>

                    <div class="manager-form-group mb-3">
                        <label class="manager-label">รายละเอียดเงื่อนไข (Description)</label>
                        <textarea name="Description" class="manager-textarea" rows="2" placeholder="อธิบายสิทธิ์การใช้งานของแคมเปญให้พนักงานรับทราบ..."></textarea>
                    </div>

                    <div class="manager-form-row mb-3">
                        <div class="manager-form-group">
                            <label class="manager-label">ประเภทส่วนลด (DiscountType) <span class="manager-req">*</span></label>
                            <select name="DiscountType" class="manager-select" required>
                                <option value="percent_room">ลดเปอร์เซ็นต์ค่าห้อง (percent_room)</option>
                                <option value="percent_extra_nights">ลดเปอร์เซ็นต์คืนพิเศษ (percent_extra_nights)</option>
                                <option value="free_extra_bed">เตียงเสริมฟรี (free_extra_bed)</option>
                            </select>
                        </div>
                        <div class="manager-form-group">
                            <label class="manager-label">เปอร์เซ็นต์ส่วนลด (%)</label>
                            <input type="number" name="DiscountPercent" class="manager-input" step="0.01" min="0.01" max="20" placeholder="สูงสุดไม่เกิน 20" />
                        </div>
                        <div class="manager-form-group">
                            <label class="manager-label">เพดานส่วนลดสูงสุด (Max %)</label>
                            <input type="number" name="DiscountPercentMax" class="manager-input" step="0.01" min="0.01" max="20" value="20" placeholder="20" />
                        </div>
                    </div>

                    <div class="manager-form-row mb-3">
                        <div class="manager-form-group">
                            <label class="manager-label">เข้าพักขั้นต่ำกี่คน (MinGuests)</label>
                            <input type="number" name="MinGuests" class="manager-input" min="1" placeholder="เช่น 2" />
                        </div>
                        <div class="manager-form-group">
                            <label class="manager-label">จองขั้นต่ำกี่คืน (MinNights)</label>
                            <input type="number" name="MinNights" class="manager-input" min="1" placeholder="เช่น 3" />
                        </div>
                        <div class="manager-form-group">
                            <label class="manager-label">จำกัดคืนลดสูงสุด (MaxDiscountNights)</label>
                            <input type="number" name="MaxDiscountNights" class="manager-input" min="1" placeholder="เช่น 1" />
                        </div>
                        <div class="manager-form-group">
                            <label class="manager-label">ใช้เฉพาะประเภทห้อง (ถ้ามี)</label>
                            <select name="ApplicableRoomTypeId" class="manager-select">
                                <option value="">ทุกประเภทห้องพัก</option>
                                @foreach (var opt in Model.RoomTypeOptions)
                                {
                                    <option value="@opt.Value">@opt.Label</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="manager-form-row mb-3">
                        <div class="manager-form-group">
                            <label class="manager-label">สิทธิ์มูลค่า Voucher ขั้นต่ำ (บาท)</label>
                            <input type="number" name="VoucherMinValue" class="manager-input" step="0.01" min="0" placeholder="เช่น 100.00" />
                        </div>
                        <div class="manager-form-group">
                            <label class="manager-label">สิทธิ์มูลค่า Voucher สูงสุด (บาท)</label>
                            <input type="number" name="VoucherMaxValue" class="manager-input" step="0.01" min="0" placeholder="เช่น 300.00" />
                        </div>
                        <div class="manager-form-group">
                            <label class="manager-label">วันเริ่มต้น (ValidFrom)</label>
                            <input type="date" name="ValidFrom" class="manager-input" />
                        </div>
                        <div class="manager-form-group">
                            <label class="manager-label">วันสิ้นสุด (ValidTo)</label>
                            <input type="date" name="ValidTo" class="manager-input" />
                        </div>
                    </div>

                    <div class="manager-checkbox-row">
                        <label class="manager-checkbox-label">
                            <input type="checkbox" name="RequiresHoliday" value="true" />
                            <span>ต้องใช้ร่วมกับตารางวันหยุดเทศกาล (RequiresHoliday)</span>
                        </label>
                        <label class="manager-checkbox-label">
                            <input type="checkbox" name="IsActive" value="true" checked />
                            <span>เปิดใช้งานทันที (IsActive)</span>
                        </label>
                    </div>
                </div>

                <div class="modal-footer manager-modal-footer">
                    <button type="button" class="manager-btn manager-btn-ghost" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="manager-btn manager-btn-primary">
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span>บันทึกแคมเปญ</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 2: Create / Edit Holiday Calendar Event (POST /Manager/SaveHoliday) -->
<div class="modal fade manager-modal manager-promo-modal" id="managerSaveHolidayModal" tabindex="-1" aria-labelledby="managerSaveHolidayModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content manager-modal-content">
            <form id="saveHolidayModalForm"
                  asp-controller="Manager"
                  asp-action="SaveHoliday"
                  method="post"
                  data-manager-ajax>
                @Html.AntiForgeryToken()
                <input type="hidden" name="HolidayId" value="" />

                <div class="modal-header manager-modal-header">
                    <h5 class="modal-title" id="managerSaveHolidayModalLabel">
                        <i class="fa-solid fa-calendar-plus text-info"></i>
                        บันทึกวันหยุดเทศกาลปฏิทิน (`SaveHoliday`)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body manager-modal-body">
                    <div class="manager-form-group mb-3">
                        <label class="manager-label">ชื่อวันเทศกาล / วันหยุด <span class="manager-req">*</span></label>
                        <input type="text" name="HolidayName" class="manager-input" maxlength="150" placeholder="เช่น เทศกาลปีใหม่, เทศกาลสงกรานต์" required />
                    </div>

                    <div class="manager-form-row mb-3">
                        <div class="manager-form-group">
                            <label class="manager-label">วันเริ่มต้นปฏิทิน <span class="manager-req">*</span></label>
                            <input type="date" name="StartDate" class="manager-input" required />
                        </div>
                        <div class="manager-form-group">
                            <label class="manager-label">วันสิ้นสุดปฏิทิน <span class="manager-req">*</span></label>
                            <input type="date" name="EndDate" class="manager-input" required />
                        </div>
                    </div>

                    <div class="manager-form-group">
                        <label class="manager-label">บันทึกกิจกรรมเพิ่มเติม (Event Note)</label>
                        <input type="text" name="EventNote" class="manager-input" maxlength="255" placeholder="เช่น ปริมาณคนพักหนาแน่น, สงกรานต์วันไหล" />
                    </div>
                </div>

                <div class="modal-footer manager-modal-footer">
                    <button type="button" class="manager-btn manager-btn-ghost" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="manager-btn manager-btn-primary">
                        <i class="fa-solid fa-calendar-check"></i>
                        <span>บันทึกวันหยุด</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            // 1. ระบบจัดการ Switch Tabs ของฐานข้อมูลแยกฝั่งจริง (Promotions Table / Holidays Table)
            var dbTabButtons = document.querySelectorAll('[data-manager-dbtab-target]');
            var dbTabPanes = document.querySelectorAll('.manager-promo-dbtab-pane');

            dbTabButtons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var targetId = btn.getAttribute('data-manager-dbtab-target');
                    if (!targetId) return;

                    dbTabButtons.forEach(function (b) {
                        b.classList.toggle('active', b.getAttribute('data-manager-dbtab-target') === targetId);
                    });

                    dbTabPanes.forEach(function (pane) {
                        pane.classList.toggle('active', pane.id === targetId);
                    });
                });
            });

            // 2. ข้อมูลวันหยุดและเทศกาลจริง (Holiday Data) จาก Model เพื่อใช้งานบนปฏิทิน
            var holidayList = @Html.Raw(JsonSerializer.Serialize(Model.Holidays));

            // 3. ระบบ Interactive Holiday Calendar Widget
            var monthsTH = ["มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน", "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม"];
            var currentDate = new Date(2026, 10, 22); // อ้างอิงปี 2026 ตามที่ระบุใน Today หรือระบบจริง
            
            @if (Model.Holidays != null && Model.Holidays.Any()) {
                var firstHoliday = Model.Holidays.FirstOrDefault();
                if (firstHoliday != null) {
                    @:currentDate = new Date(@firstHoliday.StartDate.Year, @(firstHoliday.StartDate.Month - 1), 1);
                }
            }

            var calTitle = document.getElementById('calendarTitle');
            var calGrid = document.getElementById('calendarGrid');

            function renderCalendar() {
                if (!calTitle || !calGrid) return;

                var year = currentDate.getFullYear();
                var month = currentDate.getMonth();

                calTitle.textContent = monthsTH[month] + " " + year;
                calGrid.innerHTML = "";

                var firstDayIndex = new Date(year, month, 1).getDay();
                var totalDays = new Date(year, month + 1, 0).getDate();

                // เรนเดอร์วันว่างของสัปดาห์แรก
                for (var i = 0; i < firstDayIndex; i++) {
                    var emptyDiv = document.createElement('div');
                    emptyDiv.className = 'manager-promo-calendar-day-empty';
                    calGrid.appendChild(emptyDiv);
                }

                // เรนเดอร์แต่ละวันของเดือน
                for (var d = 1; d <= totalDays; d++) {
                    var dayDiv = document.createElement('div');
                    dayDiv.className = 'manager-promo-calendar-day';
                    dayDiv.textContent = d;

                    var thisDateStr = year + "-" + padZero(month + 1) + "-" + padZero(d);
                    var matchedHolidays = findHolidayForDate(thisDateStr);

                    if (matchedHolidays.length > 0) {
                        var holiday = matchedHolidays[0]; // ใช้เทศกาลแรกหากทับกัน
                        dayDiv.classList.add('manager-promo-calendar-day-has-event');
                        
                        if (holiday.Status === "ongoing") {
                            dayDiv.classList.add('manager-promo-calendar-day-ongoing');
                        } else {
                            dayDiv.classList.add('manager-promo-calendar-day-upcoming');
                        }

                        dayDiv.title = holiday.HolidayName;
                        dayDiv.setAttribute('data-holiday-id', holiday.HolidayId);
                        
                        // Event Listener เพื่อแสดงรายละเอียดวันหยุดที่ถูกเลือก
                        dayDiv.addEventListener('click', (function(h) {
                            return function() {
                                showHolidayDetail(h);
                            };
                        })(holiday));
                    }

                    calGrid.appendChild(dayDiv);
                }
            }

            function padZero(num) {
                return num < 10 ? '0' + num : num;
            }

            function findHolidayForDate(dateStr) {
                // ค้นหาช่วงวันหยุดในโมเดลจริง
                return holidayList.filter(function (h) {
                    return dateStr >= h.StartDate && dateStr <= h.EndDate;
                });
            }

            function showHolidayDetail(h) {
                var placeholder = document.getElementById('holidayDetailPlaceholder');
                var content = document.getElementById('holidayDetailContent');
                var detName = document.getElementById('detHolidayName');
                var detStatus = document.getElementById('detHolidayStatus');
                var detNote = document.getElementById('detHolidayNote');
                var detStart = document.getElementById('detStartDate');
                var detEnd = document.getElementById('detEndDate');
                var actionWrap = document.getElementById('holidayActionWrap');

                if (!content || !placeholder) return;

                placeholder.classList.add('d-none');
                content.classList.remove('d-none');

                detName.textContent = h.HolidayName;
                detNote.textContent = h.EventNote || "ไม่มีคำอธิบายเพิ่มเติมเกี่ยวกับกิจกรรม";
                
                // ฟอร์แมตวันที่แบบไทยอ่านง่าย
                detStart.textContent = formatDateString(h.StartDate);
                detEnd.textContent = formatDateString(h.EndDate);

                // ตั้งค่า Badge สถานะ
                detStatus.className = 'manager-badge manager-promo-holiday-badge-' + h.Status;
                detStatus.textContent = h.Status === 'ongoing' ? 'กำลังดำเนินอยู่' : (h.Status === 'upcoming' ? 'กำลังจะมาถึง' : 'ผ่านมาแล้ว');

                // เติมฟอร์มสำหรับลบและแก้ไขข้อมูลวันหยุด
                var editDataJson = JSON.stringify({
                    HolidayId: h.HolidayId,
                    HolidayName: h.HolidayName,
                    StartDate: h.StartDate,
                    EndDate: h.EndDate,
                    EventNote: h.EventNote || ""
                });

                actionWrap.innerHTML = `
                    <button type="button" class="manager-btn manager-btn-outline manager-btn-sm" 
                            data-manager-fill="#saveHolidayModalForm" 
                            data-manager-fill-data='${editDataJson}'>
                        <i class="fa-solid fa-pen-to-square"></i> แก้ไขเทศกาล
                    </button>
                    <form action="/Manager/DeleteHoliday" method="post" data-manager-ajax data-manager-confirm="ต้องการลบวันเทศกาล '${h.HolidayName}' หรือไม่?" class="d-inline">
                        <input type="hidden" name="holidayId" value="${h.HolidayId}" />
                        <button type="submit" class="manager-btn manager-btn-danger manager-btn-sm">
                            <i class="fa-solid fa-trash"></i> ลบรายการ
                        </button>
                    </form>
                `;
            }

            function formatDateString(isoStr) {
                if (!isoStr) return "--";
                var parts = isoStr.split('-');
                if (parts.length === 3) {
                    return parts[2] + "/" + parts + "/" + parts[0];
                }
                return isoStr;
            }

            // ปุ่มกดเปลี่ยนเดือน
            var btnPrev = document.getElementById('btnPrevMonth');
            var btnNext = document.getElementById('btnNextMonth');

            if (btnPrev && btnNext) {
                btnPrev.addEventListener('click', function () {
                    currentDate.setMonth(currentDate.getMonth() - 1);
                    renderCalendar();
                });
                btnNext.addEventListener('click', function () {
                    currentDate.setMonth(currentDate.getMonth() + 1);
                    renderCalendar();
                });
            }

            // เริ่มเรนเดอร์เมื่อโหลดสำเร็จ
            renderCalendar();

        })();
    </script>
}
