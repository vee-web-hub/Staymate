@model StayMate_Kavinvee_0576.Models.ViewModels.ManagerRoomManagementViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "จัดการห้องพักและราคา";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<div class="manager-portal-wrapper manager-room-page">

    <form id="managerRoomGlobalTokenForm" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <!-- ═══════════════════════ การแจ้งเตือนสถานะ ═══════════════════════ -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="manager-alert manager-alert-success" role="alert">
            <div class="manager-alert-content">
                <i class="fa-solid fa-circle-check"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="manager-alert-close" data-bs-dismiss="alert" aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="manager-alert manager-alert-danger" role="alert">
            <div class="manager-alert-content">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" class="manager-alert-close" data-bs-dismiss="alert" aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="manager-alert manager-alert-danger" role="alert">
            <div class="manager-alert-content">
                <i class="fa-solid fa-circle-exclamation"></i>
                <div asp-validation-summary="All" class="manager-room-validation"></div>
            </div>
        </div>
    }

    <!-- ═══════════════════════ ส่วนหัวของหน้าจอ ═══════════════════════ -->
    <section class="manager-room-header">
        <div class="manager-room-header-top">
            <div class="manager-room-title-wrap">
                <nav class="manager-room-breadcrumb" aria-label="Breadcrumb">
                    <a asp-controller="Manager" asp-action="Index" class="manager-room-breadcrumb-link">
                        <i class="fa-solid fa-chart-pie"></i> ภาพรวมระบบ
                    </a>
                    <span class="manager-room-breadcrumb-sep">/</span>
                    <span class="manager-room-breadcrumb-current">จัดการห้องพักและราคา</span>
                </nav>
                <h1 class="manager-room-title">จัดการห้องพักและราคา</h1>
                <p class="manager-room-desc">
                    บริหารประเภทห้องพัก กำหนดราคาพื้นฐาน และสร้างราคาพิเศษตามช่วงเทศกาลหรือวันหยุดยาวของโรงแรม
                </p>
            </div>

            <div class="manager-room-header-meta">
                <div class="manager-room-date-pill">
                    <i class="fa-regular fa-calendar-check"></i>
                    <span>ราคาอ้างอิงวันที่: <strong>@Model.Today.ToString("dd/MM/yyyy")</strong></span>
                </div>
                <div class="manager-room-date-pill manager-room-pill-cyan">
                    <i class="fa-solid fa-door-open"></i>
                    <span>ห้องพักเปิดใช้งาน: <strong>@Model.TotalRooms.ToString("N0") ห้อง</strong></span>
                </div>
                <div class="manager-room-header-btns">
                    <button type="button"
                            class="manager-btn manager-btn-primary"
                            data-manager-fill="#savePricePeriodForm"
                            data-manager-fill-data='{"RateId":"","RoomTypeId":"","PeriodName":"","StartDate":"@Model.Today.ToString("yyyy-MM-dd")","EndDate":"@Model.Today.ToString("yyyy-MM-dd")","PricePerNight":""}'>
                        <i class="fa-solid fa-calendar-plus"></i>
                        <span>กำหนดช่วงราคาพิเศษ</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- แถบลิงก์ข้ามไปยังส่วนต่างๆ ของหน้าจอ -->
        <nav class="manager-room-jumpnav" aria-label="หมวดหมู่ย่อย">
            <a href="#section-room-overview" class="manager-room-jump-link">
                <i class="fa-solid fa-grip"></i>
                <span>1. สรุปประเภทห้องพัก</span>
            </a>
            <a href="#section-rate-summary" class="manager-room-jump-link">
                <i class="fa-solid fa-table-list"></i>
                <span>2. ตารางเปรียบเทียบราคา</span>
            </a>
            <a href="#section-room-details" class="manager-room-jump-link">
                <i class="fa-solid fa-circle-info"></i>
                <span>3. รายการห้องพักรายห้อง</span>
            </a>
            <a href="#section-rate-management" class="manager-room-jump-link">
                <i class="fa-solid fa-tags"></i>
                <span>4. จัดการราคาตามเทศกาล</span>
            </a>
        </nav>
    </section>

    <!-- ═══════════════════════ ส่วนที่ 1: การ์ดสรุปประเภทห้องพัก ═══════════════════════ -->
    <section id="section-room-overview" class="manager-room-section">
        <div class="manager-room-section-head">
            <div>
                <h2 class="manager-room-section-title">
                    <i class="fa-solid fa-layer-group text-primary"></i>
                    1. สรุปภาพรวมห้องพักแยกตามประเภท
                </h2>
                <p class="manager-room-section-subtitle">
                    รายละเอียดปริมาณห้องพัก อัตราความหนาแน่นผู้เข้าพัก และการเปรียบเทียบราคาในแต่ละประเภทห้องพัก
                </p>
            </div>
            <span class="manager-badge manager-badge-info">
                รวมทั้งหมด: @(Model.RoomTypes?.Count ?? 0) ประเภทห้องพัก
            </span>
        </div>

        @if (Model.RoomTypes != null && Model.RoomTypes.Any())
        {
            <div class="manager-room-grid">
                @foreach (var rt in Model.RoomTypes)
                {
                    var isActiveType = rt.RoomCount > 0;
                    var editBasePriceJson = JsonSerializer.Serialize(new
                    {
                        roomTypeId = rt.RoomTypeId,
                        basePrice = rt.BasePrice,
                        extraBedPrice = rt.ExtraBedPrice
                    });

                    <article class="manager-room-card">
                        <div class="manager-room-card-banner">
                            <div class="manager-room-card-icon">
                                @if (rt.TypeCode.Contains("SUI", StringComparison.OrdinalIgnoreCase))
                                {
                                    <i class="fa-solid fa-crown"></i>
                                }
                                else if (rt.TypeCode.Contains("FAM", StringComparison.OrdinalIgnoreCase))
                                {
                                    <i class="fa-solid fa-people-roof"></i>
                                }
                                else if (rt.TypeCode.Contains("DELUXE", StringComparison.OrdinalIgnoreCase))
                                {
                                    <i class="fa-solid fa-gem"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-bed"></i>
                                }
                            </div>
                            <div class="manager-room-card-badges">
                                <span class="manager-code-badge">@rt.TypeCode</span>
                                @if (isActiveType)
                                {
                                    <span class="manager-room-status manager-room-status-active">
                                        <i class="fa-solid fa-circle-check"></i> พร้อมให้บริการ
                                    </span>
                                }
                                else
                                {
                                    <span class="manager-room-status manager-room-status-inactive">
                                        <i class="fa-solid fa-circle-pause"></i> ปิดบริการ
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="manager-room-card-body">
                            <h3 class="manager-room-card-title">@rt.TypeName</h3>
                            <p class="manager-room-card-bed">
                                <i class="fa-solid fa-mattress-pillow"></i>
                                <span>จัดเตรียมเตียง: <strong>@(string.IsNullOrWhiteSpace(rt.BedType) ? "--" : rt.BedType)</strong></span>
                            </p>

                            <div class="manager-room-stats-box">
                                <div class="manager-room-stat-item">
                                    <span class="manager-room-stat-label">ห้องทั้งหมด</span>
                                    <strong class="manager-room-stat-val">@rt.RoomCount.ToString("N0")</strong>
                                </div>
                                <div class="manager-room-stat-item manager-room-stat-avail">
                                    <span class="manager-room-stat-label">ห้องว่าง</span>
                                    <strong class="manager-room-stat-val">@rt.AvailableCount.ToString("N0")</strong>
                                </div>
                                <div class="manager-room-stat-item manager-room-stat-occ">
                                    <span class="manager-room-stat-label">มีผู้เข้าพัก</span>
                                    <strong class="manager-room-stat-val">@rt.OccupiedCount.ToString("N0")</strong>
                                </div>
                            </div>

                            <div class="manager-room-substats">
                                <span><i class="fa-solid fa-broom text-warning"></i> รอทำความสะอาด: <strong>@rt.NeedsCleaningCount</strong></span>
                                <span><i class="fa-solid fa-screwdriver-wrench text-danger"></i> ซ่อมบำรุง: <strong>@rt.MaintenanceCount</strong></span>
                            </div>

                            <div class="manager-room-price-block">
                                <div>
                                    <span class="manager-room-price-caption">ราคาพื้นฐาน / คืน</span>
                                    <div class="manager-room-price-main">฿@rt.BasePrice.ToString("N2")</div>
                                </div>
                                <div class="text-end">
                                    <span class="manager-room-price-caption">ราคาขายวันนี้</span>
                                    <div class="manager-room-price-current">฿@rt.CurrentPrice.ToString("N2")</div>
                                </div>
                            </div>
                        </div>

                        <div class="manager-room-card-footer manager-room-actions">
                            <a href="#room-detail-@rt.RoomTypeId" class="manager-btn manager-btn-outline">
                                <i class="fa-solid fa-eye"></i>
                                <span>ดูรายละเอียดห้องพัก</span>
                            </a>
                            <button type="button"
                                    class="manager-btn manager-btn-primary"
                                    data-manager-fill="#updateBasePriceModalForm"
                                    data-manager-fill-data='@Html.Raw(editBasePriceJson)'>
                                <i class="fa-solid fa-pen-to-square"></i>
                                <span>แก้ไขราคาเริ่มต้น</span>
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="manager-card manager-empty-state">
                <i class="fa-solid fa-bed"></i>
                <p>ไม่พบข้อมูลประเภทห้องพักในระบบ</p>
            </div>
        }
    </section>

    <!-- ═══════════════════════ ส่วนที่ 2: ตารางเปรียบเทียบราคา ═══════════════════════ -->
    <section id="section-rate-summary" class="manager-room-section">
        <div class="manager-card">
            <div class="manager-card-header manager-card-header-responsive">
                <div>
                    <h2 class="manager-card-title">
                        <i class="fa-solid fa-table-list text-primary"></i>
                        2. ตารางเปรียบเทียบราคาและเงื่อนไขเข้าพัก
                    </h2>
                    <p class="manager-card-subtitle">
                        สรุปการเปรียบเทียบราคา ความจุจำนวนผู้เข้าพัก และสิทธิการรับเตียงเสริมของห้องพักแต่ละประเภท
                    </p>
                </div>
            </div>

            <div class="manager-table-responsive">
                <table class="manager-table manager-room-table">
                    <thead>
                        <tr>
                            <th>ประเภทห้องพัก</th>
                            <th class="text-end">ราคาเริ่มต้น / คืน</th>
                            <th class="text-end">ราคาขายวันนี้</th>
                            <th class="text-center">จำกัดผู้เข้าพัก</th>
                            <th class="text-center">บริการเตียงเสริม</th>
                            <th class="text-center">สัดส่วนห้องพัก</th>
                            <th class="text-center">สถานะใช้งาน</th>
                            <th class="text-end">เครื่องมือ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RoomTypes != null && Model.RoomTypes.Any())
                        {
                            foreach (var rt in Model.RoomTypes)
                            {
                                var isActiveType = rt.RoomCount > 0;
                                var editBasePriceJson = JsonSerializer.Serialize(new
                                {
                                    roomTypeId = rt.RoomTypeId,
                                    basePrice = rt.BasePrice,
                                    extraBedPrice = rt.ExtraBedPrice
                                });
                                var addPeriodForTypeJson = JsonSerializer.Serialize(new
                                {
                                    RateId = "",
                                    RoomTypeId = rt.RoomTypeId,
                                    PeriodName = "",
                                    StartDate = Model.Today.ToString("yyyy-MM-dd"),
                                    EndDate = Model.Today.ToString("yyyy-MM-dd"),
                                    PricePerNight = rt.BasePrice
                                });

                                <tr>
                                    <td>
                                        <div class="manager-room-type-cell">
                                            <span class="manager-code-badge">@rt.TypeCode</span>
                                            <div>
                                                <strong>@rt.TypeName</strong>
                                                <div class="manager-room-cell-sub">จัดเตรียมเตียง: @(string.IsNullOrWhiteSpace(rt.BedType) ? "--" : rt.BedType)</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <strong class="manager-amount">฿@rt.BasePrice.ToString("N2")</strong>
                                    </td>
                                    <td class="text-end">
                                        <strong class="manager-room-current-price text-success">฿@rt.CurrentPrice.ToString("N2")</strong>
                                        @if (!string.IsNullOrWhiteSpace(rt.CurrentPeriodName))
                                        {
                                            <div class="manager-room-period-tag">
                                                <i class="fa-solid fa-calendar-day"></i> @rt.CurrentPeriodName
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="manager-room-cell-sub">ใช้งานราคาพื้นฐาน</div>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="manager-pill-neutral">
                                            <i class="fa-solid fa-user-group"></i> @rt.MinGuests - @rt.MaxGuests ท่าน
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (rt.AllowExtraBed)
                                        {
                                            <span class="manager-badge manager-badge-info">
                                                คิดเพิ่ม +฿@rt.ExtraBedPrice.ToString("N2")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="manager-text-muted">ไม่รองรับ</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <strong>@rt.RoomCount.ToString("N0") ห้อง</strong>
                                        <div class="manager-room-cell-sub">
                                            ว่าง @rt.AvailableCount | พักอยู่ @rt.OccupiedCount
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        @if (isActiveType)
                                        {
                                            <span class="manager-room-status manager-room-status-active">เปิดบริการ</span>
                                        }
                                        else
                                        {
                                            <span class="manager-room-status manager-room-status-inactive">ปิดชั่วคราว</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="manager-room-actions justify-content-end">
                                            <button type="button"
                                                    class="manager-btn manager-btn-outline manager-btn-sm"
                                                    data-manager-fill="#updateBasePriceModalForm"
                                                    data-manager-fill-data='@Html.Raw(editBasePriceJson)'>
                                                <i class="fa-solid fa-pen"></i>
                                                <span>ปรับราคาตั้งต้น</span>
                                            </button>
                                            <button type="button"
                                                    class="manager-btn manager-btn-ghost manager-btn-sm"
                                                    data-manager-fill="#savePricePeriodForm"
                                                    data-manager-fill-data='@Html.Raw(addPeriodForTypeJson)'
                                                    title="เพิ่มกำหนดราคาเทศกาล">
                                                <i class="fa-solid fa-calendar-plus"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="manager-empty-state">
                                    <i class="fa-regular fa-folder-open"></i>
                                    <p>ไม่มีข้อมูลสรุปประเภทห้องพักในระบบ</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════ ส่วนที่ 3: รายการห้องพักรายห้อง ═══════════════════════ -->
    <section id="section-room-details" class="manager-room-section">
        <div class="manager-room-section-head">
            <div>
                <h2 class="manager-room-section-title">
                    <i class="fa-solid fa-clipboard-list text-primary"></i>
                    3. ตรวจสอบสถานะการดำเนินงานและรายชื่อห้องพักรายห้อง
                </h2>
                <p class="manager-room-section-subtitle">
                    ข้อมูลคุณสมบัติเด่น ขนาด และสิ่งอำนวยความสะดวกพื้นฐานของแต่ละประเภทห้องพัก พร้อมตารางตรวจสถานะห้องทั้งหมดรายห้อง
                </p>
            </div>
        </div>

        @if (Model.RoomTypes != null && Model.RoomTypes.Any())
        {
            <div class="manager-room-detail-grid">
                @foreach (var rt in Model.RoomTypes)
                {
                    var isActiveType = rt.RoomCount > 0;
                    var editBasePriceJson = JsonSerializer.Serialize(new
                    {
                        roomTypeId = rt.RoomTypeId,
                        basePrice = rt.BasePrice,
                        extraBedPrice = rt.ExtraBedPrice
                    });

                    <article id="room-detail-@rt.RoomTypeId" class="manager-card manager-room-detail-card">
                        <div class="manager-room-detail-header">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="manager-code-badge">ID: @rt.RoomTypeId | @rt.TypeCode</span>
                                    @if (isActiveType)
                                    {
                                        <span class="manager-room-status manager-room-status-active">เปิดบริการอยู่ (@rt.RoomCount ห้อง)</span>
                                    }
                                    else
                                    {
                                        <span class="manager-room-status manager-room-status-inactive">ปิดชั่วคราว (0 ห้อง)</span>
                                    }
                                </div>
                                <h3 class="manager-room-detail-name">@rt.TypeName</h3>
                            </div>
                            <button type="button"
                                    class="manager-btn manager-btn-primary manager-btn-sm"
                                    data-manager-fill="#updateBasePriceModalForm"
                                    data-manager-fill-data='@Html.Raw(editBasePriceJson)'>
                                <i class="fa-solid fa-pen-to-square"></i>
                                <span>ปรับปรุงราคาเริ่มต้น</span>
                            </button>
                        </div>

                        <div class="manager-room-spec-grid">
                            <div class="manager-room-spec-box">
                                <span class="manager-room-spec-label">ชื่อประเภทห้อง</span>
                                <strong class="manager-room-spec-value">@rt.TypeName</strong>
                            </div>
                            <div class="manager-room-spec-box">
                                <span class="manager-room-spec-label">จำนวนผู้เข้าพักมาตรฐาน</span>
                                <strong class="manager-room-spec-value">@rt.MinGuests – @rt.MaxGuests ท่าน</strong>
                            </div>
                            <div class="manager-room-spec-box">
                                <span class="manager-room-spec-label">รูปแบบเตียง</span>
                                <strong class="manager-room-spec-value">@(string.IsNullOrWhiteSpace(rt.BedType) ? "--" : rt.BedType)</strong>
                            </div>
                            <div class="manager-room-spec-box">
                                <span class="manager-room-spec-label">อัตราค่าบริการ (รวมสิทธิเตียงเสริม)</span>
                                <strong class="manager-room-spec-value text-primary">
                                    ฿@rt.BasePrice.ToString("N2")
                                    @(rt.AllowExtraBed ? $" (เตียงเสริม +฿{rt.ExtraBedPrice:N2})" : " (ไม่รองรับเตียงเสริม)")
                                </strong>
                            </div>
                        </div>

                        <div class="manager-room-amenities-bar">
                            <span class="manager-room-amenities-title">
                                <i class="fa-solid fa-concierge-bell"></i> สิ่งอำนวยความสะดวกภายในห้องพัก:
                            </span>
                            <div class="manager-room-amenity-chips">
                                <span class="manager-room-amenity-chip"><i class="fa-solid fa-wifi"></i> ฟรี Wi-Fi ความเร็วสูง</span>
                                <span class="manager-room-amenity-chip"><i class="fa-solid fa-snowflake"></i> เครื่องปรับอากาศ</span>
                                <span class="manager-room-amenity-chip"><i class="fa-solid fa-tv"></i> สมาร์ททีวีจอแบน</span>
                                <span class="manager-room-amenity-chip"><i class="fa-solid fa-shower"></i> ห้องน้ำส่วนตัวพร้อมเครื่องทำน้ำอุ่น</span>
                                <span class="manager-room-amenity-chip"><i class="fa-solid fa-temperature-low"></i> ตู้เย็นและมินิบาร์</span>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }

        
                <!-- ตารางข้อมูลห้องพักแยกรายห้องแบบละเอียด -->
        <div class="manager-card mt-3">
            <div class="manager-card-header manager-card-header-responsive">
                <div>
                    <h3 class="manager-card-title">
                        <i class="fa-solid fa-door-closed text-primary"></i>
                        รายการข้อมูลและสถานะห้องพักรายห้อง 
                        (<span id="managerRoomCountText">กำลังโหลด...</span>)
                    </h3>
                    <p class="manager-card-subtitle">
                        ค้นหาเลขห้อง ระดับชั้น หรือกรองตามสถานะและประเภทห้องจากข้อมูลทั้งหมดในระบบ
                    </p>
                </div>

                <!-- ฟอร์มกรองสืบค้นฝั่ง Server-side -->
                <form method="get"
                      asp-controller="Manager"
                      asp-action="RoomManagement"
                      data-manager-autosubmit
                      class="manager-room-filter-bar">
                    <input type="hidden" name="includePast" value="@(Model.IncludePastPeriods ? "true" : "false")" />

                    <div class="manager-search-box">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="search"
                               name="q"
                               value="@Model.Search"
                               class="manager-input"
                               placeholder="ค้นหาเลขห้อง หรือประเภทห้อง..."
                               data-manager-search="#managerRoomsTable" />
                    </div>

                    <select name="roomTypeId"
                            class="manager-select"
                            data-manager-filter="#managerRoomsTable"
                            data-filter-key="roomtype"
                            aria-label="กรองประเภทห้อง">
                        <option value="">ทุกประเภทห้องพัก</option>
                        @foreach (var opt in Model.RoomTypeOptions)
                        {
                            <option value="@opt.Value" selected="@(Model.RoomTypeId?.ToString() == opt.Value ? "selected" : null)">
                                @opt.Label
                            </option>
                        }
                    </select>

                    <select name="status"
                            class="manager-select"
                            data-manager-filter="#managerRoomsTable"
                            data-filter-key="status"
                            aria-label="กรองสถานะห้อง">
                        <option value="">ทุกสถานะห้องพัก</option>
                        @foreach (var st in Model.StatusOptions)
                        {
                            <option value="@st.Value" selected="@(Model.Status == st.Value ? "selected" : null)">
                                @st.Label
                            </option>
                        }
                    </select>

                    <button type="submit" class="manager-btn manager-btn-primary">
                        <i class="fa-solid fa-filter"></i>
                        <span>ค้นหา</span>
                    </button>

                    @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Status) || Model.RoomTypeId.HasValue)
                    {
                        <a asp-controller="Manager" asp-action="RoomManagement" class="manager-btn manager-btn-ghost">
                            <i class="fa-solid fa-rotate-left"></i>
                            <span>ล้างตัวกรอง</span>
                        </a>
                    }
                </form>
            </div>

            <div class="manager-table-responsive">
                <table class="manager-table manager-room-table" id="managerRoomsTable">
                    <thead>
                        <tr>
                            <th>หมายเลขห้อง</th>
                            <th class="text-center">ระดับชั้น</th>
                            <th>ประเภทห้องพัก</th>
                            <th class="text-end">ราคาปกติ / คืน</th>
                            <th class="text-end">ราคาจองวันนี้</th>
                            <th class="text-center">สถานะปัจจุบัน</th>
                            <th class="text-center">สถานะการให้บริการ</th>
                        </tr>
                    </thead>
                    <tbody id="paginationTableBody">
                        @if (Model.Rooms != null && Model.Rooms.Any())
                        {
                            foreach (var r in Model.Rooms)
                            {
                                <tr data-status="@r.Status" data-roomtype="@r.RoomTypeId" class="manager-room-row-item">
                                    <td>
                                        <span class="manager-code-badge">ห้อง @r.RoomNumber</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="manager-pill-neutral">ชั้น @r.FloorNo</span>
                                    </td>
                                    <td>
                                        <strong>@r.RoomTypeName</strong>
                                    </td>
                                    <td class="text-end">
                                        ฿@r.BasePrice.ToString("N2")
                                    </td>
                                    <td class="text-end">
                                        <strong class="manager-amount">฿@r.CurrentPrice.ToString("N2")</strong>
                                    </td>
                                    <td class="text-center">
                                        <span class="manager-room-occ-badge manager-room-occ-@r.Status">
                                            @r.StatusLabel
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (r.IsActive)
                                        {
                                            <span class="manager-room-status manager-room-status-active">เปิดใช้งาน</span>
                                        }
                                        else
                                        {
                                            <span class="manager-room-status manager-room-status-inactive">ปิดให้บริการ</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr data-manager-empty-row>
                                <td colspan="7" class="manager-empty-state">
                                    <i class="fa-solid fa-door-closed"></i>
                                    <p>ไม่พบรายการห้องพักตามเงื่อนไขที่เลือก</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="manager-empty-state d-none" data-manager-empty-for="#managerRoomsTable">
                    <i class="fa-solid fa-filter-circle-xmark"></i>
                    <p>ไม่พบหมายเลขห้องพักที่ตรงกับคำค้นหาของคุณ</p>
                </div>
            </div>

            <!-- เพิ่มแถบเปลี่ยนหน้า Pagination Footer -->
            <div class="manager-card-footer d-flex justify-content-between align-items-center flex-wrap gap-2 py-3" id="tablePaginationFooter">
                <div class="manager-text-muted text-sm">
                    แสดง <span id="paginationInfoStart">0</span> - <span id="paginationInfoEnd">0</span> จากทั้งหมด <span id="paginationInfoTotal">0</span> รายการ
                </div>
                <nav aria-label="แถบสลับหน้าตารางห้องพัก">
                    <ul class="pagination pagination-sm mb-0" id="tablePaginationBtns" style="gap: 4px;">
                        <!-- ปุ่มจะถูกสร้างแบบ Dynamic ผ่าน JavaScript -->
                    </ul>
                </nav>
            </div>
        </div>


    <!-- ═══════════════════════ ส่วนที่ 4: การกำหนดอัตราค่าบริการตามเทศกาล ═══════════════════════ -->
    <section id="section-rate-management" class="manager-room-section">
        <div class="manager-card">
            <div class="manager-card-header manager-card-header-responsive">
                <div>
                    <h2 class="manager-card-title">
                        <i class="fa-solid fa-money-check-dollar text-primary"></i>
                        4. อัตราค่าบริการห้องพักตามเทศกาลและช่วงเวลาพิเศษ
                    </h2>
                    <p class="manager-card-subtitle">
                        กำหนดราคาสำหรับช่วงเวลาพิเศษ (เช่น ปีใหม่ สงกรานต์ หรือ High Season) โดยระบบจะล็อกป้องกันวันที่ซ้อนทับกันในประเภทห้องเดียวกัน
                    </p>
                </div>

                <div class="manager-room-rate-tools">
                    <form method="get" asp-controller="Manager" asp-action="RoomManagement" class="d-inline">
                        <input type="hidden" name="q" value="@Model.Search" />
                        <input type="hidden" name="status" value="@Model.Status" />
                        <input type="hidden" name="roomTypeId" value="@Model.RoomTypeId" />
                        <input type="hidden" name="includePast" value="@(Model.IncludePastPeriods ? "false" : "true")" />
                        <button type="submit" class="manager-btn manager-btn-outline">
                            <i class="fa-solid @(Model.IncludePastPeriods ? "fa-eye-slash" : "fa-clock-rotate-left")"></i>
                            <span>@(Model.IncludePastPeriods ? "ซ่อนราคาเทศกาลที่ผ่านไปแล้ว" : "แสดงราคาเทศกาลที่ผ่านไปแล้ว")</span>
                        </button>
                    </form>

                    <button type="button"
                            class="manager-btn manager-btn-primary"
                            data-manager-fill="#savePricePeriodForm"
                            data-manager-fill-data='{"RateId":"","RoomTypeId":"","PeriodName":"","StartDate":"@Model.Today.ToString("yyyy-MM-dd")","EndDate":"@Model.Today.ToString("yyyy-MM-dd")","PricePerNight":""}'>
                        <i class="fa-solid fa-plus"></i>
                        <span>เพิ่มราคาเทศกาลใหม่</span>
                    </button>
                </div>
            </div>

            @{
                var basePriceLookup = Model.RoomTypes?.ToDictionary(k => k.RoomTypeId, v => v.BasePrice) ?? new Dictionary<byte, decimal>();
                var currentPriceLookup = Model.RoomTypes?.ToDictionary(k => k.RoomTypeId, v => v.CurrentPrice) ?? new Dictionary<byte, decimal>();
            }

            <div class="manager-table-responsive">
                <table class="manager-table manager-room-table" id="managerPricePeriodsTable">
                    <thead>
                        <tr>
                            <th>ประเภทห้องพัก</th>
                            <th>ชื่อเทศกาล / ช่วงฤดูกาล</th>
                            <th class="text-end">ราคาตั้งต้น</th>
                            <th>วันเริ่มต้นแคมเปญ</th>
                            <th>วันสิ้นสุดแคมเปญ</th>
                            <th class="text-end">ราคาพิเศษ / คืน</th>
                            <th class="text-end">ราคาที่มีผลวันนี้</th>
                            <th class="text-center">สถานะแคมเปญ</th>
                            <th class="text-end">เครื่องมือ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PricePeriods != null && Model.PricePeriods.Any())
                        {
                            foreach (var p in Model.PricePeriods)
                            {
                                var baseRate = basePriceLookup.TryGetValue(p.RoomTypeId, out var br) ? br : 0m;
                                var currRate = currentPriceLookup.TryGetValue(p.RoomTypeId, out var cr) ? cr : baseRate;
                                var editPeriodJson = JsonSerializer.Serialize(new
                                {
                                    RateId = p.RateId,
                                    RoomTypeId = p.RoomTypeId,
                                    PeriodName = p.PeriodName ?? "",
                                    StartDate = p.StartDate.ToString("yyyy-MM-dd"),
                                    EndDate = p.EndDate.ToString("yyyy-MM-dd"),
                                    PricePerNight = p.PricePerNight
                                });

                                <tr>
                                    <td>
                                        <strong>@p.RoomTypeName</strong>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(p.PeriodName))
                                        {
                                            <span class="manager-room-period-name">@p.PeriodName</span>
                                        }
                                        else
                                        {
                                            <span class="manager-text-muted">-- ไม่ระบุชื่อช่วง --</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(p.CreatedByName))
                                        {
                                            <div class="manager-room-cell-sub">บันทึกโดย: @p.CreatedByName</div>
                                        }
                                    </td>
                                    <td class="text-end">
                                        ฿@baseRate.ToString("N2")
                                    </td>
                                    <td>
                                        <span class="manager-room-date-text">@p.StartDate.ToString("dd/MM/yyyy")</span>
                                    </td>
                                    <td>
                                        <span class="manager-room-date-text">@p.EndDate.ToString("dd/MM/yyyy")</span>
                                    </td>
                                    <td class="text-end">
                                        <strong class="manager-amount">฿@p.PricePerNight.ToString("N2")</strong>
                                    </td>
                                    <td class="text-end">
                                        <span class="manager-room-current-price">฿@currRate.ToString("N2")</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="manager-room-period-badge manager-room-period-@p.PeriodStatus">
                                            @p.PeriodStatusLabel
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="manager-room-actions justify-content-end">
                                            <button type="button"
                                                    class="manager-btn manager-btn-outline manager-btn-sm"
                                                    data-manager-fill="#savePricePeriodForm"
                                                    data-manager-fill-data='@Html.Raw(editPeriodJson)'>
                                                <i class="fa-solid fa-pen-to-square"></i>
                                                <span>แก้ไข</span>
                                            </button>

                                            <form asp-controller="Manager"
                                                  asp-action="DeletePricePeriod"
                                                  method="post"
                                                  data-manager-ajax
                                                  data-manager-confirm="ต้องการยืนยันการลบแคมเปญช่วงราคาพิเศษ '@(p.PeriodName ?? p.RoomTypeName)' (@p.StartDate.ToString("dd/MM/yyyy") - @p.EndDate.ToString("dd/MM/yyyy")) หรือไม่?"
                                                  class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="rateId" value="@p.RateId" />
                                                <button type="submit" class="manager-btn manager-btn-danger manager-btn-sm" title="ลบข้อมูล">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="manager-empty-state">
                                    <i class="fa-regular fa-calendar-xmark"></i>
                                    <p>ยังไม่มีการกำหนดราคารายช่วงฤดูกาลพิเศษ (ทุกประเภทห้องพักใช้งานราคาพื้นฐานมาตรฐาน)</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.DataNotes != null && Model.DataNotes.Any())
            {
                <div class="manager-notes-box">
                    <div class="manager-notes-title">
                        <i class="fa-solid fa-circle-info"></i>
                        <span>ข้อกำหนดและการคำนวณราคาอัตโนมัติ</span>
                    </div>
                    <ul class="manager-notes-list">
                        @foreach (var note in Model.DataNotes)
                        {
                            <li>@note</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </section>

</div>

<!-- ═════════════════════════════════════════════════════════════════════════════
     โมดอลการทำรายการ (เชื่อมกับ POST Actions ใน Controller)
     ═════════════════════════════════════════════════════════════════════════════ -->

<!-- โมดอล 1: ปรับปรุงราคาตั้งต้นเริ่มต้น (POST /Manager/UpdateBasePrice) -->
<div class="modal fade manager-modal manager-room-modal" id="managerUpdateBasePriceModal" tabindex="-1" aria-labelledby="managerUpdateBasePriceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content manager-modal-content">
            <form id="updateBasePriceModalForm"
                  asp-controller="Manager"
                  asp-action="UpdateBasePrice"
                  method="post"
                  data-manager-ajax>
                @Html.AntiForgeryToken()

                <div class="modal-header manager-modal-header">
                    <h5 class="modal-title" id="managerUpdateBasePriceModalLabel">
                        <i class="fa-solid fa-money-bill-wave text-info"></i>
                        แก้ไขค่าบริการเริ่มต้นและค่าบริการเตียงเสริม
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body manager-modal-body">
                    <div class="manager-form-group mb-3">
                        <label for="modalBaseRoomTypeId" class="manager-label">ระบุประเภทห้องพัก <span class="manager-req">*</span></label>
                        <select id="modalBaseRoomTypeId" name="roomTypeId" class="manager-select" required>
                            @if (Model.RoomTypes != null)
                            {
                                foreach (var rt in Model.RoomTypes)
                                {
                                    <option value="@rt.RoomTypeId">@rt.TypeName (@rt.TypeCode)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="manager-form-group mb-3">
                        <label for="modalBasePriceInput" class="manager-label">ราคาตั้งต้นเริ่มต้น / คืน (บาท) <span class="manager-req">*</span></label>
                        <input type="number"
                               id="modalBasePriceInput"
                               name="basePrice"
                               class="manager-input"
                               step="0.01"
                               min="0.01"
                               max="99999999.99"
                               placeholder="กรอกราคาค่าห้องเริ่มต้นต่อคืน"
                               required />
                    </div>

                    <div class="manager-form-group">
                        <label for="modalExtraBedPriceInput" class="manager-label">ราคาเสริมเตียงนอน / คืน (บาท)</label>
                        <input type="number"
                               id="modalExtraBedPriceInput"
                               name="extraBedPrice"
                               class="manager-input"
                               step="0.01"
                               min="0"
                               max="99999999.99"
                               placeholder="ระบุค่าบริการเสริมเตียงนอนต่อคืน (ใส่ 0 หากไม่มีค่าใช้จ่าย)" />
                    </div>
                </div>

                <div class="modal-footer manager-modal-footer">
                    <button type="button" class="manager-btn manager-btn-ghost" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="manager-btn manager-btn-primary">
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span>บันทึกข้อมูล</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- โมดอล 2: บันทึก-แก้ไขแคมเปญช่วงราคาตามวันเทศกาล (POST /Manager/SavePricePeriod) -->
<div class="modal fade manager-modal manager-room-modal" id="managerSavePricePeriodModal" tabindex="-1" aria-labelledby="managerSavePricePeriodModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content manager-modal-content">
            <form id="savePricePeriodForm"
                  asp-controller="Manager"
                  asp-action="SavePricePeriod"
                  method="post"
                  data-manager-ajax>
                @Html.AntiForgeryToken()
                <input type="hidden" name="RateId" id="periodRateIdInput" value="" />

                <div class="modal-header manager-modal-header">
                    <h5 class="modal-title" id="managerSavePricePeriodModalLabel">
                        <i class="fa-solid fa-calendar-week text-info"></i>
                        ตั้งค่าอัตราค่าห้องพักพิเศษตามวันและเวลาเทศกาล
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body manager-modal-body">
                    <div id="periodDateErrorAlert" class="manager-alert manager-alert-danger d-none mb-3" role="alert">
                        <div class="manager-alert-content">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <span id="periodDateErrorText">ไม่สามารถทำรายการได้เนื่องจากเลือกวันที่สิ้นสุดก่อนวันที่เริ่มต้นแคมเปญ</span>
                        </div>
                    </div>

                    <div class="manager-form-group mb-3">
                        <label for="periodModalRoomTypeId" class="manager-label">ระบุประเภทห้องพัก <span class="manager-req">*</span></label>
                        <select id="periodModalRoomTypeId" name="RoomTypeId" class="manager-select" required>
                            <option value="">-- เลือกประเภทห้องพักที่ต้องการรับราคาพิเศษ --</option>
                            @if (Model.RoomTypes != null)
                            {
                                foreach (var rt in Model.RoomTypes)
                                {
                                    <option value="@rt.RoomTypeId">@rt.TypeName (ราคาปกติ: ฿@rt.BasePrice.ToString("N2"))</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="manager-form-group mb-3">
                        <label for="periodModalName" class="manager-label">ชื่อแคมเปญ / เทศกาลพิเศษ</label>
                        <input type="text"
                               id="periodModalName"
                               name="PeriodName"
                               class="manager-input"
                               maxlength="100"
                               placeholder="ระบุชื่อแคมเปญ เช่น ปีใหม่, สงกรานต์, วันหยุดต่อเนื่อง" />
                    </div>

                    <div class="manager-form-row mb-3">
                        <div class="manager-form-group">
                            <label for="periodModalStartDate" class="manager-label">วันเริ่มต้นแคมเปญ <span class="manager-req">*</span></label>
                            <input type="date"
                                   id="periodModalStartDate"
                                   name="StartDate"
                                   class="manager-input"
                                   required />
                        </div>
                        <div class="manager-form-group">
                            <label for="periodModalEndDate" class="manager-label">วันสิ้นสุดแคมเปญ <span class="manager-req">*</span></label>
                            <input type="date"
                                   id="periodModalEndDate"
                                   name="EndDate"
                                   class="manager-input"
                                   required />
                        </div>
                    </div>

                    <div class="manager-form-group">
                        <label for="periodModalPrice" class="manager-label">ราคาค่าห้องกรณีพิเศษ / คืน (บาท) <span class="manager-req">*</span></label>
                        <input type="number"
                               id="periodModalPrice"
                               name="PricePerNight"
                               class="manager-input"
                               step="0.01"
                               min="0.01"
                               max="99999999.99"
                               placeholder="ระบุตัวเลขยอดเงิน เช่น 1800.00"
                               required />
                    </div>
                </div>

                <div class="modal-footer manager-modal-footer">
                    <button type="button" class="manager-btn manager-btn-ghost" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="manager-btn manager-btn-primary">
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span>บันทึกข้อมูลช่วงราคา</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            // =================================================================
            // 1. ระบบแบ่งหน้าตารางห้องพัก (Client-side Pagination)
            // =================================================================
            var tableBody = document.getElementById('paginationTableBody');
            var footer = document.getElementById('tablePaginationFooter');
            var paginationBtns = document.getElementById('tablePaginationBtns');
            var countTextSpan = document.getElementById('managerRoomCountText');
            
            var itemsPerPage = 10; // กำหนดให้แสดงผลหน้าละ 10 ห้องพัก
            var currentPage = 1;
            var filteredRows = [];

            function initPagination() {
                if (!tableBody) return;

                // ดึงแถวข้อมูลทั้งหมดในปัจจุบัน (สแกนหาแถวที่ไม่ถูกปิดซ่อนโดย Filter ของระบบค้นหา)
                var allRows = Array.prototype.slice.call(tableBody.querySelectorAll('.manager-room-row-item'));
                
                filteredRows = allRows.filter(function(row) {
                    return !row.classList.contains('d-none');
                });

                // อัปเดตข้อความจำนวนห้องที่พบจริงบนหัวข้อการ์ดแบบ Dynamic
                if (countTextSpan) {
                    countTextSpan.textContent = 'พบ ' + filteredRows.length + ' จาก ' + allRows.length + ' ห้อง';
                }

                // หากไม่มีข้อมูลที่ตรงเงื่อนไขเลยให้ซ่อนแถบ Pagination ด้านล่าง
                if (filteredRows.length === 0) {
                    if (footer) footer.style.setProperty('display', 'none', 'important');
                    return;
                } else {
                    if (footer) footer.style.setProperty('display', 'flex', 'important');
                }

                var totalPages = Math.ceil(filteredRows.length / itemsPerPage);
                if (currentPage > totalPages) currentPage = 1;

                // ซ่อน/แสดงแถวข้อมูลตามเงื่อนไขหน้าปัจจุบัน
                var startIdx = (currentPage - 1) * itemsPerPage;
                var endIdx = startIdx + itemsPerPage;

                filteredRows.forEach(function(row, idx) {
                    if (idx >= startIdx && idx < endIdx) {
                        row.style.setProperty('display', '', 'important'); // แสดงแถวที่อยู่ในช่วงหน้า
                    } else {
                        row.style.setProperty('display', 'none', 'important'); // ซ่อนแถวที่อยู่นอกช่วงหน้า
                    }
                });

                // อัปเดตตัวเลขรายละเอียดการแสดงผลด้านซ้ายของ Footer
                document.getElementById('paginationInfoStart').textContent = startIdx + 1;
                document.getElementById('paginationInfoEnd').textContent = Math.min(endIdx, filteredRows.length);
                document.getElementById('paginationInfoTotal').textContent = filteredRows.length;

                // วาดปุ่มนำทาง (Previous, ตัวเลข, Next) ลงในเมนูสลับหน้า
                renderPaginationButtons(totalPages);
            }

            function renderPaginationButtons(totalPages) {
                if (!paginationBtns) return;
                paginationBtns.innerHTML = '';

                // สร้างปุ่มย้อนกลับ (Previous)
                var prevLi = document.createElement('li');
                prevLi.className = 'page-item ' + (currentPage === 1 ? 'disabled' : '');
                prevLi.innerHTML = '<button class="manager-btn manager-btn-ghost manager-btn-sm py-1 px-2" type="button" aria-label="หน้าก่อนหน้า"><i class="fa-solid fa-angle-left"></i></button>';
                if (currentPage !== 1) {
                    prevLi.querySelector('button').addEventListener('click', function() {
                        currentPage--;
                        initPagination();
                    });
                }
                paginationBtns.appendChild(prevLi);

                // สร้างปุ่มหมายเลขหน้าแบบเรียงลำดับ
                for (var i = 1; i <= totalPages; i++) {
                    (function(pageIndex) {
                        var pageLi = document.createElement('li');
                        pageLi.className = 'page-item';
                        var activeClass = currentPage === pageIndex ? 'manager-btn-primary' : 'manager-btn-ghost';
                        pageLi.innerHTML = '<button class="manager-btn ' + activeClass + ' manager-btn-sm py-1 px-2" type="button" style="min-width: 32px;">' + pageIndex + '</button>';
                        
                        pageLi.querySelector('button').addEventListener('click', function() {
                            currentPage = pageIndex;
                            initPagination();
                        });
                        paginationBtns.appendChild(pageLi);
                    })(i);
                }

                // สร้างปุ่มถัดไป (Next)
                var nextLi = document.createElement('li');
                nextLi.className = 'page-item ' + (currentPage === totalPages ? 'disabled' : '');
                nextLi.innerHTML = '<button class="manager-btn manager-btn-ghost manager-btn-sm py-1 px-2" type="button" aria-label="หน้าถัดไป"><i class="fa-solid fa-angle-right"></i></button>';
                if (currentPage !== totalPages) {
                    nextLi.querySelector('button').addEventListener('click', function() {
                        currentPage++;
                        initPagination();
                    });
                }
                paginationBtns.appendChild(nextLi);
            }

            // รันระบบสลับหน้าทันทีเมื่อเปิดหน้าจอ
            initPagination();

            // เชื่อมโยงตัวสลับหน้าเข้ากับฟอร์มค้นหาและตัวกรองของเดิมในระบบ
            var filterForm = document.querySelector('[data-manager-autosubmit]');
            var searchBox = document.querySelector('[data-manager-search]');
            
            if (filterForm) {
                filterForm.addEventListener('change', function() {
                    currentPage = 1;
                    setTimeout(initPagination, 150); // รอระบบกรองเดิมประมวลผล d-none เสร็จแล้วอัปเดตหน้าทันที
                });
            }
            if (searchBox) {
                searchBox.addEventListener('input', function() {
                    currentPage = 1;
                    setTimeout(initPagination, 150);
                });
            }

            // =================================================================
            // 2. ระบบตรวจสอบป้องกันความขัดแย้งของช่วงวันที่ (Date Validation)
            // =================================================================
            var periodForm = document.getElementById('savePricePeriodForm');
            var startInput = document.getElementById('periodModalStartDate');
            var endInput = document.getElementById('periodModalEndDate');
            var errorAlert = document.getElementById('periodDateErrorAlert');

            function validatePeriodDates() {
                if (!startInput || !endInput) return true;
                if (startInput.value && endInput.value) {
                    endInput.min = startInput.value;
                    if (endInput.value < startInput.value) {
                        if (errorAlert) errorAlert.classList.remove('d-none');
                        return false;
                    }
                }
                if (errorAlert) errorAlert.classList.add('d-none');
                return true;
            }

            if (startInput && endInput) {
                startInput.addEventListener('change', validatePeriodDates);
                endInput.addEventListener('change', validatePeriodDates);
            }

            if (periodForm) {
                // ตรวจสอบและหยุด Event การบันทึกทันทีหากเลือกช่วงวันที่ขัดแย้งกัน
                periodForm.addEventListener('submit', function (e) {
                    if (!validatePeriodDates()) {
                        e.preventDefault();
                        e.stopImmediatePropagation();
                    }
                }, true);
            }
        })();
    </script>
}
