<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StayMate Housekeeping</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/staymate-layout.css" asp-append-version="true" />
</head>
<body class="staff-page">

    <header class="staff-header">
        <div class="brand-group">
            <a asp-controller="Housekeeping" asp-action="Index" class="brand-group text-decoration-none">
                <img src="~/images/Logo/LogoStayMate.jpg" 
                     alt="StayMate Logo" 
                     class="brand-logo-img" 
                     onerror="this.onerror=null; this.src='https://placehold.co/76x76/070D1E/00E5FF?text=SM';" />
                <span class="brand-text">StayMate</span>
            </a>
            <span class="staff-portal-badge ms-2">
                <i class="fa-solid fa-broom text-info"></i> Housekeeping Portal
            </span>
        </div>

        <div class="header-actions">
            <!-- ปุ่มแจ้งเตือน (วงสีเหลือง) -->
            <div class="notification-btn-wrapper">
                <button type="button" class="btn-header-notification" title="งานทำความสะอาดด่วนใหม่">
                    <i class="fa-regular fa-bell"></i>
                    <span class="notification-pulse-dot"></span>
                </button>
            </div>

            <div class="user-badge-chip">
                <i class="fa-solid fa-hands-bubbles text-warning"></i>
                <span>@(User.Identity?.Name ?? "Housekeeper")</span>
            </div>

            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                <button type="submit" class="btn-header-logout">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i> ออกจากระบบ
                </button>
            </form>
        </div>
    </header>

    <div class="staff-container">
        <aside class="staff-sidebar">
            <div class="sidebar-category-title">CLEANING MANAGEMENT</div>
            <nav>
                <!-- ครบ 4 เมนูตาม SRS ข้อ 5 -->
                <a asp-controller="Housekeeping" asp-action="Index">
                    <i class="fa-solid fa-table-cells-large"></i> กระดานรวม (Board)
                </a>
                <a asp-controller="Housekeeping" asp-action="Tasks">
                    <i class="fa-solid fa-list-check text-warning"></i> รายการห้องที่มอบหมาย
                </a>
                <a asp-controller="Housekeeping" asp-action="TaskDetails">
                    <i class="fa-solid fa-clipboard-question text-info"></i> รายละเอียดงานรายห้อง
                </a>
                <a asp-controller="Housekeeping" asp-action="RoomStatus">
                    <i class="fa-solid fa-circle-check text-success"></i>  อัปเดตสถานะห้องพัก
                </a>
            </nav>

           
        </aside>

        <main class="staff-content">
            @RenderBody()
        </main>
    </div>

    <footer class="staff-footer">
        <span>© 2026 StayMate Housekeeping Board</span>
        <span>Fast Touch Friendly PMS</span>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
