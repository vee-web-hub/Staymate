
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - StayMate Executive</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/staymate-layout.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/owner.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="staff-page owner-page">

<header class="staff-header owner-header">

    <div class="brand-group">

        <a asp-controller="Owner"
           asp-action="Index"
           class="brand-group text-decoration-none">

            <img src="~/images/Logo/LogoStayMate.jpg"
                 alt="StayMate Logo"
                 class="brand-logo-img" />

            <span class="brand-text">StayMate</span>
        </a>

        <span class="staff-portal-badge owner-portal-badge">
            <i class="fa-solid fa-crown text-warning"></i>
            Executive Dashboard
        </span>

    </div>

    <div class="header-actions">

        <div class="notification-btn-wrapper">
            <button type="button"
                    class="btn-header-notification"
                    title="รายงานผลประกอบการประจำวัน">

                <i class="fa-regular fa-bell"></i>
                <span class="notification-pulse-dot"></span>

            </button>
        </div>

        <a asp-controller="Owner"
           asp-action="Profile"
           class="user-badge-chip text-decoration-none">

            <i class="fa-solid fa-gem text-warning"></i>

            <span>
                @(User.Identity?.Name ?? "Owner")
            </span>

            
        </a>

        <form asp-controller="Account"
              asp-action="Logout"
              method="post"
              class="d-inline m-0">

            @Html.AntiForgeryToken()

            <button type="submit" class="btn-header-logout">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                ออกจากระบบ
            </button>

        </form>

    </div>

</header>

<div class="staff-container">

    <aside class="staff-sidebar">

        <div class="sidebar-category-title">
            EXECUTIVE INTELLIGENCE
        </div>

        <nav>

            <a asp-controller="Owner"
               asp-action="Index"
               class="@(currentAction == "Index" ? "active" : "")">

                <i class="fa-solid fa-chart-line"></i>
                แดชบอร์ดผู้บริหาร
            </a>

            <a asp-controller="Owner"
               asp-action="FinancialOverview"
               class="@(currentAction == "FinancialOverview" ? "active" : "")">

                <i class="fa-solid fa-sack-dollar"></i>
                สรุปรายรับ-ต้นทุน
            </a>

            <a asp-controller="Owner"
               asp-action="PerformanceReports"
               class="@(currentAction == "PerformanceReports" ? "active" : "")">

                <i class="fa-solid fa-scale-balanced"></i>
                วิเคราะห์ผลประกอบการ
            </a>

            <a asp-controller="Owner"
               asp-action="StaffOverview"
               class="@(currentAction == "StaffOverview" ? "active" : "")">

                <i class="fa-solid fa-id-card-clip"></i>
                สรุปภาพรวมพนักงาน
            </a>

        </nav>

        <div class="sidebar-category-title mt-4">
            ACCOUNT
        </div>

        <nav>
            <a asp-controller="Owner"
               asp-action="Profile"
               class="@(currentAction == "Profile" ? "active" : "")">

                <i class="fa-solid fa-user-circle"></i>
                โปรไฟล์ของฉัน
            </a>
        </nav>

        

    </aside>

    <main class="staff-content">

        <div class="readonly-notice">
            <i class="fa-solid fa-lock text-primary fs-5"></i>

            <div>
                <strong>Executive Read-Only View:</strong>
                หน้านี้สำหรับแสดงผลตัวชี้วัดทางการเงิน
                และสถิติภาพรวม ไม่สามารถแก้ไขหรือบันทึกข้อมูลธุรกรรมได้
            </div>
        </div>

        @RenderBody()

    </main>

</div>

<footer class="staff-footer">
    <span>© 2026 StayMate Hotel Booking System</span>
    <span>Executive Command Space · Highly Confidential</span>
</footer>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/Owner/Owner.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
