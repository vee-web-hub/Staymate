
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StayMate</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/staymate-layout.css" asp-append-version="true" />
</head>
<body class="customer-page">
    <header class="customer-header">
        <a class="customer-logo" asp-controller="Home" asp-action="Index">
            🏨 StayMate
        </a>

        <nav class="customer-navbar">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Customer" asp-action="Index">Rooms</a>
            <a asp-controller="Customer" asp-action="Index">Promotions</a>
            <a asp-controller="Customer" asp-action="Index">My Booking</a>
            <a asp-controller="Home" asp-action="Index">Contact</a>
        </nav>

        <div class="customer-profile">👤 Customer</div>
    </header>

    <main class="customer-content container">
        @RenderBody()
    </main>

    <footer class="customer-footer">
        <div><strong>🏨 StayMate</strong><p>Hotel Booking System</p></div>
        <div><strong>Quick Links</strong><p>Rooms · Promotions · Booking</p></div>
        <div><strong>Contact</strong><p>02-xxx-xxxx</p></div>
        <div><strong>Copyright</strong><p>© 2569 StayMate</p></div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
