
@{
    ViewData["Title"] ??= "Customer";

    // ตรวจสอบ Action ปัจจุบัน
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool Is(params string[] names) =>
        names.Any(n => string.Equals(n, action, StringComparison.OrdinalIgnoreCase));

    string Act(params string[] names) =>
        Is(names) ? "active" : "";

    const string C = "Customer";
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - StayMate Hotel</title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Font Awesome 6.5.1 -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Global CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- StayMate Layout CSS -->
    <link rel="stylesheet"
          href="~/css/staymate-layout.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="customer-page">

    <!-- =========================================
         HEADER
    ========================================== -->
    <header class="customer-header" id="siteHeader">

        <!-- BRAND -->
        <div class="brand-group">

            <!-- Mobile Menu Button -->
            <button class="btn-header-menu d-xl-none"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#mobileMenu"
                    aria-controls="mobileMenu"
                    aria-label="เปิดเมนู">

                <i class="fa-solid fa-bars"></i>
            </button>

            <!-- Logo -->
            <a asp-controller="@C"
               asp-action="Index"
               class="brand-group text-decoration-none">

                <img src="~/images/Logo/LogoStayMate.jpg"
                     alt="StayMate Logo"
                     class="brand-logo-img"
                     onerror="this.onerror=null; this.src='https://placehold.co/76x76/070D1E/00E5FF?text=SM';" />

                <span class="brand-text">StayMate</span>

            </a>
        </div>


        <!-- =====================================
             DESKTOP NAVIGATION
        ====================================== -->
        <nav class="customer-navbar d-none d-xl-flex"
             aria-label="เมนูหลัก">

            <!-- 1. Home -->
            <a asp-controller="@C"
               asp-action="Index"
               class="@Act("Index")"
               aria-current="@(Is("Index") ? "page" : null)">

                <i class="fa-solid fa-house me-1"></i>
                หน้าแรก
            </a>

            <!-- 2. Room Availability -->
            <a asp-controller="@C"
               asp-action="RoomAvailability"
               class="@Act("RoomAvailability")"
               aria-current="@(Is("RoomAvailability") ? "page" : null)">

                <i class="fa-solid fa-magnifying-glass me-1"></i>
                ค้นหาห้องว่าง
            </a>

            <!-- 3. Rooms -->
            <a asp-controller="@C"
               asp-action="Rooms"
               class="@Act("Rooms", "RoomDetails")"
               aria-current="@(Is("Rooms", "RoomDetails") ? "page" : null)">

                <i class="fa-solid fa-bed me-1"></i>
                ห้องพัก
            </a>

            <!-- 4. Promotions -->
            <a asp-controller="@C"
               asp-action="Promotions"
               class="@Act("Promotions")"
               aria-current="@(Is("Promotions") ? "page" : null)">

                <i class="fa-solid fa-tags me-1"></i>
                โปรโมชั่น
            </a>

            <!-- 5. My Bookings -->
            <a asp-controller="@C"
               asp-action="MyBookings"
               class="@Act("MyBookings", "BookingDetails")"
               aria-current="@(Is("MyBookings", "BookingDetails") ? "page" : null)">

                <i class="fa-solid fa-receipt me-1"></i>
                การจองของฉัน
            </a>

            <!-- 6. Profile -->
            <a asp-controller="@C"
               asp-action="Profile"
               class="@Act("Profile")"
               aria-current="@(Is("Profile") ? "page" : null)">

                <i class="fa-solid fa-user me-1"></i>
                โปรไฟล์
            </a>

            <!-- 7. Reviews -->
            <a asp-controller="@C"
               asp-action="Reviews"
               class="@Act("Reviews")"
               aria-current="@(Is("Reviews") ? "page" : null)">

                <i class="fa-solid fa-star me-1"></i>
                รีวิว
            </a>

        </nav>


        <!-- =====================================
             HEADER ACTIONS
        ====================================== -->
        <div class="header-actions">

            @if (User.Identity?.IsAuthenticated == true)
            {
                <!-- User Profile -->
                <a asp-controller="@C"
                   asp-action="Profile"
                   class="user-badge-chip text-decoration-none"
                   title="ข้อมูลโปรไฟล์">

                    <i class="fa-regular fa-circle-user text-info"></i>

                    <span>
                        @User.Identity.Name
                    </span>
                </a>

                <!-- Logout -->
                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="d-inline m-0">

                    <button type="submit"
                            class="btn-header-logout">

                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        ออกจากระบบ

                    </button>

                </form>
            }
            else
            {
                <!-- Login -->
                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-sm btn-outline-light rounded-pill px-3">

                    <i class="fa-regular fa-user me-1"></i>
                    เข้าสู่ระบบ

                </a>
            }

        </div>

    </header>


    <!-- =========================================
         MOBILE OFFCANVAS MENU
    ========================================== -->
    <div class="offcanvas offcanvas-start sm-offcanvas"
         tabindex="-1"
         id="mobileMenu"
         aria-labelledby="mobileMenuLabel">

        <!-- Mobile Header -->
        <div class="offcanvas-header">

            <span class="brand-text" id="mobileMenuLabel">
                StayMate
            </span>

            <button type="button"
                    class="btn-close btn-close-white"
                    data-bs-dismiss="offcanvas"
                    aria-label="ปิดเมนู">
            </button>

        </div>


        <!-- Mobile Body -->
        <div class="offcanvas-body">

            <nav class="sm-mobile-nav"
                 aria-label="เมนูสำหรับมือถือ">

                <!-- 1. Home -->
                <a asp-controller="@C"
                   asp-action="Index"
                   class="@Act("Index")">

                    <i class="fa-solid fa-house"></i>
                    หน้าแรก

                </a>

                <!-- 2. Room Availability -->
                <a asp-controller="@C"
                   asp-action="RoomAvailability"
                   class="@Act("RoomAvailability")">

                    <i class="fa-solid fa-magnifying-glass"></i>
                    ค้นหาห้องว่าง

                </a>

                <!-- 3. Rooms -->
                <a asp-controller="@C"
                   asp-action="Rooms"
                   class="@Act("Rooms", "RoomDetails")">

                    <i class="fa-solid fa-bed"></i>
                    ห้องพัก

                </a>

                <!-- 4. Promotions -->
                <a asp-controller="@C"
                   asp-action="Promotions"
                   class="@Act("Promotions")">

                    <i class="fa-solid fa-tags"></i>
                    โปรโมชั่น

                </a>

                <!-- 5. My Bookings -->
                <a asp-controller="@C"
                   asp-action="MyBookings"
                   class="@Act("MyBookings", "BookingDetails")">

                    <i class="fa-solid fa-receipt"></i>
                    การจองของฉัน

                </a>

                <!-- 6. Profile -->
                <a asp-controller="@C"
                   asp-action="Profile"
                   class="@Act("Profile")">

                    <i class="fa-solid fa-user"></i>
                    โปรไฟล์

                </a>

                <!-- 7. Reviews -->
                <a asp-controller="@C"
                   asp-action="Reviews"
                   class="@Act("Reviews")">

                    <i class="fa-solid fa-star"></i>
                    รีวิว

                </a>

            </nav>


            <!-- MOBILE USER ACTIONS -->
            <div class="sm-mobile-auth">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="@C"
                       asp-action="Profile"
                       class="btn btn-outline-light rounded-pill">

                        <i class="fa-regular fa-user me-1"></i>
                        ข้อมูลส่วนตัว

                    </a>

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">

                        <button type="submit"
                                class="btn-header-logout w-100 justify-content-center">

                            <i class="fa-solid fa-arrow-right-from-bracket"></i>
                            ออกจากระบบ

                        </button>

                    </form>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-outline-light rounded-pill">

                        <i class="fa-solid fa-right-to-bracket me-1"></i>
                        เข้าสู่ระบบ

                    </a>
                }

            </div>

        </div>

    </div>


    <!-- =========================================
         MAIN CONTENT
    ========================================== -->
    <main class="customer-content page-enter">

        @RenderBody()

    </main>


    <!-- =========================================
         FOOTER
    ========================================== -->
    <footer class="customer-footer">

        <div class="customer-footer-grid">

            <!-- ABOUT -->
            <div class="footer-col">

                <h5>
                    <i class="fa-solid fa-hotel me-2"></i>
                    StayMate Hotel
                </h5>

                <p>
                    ระบบจองห้องพัก Futuristic Urban Hotel
                    สัมผัสความสะดวกสบาย ห้องพักคุณภาพ
                    โปรโมชั่นสุดคุ้ม และบริการที่ครบวงจร
                </p>

            </div>


            <!-- CUSTOMER MENU -->
            <div class="footer-col">

                <h5>เมนูสำหรับลูกค้า</h5>

                <ul class="list-unstyled">

                    <li>
                        <a asp-controller="@C" asp-action="Index">
                            หน้าแรก
                        </a>
                    </li>

                    <li>
                        <a asp-controller="@C" asp-action="RoomAvailability">
                            ค้นหาห้องว่าง
                        </a>
                    </li>

                    <li>
                        <a asp-controller="@C" asp-action="Rooms">
                            ประเภทห้องพัก
                        </a>
                    </li>

                    <li>
                        <a asp-controller="@C" asp-action="Promotions">
                            โปรโมชั่นพิเศษ
                        </a>
                    </li>

                </ul>

            </div>


            <!-- BOOKING & ACCOUNT -->
            <div class="footer-col">

                <h5>การจองและบัญชี</h5>

                <ul class="list-unstyled">

                    <li>
                        <a asp-controller="@C" asp-action="MyBookings">
                            การจองของฉัน
                        </a>
                    </li>

                    <li>
                        <a asp-controller="@C" asp-action="Profile">
                            โปรไฟล์ส่วนตัว
                        </a>
                    </li>

                    <li>
                        <a asp-controller="@C" asp-action="Reviews">
                            รีวิวและความคิดเห็น
                        </a>
                    </li>

                </ul>

            </div>


            <!-- CONTACT -->
            <div class="footer-col">

                <h5>ฝ่ายบริการลูกค้า</h5>

                <p>
                    <i class="fa-solid fa-phone me-2 text-warning"></i>
                    02-xxx-xxxx
                </p>

                <p>
                    <i class="fa-solid fa-envelope me-2 text-warning"></i>
                    booking@staymate-hotel.com
                </p>

                <p>
                    <i class="fa-solid fa-clock me-2 text-warning"></i>
                    Customer Support
                </p>

            </div>

        </div>


        <!-- FOOTER BOTTOM -->
        <div class="footer-bottom-bar">

            <span>
                © 2026 StayMate Hotel Booking System
            </span>

            <span>
                <i class="fa-solid fa-shield-halved me-1"></i>
                Secured Smart Booking Engine
            </span>

        </div>

    </footer>


    <!-- =========================================
         JAVASCRIPT
    ========================================== -->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Header shadow when scrolling
        (function () {

            const header = document.getElementById('siteHeader');

            if (!header) return;

            const updateHeader = () => {
                header.classList.toggle(
                    'is-scrolled',
                    window.scrollY > 8
                );
            };

            updateHeader();

            window.addEventListener(
                'scroll',
                updateHeader,
                { passive: true }
            );

        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
