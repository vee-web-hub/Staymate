
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - StayMate Hotel</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/staymate-layout.css" asp-append-version="true" />
</head>

<body class="customer-page">

    <!-- ================= HEADER ================= -->
    <header class="customer-header">

        <!-- Brand -->
        <div class="brand-group">
            <a asp-controller="Home"
               asp-action="Index"
               class="brand-group text-decoration-none">

                <img src="~/images/Logo/LogoStayMate.jpg"
                     alt="StayMate Logo"
                     class="brand-logo-img"
                     onerror="this.onerror=null; this.src='https://placehold.co/76x76/070D1E/00E5FF?text=SM';" />

                <span class="brand-text">StayMate</span>
            </a>
        </div>

        <!-- Main Navigation -->
        <nav class="customer-navbar d-none d-lg-flex">

            <!-- 1. Home -->
            <a asp-controller="Home"
               asp-action="Index">
                <i class="fa-solid fa-house me-1"></i>
                หน้าแรก
            </a>

            <!-- 2. Room Availability -->
            <a asp-controller="Customer"
               asp-action="RoomAvailability">
                <i class="fa-solid fa-magnifying-glass me-1"></i>
                ค้นหาห้องว่าง
            </a>

            <!-- 3. Rooms / Room Details -->
            <a asp-controller="Customer"
               asp-action="Rooms">
                <i class="fa-solid fa-bed me-1"></i>
                ห้องพัก
            </a>

            <!-- 4. Promotions -->
            <a asp-controller="Customer"
               asp-action="Promotions">
                <i class="fa-solid fa-tags me-1"></i>
                โปรโมชั่น
            </a>

            <!-- 5. Checkout & Payment -->
            <a asp-controller="Customer"
               asp-action="Checkout">
                <i class="fa-solid fa-credit-card me-1"></i>
                ชำระเงิน
            </a>

            <!-- 6. My Bookings / Booking Details -->
            <a asp-controller="Customer"
               asp-action="MyBookings">
                <i class="fa-solid fa-receipt me-1"></i>
                การจองของฉัน
            </a>

            <!-- 7. Profile -->
            <a asp-controller="Customer"
               asp-action="Profile">
                <i class="fa-solid fa-user me-1"></i>
                โปรไฟล์
            </a>

            <!-- 8. Review & Feedback -->
            <a asp-controller="Customer"
               asp-action="Reviews">
                <i class="fa-solid fa-star me-1"></i>
                รีวิว
            </a>

        </nav>

        <!-- Header Actions -->
        <div class="header-actions">

            <!-- Notification -->
            <div class="notification-btn-wrapper">
                <button type="button"
                        class="btn-header-notification"
                        title="การแจ้งเตือน"
                        aria-label="การแจ้งเตือน">

                    <i class="fa-regular fa-bell"></i>
                    <span class="notification-pulse-dot"></span>
                </button>
            </div>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <!-- User Profile -->
                <a asp-controller="Customer"
                   asp-action="Profile"
                   class="user-badge-chip text-decoration-none"
                   title="ข้อมูลโปรไฟล์">

                    <i class="fa-regular fa-circle-user text-info"></i>
                    <span>@User.Identity.Name</span>
                </a>

                <!-- Logout -->
                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="d-inline m-0">

                    <button type="submit" class="btn-header-logout">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        ออกจากระบบ
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-sm btn-outline-light rounded-pill px-3">

                    <i class="fa-regular fa-user"></i>
                    เข้าสู่ระบบ
                </a>
            }

        </div>
    </header>


    <!-- ================= MAIN CONTENT ================= -->
    <main class="customer-content">
        @RenderBody()
    </main>


    <!-- ================= FOOTER ================= -->
    <footer class="customer-footer">

        <div class="customer-footer-grid">

            <!-- About -->
            <div class="footer-col">
                <h5>
                    <i class="fa-solid fa-hotel me-2"></i>
                    StayMate Hotel
                </h5>

                <p>
                    ระบบจองห้องพัก Future Urban Hotel
                    สัมผัสความสะดวกสบาย โปรโมชั่นสุดคุ้ม
                    และระบบจัดการห้องพักแบบครบวงจร
                </p>
            </div>


            <!-- Customer Services -->
            <div class="footer-col">
                <h5>เมนูสำหรับลูกค้า</h5>

                <ul class="list-unstyled">

                    <li>
                        <a asp-controller="Home" asp-action="Index">
                            <i class="fa-solid fa-house me-2"></i>
                            หน้าแรก
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Customer" asp-action="RoomAvailability">
                            <i class="fa-solid fa-magnifying-glass me-2"></i>
                            ค้นหาห้องว่าง
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Customer" asp-action="Rooms">
                            <i class="fa-solid fa-bed me-2"></i>
                            ประเภทห้องพัก
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Customer" asp-action="Promotions">
                            <i class="fa-solid fa-tags me-2"></i>
                            โปรโมชั่น
                        </a>
                    </li>

                </ul>
            </div>


            <!-- Booking Management -->
            <div class="footer-col">
                <h5>การจองและบัญชี</h5>

                <ul class="list-unstyled">

                    <li>
                        <a asp-controller="Customer" asp-action="Checkout">
                            <i class="fa-solid fa-credit-card me-2"></i>
                            จองและชำระเงิน
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Customer" asp-action="MyBookings">
                            <i class="fa-solid fa-receipt me-2"></i>
                            การจองของฉัน
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Customer" asp-action="Profile">
                            <i class="fa-solid fa-user me-2"></i>
                            โปรไฟล์ส่วนตัว
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Customer" asp-action="Reviews">
                            <i class="fa-solid fa-star me-2"></i>
                            รีวิวและความคิดเห็น
                        </a>
                    </li>

                </ul>
            </div>


            <!-- Contact -->
            <div class="footer-col">
                <h5>ฝ่ายบริการลูกค้า</h5>

                <p>
                    <i class="fa-solid fa-phone me-2 text-warning"></i>
                    02-xxx-xxxx
                </p>

                <p>
                    <i class="fa-solid fa-envelope me-2 text-warning"></i>
                    booking@staymate-hotel.com
                </p>

                <p>
                    <i class="fa-solid fa-clock me-2 text-warning"></i>
                    Customer Support
                </p>
            </div>

        </div>


        <!-- Footer Bottom -->
        <div class="footer-bottom-bar">

            <span>
                © 2026 StayMate Hotel Booking System
            </span>

            <span>
                <i class="fa-solid fa-shield-halved me-1"></i>
                Secured Smart Booking Engine
            </span>

        </div>

    </footer>


    <!-- ================= SCRIPTS ================= -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
