
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StayMate Finance</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/staymate-layout.css" asp-append-version="true" />
</head>
<body class="staff-page">
    <header class="staff-header">
        <a class="staff-logo" asp-controller="Home" asp-action="Index">🏨 StayMate</a>
        <span class="staff-portal-name">Finance Portal</span>
        <span class="staff-profile">💳 Finance Officer</span>
    </header>

    <div class="staff-container">
        <aside class="staff-sidebar">
            <div class="sidebar-role">FINANCE</div>
            <nav>
                <a asp-controller="Finance" asp-action="Index">📊 Dashboard</a>
                <a asp-controller="Finance" asp-action="Index">💳 Payment Review</a>
                <a asp-controller="Finance" asp-action="Index">🧾 Receipts</a>
                <a asp-controller="Finance" asp-action="Index">💰 Income & Expenses</a>
                <a asp-controller="Finance" asp-action="Index">📑 Financial Reports</a>
            </nav>
            <div class="sidebar-bottom">
                <a asp-controller="Home" asp-action="Index">↪ Back to Home</a>
            </div>
        </aside>

        <main class="staff-content">@RenderBody()</main>
    </div>

    <footer class="staff-footer">
        <span>© 2569 StayMate</span>
        <span>Finance Portal · Confidential</span>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
