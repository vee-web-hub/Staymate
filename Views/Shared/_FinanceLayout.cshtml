<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StayMate Finance</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/staymate-layout.css" asp-append-version="true" />
</head>
<body class="staff-page">

    <header class="staff-header">
        <div class="brand-group">
            <a asp-controller="Finance" asp-action="Index" class="brand-group text-decoration-none">
                <img src="~/images/Logo/LogoStayMate.jpg" 
                     alt="StayMate Logo" 
                     class="brand-logo-img" 
                     onerror="this.onerror=null; this.src='https://placehold.co/76x76/070D1E/00E5FF?text=SM';" />
                <span class="brand-text">StayMate</span>
            </a>
            <span class="staff-portal-badge ms-2">
                <i class="fa-solid fa-wallet text-success"></i> Finance Portal
            </span>
        </div>

        <div class="header-actions">
            <!-- ปุ่มแจ้งเตือน (วงสีเหลือง) -->
            <div class="notification-btn-wrapper">
                <button type="button" class="btn-header-notification" title="สลิปรอตรวจสอบใหม่">
                    <i class="fa-regular fa-bell"></i>
                    <span class="notification-pulse-dot"></span>
                </button>
            </div>

            <div class="user-badge-chip">
                <i class="fa-solid fa-user-shield text-info"></i>
                <span>@(User.Identity?.Name ?? "Finance Officer")</span>
            </div>

            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                <button type="submit" class="btn-header-logout">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i> ออกจากระบบ
                </button>
            </form>
        </div>
    </header>

    <div class="staff-container">
        <aside class="staff-sidebar">
            <div class="sidebar-category-title">FINANCIAL AUDIT</div>
            <nav>
                <!-- ครบ 5 เมนูตาม SRS ข้อ 4 -->
                <a asp-controller="Finance" asp-action="Index">
                    <i class="fa-solid fa-gauge-high"></i> แดชบอร์ดการเงิน
                </a>
                <a asp-controller="Finance" asp-action="PaymentApproval">
                    <i class="fa-solid fa-file-invoice-dollar text-primary"></i> อนุมัติสลิปโอนเงิน
                </a>
                <a asp-controller="Finance" asp-action="Transactions">
                    <i class="fa-solid fa-clock-rotate-left"></i> ประวัติธุรกรรมทั้งหมด
                </a>
                <a asp-controller="Finance" asp-action="Receipts">
                    <i class="fa-solid fa-receipt text-warning"></i>  จัดการใบเสร็จรับเงิน
                </a>
                <a asp-controller="Finance" asp-action="Reports">
                    <i class="fa-solid fa-chart-pie text-success"></i> รายงานรายรับ-รายจ่าย
                </a>
            </nav>

           
        </aside>

        <main class="staff-content">
            @RenderBody()
        </main>
    </div>

    <footer class="staff-footer">
        <span>© 2026 StayMate Hotel Booking System</span>
        <span>Corporate FinTech Dashboard · Confidential</span>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
