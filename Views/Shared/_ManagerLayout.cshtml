
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - StayMate Manager</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/staymate-layout.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/Manager.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="staff-page manager-page">

<header class="staff-header manager-header">

    <div class="brand-group">

        <a asp-controller="Manager"
           asp-action="Index"
           class="brand-group text-decoration-none">

            <img src="~/images/Logo/LogoStayMate.jpg"
                 alt="StayMate Logo"
                 class="brand-logo-img" />

            <span class="brand-text">StayMate</span>
        </a>

        <span class="staff-portal-badge manager-portal-badge">
            <i class="fa-solid fa-user-gear text-info"></i>
            Hotel Manager Portal
        </span>

    </div>

    <div class="header-actions">

        <div class="notification-btn-wrapper">
            <button type="button"
                    class="btn-header-notification"
                    title="การแจ้งเตือนระดับบริหาร">

                <i class="fa-regular fa-bell"></i>
                <span class="notification-pulse-dot"></span>

            </button>
        </div>

        <a asp-controller="Manager"
           asp-action="Profile"
           class="user-badge-chip text-decoration-none">

            <i class="fa-solid fa-briefcase text-warning"></i>

            <span>
                @(User.Identity?.Name ?? "Hotel Manager")
            </span>

        </a>

        <form asp-controller="Account"
              asp-action="Logout"
              method="post"
              class="d-inline m-0">

            @Html.AntiForgeryToken()

            <button type="submit" class="btn-header-logout">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                ออกจากระบบ
            </button>

        </form>

    </div>

</header>

<div class="staff-container">

    <aside class="staff-sidebar">

        <div class="sidebar-category-title">
            OPERATIONS CONTROL
        </div>

        <nav>

            <a asp-controller="Manager"
               asp-action="Index"
               class="@(currentAction == "Index" ? "active" : "")">

                <i class="fa-solid fa-chart-pie"></i>
                ภาพรวมการดำเนินงาน
            </a>

            <a asp-controller="Manager"
               asp-action="RoomManagement"
               class="@(currentAction == "RoomManagement" ? "active" : "")">

                <i class="fa-solid fa-hotel"></i>
                จัดการห้องพักและราคา
            </a>

            <a asp-controller="Manager"
               asp-action="PromotionManagement"
               class="@(currentAction == "PromotionManagement" ? "active" : "")">

                <i class="fa-solid fa-gift"></i>
                จัดการโปรโมชั่น
            </a>

            <a asp-controller="Manager"
               asp-action="ReviewManagement"
               class="@(currentAction == "ReviewManagement" ? "active" : "")">

                <i class="fa-solid fa-star"></i>
                จัดการรีวิว Feedback
            </a>

            <a asp-controller="Manager"
               asp-action="StaffManagement"
               class="@(currentAction == "StaffManagement" ? "active" : "")">

                <i class="fa-solid fa-users"></i>
                จัดการบัญชีพนักงาน
            </a>

        </nav>

        <div class="sidebar-category-title mt-4">
            ACCOUNT
        </div>

        <nav>

            <a asp-controller="Manager"
               asp-action="Profile"
               class="@(currentAction == "Profile" ? "active" : "")">

                <i class="fa-solid fa-user-circle"></i>
                โปรไฟล์ของฉัน
            </a>

        </nav>

    </aside>

    <main class="staff-content">

        @RenderBody()

    </main>

</div>

<footer class="staff-footer">
    <span>© 2026 StayMate Hotel Management</span>
    <span>Hotel Operations & Management Portal</span>
</footer>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/manager/manager.js"
        asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
