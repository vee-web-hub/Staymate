@{
    var hotel = (ViewBag.Hotel as StayMate_Kavinvee_0576.Models.HotelSetting) ?? StayMate_Kavinvee_0576.Models.HotelSetting.Default();
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
    ViewData["Title"] = "ติดต่อเรา";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />
    <link rel="stylesheet" href="~/css/Home.css" asp-append-version="true" />
}

<div class="sm-home-wrapper">

    <!-- =========================================================
         1. PAGE HERO BANNER (Contact Us)
         ========================================================= -->
    <section class="sm-subpage-hero sm-full-bleed">
        <div class="sm-subpage-hero-bg"
             style="background-image: url('https://images.unsplash.com/photo-1551882547-ff40c63fe5fa?auto=format&fit=crop&w=2000&q=85');">
        </div>
        <div class="sm-hero-overlay"></div>
        <div class="sm-hero-glow-orb sm-orb-cyan"></div>

        <div class="container position-relative z-2 py-4">
            <nav aria-label="breadcrumb" class="mb-3" data-aos="fade-down">
                <ol class="breadcrumb sm-breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house me-1"></i>หน้าแรก</a></li>
                    <li class="breadcrumb-item active" aria-current="page">ติดต่อเรา</li>
                </ol>
            </nav>

            <div class="row align-items-end g-4">
                <div class="col-lg-12" data-aos="fade-up">
                    <div class="sm-hero-badge mb-2">
                        <span class="sm-badge-pulse"></span>
                        <span>24/7 DIGITAL CONCIERGE &amp; SUPPORT</span>
                    </div>
                    <h1 class="sm-subpage-title text-white">
                        Contact StayMate<br />
                        <span class="sm-text-gradient">เราพร้อมดูแลและให้คำปรึกษาตลอด 24 ชั่วโมง</span>
                    </h1>
                    <p class="text-light opacity-75 mb-0" style="max-width: 620px;">
                        สอบถามข้อมูลห้องพัก เงื่อนไขโปรโมชั่น การจัดเลี้ยง หรือการเดินทาง ทีมงานฝ่ายบริการลูกค้าของ StayMate พร้อมตอบกลับอย่างรวดเร็วในทุกช่องทาง
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- =========================================================
         2. QUICK CONTACT INFO CARDS (4 ช่องทางติดต่อหลัก)
         ========================================================= -->
    <section class="sm-section pb-3">
        <div class="container">
            <div class="row g-4">
                <div class="col-sm-6 col-lg-3" data-aos="fade-up" data-aos-delay="50">
                    <div class="sm-contact-info-card h-100">
                        <div class="sm-contact-icon"><i class="fa-solid fa-phone-volume"></i></div>
                        <h5>โทรศัพท์สายตรง</h5>
                        <p class="text-secondary small mb-2">แผนกสำรองห้องพักและต้อนรับ (24 ชม.)</p>
                        <strong class="text-primary fs-5">@hotel.Phone</strong>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-3" data-aos="fade-up" data-aos-delay="110">
                    <div class="sm-contact-info-card h-100">
                        <div class="sm-contact-icon"><i class="fa-solid fa-envelope-open-text"></i></div>
                        <h5>อีเมลติดต่อ</h5>
                        <p class="text-secondary small mb-2">ตอบกลับภายใน 1–2 ชั่วโมงทำการ</p>
                        <strong class="text-primary">@hotel.Email</strong>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-3" data-aos="fade-up" data-aos-delay="170">
                    <div class="sm-contact-info-card h-100">
                        <div class="sm-contact-icon"><i class="fa-brands fa-line"></i></div>
                        <h5>LINE Official Chat</h5>
                        <p class="text-secondary small mb-2">แชทสอบถามด่วนและรับคูปองพิเศษ</p>
                        <strong class="text-success">&#64;StayMateHotel</strong>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-3" data-aos="fade-up" data-aos-delay="230">
                    <div class="sm-contact-info-card h-100">
                        <div class="sm-contact-icon"><i class="fa-solid fa-location-dot"></i></div>
                        <h5>ที่ตั้งโรงแรม</h5>
                        <p class="text-secondary small mb-2">@hotel.Address</p>
                        <small class="d-block text-secondary">เช็คอิน @hotel.CheckInTime.ToString("HH:mm") · เช็คเอาท์ @hotel.CheckOutTime.ToString("HH:mm")</small>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- =========================================================
         3. LOCATION MAP & SMART TRANSIT GUIDE (ขยายกว้างเต็มพื้นที่แทนฟอร์มที่ถูกลบ)
         ========================================================= -->
    <section class="sm-section pt-4">
        <div class="container">
            <div class="row g-4" data-aos="fade-up">
                <div class="col-lg-12">
                    <div class="sm-detail-card">
                        <span class="sm-eyebrow"><i class="fa-solid fa-map-location-dot me-1"></i> LOCATION &amp; TRANSIT GUIDE</span>
                        <h3 class="sm-section-title mt-1 mb-4">แผนที่และการเดินทางมายัง StayMate</h3>

                        <div class="row g-4 align-items-center">
                            <!-- แผนที่ Google Map ฝั่งซ้าย -->
                            <div class="col-lg-6">
                                <div class="sm-map-frame">
                                    <iframe title="แผนที่โรงแรม StayMate"
                                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3875.640998170251!2d100.5580045!3d13.7371511!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x30e29ee109dab6e1%3A0xfd15aa1c632d9677!2sAsok%20BTS%20Station!5e0!3m2!1sen!2sth!4v1700000000000!5m2!1sen!2sth"
                                            width="100%" height="340" style="border:0; border-radius: 12px;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
                                    </iframe>
                                </div>
                            </div>

                            <!-- คำแนะนำเส้นทางฝั่งขวา -->
                            <div class="col-lg-6">
                                <div class="d-grid gap-3">
                                    <div class="sm-transit-item">
                                        <div class="sm-transit-badge bg-success-subtle text-success"><i class="fa-solid fa-train-subway"></i></div>
                                        <div>
                                            <strong class="d-block text-dark">รถไฟฟ้า BTS และ MRT</strong>
                                            <span class="text-secondary small">สถานี BTS อโศก (ทางออก 3) หรือ MRT สุขุมวิท เดินเชื่อม Skywalk เพียง 3 นาทีถึงตัวอาคาร</span>
                                        </div>
                                    </div>

                                    <div class="sm-transit-item">
                                        <div class="sm-transit-badge bg-primary-subtle text-primary"><i class="fa-solid fa-charging-station"></i></div>
                                        <div>
                                            <strong class="d-block text-dark">รถยนต์ส่วนตัว &amp; EV Supercharger</strong>
                                            <span class="text-secondary small">ที่จอดรถในร่มรองรับ 100 คัน ฟรีสำหรับผู้เข้าพัก พร้อมหัวชาร์จรถยนต์ไฟฟ้า DC Fast Charge</span>
                                        </div>
                                    </div>

                                    <div class="sm-transit-item">
                                        <div class="sm-transit-badge bg-info-subtle text-info"><i class="fa-solid fa-plane-arrival"></i></div>
                                        <div>
                                            <strong class="d-block text-dark">จากสนามบินสุวรรณภูมิ (BKK)</strong>
                                            <span class="text-secondary small">เดินทางด้วย Airport Rail Link ลงสถานีมักกะสัน ต่อ MRT เพชรบุรี มาลงสถานีสุขุมวิทเพียง 30 นาที</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </section>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof AOS !== "undefined") {
                AOS.init({ duration: 700, once: true });
            }
        });
    </script>
}
