@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof AOS !== "undefined") {
                AOS.init({ duration: 700, once: true, offset: 50 });
            }

            const filterBtns = document.querySelectorAll(".sm-filter-btn");
            const roomItems = document.querySelectorAll(".sm-room-item");

            filterBtns.forEach(btn => {
                btn.addEventListener("click", function () {
                    filterBtns.forEach(b => b.classList.remove("active"));
                    this.classList.add("active");

                    const filterVal = this.getAttribute("data-filter");
                    roomItems.forEach(item => {
                        const categories = item.getAttribute("data-category") || "";
                        if (filterVal === "all" || categories.includes(filterVal)) {
                            item.classList.remove("d-none");
                        } else {
                            item.classList.add("d-none");
                        }
                    });
                });
            });

            const sortSelect = document.getElementById("roomSortSelect");
            const gridContainer = document.getElementById("roomsGridContainer");

            if (sortSelect && gridContainer) {
                sortSelect.addEventListener("change", function () {
                    const itemsArray = Array.from(roomItems);
                    const mode = this.value;

                    itemsArray.sort((a, b) => {
                        const priceA = parseInt(a.getAttribute("data-price"), 10);
                        const priceB = parseInt(b.getAttribute("data-price"), 10);
                        const sizeA = parseInt(a.getAttribute("data-size"), 10);
                        const sizeB = parseInt(b.getAttribute("data-size"), 10);
                        const orderA = parseInt(a.getAttribute("data-order"), 10);
                        const orderB = parseInt(b.getAttribute("data-order"), 10);

                        if (mode === "price-asc") return priceA - priceB;
                        if (mode === "price-desc") return priceB - priceA;
                        if (mode === "size-desc") return sizeB - sizeA;
                        return orderA - orderB;
                    });

                    itemsArray.forEach(el => gridContainer.appendChild(el));
                });
            }
        });
    </script>
}
