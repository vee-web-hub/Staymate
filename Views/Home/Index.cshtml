@{
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
    ViewData["Title"] = "หน้าแรก";
}

@section Styles {
    <!-- AOS: Scroll Reveal CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />
    <!-- Swiper.js: Carousel CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <!-- StayMate Home Page Specific CSS -->
    <link rel="stylesheet" href="~/css/Home.css" asp-append-version="true" />
}

<div class="sm-home-wrapper">

    <!-- =========================================================
         SECTION 1: QUICK SUB-NAVBAR (ทางลัดอัจฉริยะใต้ Header หลัก)
         ========================================================= -->
    <div class="sm-quick-subnav d-none d-lg-flex" aria-label="ทางลัดภายในหน้าแรก">
        <div class="sm-subnav-inner">
            <span class="sm-subnav-status">
                <span class="sm-live-dot"></span> SMART HOTEL SYSTEM ONLINE
            </span>
            <div class="sm-subnav-links">
                <a href="#bookingSearch"><i class="fa-solid fa-magnifying-glass"></i> ค้นหาห้องว่าง</a>
                <a href="#featuredRooms"><i class="fa-solid fa-bed"></i> ห้องพักแนะนำ</a>
                <a href="#specialPromotions"><i class="fa-solid fa-bolt"></i> โปรโมชั่น (5)</a>
                <a href="#hotelFacilities"><i class="fa-solid fa-microchip"></i> บริการอัจฉริยะ</a>
                <a href="#aboutStayMate"><i class="fa-solid fa-building-shield"></i> รู้จัก StayMate</a>
            </div>
        </div>
    </div>

    <!-- =========================================================
         SECTION 2: HERO SECTION (Full-Width ภาพโรงแรมขนาดใหญ่พร้อมเอฟเฟกต์ซูม)
         ========================================================= -->
    <section class="sm-hero-section sm-full-bleed" id="heroSection">
        <!-- Background Image Layer for GSAP Zoom -->
        <div class="sm-hero-bg" id="heroBgImage"
             style="background-image: url('https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=2000&q=85');">
        </div>
        <!-- Futuristic Mesh & Dark Gradient Overlay -->
        <div class="sm-hero-overlay"></div>
        <div class="sm-hero-glow-orb sm-orb-cyan"></div>
        <div class="sm-hero-glow-orb sm-orb-violet"></div>

        <div class="container position-relative z-2">
            <div class="row align-items-center min-vh-hero py-5">
                <div class="col-lg-8 col-xl-7">
                    <div class="sm-hero-badge gsap-hero-item">
                        <span class="sm-badge-pulse"></span>
                        <span>WELCOME TO STAYMATE · FUTURE URBAN HOTEL</span>
                    </div>

                    <h1 class="sm-hero-title gsap-hero-item">
                        มิติใหม่แห่งการพักผ่อน<br />
                        <span class="sm-text-gradient">โรงแรมอัจฉริยะแห่งอนาคต</span>
                    </h1>

                    <p class="sm-hero-desc gsap-hero-item">
                        สัมผัสประสบการณ์ Boutique Luxury ผสานเทคโนโลยี Smart Hospitality ใจกลางเมือง 
                        เลือกห้องพักที่ตอบโจทย์ทุกไลฟ์สไตล์ พร้อมโปรโมชั่นสุดคุ้มและบริการระดับพรีเมียมตลอด 24 ชั่วโมง
                    </p>

                    <div class="sm-hero-actions gsap-hero-item">
                        <a asp-controller="Home" asp-action="Rooms" class="sm-btn-primary">
                            <span>Explore Rooms</span>
                            <i class="fa-solid fa-arrow-right-long"></i>
                        </a>
                        <a href="#specialPromotions" class="sm-btn-glass">
                            <i class="fa-solid fa-wand-magic-sparkles text-info"></i>
                            <span>ดูโปรโมชั่นพิเศษ</span>
                        </a>
                    </div>

                    <!-- Trust Metrics -->
                    <div class="sm-hero-metrics gsap-hero-item">
                        <div class="sm-metric-item">
                            <span class="sm-metric-val">4.9<small>/5</small></span>
                            <span class="sm-metric-lbl">คะแนนรีวิวผู้เข้าพักจริง</span>
                        </div>
                        <div class="sm-metric-divider"></div>
                        <div class="sm-metric-item">
                            <span class="sm-metric-val">100<small>%</small></span>
                            <span class="sm-metric-lbl">Smart Room Automation</span>
                        </div>
                        <div class="sm-metric-divider"></div>
                        <div class="sm-metric-item">
                            <span class="sm-metric-val">24<small>/7</small></span>
                            <span class="sm-metric-lbl">Digital Concierge Care</span>
                        </div>
                    </div>
                </div>

                <!-- Right Floating Glass Showcase Card (Desktop Only) -->
                <div class="col-lg-4 col-xl-5 d-none d-lg-block">
                    <div class="sm-hero-showcase-card gsap-hero-card">
                        <div class="sm-showcase-header">
                            <div>
                                <span class="sm-showcase-tag">SMART AMBIENCE CONTROL</span>
                                <h4 class="mb-0 text-white fw-bold mt-1">StayMate Horizon Suite</h4>
                            </div>
                            <span class="sm-showcase-icon"><i class="fa-solid fa-wifi"></i></span>
                        </div>
                        <div class="sm-showcase-img-wrap">
                            <img src="https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=900&q=80"
                                 alt="StayMate Luxury Room" class="img-fluid rounded-3" />
                            <span class="sm-showcase-price-pill">เริ่มต้น ฿1,200 / คืน</span>
                        </div>
                        <div class="sm-showcase-specs">
                            <span><i class="fa-solid fa-key text-info"></i> Digital Keyless</span>
                            <span><i class="fa-solid fa-bolt text-warning"></i> High-Speed Wi-Fi 6</span>
                            <span><i class="fa-solid fa-shield-halved text-success"></i> Best Rate</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- =========================================================
         SECTION 3: BOOKING SEARCH BAR (กล่องจองห้องสไตล์ Futuristic Console)
         ========================================================= -->
    <section class="sm-booking-section" id="bookingSearch" data-aos="fade-up" data-aos-duration="700">
        <div class="container">
            <div class="sm-booking-card">
                <div class="sm-booking-top-bar">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-calendar-check text-info"></i>
                        <span class="fw-semibold">SMART BOOKING CONSOLE</span>
                        <span class="sm-booking-badge">Instant Availability Check</span>
                    </div>
                    <span class="sm-booking-hint d-none d-md-inline">
                        <i class="fa-solid fa-circle-info me-1"></i> จองตรงกับโรงแรม รับสิทธิ์ใช้โปรโมชั่นสูงสุด 5 รายการ
                    </span>
                </div>

                <form class="sm-booking-form" id="demoBookingForm" onsubmit="return false;">
                    <div class="row g-3 align-items-end">
                        <!-- Check-in Date -->
                        <div class="col-12 col-md-6 col-lg-3">
                            <label for="checkInDate" class="sm-form-label">
                                <i class="fa-regular fa-calendar-plus text-primary me-1"></i> วันเช็คอิน (Check-in Date)
                            </label>
                            <div class="sm-input-group">
                                <input type="date" id="checkInDate" class="form-control sm-input" required />
                            </div>
                        </div>

                        <!-- Check-out Date -->
                        <div class="col-12 col-md-6 col-lg-3">
                            <label for="checkOutDate" class="sm-form-label">
                                <i class="fa-regular fa-calendar-minus text-primary me-1"></i> วันเช็คเอาท์ (Check-out Date)
                            </label>
                            <div class="sm-input-group">
                                <input type="date" id="checkOutDate" class="form-control sm-input" required />
                            </div>
                        </div>

                        <!-- Guests Count -->
                        <div class="col-12 col-md-6 col-lg-3">
                            <label for="guestCount" class="sm-form-label">
                                <i class="fa-solid fa-user-group text-primary me-1"></i> จำนวนผู้เข้าพัก (Guests)
                            </label>
                            <div class="sm-input-group">
                                <select id="guestCount" class="form-select sm-input">
                                    <option value="1">ผู้ใหญ่ 1 ท่าน (Standard / Deluxe)</option>
                                    <option value="2" selected>ผู้ใหญ่ 2 ท่าน (ยอดนิยม)</option>
                                    <option value="3">ผู้ใหญ่ 3 ท่าน (รองรับเตียงเสริม)</option>
                                    <option value="4">4 ท่าน (Family / Gang Pack)</option>
                                    <option value="5">5–6 ท่าน (Suite / Connecting)</option>
                                </select>
                            </div>
                        </div>

                        <!-- Search Rooms Button -->
                        <div class="col-12 col-md-6 col-lg-3">
                            <a asp-controller="Home" asp-action="Rooms" id="btnSearchRooms" class="sm-btn-search w-100">
                                <i class="fa-solid fa-magnifying-glass"></i>
                                <span>Search Rooms</span>
                            </a>
                        </div>
                    </div>

                    <!-- Quick Filter Pills -->
                    <div class="sm-booking-quick-tags">
                        <span class="sm-tag-label">ยอดนิยม:</span>
                        <a asp-controller="Home" asp-action="Rooms" class="sm-quick-pill">🛏️ ห้องเตียงเสริม (มา 3 จ่าย 2)</a>
                        <a asp-controller="Home" asp-action="Rooms" class="sm-quick-pill">👨‍👩‍👧‍👦 ห้องครอบครัว Family</a>
                        <a asp-controller="Home" asp-action="Promotions" class="sm-quick-pill">🌙 พักยาว 3+ คืน ลดพิเศษ</a>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <!-- =========================================================
         SECTION 4: FEATURED ROOMS (แสดงห้องพัก 4 ประเภท)
         ========================================================= -->
    <section class="sm-section" id="featuredRooms">
        <div class="container">
            <div class="sm-section-header" data-aos="fade-up">
                <div>
                    <span class="sm-eyebrow"><i class="fa-solid fa-layer-group me-1"></i> ACCOMMODATION COLLECTION</span>
                    <h2 class="sm-section-title">Featured Rooms · ห้องพักดีไซน์อนาคต</h2>
                    <p class="sm-section-subtitle">
                        เลือกพื้นที่แห่งการพักผ่อนทั้ง 4 รูปแบบ ออกแบบด้วยนวัตกรรม Smart Room เพื่อความสบายสูงสุดของคุณ
                    </p>
                </div>
                <a asp-controller="Home" asp-action="Rooms" class="sm-link-arrow">
                    <span>ดูห้องพักทั้งหมด</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>

            <div class="row g-4">
                <!-- 1. Standard Room -->
                <div class="col-12 col-md-6 col-xl-3" data-aos="fade-up" data-aos-delay="50">
                    <article class="sm-room-card h-100">
                        <div class="sm-room-img-box">
                            <img src="https://images.unsplash.com/photo-1631049307264-da0ec9d70304?auto=format&fit=crop&w=800&q=80"
                                 alt="Standard Room" class="sm-room-img" loading="lazy" />
                            <span class="sm-room-badge">Smart Value</span>
                            <div class="sm-room-capacity">
                                <i class="fa-solid fa-user-group"></i> 1–2 ท่าน
                            </div>
                        </div>
                        <div class="sm-room-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h3 class="sm-room-title">Standard Room</h3>
                                <span class="sm-room-size">28 ตร.ม.</span>
                            </div>
                            <p class="sm-room-desc">
                                ห้องพักมาตรฐานดีไซน์โมเดิร์น มินิมอล ครบครันด้วยระบบควบคุมไฟอัจฉริยะและมุมทำงานส่วนตัว เหมาะสำหรับนักเดินทางและคู่รัก
                            </p>
                            <ul class="sm-room-highlights">
                                <li><i class="fa-solid fa-check text-info"></i> เตียง Queen/Twin Comfort</li>
                                <li><i class="fa-solid fa-check text-info"></i> Smart TV 55" &amp; Wi-Fi 6</li>
                                <li><i class="fa-solid fa-check text-info"></i> ฝักบัว Rain Shower แรงดันสูง</li>
                            </ul>
                            <div class="sm-room-footer">
                                <div class="sm-room-price">
                                    <small>เริ่มต้น</small>
                                    <strong>฿1,200</strong><span>/คืน</span>
                                </div>
                                <a asp-controller="Home" asp-action="RoomDetails" class="sm-btn-outline-card">
                                    View Details <i class="fa-solid fa-angle-right"></i>
                                </a>
                            </div>
                        </div>
                    </article>
                </div>

                <!-- 2. Deluxe Room -->
                <div class="col-12 col-md-6 col-xl-3" data-aos="fade-up" data-aos-delay="120">
                    <article class="sm-room-card h-100">
                        <div class="sm-room-img-box">
                            <img src="https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=800&q=80"
                                 alt="Deluxe Room" class="sm-room-img" loading="lazy" />
                            <span class="sm-room-badge sm-badge-cyan">Popular · รองรับเตียงเสริม</span>
                            <div class="sm-room-capacity">
                                <i class="fa-solid fa-user-group"></i> 2–3 ท่าน
                            </div>
                        </div>
                        <div class="sm-room-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h3 class="sm-room-title">Deluxe Room</h3>
                                <span class="sm-room-size">36 ตร.ม.</span>
                            </div>
                            <p class="sm-room-desc">
                                ห้องพักวิวเมืองมุมสูงผ่านกระจก Panoramic พื้นที่กว้างขวาง รองรับการเสริมเตียงและเข้าร่วมโปรโมชั่น "มา 3 จ่าย 2"
                            </p>
                            <ul class="sm-room-highlights">
                                <li><i class="fa-solid fa-check text-info"></i> วิวเมืองมุมสูง (City Skyline)</li>
                                <li><i class="fa-solid fa-check text-info"></i> รองรับ Extra Bed นุ่มพิเศษ</li>
                                <li><i class="fa-solid fa-check text-info"></i> โซฟาเลานจ์ &amp; มินิบาร์พรีเมียม</li>
                            </ul>
                            <div class="sm-room-footer">
                                <div class="sm-room-price">
                                    <small>เริ่มต้น</small>
                                    <strong>฿1,800</strong><span>/คืน</span>
                                </div>
                                <a asp-controller="Home" asp-action="RoomDetails" class="sm-btn-outline-card">
                                    View Details <i class="fa-solid fa-angle-right"></i>
                                </a>
                            </div>
                        </div>
                    </article>
                </div>

                <!-- 3. Family Room -->
                <div class="col-12 col-md-6 col-xl-3" data-aos="fade-up" data-aos-delay="190">
                    <article class="sm-room-card h-100">
                        <div class="sm-room-img-box">
                            <img src="https://images.unsplash.com/photo-1566665797739-1674de7a421a?auto=format&fit=crop&w=800&q=80"
                                 alt="Family Room" class="sm-room-img" loading="lazy" />
                            <span class="sm-room-badge sm-badge-violet">Family &amp; Gang</span>
                            <div class="sm-room-capacity">
                                <i class="fa-solid fa-people-roof"></i> 4 ท่าน
                            </div>
                        </div>
                        <div class="sm-room-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h3 class="sm-room-title">Family Room</h3>
                                <span class="sm-room-size">50 ตร.ม.</span>
                            </div>
                            <p class="sm-room-desc">
                                พื้นที่ความสุขขนาดใหญ่สำหรับครอบครัวและกลุ่มเพื่อน แบ่งโซนนั่งเล่นและโซนพักผ่อนอย่างลงตัว สะดวกสบายไม่อึดอัด
                            </p>
                            <ul class="sm-room-highlights">
                                <li><i class="fa-solid fa-check text-info"></i> เตียงใหญ่ 2 เตียง (2 King Beds)</li>
                                <li><i class="fa-solid fa-check text-info"></i> โต๊ะทานอาหารและมุมบอร์ดเกม</li>
                                <li><i class="fa-solid fa-check text-info"></i> ห้องน้ำแยกโซนเปียก-แห้ง 2 อ่างล้างหน้า</li>
                            </ul>
                            <div class="sm-room-footer">
                                <div class="sm-room-price">
                                    <small>เริ่มต้น</small>
                                    <strong>฿2,600</strong><span>/คืน</span>
                                </div>
                                <a asp-controller="Home" asp-action="RoomDetails" class="sm-btn-outline-card">
                                    View Details <i class="fa-solid fa-angle-right"></i>
                                </a>
                            </div>
                        </div>
                    </article>
                </div>

                <!-- 4. Suite Room -->
                <div class="col-12 col-md-6 col-xl-3" data-aos="fade-up" data-aos-delay="260">
                    <article class="sm-room-card h-100">
                        <div class="sm-room-img-box">
                            <img src="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80"
                                 alt="Suite Room" class="sm-room-img" loading="lazy" />
                            <span class="sm-room-badge sm-badge-gold">Futuristic Luxury</span>
                            <div class="sm-room-capacity">
                                <i class="fa-solid fa-crown"></i> 2–4 ท่าน
                            </div>
                        </div>
                        <div class="sm-room-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h3 class="sm-room-title">Suite Room</h3>
                                <span class="sm-room-size">68 ตร.ม.</span>
                            </div>
                            <p class="sm-room-desc">
                                ที่สุดแห่งความหรูหราระดับ Flagship พร้อมห้องนั่งเล่นแยกสัดส่วน อ่างอาบน้ำระบบจากุซซี่ชมวิวเมือง และระบบสั่งงานด้วยเสียง
                            </p>
                            <ul class="sm-room-highlights">
                                <li><i class="fa-solid fa-check text-info"></i> อ่างจากุซซี่ริมกระจกชมวิวพาโนรามา</li>
                                <li><i class="fa-solid fa-check text-info"></i> ระบบเสียงลำโพง Hi-Res รอบทิศทาง</li>
                                <li><i class="fa-solid fa-check text-info"></i> สิทธิ์เข้าใช้ Executive Sky Lounge</li>
                            </ul>
                            <div class="sm-room-footer">
                                <div class="sm-room-price">
                                    <small>เริ่มต้น</small>
                                    <strong>฿3,900</strong><span>/คืน</span>
                                </div>
                                <a asp-controller="Home" asp-action="RoomDetails" class="sm-btn-outline-card">
                                    View Details <i class="fa-solid fa-angle-right"></i>
                                </a>
                            </div>
                        </div>
                    </article>
                </div>
            </div>
        </div>
    </section>

    <!-- =========================================================
         SECTION 5: PROMOTIONS (Carousel สไลด์โชว์ครบทั้ง 5 โปรโมชั่น)
         ========================================================= -->
    <section class="sm-promo-section sm-full-bleed" id="specialPromotions">
        <div class="container">
            <div class="sm-section-header sm-header-dark" data-aos="fade-up">
                <div>
                    <span class="sm-eyebrow sm-eyebrow-cyan">
                        <i class="fa-solid fa-fire-flame-curved me-1"></i> EXCLUSIVE CAMPAIGNS
                    </span>
                    <h2 class="sm-section-title text-white">Special Promotions · 5 โปรโมชั่นสุดคุ้ม</h2>
                    <p class="sm-section-subtitle text-light opacity-75">
                        คัดสรรดีลสุดพิเศษสำหรับทุกสไตล์การเข้าพัก ทั้งมาเป็นแก๊ง ครอบครัว หรือพักผ่อนระยะยาว
                    </p>
                </div>

                <!-- Swiper Navigation Buttons -->
                <div class="sm-swiper-controls">
                    <button type="button" class="sm-swiper-btn promo-prev" aria-label="โปรโมชั่นก่อนหน้า">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <button type="button" class="sm-swiper-btn promo-next" aria-label="โปรโมชั่นถัดไป">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>
            </div>

            <!-- Swiper Container -->
            <div class="swiper sm-promo-swiper" data-aos="fade-up" data-aos-delay="100">
                <div class="swiper-wrapper">

                    <!-- Promo 1: มา 3 จ่าย 2 -->
                    <div class="swiper-slide h-auto">
                        <div class="sm-promo-card sm-grad-blue h-100">
                            <div class="sm-promo-top">
                                <span class="sm-promo-pill">PROMO 01 · HOT DEAL</span>
                                <span class="sm-promo-icon"><i class="fa-solid fa-gift"></i></span>
                            </div>
                            <h3 class="sm-promo-title">มา 3 จ่าย 2</h3>
                            <p class="sm-promo-subtitle">3 Guests, Pay for 2 Extra Value</p>
                            <p class="sm-promo-desc">
