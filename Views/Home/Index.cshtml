
@{
    ViewData["Title"] = "Welcome";
}

<section class="py-5">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="badge bg-primary mb-3">
                    Welcome to StayMate
                </span>

                <h1 class="display-4 fw-bold">
                    Your Perfect Stay<br />
                    Starts Here.
                </h1>

                <p class="lead text-secondary mt-3">
                    ค้นหาห้องพักที่ใช่ พร้อมโปรโมชั่นสุดพิเศษ
                    และบริการที่ตอบโจทย์ทุกการเดินทาง
                </p>

                <a asp-controller="Customer"
                   asp-action="Index"
                   class="btn btn-primary btn-lg mt-3">
                    ค้นหาห้องพัก
                </a>
            </div>

            <div class="col-lg-5">
                <div class="p-5 rounded-4 bg-light text-center">
                    <div style="font-size: 100px;">🏨</div>
                    <h3 class="fw-bold">StayMate Hotel</h3>
                    <p class="text-secondary mb-0">
                        Comfort, Convenience, and Care
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-light">
    <div class="container">
        <h2 class="fw-bold mb-2">Our Rooms</h2>
        <p class="text-secondary mb-4">
            เลือกห้องพักที่เหมาะกับการเดินทางของคุณ
        </p>

        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <div class="fs-1">🛏️</div>
                        <h5 class="fw-bold mt-2">Standard Room</h5>
                        <p class="text-secondary">
                            ห้องพักมาตรฐาน สำหรับ 1–2 ท่าน
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <div class="fs-1">🌇</div>
                        <h5 class="fw-bold mt-2">Deluxe Room</h5>
                        <p class="text-secondary">
                            ห้องพักวิวพิเศษ รองรับเตียงเสริม
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <div class="fs-1">👨‍👩‍👧‍👦</div>
                        <h5 class="fw-bold mt-2">Family Room</h5>
                        <p class="text-secondary">
                            พื้นที่สำหรับครอบครัวและกลุ่มเพื่อน
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <div class="fs-1">🛁</div>
                        <h5 class="fw-bold mt-2">Suite Room</h5>
                        <p class="text-secondary">
                            ห้องสวีทพร้อมบรรยากาศสุดพิเศษ
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <h2 class="fw-bold mb-4">Special Promotions</h2>

        <div class="row g-3">
            <div class="col-md-4">
                <div class="p-4 rounded-3 border h-100">
                    <h5>🎁 มา 3 จ่าย 2</h5>
                    <p class="text-secondary mb-0">
                        โปรโมชั่นสำหรับห้องพักที่รองรับเตียงเสริม
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-4 rounded-3 border h-100">
                    <h5>🌙 Stay 3+ Nights</h5>
                    <p class="text-secondary mb-0">
                        รับส่วนลดเมื่อเข้าพักต่อเนื่องตามเงื่อนไข
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-4 rounded-3 border h-100">
                    <h5>👨‍👩‍👧‍👦 Family & Gang</h5>
                    <p class="text-secondary mb-0">
                        สิทธิพิเศษสำหรับการเข้าพักเป็นกลุ่ม
                    </p>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <a asp-controller="Customer"
               asp-action="Index"
               class="btn btn-primary">
                ดูห้องพักและโปรโมชั่นทั้งหมด
            </a>
        </div>
    </div>
</section>
