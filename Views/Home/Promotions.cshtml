@model List<StayMate_Kavinvee_0576.Models.ViewModels.PromoCardItem>
@{
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
    ViewData["Title"] = "โปรโมชั่นพิเศษ";

    int total = Model.Count;
    int cPopular = Model.Count(p => p.Category.Contains("popular"));
    int cLong = Model.Count(p => p.Category.Contains("stay-long"));
    int cGroup = Model.Count(p => p.Category.Contains("group-pack"));
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />
    <link rel="stylesheet" href="~/css/Home.css" asp-append-version="true" />
}

<div class="sm-home-wrapper">

    <!-- 1. HERO -->
    <section class="sm-subpage-hero sm-full-bleed">
        <div class="sm-subpage-hero-bg"
             style="background-image: url('https://images.unsplash.com/photo-1540518614846-7ede433c4576?auto=format&fit=crop&w=2000&q=85');">
        </div>
        <div class="sm-hero-overlay"></div>
        <div class="sm-hero-glow-orb sm-orb-violet"></div>

        <div class="container position-relative z-2 py-4">
            <nav aria-label="breadcrumb" class="mb-3" data-aos="fade-down">
                <ol class="breadcrumb sm-breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house me-1"></i>หน้าแรก</a></li>
                    <li class="breadcrumb-item active" aria-current="page">โปรโมชั่น</li>
                </ol>
            </nav>

            <div class="row align-items-end g-4">
                <div class="col-lg-12" data-aos="fade-up">
                    <div class="sm-hero-badge mb-2 sm-badge-pulse-violet">
                        <span class="sm-badge-pulse bg-warning" style="box-shadow: 0 0 10px #FFB547;"></span>
                        <span>SPECIAL PROMOTIONS</span>
                    </div>
                    <h1 class="sm-subpage-title text-white">
                        Special Promotions<br />
                        <span class="sm-text-gradient">โปรโมชั่นและสิทธิพิเศษสำหรับคุณ</span>
                    </h1>
                    <p class="text-light opacity-75 mb-0" style="max-width: 620px;">
                        ดูโปรโมชั่นที่เปิดให้บริการอยู่ในขณะนี้ เมื่อพร้อมเข้าพัก เข้าสู่ระบบเพื่อจองห้องพักและรับสิทธิ์ตามเงื่อนไขของแต่ละโปรโมชั่น
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. FILTER -->
    <section class="sm-rooms-filter-wrap" data-aos="fade-up">
        <div class="container">
            <div class="sm-filter-bar">
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <span class="sm-filter-label"><i class="fa-solid fa-tags text-primary me-1"></i> เลือกประเภทโปรโมชั่น:</span>
                    <button type="button" class="sm-filter-btn active" data-filter="all">ทั้งหมด (@total)</button>
                    <button type="button" class="sm-filter-btn" data-filter="popular">ดีลยอดนิยม (@cPopular)</button>
                    <button type="button" class="sm-filter-btn" data-filter="stay-long">พักระยะยาว (@cLong)</button>
                    <button type="button" class="sm-filter-btn" data-filter="group-pack">กลุ่มและครอบครัว (@cGroup)</button>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. PROMOTION CARDS -->
    <section class="sm-section pt-3">
        <div class="container">

            @if (total == 0)
            {
                <div class="text-center py-5">
                    <i class="fa-regular fa-face-smile fa-2x mb-3 text-muted"></i>
                    <h5 class="mb-1">ขณะนี้ยังไม่มีโปรโมชั่นที่เปิดใช้งาน</h5>
                    <p class="text-muted mb-3">โปรดกลับมาตรวจสอบใหม่เร็ว ๆ นี้</p>
                    <a asp-controller="Home" asp-action="Rooms" class="sm-promo-action-btn d-inline-flex">ดูห้องพักทั้งหมด <i class="fa-solid fa-angle-right"></i></a>
                </div>
            }
            else
            {
                <div class="row g-4" id="promotionsContainer">
                    @{ var delay = 0; }
                    @foreach (var p in Model)
                    {
                        <div class="col-lg-6 sm-promo-item-card" data-category="@p.Category" data-aos="fade-up" data-aos-delay="@delay">
                            <div class="sm-promo-showcase-box @p.GradClass">
                                <div class="sm-promo-header-row">
                                    <span class="sm-promo-badge-tag">@p.BadgeText</span>

                                    @if (p.ValidTo.HasValue)
                                    {
                                        <div class="sm-countdown-wrap" data-end="@p.ValidTo.Value.ToString("yyyy-MM-dd")T23:59:59">
                                            <i class="fa-regular fa-clock me-1"></i>เหลือเวลา <span class="countdown-timer">--:--:--</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="sm-countdown-wrap">
                                            <i class="fa-regular fa-clock me-1"></i>ไม่มีวันสิ้นสุด
                                        </div>
                                    }
                                </div>

                                <h2 class="sm-promo-showcase-title">@p.PromoName</h2>
                                <span class="sm-promo-showcase-sub">
                                    @p.Meta1@(string.IsNullOrEmpty(p.Meta2) ? "" : " • " + p.Meta2)
                                </span>

                                @if (!string.IsNullOrWhiteSpace(p.Description))
                                {
                                    <p class="sm-promo-showcase-desc">@p.Description</p>
                                }

                                @if (p.Perks.Count > 0)
                                {
                                    <div class="sm-promo-perks">
                                        @foreach (var perk in p.Perks)
                                        {
                                            <span><i class="fa-solid @perk.Icon"></i> @perk.Text</span>
                                        }
                                    </div>
                                }

                                <div class="small text-white opacity-75 mt-2">
                                    @if (!string.IsNullOrEmpty(p.ApplicableRoomTypeName))
                                    {
                                        <div><i class="fa-solid fa-door-open me-1"></i>ใช้ได้กับห้อง: @p.ApplicableRoomTypeName</div>
                                    }
                                    else
                                    {
                                        <div><i class="fa-solid fa-door-open me-1"></i>ใช้ได้กับห้องพักทุกประเภท</div>
                                    }
                                    @if (p.ValidFrom.HasValue || p.ValidTo.HasValue)
                                    {
                                        <div>
                                            <i class="fa-regular fa-calendar me-1"></i>ระยะเวลา:
                                            @(p.ValidFrom?.ToString("d MMM yyyy") ?? "-") – @(p.ValidTo?.ToString("d MMM yyyy") ?? "-")
                                        </div>
                                    }
                                </div>

                                <div class="sm-promo-showcase-footer">
                                    <div class="sm-coupon-box">
                                        <small>รหัสโปรโมชั่น:</small>
                                        <div class="sm-coupon-code">
                                            <span class="code-text">@p.PromoCode</span>
                                            <button type="button" class="sm-copy-btn" data-code="@p.PromoCode" aria-label="คัดลอกโค้ด"><i class="fa-regular fa-copy"></i></button>
                                        </div>
                                    </div>

                                    @if (p.ApplicableRoomTypeId.HasValue)
                                    {
                                        <a asp-controller="Home" asp-action="RoomDetails" asp-route-id="@p.ApplicableRoomTypeId" class="sm-promo-action-btn">ดูห้องพักที่ร่วมรายการ <i class="fa-solid fa-angle-right"></i></a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Home" asp-action="Rooms" class="sm-promo-action-btn">ดูห้องพักที่ร่วมรายการ <i class="fa-solid fa-angle-right"></i></a>
                                    }
                                </div>
                            </div>
                        </div>
                        delay = Math.Min(delay + 50, 200);
                    }
                </div>
            }

            <!-- 4. แจ้งให้ล็อกอินก่อนจอง -->
            <div class="mt-5 p-4 rounded-4 border text-center" data-aos="fade-up">
                <h5 class="mb-1"><i class="fa-solid fa-circle-info text-primary me-2"></i>สนใจโปรโมชั่นไหน?</h5>
                <p class="text-muted mb-3">การจองห้องพักและการใช้สิทธิ์โปรโมชั่นต้องเข้าสู่ระบบก่อน</p>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Customer" asp-action="Index" class="sm-btn-primary px-4 py-2">ไปที่หน้าของฉัน</a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="sm-btn-primary px-4 py-2 me-2">เข้าสู่ระบบ</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-secondary px-4 py-2">สมัครสมาชิก</a>
                }
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof AOS !== "undefined") AOS.init({ duration: 700, once: true });

            // 1. กรองการ์ด (ใช้ split เพื่อไม่ให้ "popular" ไปชนกับชื่ออื่น)
            const filterBtns = document.querySelectorAll(".sm-filter-btn");
            const promoCards = document.querySelectorAll(".sm-promo-item-card");
            filterBtns.forEach(btn => {
                btn.addEventListener("click", function () {
                    filterBtns.forEach(b => b.classList.remove("active"));
                    this.classList.add("active");
                    const f = this.dataset.filter;
                    promoCards.forEach(card => {
                        const cats = (card.dataset.category || "").split(" ");
                        card.classList.toggle("d-none", !(f === "all" || cats.includes(f)));
                    });
                });
            });

            // 2. Countdown จากวันสิ้นสุดจริง (data-end)
            document.querySelectorAll(".sm-countdown-wrap[data-end]").forEach(wrap => {
                const target = new Date(wrap.dataset.end).getTime();
                const display = wrap.querySelector(".countdown-timer");
                const fmt = n => String(n).padStart(2, "0");

                function tick() {
                    const diff = target - Date.now();
                    if (diff <= 0) { display.textContent = "สิ้นสุดแล้ว"; return false; }
                    const d = Math.floor(diff / 86400000);
                    const h = Math.floor((diff % 86400000) / 3600000);
                    const m = Math.floor((diff % 3600000) / 60000);
                    const s = Math.floor((diff % 60000) / 1000);
                    display.textContent = (d > 0 ? d + " วัน " : "") + `${fmt(h)}:${fmt(m)}:${fmt(s)}`;
                    return true;
                }
                if (tick()) {
                    const id = setInterval(() => { if (!tick()) clearInterval(id); }, 1000);
                }
            });

            // 3. คัดลอกโค้ด
            document.querySelectorAll(".sm-copy-btn").forEach(btn => {
                btn.addEventListener("click", function () {
                    navigator.clipboard.writeText(this.dataset.code).then(() => {
                        const icon = this.querySelector("i");
                        icon.className = "fa-solid fa-check text-success";
                        setTimeout(() => icon.className = "fa-regular fa-copy", 2000);
                    }).catch(err => console.error("คัดลอกโค้ดไม่สำเร็จ:", err));
                });
            });
        });
    </script>
}