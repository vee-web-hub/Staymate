                        },
                        {
                            user: "คุณ กัญญาณัฐ พี.",
                            score: 4.6,
                            date: "28 ก.ย. 2026",
                            comment: "ชอบความมินิมอล มี USB-C ชาร์จแบตเตอรี่ข้างเตียงเยอะดี อินเทอร์เน็ต Wi-Fi เร็วมาก เหมาะกับคนที่ต้องแบกงานมาทำด้วย"
                        }
                    ]
                },
                deluxe: {
                    code: "TYPE B · SKYLINE PANORAMA",
                    title: "Deluxe Room",
                    tagline: "ห้องพักวิวเมืองมุมสูง รองรับเตียงเสริมและโปรโมชั่น 'มา 3 จ่าย 2'",
                    size: "36 ตร.ม.",
                    guests: "2–3 ท่าน (เสริมเตียงได้)",
                    bed: "1 King Bed + Sofa Bed",
                    view: "City Skyline View",
                    price: 1800,
                    desc: "Deluxe Room ของ StayMate ออกแบบภายใต้แนวคิด Futuristic Boutique Luxury ที่มอบพื้นที่กว้างถึง 36 ตารางเมตร โดดเด่นด้วยหน้าต่างกระจกบานใหญ่จากพื้นจรดเพดาน เปิดรับวิวเส้นขอบฟ้าของเมืองยามค่ำคืน มาพร้อมโซฟาพักผ่อนริมหน้าต่าง และรองรับการเสริมเตียงมาตรฐานโรงแรมโดยไม่ทำให้ห้องอึดอัด",
                    images: {
                        bed: "https://www.hotelscombined.com/rimg/himg/14/44/0e/leonardo-19066-741285-684003.jpg?crop=true&height=607&width=968", // เตียงดีลักซ์วิวสวย
                        bathroom: "https://cdn.kiwicollection.com/media/room_images/PR000394/xl/000394-chiph-p0847-gold-coast-and-wellbeing-suite-bathroom.jpg", // ห้องน้ำดีลักซ์โมเดิร์น
                        ambient: "https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1200&q=85"  // โซฟาริมกระจกวิวเมืองใหญ่
                    },
                    score: "4.9",
                    reviews: [
                        {
                            user: "คุณ ฐิติพันธ์ เอส.",
                            score: 5,
                            date: "04 พ.ย. 2026",
                            comment: "จองโปรมา 3 จ่าย 2 ไปกับเพื่อน เสริมเตียงนอนสบายมาก ไม่อึดอัดเลย วิวเมืองจากห้องกระจกบานใหญ่คือสวยแบบสะกดตาจริง ๆ คุ้มค่ามาก!"
                        },
                        {
                            user: "คุณ ปิยธิดา เจ.",
                            score: 4.8,
                            date: "19 ต.ค. 2026",
                            comment: "ห้องสวยงามเหมือนในรูปเป๊ะ ๆ ระบบคำนวณแสงไฟอัจฉริยะล้ำสมัยมาก ห้องน้ำสะอาดสะอ้าน อุปกรณ์อำนวยความสะดวกครบถ้วน แนะนำเลยค่ะ"
                        }
                    ]
                },
                family: {
                    code: "TYPE C · SHARED HAPPINESS SPACE",
                    title: "Family Room",
                    tagline: "พื้นที่ความสุขขนาดใหญ่ 50 ตร.ม. สำหรับครอบครัวและแก๊งเพื่อน 4 ท่าน",
                    size: "50 ตร.ม.",
                    guests: "4 ท่าน (ครอบครัว / กลุ่มเพื่อน)",
                    bed: "2 King Size Beds",
                    view: "Panoramic City & Pool View",
                    price: 2600,
                    desc: "Family Room มอบพื้นที่กว้างขวางถึง 50 ตร.ม. พร้อมเตียง King Size 2 เตียงใหญ่ โซนนั่งเล่นและโต๊ะรับประทานอาหารสำหรับสังสรรค์ ห้องน้ำขนาดใหญ่มาพร้อมอ่างอาบน้ำและอ่างล้างหน้าคู่ (Double Vanity) ตอบโจทย์การเข้าพักเป็นกลุ่มอย่างแท้จริง",
                    images: {
                        bed: "https://www.unionhouse.com.tw/f/enroom_1501480059.jpg", // สองเตียงใหญ่กว้างขวาง
                        bathroom: "https://www.rebstock.com/images/portal_95023/2011/2011003_w1500.jpg", // อ่างอาบน้ำหรูและอ่างล้างหน้าคู่
                        ambient: "https://jacosmohotelandspa.com/UploadFile/Gallery-2026/Rooms/FAMILY-WITH-CITY-VIEW/1.jpg"  // โซนนั่งเล่น โต๊ะทานข้าว บอร์ดเกม
                    },
                    score: "4.9",
                    reviews: [
                        {
                            user: "คุณ อรวรรณ ดี.",
                            score: 5,
                            date: "08 พ.ย. 2026",
                            comment: "พาครอบครัวและเด็ก ๆ มาพัก ทุกคนแฮปปี้มาก มีเตียง King size ถึงสองเตียงเต็ม ห้องน้ำมีอ่างอาบน้ำใหญ่ให้เด็ก ๆ แช่ สัญญาณเน็ตแรงทั่วทั้งห้องพึงพอใจค่ะ"
                        },
                        {
                            user: "คุณ ณัฐวุฒิ โอ.",
                            score: 4.8,
                            date: "31 ต.ค. 2026",
                            comment: "มากับแก๊งเพื่อน 4 คน พื้นที่กว้างมาก ไม่แออัด โต๊ะกลางบอร์ดเกมตอบโจทย์กิจกรรมตอนกลางคืน แถมระบบแอนิเมชันทีวีแชร์จอไอโฟนได้สะดวกรวดเร็ว"
                        }
                    ]
                },
                suite: {
                    code: "TYPE D · EXECUTIVE HORIZON SUITE",
                    title: "Suite Room",
                    tagline: "ห้องสวีทระดับ Flagship พร้อมอ่างจากุซซี่ชมวิวเมืองและสิทธิ์เข้าใช้ Sky Lounge",
                    size: "68 ตร.ม.",
                    guests: "2–4 ท่าน (Executive Privilege)",
                    bed: "1 Emperor King + Living Lounge",
                    view: "180° Horizon Skyline",
                    price: 3900,
                    desc: "Suite Room คือที่สุดแห่งประสบการณ์พักผ่อนของ StayMate แบ่งโซนห้องนั่งเล่นและห้องนอนเป็นสัดส่วน ไฮไลท์คืออ่างอาบน้ำระบบจากุซซี่ริมกระจกชมวิวเมือง 180 องศา ระบบสั่งงานด้วยเสียงอัจฉริยะ และสิทธิ์เข้าใช้บริการ Executive Sky Lounge ฟรีตลอดการเข้าพัก",
                    images: {
                        bed: "https://images.trvl-media.com/lodging/1000000/810000/809400/809389/65e1373e.jpg?impolicy=resizecrop&ra=fill&rh=575&rw=575", // ห้องสูทอลังการ
                        bathroom: "https://r.profitroom.com/hotelnarvilconferencespa1/images/gallery/thumbs/1080x655/201806051034290.Hotel_Narvil_Apartament_VIP_jacuzzi_3.jpg", // อ่างจากุซซี่กระจกขอบเมือง
                        ambient: "https://www.wellnesshotel.com/import/rooms/4848/image-thumb__4848__gallery/eadded6a-d089-4c19-b19f-b8ff3faf1056.7da959d7.jpg"  // ห้องนั่งเล่นแยกส่วนหรูหรา
                    },
                    score: "5.0",
                    reviews: [
                        {
                            user: "คุณ แพรวพรรณ จี.",
                            score: 5,
                            date: "14 พ.ย. 2026",
                            comment: "ที่สุดของความประทับใจค่ะ! อ่างจากุซซี่ริมกระจกมองเห็นวิวกรุงเทพฯ แบบ 180 องศา สวยงามหรูหราเกินบรรยาย สั่งการปิดม่านปรับแอร์ด้วยเสียงล้ำมาก สิทธิ์เลานจ์ก็คุ้มมากค่ะ"
                        },
                        {
                            user: "คุณ ศรัณย์ ที.",
                            score: 5,
                            date: "02 พ.ย. 2026",
                            comment: "มาฉลองวันครบรอบแต่งงานที่นี่ ทางโรงแรมจัดเตรียมห้องได้ประทับใจมาก ระบบความบันเทิงเสียงรอบทิศทางในห้องดูหนังฟินสุด ๆ จะกลับมาพักอีกแน่นอน"
                        }
                    ]
                }
            };

            let currentRoomKey = "deluxe";

            // ตรวจสอบ Query String ?type=... จาก URL
            const params = new URLSearchParams(window.location.search);
            const typeParam = (params.get("type") || "").toLowerCase();
            if (roomCatalog[typeParam]) {
                currentRoomKey = typeParam;
            }

            const switchButtons = document.querySelectorAll(".sm-switch-pill");
            const mainImg = document.getElementById("mainGalleryImg");
            const thumbs = document.querySelectorAll(".sm-gallery-thumb");

            // หากเว็บต้นทางปิด hotlink หรือไฟล์ภาพหาย ให้แสดง placeholder แทน broken image icon
            // รูปหลักยังโหลดจาก URL ภายนอกตามที่กำหนดไว้ใน roomCatalog
            const imageFallback = "data:image/svg+xml;charset=UTF-8," + encodeURIComponent(
                '<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="800" viewBox="0 0 1200 800">' +
                '<rect width="1200" height="800" fill="#e9edf2"/>' +
                '<g fill="none" stroke="#8995a3" stroke-width="18"><rect x="390" y="230" width="420" height="300" rx="24"/><path d="M390 430h420M500 230v-80h200v80"/></g>' +
                '<text x="600" y="620" text-anchor="middle" font-family="Arial,sans-serif" font-size="34" fill="#526071">Image temporarily unavailable</text>' +
                '</svg>'
            );

            function setGalleryImage(img, url, altText) {
                if (!img) return;
                img.alt = altText;
                img.onerror = function () {
                    this.onerror = null; // ป้องกันการวนลูปเมื่อ fallback โหลดไม่ได้
                    this.src = imageFallback;
                };
                img.src = url;
            }

            function renderRoom(key) {
                const data = roomCatalog[key];
                if (!data) return;
                currentRoomKey = key;

                document.getElementById("breadcrumbRoomName").textContent = data.title;
                document.getElementById("detailRoomCode").textContent = data.code;
                document.getElementById("detailRoomTitle").textContent = data.title;
                document.getElementById("detailRoomTagline").textContent = data.tagline;
                document.getElementById("specSize").textContent = data.size;
                document.getElementById("specGuests").textContent = data.guests;
                document.getElementById("specBed").textContent = data.bed;
                document.getElementById("specView").textContent = data.view;
                document.getElementById("detailFullDesc").textContent = data.desc;
                document.getElementById("panelRoomName").textContent = data.title;
                document.getElementById("panelBasePrice").textContent = "฿" + data.price.toLocaleString();
                document.getElementById("reviewScoreBadge").textContent = data.score;

                // อัปเดตแกลเลอรีด้วย URL แยกตามประเภทภาพ (เตียง / ห้องน้ำ / มุมห้อง)
                setGalleryImage(mainImg, data.images.bed, "Room bedroom");

                // ภาพที่ 1: มุมเตียงนอน
                document.getElementById("thumb0").setAttribute("data-src", data.images.bed);
                setGalleryImage(document.getElementById("thumbImg0"), data.images.bed, "Bedroom thumbnail");
                document.getElementById("thumbLabel0").textContent = "มุมพักผ่อนหลัก";

                // ภาพที่ 2: ห้องน้ำ (Bathroom) ตรงกับรูปห้องน้ำจริง
                document.getElementById("thumb1").setAttribute("data-src", data.images.bathroom);
                setGalleryImage(document.getElementById("thumbImg1"), data.images.bathroom, "Bathroom thumbnail");
                document.getElementById("thumbLabel1").textContent = key === "suite" ? "Panorama Jacuzzi" : "Smart Bathroom";

                // ภาพที่ 3: มุมตกแต่งวิว (Ambient & View) วิวมุมกระจกและสิ่งอำนวยความสะดวก
                document.getElementById("thumb2").setAttribute("data-src", data.images.ambient);
                setGalleryImage(document.getElementById("thumbImg2"), data.images.ambient, "Room ambience thumbnail");
                document.getElementById("thumbLabel2").textContent = key === "family" ? "Lounge & Boardgame" : "Ambient & View";

                // รีเซ็ตการไฮไลท์รูปแรก
                thumbs.forEach((t, idx) => {
                    t.classList.toggle("active", idx === 0);
                });

                switchButtons.forEach(btn => {
                    btn.classList.toggle("active", btn.getAttribute("data-room") === key);
                });

                // เรนเดอร์ความคิดเห็นรีวิว (Dynamic Static Reviews) เจาะจงตามประเภทห้องพัก
                renderReviewsList(data.reviews);

                calculateSimulatedPrice();
            }

            // ฟังก์ชันสร้าง UI แสดงผลรีวิวแบบไดนามิก
            function renderReviewsList(reviews) {
                const container = document.getElementById("dynamicReviewsList");
                container.innerHTML = ""; // ล้างข้อมูลเดิม

                reviews.forEach(rev => {
                    // สร้างดาวความเห็นตามคะแนนจริง
                    let starsHtml = "";
                    const fullStars = Math.floor(rev.score);
                    for (let i = 0; i < 5; i++) {
                        if (i < fullStars) {
                            starsHtml += '<i class="fa-solid fa-star text-warning me-1"></i>';
                        } else {
                            starsHtml += '<i class="fa-regular fa-star text-muted me-1"></i>';
                        }
                    }

                    const reviewHtml = `
                        <div class="p-3 rounded-4 bg-light border border-light-subtle d-flex flex-column gap-2" data-aos="fade-up">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="sm-avatar-placeholder">${rev.user.charAt(4)}</div>
                                    <div>
                                        <strong class="text-dark d-block">${rev.user}</strong>
                                        <span class="text-muted" style="font-size: 0.76rem;"><i class="fa-regular fa-calendar-check me-1"></i>เข้าพักเมื่อ: ${rev.date}</span>
                                    </div>
                                </div>
                                <div class="sm-rating-stars-wrap">
                                    ${starsHtml} <span class="fw-bold text-dark ms-1" style="font-size: 0.88rem;">(${rev.score})</span>
                                </div>
                            </div>
                            <p class="text-secondary mb-0 small lh-lg" style="font-style: italic;">
                                "${rev.comment}"
                            </p>
                        </div>
                    `;
                    container.insertAdjacentHTML("beforeend", reviewHtml);
                });
            }

            switchButtons.forEach(btn => {
                btn.addEventListener("click", function () {
                    renderRoom(this.getAttribute("data-room"));
                });
            });

            // Gallery Thumbnail Click
            thumbs.forEach(thumb => {
                thumb.addEventListener("click", function () {
                    thumbs.forEach(t => t.classList.remove("active"));
                    this.classList.add("active");
                    setGalleryImage(mainImg, this.getAttribute("data-src"), "Selected room gallery image");
                });
            });

            // ตั้งค่าวันที่เริ่มต้นใน Simulator
            const simIn = document.getElementById("simCheckIn");
            const simOut = document.getElementById("simCheckOut");
            const simGuests = document.getElementById("simGuests");
            const simPromo = document.getElementById("simPromo");

            const today = new Date();
            const tomorrow = new Date(today);
            tomorrow.setDate(today.getDate() + 1);
            const fmt = d => d.toISOString().split("T")[0];

            simIn.value = fmt(today);
            simOut.value = fmt(tomorrow);

            function calculateSimulatedPrice() {
                const basePrice = roomCatalog[currentRoomKey].price;
                const d1 = new Date(simIn.value);
                const d2 = new Date(simOut.value);
                let nights = Math.round((d2 - d1) / (1000 * 60 * 60 * 24));
                if (isNaN(nights) || nights < 1) nights = 1;

                const subTotal = basePrice * nights;
                const promo = simPromo.value;
                let discount = 0;
                let promoNote = "ไม่มีส่วนลดเพิ่มเติม";

                if (promo === "pay2") {
                    discount = 500 * nights; // จำลองฟรีค่าเตียงเสริม 500/คืน
                    promoNote = "ฟรีค่าเตียงเสริมคนที่ 3 (มา 3 จ่าย 2)";
                } else if (promo === "stay3") {
                    discount = Math.round(subTotal * 0.20);
                    promoNote = "ส่วนลด Stay 3+ Nights (20%)";
                } else if (promo === "weekly") {
                    discount = Math.round(subTotal * 0.25);
                    promoNote = "ส่วนลด Weekly Escape (25%)";
                }

                const grandTotal = Math.max(basePrice, subTotal - discount);

                document.getElementById("calcNightText").textContent = `ราคาห้องพัก (${nights} คืน)`;
                document.getElementById("calcSubTotal").textContent = "฿" + subTotal.toLocaleString();
                document.getElementById("calcPromoLabel").innerHTML = `<i class="fa-solid fa-tag me-1"></i>${promoNote}`;
                document.getElementById("calcDiscount").textContent = discount > 0 ? `-฿${discount.toLocaleString()}` : "฿0";
                document.getElementById("calcGrandTotal").textContent = "฿" + grandTotal.toLocaleString();
            }

            [simIn, simOut, simGuests, simPromo].forEach(el => {
                el.addEventListener("change", calculateSimulatedPrice);
            });

            // เริ่มแสดงผลห้องเริ่มต้น
            renderRoom(currentRoomKey);
        });
    </script>
}
