                    images: {
                        bed: "https://www.daysinnvancouver.com/Content/images/DeluxeQueenHotelRoom.jpg", // โทนสแตนดาร์ดเรียบหรู
                        bathroom: "https://www.rebstock.com/images/portal_95023/2011/2011003_w1500.jpg", // ห้องอาบน้ำเรนชาวเวอร์โมเดิร์น
                        ambient: "https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1200&q=85"  // มุมโต๊ะทำงานควบคุมไฟอัจฉริยะ
