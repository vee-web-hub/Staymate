@{
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
    ViewData["Title"] = "รายละเอียดห้องพัก";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />
    <link rel="stylesheet" href="~/css/Home.css" asp-append-version="true" />
}

<div class="sm-home-wrapper">

    <!-- =========================================================
         1. TOP ROOM TYPE SWITCHER BAR (สลับดูรายละเอียดทั้ง 4 ห้องได้ทันที)
         ========================================================= -->
    <section class="sm-detail-header-bar sm-full-bleed">
        <div class="container">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb sm-breadcrumb mb-0">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">หน้าแรก</a></li>
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Rooms">ประเภทห้องพัก</a></li>
                        <li class="breadcrumb-item active" id="breadcrumbRoomName" aria-current="page">Deluxe Room</li>
                    </ol>
                </nav>

                <!-- ปุ่มสลับประเภทห้องพัก (Interactive Switcher) -->
                <div class="sm-room-switcher" role="tablist" aria-label="เลือกดูประเภทห้องพัก">
                    <span class="sm-switcher-label d-none d-md-inline"><i class="fa-solid fa-repeat me-1"></i> เลือกดูห้อง:</span>
                    <button type="button" class="sm-switch-pill" data-room="standard">Standard</button>
                    <button type="button" class="sm-switch-pill active" data-room="deluxe">Deluxe</button>
                    <button type="button" class="sm-switch-pill" data-room="family">Family</button>
                    <button type="button" class="sm-switch-pill" data-room="suite">Suite</button>
                </div>
            </div>
        </div>
    </section>

    <!-- =========================================================
         2. MAIN ROOM DETAILS & INTERACTIVE GALLERY
         ========================================================= -->
    <section class="sm-section pt-4">
        <div class="container">

            <!-- Title & Quick Rating Row -->
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4" data-aos="fade-up">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="sm-eyebrow mb-0" id="detailRoomCode">TYPE B · SKYLINE PANORAMA</span>
                        <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle">
                            <i class="fa-solid fa-bolt me-1"></i>Smart Room 100%
                        </span>
                    </div>
                    <h1 class="sm-section-title mb-1" id="detailRoomTitle">Deluxe Room</h1>
                    <p class="text-secondary mb-0" id="detailRoomTagline">
                        ห้องพักวิวเมืองมุมสูง รองรับเตียงเสริมและโปรโมชั่น "มา 3 จ่าย 2"
                    </p>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="sm-rating-chip">
                        <span class="sm-rating-score"><i class="fa-solid fa-star text-warning me-1"></i>4.9</span>
                        <span class="sm-rating-text">ดีเยี่ยม (รีวิวผู้เข้าพักจริง)</span>
                    </div>
                    <a asp-controller="Home" asp-action="Rooms" class="btn btn-outline-secondary rounded-pill btn-sm px-3">
                        <i class="fa-solid fa-arrow-left me-1"></i> ดูห้องทั้งหมด
                    </a>
                </div>
            </div>

            <!-- Interactive Photo Gallery (อัปเกรดรูปภาพให้ตรงกับหัวข้อจริง 100%) -->
            <div class="row g-3 mb-5" data-aos="fade-up" data-aos-delay="50">
                <div class="col-lg-8">
                    <div class="sm-gallery-main-wrap">
                        <img id="mainGalleryImg"
                             src="https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=1400&q=85"
                             alt="Room Main View" class="sm-gallery-main-img" />
                        <span class="sm-gallery-badge" id="detailGalleryBadge">
                            <i class="fa-solid fa-camera me-1"></i> StayMate Official Room Preview
                        </span>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="row g-3 h-100" id="galleryThumbsContainer">
                        <!-- Thumbs populated/updated by JS -->
                        <div class="col-4 col-lg-12">
                            <div class="sm-gallery-thumb active" id="thumb0" data-src="">
                                <img src="" alt="มุมเตียงนอน" id="thumbImg0" />
                                <span id="thumbLabel0">มุมพักผ่อนหลัก</span>
                            </div>
                        </div>
                        <div class="col-4 col-lg-6">
                            <div class="sm-gallery-thumb" id="thumb1" data-src="">
                                <img src="" alt="ห้องน้ำ" id="thumbImg1" />
                                <span id="thumbLabel1">Smart Bathroom</span>
                            </div>
                        </div>
                        <div class="col-4 col-lg-6">
                            <div class="sm-gallery-thumb" id="thumb2" data-src="">
                                <img src="" alt="วิวและมุมตกแต่ง" id="thumbImg2" />
                                <span id="thumbLabel2">Ambient &amp; View</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Content Columns: Left Specs + Right Booking Simulator -->
            <div class="row g-4">
                <!-- Left Column: Room Details, Amenities, Reviews -->
                <div class="col-lg-8">

                    <!-- Key Highlights Bar -->
                    <div class="sm-detail-specs-bar mb-4" data-aos="fade-up">
                        <div class="sm-detail-spec-item">
                            <i class="fa-solid fa-maximize"></i>
                            <div>
                                <small>ขนาดห้องพัก</small>
                                <strong id="specSize">36 ตร.ม.</strong>
                            </div>
                        </div>
                        <div class="sm-detail-spec-item">
                            <i class="fa-solid fa-user-group"></i>
                            <div>
                                <small>จำนวนผู้เข้าพัก</small>
                                <strong id="specGuests">2–3 ท่าน (เสริมเตียงได้)</strong>
                            </div>
                        </div>
                        <div class="sm-detail-spec-item">
                            <i class="fa-solid fa-bed"></i>
                            <div>
                                <small>ประเภทเตียง</small>
                                <strong id="specBed">1 King Bed + Sofa Bed</strong>
                            </div>
                        </div>
                        <div class="sm-detail-spec-item">
                            <i class="fa-solid fa-city"></i>
                            <div>
                                <small>ทิวทัศน์</small>
                                <strong id="specView">City Skyline View</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Room Description -->
                    <div class="sm-detail-card mb-4" data-aos="fade-up">
                        <h3 class="sm-detail-card-title">
                            <i class="fa-solid fa-wand-magic-sparkles text-primary me-2"></i>รายละเอียดและแนวคิดการออกแบบ
                        </h3>
                        <p class="text-secondary lh-lg mb-3" id="detailFullDesc">
                            Deluxe Room ของ StayMate ออกแบบภายใต้แนวคิด Futuristic Boutique Luxury ที่มอบพื้นที่กว้างถึง 36 ตารางเมตร โดดเด่นด้วยหน้าต่างกระจกบานใหญ่จากพื้นจรดเพดาน เปิดรับวิวเส้นขอบฟ้าของเมืองยามค่ำคืน มาพร้อมโซฟาพักผ่อนริมหน้าต่าง และรองรับการเสริมเตียงมาตรฐานโรงแรมโดยไม่ทำให้ห้องอึดอัด
                        </p>
                        <div class="sm-smart-tech-banner">
                            <div class="sm-tech-icon"><i class="fa-solid fa-microchip"></i></div>
                            <div>
                                <strong>StayMate Smart Room Ecosystem</strong>
                                <p class="mb-0 small text-light opacity-75">
                                    ปรับโหมดแสงไฟภายในห้อง (Focus / Relax / Sleep / Cyber Glow) ผ่านแท็บเล็ตข้างเตียง พร้อมระบบ Digital Keyless เข้าห้องพักได้ทันทีผ่านสมาร์ตโฟนของคุณ
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Room Amenities Grid -->
                    <div class="sm-detail-card mb-4" data-aos="fade-up">
                        <h3 class="sm-detail-card-title">
                            <i class="fa-solid fa-list-check text-primary me-2"></i>สิ่งอำนวยความสะดวกภายในห้องพัก
                        </h3>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-bolt text-info me-2"></i>Smart Tech &amp; Entertainment</h6>
                                <ul class="sm-amenity-list">
                                    <li><i class="fa-solid fa-check text-success"></i> Free Wi-Fi 6 ความเร็วระดับ Gigabit</li>
                                    <li><i class="fa-solid fa-check text-success"></i> Smart TV 4K รองรับ Netflix / YouTube / AirPlay</li>
                                    <li><i class="fa-solid fa-check text-success"></i> แผงควบคุมไฟ Mood Lighting อัจฉริยะ</li>
                                    <li><i class="fa-solid fa-check text-success"></i> ช่องชาร์จ Universal USB-C Fast Charge ข้างเตียง</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-spa text-info me-2"></i>Comfort &amp; Bathroom</h6>
                                <ul class="sm-amenity-list">
                                    <li><i class="fa-solid fa-check text-success"></i> ที่นอน Pocket Spring ระดับพรีเมียมพร้อมท็อปเปอร์</li>
                                    <li><i class="fa-solid fa-check text-success"></i> เครื่องชงกาแฟแคปซูล มินิบาร์ และกาน้ำร้อน</li>
                                    <li><i class="fa-solid fa-check text-success"></i> ห้องน้ำแยกเปียก-แห้ง พร้อมไดร์เป่าผมแรงลมสูง</li>
                                    <li><i class="fa-solid fa-check text-success"></i> ตู้นิรภัยดิจิทัลขนาดใส่ Laptop 16" ได้</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- =========================================================
                         ★ NEW: INTERACTIVE GUEST REVIEWS SECTION ★
                         (แสดงรีวิวเจาะลึกแบบ Dynamic ปรับเปลี่ยนข้อความตามห้องที่เลือก)
                         ========================================================= -->
                    <div class="sm-detail-card mb-4" data-aos="fade-up">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="sm-detail-card-title mb-0">
                                <i class="fa-solid fa-comments text-primary me-2"></i>รีวิวจากผู้เข้าพักจริง (Guest Reviews)
                            </h3>
                            <div class="sm-review-summary-badge">
                                <span class="text-warning"><i class="fa-solid fa-star"></i> <span id="reviewScoreBadge">4.9</span>/5.0</span>
                            </div>
                        </div>

                        <!-- Review Stream Container -->
                        <div class="sm-reviews-container d-grid gap-3" id="dynamicReviewsList">
                            <!-- Populated Dynamically via JS -->
                        </div>
                    </div>

                </div>

                <!-- Right Column: Sticky Smart Booking & Price Simulator -->
                <div class="col-lg-4">
                    <aside class="sm-sticky-booking-panel" data-aos="fade-left">
                        <div class="sm-booking-panel-header">
                            <div>
                                <span class="sm-panel-tag">INSTANT RATE SIMULATOR</span>
                                <h4 class="text-white fw-bold mb-0 mt-1" id="panelRoomName">Deluxe Room</h4>
                            </div>
                            <div class="text-end">
                                <span class="sm-panel-price" id="panelBasePrice">฿1,800</span>
                                <small class="d-block text-light opacity-75">/ คืน</small>
                            </div>
                        </div>

                        <div class="sm-booking-panel-body">
                            <div class="mb-3">
                                <label class="sm-form-label">วันเช็คอิน (Check-in)</label>
                                <input type="date" id="simCheckIn" class="form-control sm-input" />
                            </div>
                            <div class="mb-3">
                                <label class="sm-form-label">วันเช็คเอาท์ (Check-out)</label>
                                <input type="date" id="simCheckOut" class="form-control sm-input" />
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="sm-form-label">จำนวนผู้เข้าพัก</label>
                                    <select id="simGuests" class="form-select sm-input">
                                        <option value="1">1 ท่าน</option>
                                        <option value="2" selected>2 ท่าน</option>
                                        <option value="3">3 ท่าน (+เตียงเสริม)</option>
                                        <option value="4">4 ท่าน</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="sm-form-label">โปรโมชั่นจำลอง</label>
                                    <select id="simPromo" class="form-select sm-input">
                                        <option value="none">ราคาปกติ</option>
                                        <option value="pay2" selected>มา 3 จ่าย 2</option>
                                        <option value="stay3">Stay 3+ Nights (-20%)</option>
                                        <option value="weekly">Weekly Escape (-25%)</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Live Price Breakdown -->
                            <div class="sm-price-breakdown">
                                <div class="d-flex justify-content-between mb-1">
                                    <span id="calcNightText">ราคาห้องพัก (1 คืน)</span>
                                    <strong id="calcSubTotal">฿1,800</strong>
                                </div>
                                <div class="d-flex justify-content-between mb-1 text-success" id="calcPromoRow">
                                    <span id="calcPromoLabel"><i class="fa-solid fa-tag me-1"></i>สิทธิพิเศษโปรโมชั่น</span>
                                    <strong id="calcDiscount">-฿0</strong>
                                </div>
                                <hr class="my-2" />
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <span class="fw-bold text-dark">ยอดประมาณการสุทธิ</span>
                                    <span class="sm-total-highlight" id="calcGrandTotal">฿1,800</span>
                                </div>
                                <small class="text-muted d-block mt-1">* ตัวเลขจำลองเบื้องต้นสำหรับการออกแบบ UI เท่านั้น</small>
                            </div>

                            <!-- CTA Buttons -->
                            <div class="d-grid gap-2 mt-3">
                                <a asp-controller="Account" asp-action="Login" class="sm-btn-search justify-content-center py-3">
                                    <i class="fa-solid fa-calendar-check"></i>
                                    <span>เข้าสู่ระบบเพื่อทำการจองห้องพัก</span>
                                </a>
                                <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-secondary rounded-3 py-2 small">
                                    <i class="fa-regular fa-comments me-1"></i> สอบถามพนักงานต้อนรับ
                                </a>
                            </div>
                        </div>
                    </aside>
                </div>
            </div>

        </div>
    </section>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof AOS !== "undefined") {
                AOS.init({ duration: 700, once: true, offset: 50 });
            }

            // ข้อมูลห้องพัก พร้อมลิงก์รูปภาพภายนอก แยกตามประเภทภาพ
            const roomCatalog = {
                standard: {
                    code: "TYPE A · URBAN MINIMAL",
