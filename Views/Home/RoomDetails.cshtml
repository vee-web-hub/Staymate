@model StayMate_Kavinvee_0576.Models.ViewModels.RoomDetailsViewModel
@{
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
    var room = Model.Room;
    ViewData["Title"] = room.TypeName;

    var guestsText = room.MinGuests == room.MaxGuests
        ? $"{room.MaxGuests} ท่าน"
        : $"{room.MinGuests}–{room.MaxGuests} ท่าน" + (room.AllowExtraBed ? " (เสริมเตียงได้)" : "");

    var thumbLabels = new[] { "มุมพักผ่อนหลัก", "Ambient & View", "Smart Room" };
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />
    <link rel="stylesheet" href="~/css/Home.css" asp-append-version="true" />
}

<div class="sm-home-wrapper">

    <!-- 1. TOP BAR: breadcrumb + ตัวสลับประเภทห้อง (ลิงก์ไปหน้าห้องอื่นตาม id ใน DB) -->
    <section class="sm-detail-header-bar sm-full-bleed">
        <div class="container">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb sm-breadcrumb mb-0">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">หน้าแรก</a></li>
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Rooms">ประเภทห้องพัก</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@room.TypeName</li>
                    </ol>
                </nav>

                <div class="sm-room-switcher" role="tablist" aria-label="เลือกดูประเภทห้องพัก">
                    <span class="sm-switcher-label d-none d-md-inline"><i class="fa-solid fa-repeat me-1"></i> เลือกดูห้อง:</span>
                    @foreach (var r in Model.AllRooms)
                    {
                        <a asp-controller="Home" asp-action="RoomDetails" asp-route-id="@r.RoomTypeId"
                           class="sm-switch-pill text-decoration-none @(r.RoomTypeId == room.RoomTypeId ? "active" : "")">@r.TypeName.Replace(" Room", "")</a>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- 2. MAIN DETAILS -->
    <section class="sm-section pt-4">
        <div class="container">

            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4" data-aos="fade-up">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="sm-eyebrow mb-0">@room.Code</span>
                        <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle">
                            <i class="fa-solid fa-bolt me-1"></i>Smart Room 100%
                        </span>
                    </div>
                    <h1 class="sm-section-title mb-1">@room.TypeName</h1>
                    <p class="text-secondary mb-0">@room.Tagline</p>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="sm-rating-chip">
                        <span class="sm-rating-score">
                            <i class="fa-solid fa-star text-warning me-1"></i>@(Model.AverageRating.HasValue ? Model.AverageRating.Value.ToString("0.0") : "–")
                        </span>
                        <span class="sm-rating-text">
                            @(Model.ReviewCount > 0 ? $"จาก {Model.ReviewCount} รีวิวผู้เข้าพักจริง" : "ยังไม่มีรีวิว")
                        </span>
                    </div>
                    <a asp-controller="Home" asp-action="Rooms" class="btn btn-outline-secondary rounded-pill btn-sm px-3">
                        <i class="fa-solid fa-arrow-left me-1"></i> ดูห้องทั้งหมด
                    </a>
                </div>
            </div>

            <!-- Gallery -->
            <div class="row g-3 mb-5" data-aos="fade-up" data-aos-delay="50">
                <div class="col-lg-8">
                    <div class="sm-gallery-main-wrap">
                        <img id="mainGalleryImg" src="@room.Gallery[0]" alt="@room.TypeName" class="sm-gallery-main-img" />
                        <span class="sm-gallery-badge">
                            <i class="fa-solid fa-camera me-1"></i> StayMate Official Room Preview
                        </span>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="row g-3 h-100">
                        @for (var i = 0; i < 3; i++)
                        {
                            var img = room.Gallery.Length > i ? room.Gallery[i] : room.Gallery[0];
                            <div class="@(i == 0 ? "col-4 col-lg-12" : "col-4 col-lg-6")">
                                <div class="sm-gallery-thumb @(i == 0 ? "active" : "")" data-src="@img">
                                    <img src="@img" alt="@thumbLabels[i]" loading="lazy" />
                                    <span>@thumbLabels[i]</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <!-- Left -->
                <div class="col-lg-8">

                    <div class="sm-detail-specs-bar mb-4" data-aos="fade-up">
                        @if (room.SizeSqm > 0)
                        {
                            <div class="sm-detail-spec-item">
                                <i class="fa-solid fa-maximize"></i>
                                <div><small>ขนาดห้องพัก</small><strong>@room.SizeText</strong></div>
                            </div>
                        }
                        <div class="sm-detail-spec-item">
                            <i class="fa-solid fa-user-group"></i>
                            <div><small>จำนวนผู้เข้าพัก</small><strong>@guestsText</strong></div>
                        </div>
                        <div class="sm-detail-spec-item">
                            <i class="fa-solid fa-bed"></i>
                            <div><small>ประเภทเตียง</small><strong>@(room.BedType ?? "-")</strong></div>
                        </div>
                        <div class="sm-detail-spec-item">
                            <i class="fa-solid fa-city"></i>
                            <div><small>ทิวทัศน์</small><strong>@room.ViewText</strong></div>
                        </div>
                    </div>

                    <div class="sm-detail-card mb-4" data-aos="fade-up">
                        <h3 class="sm-detail-card-title">
                            <i class="fa-solid fa-wand-magic-sparkles text-primary me-2"></i>รายละเอียดและแนวคิดการออกแบบ
                        </h3>
                        <p class="text-secondary lh-lg mb-3">@room.Description</p>

                        @if (room.AllowExtraBed)
                        {
                            <p class="text-secondary mb-3">
                                <i class="fa-solid fa-bed text-info me-1"></i>
                                รองรับเตียงเสริม ค่าบริการ <strong>฿@room.ExtraBedPrice.ToString("N0")</strong> / คืน
                            </p>
                        }

                        <div class="sm-smart-tech-banner">
                            <div class="sm-tech-icon"><i class="fa-solid fa-microchip"></i></div>
                            <div>
                                <strong>StayMate Smart Room Ecosystem</strong>
                                <p class="mb-0 small text-light opacity-75">
                                    ปรับโหมดแสงไฟภายในห้อง (Focus / Relax / Sleep / Cyber Glow) ผ่านแท็บเล็ตข้างเตียง พร้อมระบบ Digital Keyless เข้าห้องพักได้ทันทีผ่านสมาร์ตโฟนของคุณ
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="sm-detail-card mb-4" data-aos="fade-up">
                        <h3 class="sm-detail-card-title">
                            <i class="fa-solid fa-list-check text-primary me-2"></i>สิ่งอำนวยความสะดวกภายในห้องพัก
                        </h3>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-bolt text-info me-2"></i>จุดเด่นของห้องนี้</h6>
                                <ul class="sm-amenity-list">
                                    @foreach (var h in room.Highlights.Where(x => !string.IsNullOrWhiteSpace(x)))
                                    {
                                        <li><i class="fa-solid fa-check text-success"></i> @h</li>
                                    }
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-spa text-info me-2"></i>มาตรฐานทุกห้อง</h6>
                                <ul class="sm-amenity-list">
                                    <li><i class="fa-solid fa-check text-success"></i> Free Wi-Fi 6 ความเร็วระดับ Gigabit</li>
                                    <li><i class="fa-solid fa-check text-success"></i> แผงควบคุมไฟ Mood Lighting อัจฉริยะ</li>
                                    <li><i class="fa-solid fa-check text-success"></i> ช่องชาร์จ USB-C Fast Charge ข้างเตียง</li>
                                    <li><i class="fa-solid fa-check text-success"></i> ตู้นิรภัยดิจิทัลและมินิบาร์</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- รีวิวจริงจากตาราง reviews (เฉพาะการจองที่มีห้องประเภทนี้) -->
                    <div class="sm-detail-card mb-4" data-aos="fade-up">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="sm-detail-card-title mb-0">
                                <i class="fa-solid fa-comments text-primary me-2"></i>รีวิวจากผู้เข้าพักจริง (Guest Reviews)
                            </h3>
                            @if (Model.AverageRating.HasValue)
                            {
                                <div class="sm-review-summary-badge">
                                    <span class="text-warning"><i class="fa-solid fa-star"></i> @Model.AverageRating.Value.ToString("0.0")/5.0</span>
                                </div>
                            }
                        </div>

                        <div class="sm-reviews-container d-grid gap-3">
                            @if (!Model.Reviews.Any())
                            {
                                <div class="text-muted text-center py-3">ยังไม่มีรีวิวสำหรับห้องประเภทนี้</div>
                            }
                            @foreach (var rev in Model.Reviews)
                            {
                                var name = string.IsNullOrWhiteSpace(rev.UserName) ? "ผู้เข้าพัก" : rev.UserName;
                                <div class="p-3 rounded-4 bg-light border border-light-subtle d-flex flex-column gap-2">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="sm-avatar-placeholder">@name.Substring(0, 1)</div>
                                            <div>
                                                <strong class="text-dark d-block">@name</strong>
                                                <span class="text-muted" style="font-size: 0.76rem;">
                                                    <i class="fa-regular fa-calendar-check me-1"></i>รีวิวเมื่อ: @rev.CreatedAt.ToString("dd/MM/yyyy")
                                                </span>
                                            </div>
                                        </div>
                                        <div class="sm-rating-stars-wrap">
                                            @for (var s = 1; s <= 5; s++)
                                            {
                                                if (s <= rev.Rating)
                                                {
                                                    <i class="fa-solid fa-star text-warning me-1"></i>
                                                }
                                                else
                                                {
                                                    <i class="fa-regular fa-star text-muted me-1"></i>
                                                }
                                            }
                                            <span class="fw-bold text-dark ms-1" style="font-size: 0.88rem;">(@rev.Rating)</span>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(rev.Comment))
                                    {
                                        <p class="text-secondary mb-0 small lh-lg" style="font-style: italic;">“@rev.Comment”</p>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Right: Price simulator -->
                <div class="col-lg-4">
                    <aside class="sm-sticky-booking-panel" data-aos="fade-left">
                        <div class="sm-booking-panel-header">
                            <div>
                                <span class="sm-panel-tag">INSTANT RATE SIMULATOR</span>
                                <h4 class="text-white fw-bold mb-0 mt-1">@room.TypeName</h4>
                            </div>
                            <div class="text-end">
                                <span class="sm-panel-price">฿@room.Price.ToString("N0")</span>
                                <small class="d-block text-light opacity-75">/ คืน</small>
                            </div>
                        </div>

                        <div class="sm-booking-panel-body">
                            <div class="mb-3">
                                <label class="sm-form-label" for="simCheckIn">วันเช็คอิน (Check-in)</label>
                                <input type="date" id="simCheckIn" class="form-control sm-input" />
                            </div>
                            <div class="mb-3">
                                <label class="sm-form-label" for="simCheckOut">วันเช็คเอาท์ (Check-out)</label>
                                <input type="date" id="simCheckOut" class="form-control sm-input" />
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="sm-form-label" for="simGuests">จำนวนผู้เข้าพัก</label>
                                    <select id="simGuests" class="form-select sm-input">
                                        @for (var g = 1; g <= room.MaxGuests; g++)
                                        {
                                            <option value="@g" selected="@(g == Math.Max((int)room.MinGuests, 2) || (room.MaxGuests < 2 && g == 1))">@g ท่าน</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-6">
                                    <label class="sm-form-label" for="simPromo">โปรโมชั่นจำลอง</label>
                                    <select id="simPromo" class="form-select sm-input">
                                        <option value="-1">ราคาปกติ</option>
                                        @for (var i = 0; i < Model.Promos.Count; i++)
                                        {
                                            <option value="@i">@Model.Promos[i].Name</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="sm-price-breakdown">
                                <div class="d-flex justify-content-between mb-1">
                                    <span id="calcNightText">ราคาห้องพัก (1 คืน)</span>
                                    <strong id="calcSubTotal">฿@room.Price.ToString("N0")</strong>
                                </div>
                                <div class="d-flex justify-content-between mb-1" id="calcExtraRow">
                                    <span><i class="fa-solid fa-bed me-1"></i>ค่าเตียงเสริม</span>
                                    <strong id="calcExtra">฿0</strong>
                                </div>
                                <div class="d-flex justify-content-between mb-1 text-success">
                                    <span id="calcPromoLabel"><i class="fa-solid fa-tag me-1"></i>ไม่มีส่วนลด</span>
                                    <strong id="calcDiscount">฿0</strong>
                                </div>
                                <hr class="my-2" />
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <span class="fw-bold text-dark">ยอดประมาณการสุทธิ</span>
                                    <span class="sm-total-highlight" id="calcGrandTotal">฿@room.Price.ToString("N0")</span>
                                </div>
                                <small class="text-muted d-block mt-1">* ตัวเลขประมาณการเบื้องต้น ราคาจริงคำนวณตอนยืนยันการจอง</small>
                            </div>

                            <div class="d-grid gap-2 mt-3">
                                <a asp-controller="Account" asp-action="Login" class="sm-btn-search justify-content-center py-3">
                                    <i class="fa-solid fa-calendar-check"></i>
                                    <span>เข้าสู่ระบบเพื่อทำการจองห้องพัก</span>
                                </a>
                                <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-secondary rounded-3 py-2 small">
                                    <i class="fa-regular fa-comments me-1"></i> สอบถามพนักงานต้อนรับ
                                </a>
                            </div>
                        </div>
                    </aside>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof AOS !== "undefined") {
                AOS.init({ duration: 700, once: true, offset: 50 });
            }

            // ---------- ข้อมูลจาก DB ----------
            const room = @Json.Serialize(new {
                price = room.Price,
                allowExtraBed = room.AllowExtraBed,
                extraBedPrice = room.ExtraBedPrice,
                baseGuests = Math.Max((int)room.MinGuests, 2)
            });
            const promos = @Json.Serialize(Model.Promos);

            // ---------- Gallery ----------
            const imageFallback = "data:image/svg+xml;charset=UTF-8," + encodeURIComponent(
                '<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="800"><rect width="1200" height="800" fill="#e9edf2"/>' +
                '<text x="600" y="410" text-anchor="middle" font-family="Arial,sans-serif" font-size="34" fill="#526071">Image temporarily unavailable</text></svg>'
            );
            document.querySelectorAll("#mainGalleryImg, .sm-gallery-thumb img").forEach(img => {
                img.addEventListener("error", function () {
                    if (this.src !== imageFallback) this.src = imageFallback;
                });
            });

            const mainImg = document.getElementById("mainGalleryImg");
            const thumbs = document.querySelectorAll(".sm-gallery-thumb");
            thumbs.forEach(thumb => {
                thumb.addEventListener("click", function () {
                    thumbs.forEach(t => t.classList.remove("active"));
                    this.classList.add("active");
                    mainImg.src = this.getAttribute("data-src");
                });
            });

            // ---------- Simulator ----------
            const simIn = document.getElementById("simCheckIn");
            const simOut = document.getElementById("simCheckOut");
            const simGuests = document.getElementById("simGuests");
            const simPromo = document.getElementById("simPromo");

            const pad = n => String(n).padStart(2, "0");
            const fmt = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
            const baht = n => "฿" + Math.round(n).toLocaleString("en-US");

            const today = new Date();
            const tomorrow = new Date(today);
            tomorrow.setDate(today.getDate() + 1);
            simIn.min = fmt(today);
            simIn.value = fmt(today);
            simOut.min = fmt(tomorrow);
            simOut.value = fmt(tomorrow);

            simIn.addEventListener("change", function () {
                if (!this.value) return;
                const d = new Date(this.value + "T00:00:00");
                d.setDate(d.getDate() + 1);
                simOut.min = fmt(d);
                if (!simOut.value || new Date(simOut.value + "T00:00:00") <= new Date(this.value + "T00:00:00")) {
                    simOut.value = fmt(d);
                }
            });

            function calculate() {
                const d1 = new Date(simIn.value + "T00:00:00");
                const d2 = new Date(simOut.value + "T00:00:00");
                let nights = Math.round((d2 - d1) / 86400000);
                if (isNaN(nights) || nights < 1) nights = 1;

                const guests = parseInt(simGuests.value, 10) || 1;
                const subTotal = room.price * nights;

                // ต้องเสริมเตียงเมื่อจำนวนคนเกินความจุมาตรฐาน (สมมติ = max(min_guests, 2))
                const needExtra = room.allowExtraBed && guests > room.baseGuests;
                const extra = needExtra ? room.extraBedPrice * nights : 0;

                let discount = 0;
                let label = "ไม่มีส่วนลด";
                const idx = parseInt(simPromo.value, 10);
                const p = idx >= 0 ? promos[idx] : null;

                if (p) {
                    if (p.minGuests && guests < p.minGuests) {
                        label = `ยังไม่เข้าเงื่อนไข: ต้องมี ${p.minGuests} ท่านขึ้นไป`;
                    } else if (p.type === "free_extra_bed") {
                        if (needExtra) { discount = extra; label = p.name; }
                        else { label = "ยังไม่เข้าเงื่อนไข: ต้องมีการใช้เตียงเสริม"; }
                    } else if (p.type === "percent_room") {
                        if (p.minNights && nights < p.minNights) {
                            label = `ยังไม่เข้าเงื่อนไข: พักขั้นต่ำ ${p.minNights} คืน`;
                        } else {
                            discount = subTotal * p.percent / 100;
                            label = `${p.name} (-${p.percent}%)`;
                        }
                    } else if (p.type === "percent_extra_nights") {
                        let extraNights = Math.max(0, nights - (p.minNights || 0));
                        if (p.maxDiscountNights) extraNights = Math.min(extraNights, p.maxDiscountNights);
                        if (extraNights > 0) {
                            discount = room.price * extraNights * p.percent / 100;
                            label = `${p.name} (-${p.percent}% ${extraNights} คืน)`;
                        } else {
                            label = `ยังไม่เข้าเงื่อนไข: พักเกิน ${p.minNights || 0} คืน`;
                        }
                    }
                }

                const grand = Math.max(0, subTotal + extra - discount);

                document.getElementById("calcNightText").textContent = `ราคาห้องพัก (${nights} คืน)`;
                document.getElementById("calcSubTotal").textContent = baht(subTotal);
                document.getElementById("calcExtraRow").style.display = extra > 0 ? "" : "none";
                document.getElementById("calcExtra").textContent = baht(extra);
                document.getElementById("calcPromoLabel").innerHTML = `<i class="fa-solid fa-tag me-1"></i>${label}`;
                document.getElementById("calcDiscount").textContent = discount > 0 ? "-" + baht(discount) : "฿0";
                document.getElementById("calcGrandTotal").textContent = baht(grand);
            }

            [simIn, simOut, simGuests, simPromo].forEach(el => el.addEventListener("change", calculate));
            calculate();
        });
    </script>
}
