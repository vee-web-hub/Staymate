@model StayMate_Kavinvee_0576.ViewModels.ReceptionIndexViewModel
@{
    ViewData["Title"] = "Check-out Management";
    Layout = "~/Views/Shared/_ReceptionLayout.cshtml";

    var thaiCulture = new System.Globalization.CultureInfo("th-TH");
    var now = DateTime.Now;
    var today = DateOnly.FromDateTime(DateTime.Today);
    var currentDateText = now.ToString("วันddddที่ d MMMM yyyy", thaiCulture);

    var allStayItems = Model?.CheckOutList ?? new List<StayMate_Kavinvee_0576.ViewModels.ReceptionStayViewModel>();

    var activeCheckOuts = allStayItems
        .Where(s => !s.CheckedOutAt.HasValue)
        .OrderBy(s => s.CheckOutDate)
        .ThenBy(s => s.RoomNumber)
        .ToList();

    var historyCheckOuts = allStayItems
        .Where(s => s.CheckedOutAt.HasValue)
        .OrderByDescending(s => s.CheckedOutAt)
        .ToList();

    int occupiedRoomsCount = (Model?.OccupiedRooms ?? 0) > 0
        ? Model!.OccupiedRooms
        : activeCheckOuts.Count;

    int dueTodayCount = (Model?.TodayCheckOuts ?? 0) > 0
        ? Model!.TodayCheckOuts
        : activeCheckOuts.Count(s => s.CheckOutDate == today);

    int overdueCheckOutCount = activeCheckOuts.Count(s =>
        s.CheckOutDate < today ||
        (s.CheckOutDate == today && now > s.CheckOutDate.ToDateTime(new TimeOnly(12, 0))));

    int completedCheckOutCount = historyCheckOuts.Count;
}

@section Styles {
    <link rel="stylesheet" href="~/css/reception.css" asp-append-version="true" />
}

<div class="reception-dashboard-wrapper reception-checkout-page" id="receptionCheckOutApp">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="reception-checkin-alert reception-alert-success reception-fade-in" role="alert">
            <div class="reception-alert-icon"><i class="fa-solid fa-circle-check"></i></div>
            <div class="reception-alert-content">
                <strong>ดำเนินการสำเร็จ</strong>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="reception-checkin-alert reception-alert-danger reception-fade-in" role="alert">
            <div class="reception-alert-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <div class="reception-alert-content">
                <strong>ไม่สามารถดำเนินการได้</strong>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Page Header -->
    <section class="reception-page-header reception-checkout-header reception-fade-in">
        <div class="reception-header-left">
            <div class="reception-title-badge">
                <span class="reception-live-dot"></span>
                <span>FRONT DESK CHECK-OUT</span>
            </div>
            <h1 class="reception-main-title">
                <i class="fa-solid fa-arrow-right-from-bracket reception-checkout-title-icon"></i>
                Guest Check-out
            </h1>
            <p class="reception-welcome-text">
                ข้อมูลประจำ<strong>@currentDateText</strong>
            </p>
        </div>

        <div class="reception-header-right">
            <div class="reception-checkout-pending-pill">
                <i class="fa-solid fa-suitcase-rolling"></i>
                <span>รอ Check-out: <strong>@activeCheckOuts.Count</strong> รายการ</span>
            </div>

            <a asp-controller="Reception" asp-action="CheckOut" class="reception-btn reception-btn-outline" title="รีเฟรชข้อมูล">
                <i class="fa-solid fa-rotate"></i>
                <span>Refresh</span>
            </a>
        </div>
    </section>

    <!-- Summary Cards -->
    <section class="reception-kpi-grid reception-checkout-kpi-grid reception-fade-in">
        <article class="reception-kpi-card reception-kpi-primary">
            <div class="reception-kpi-top">
                <div>
                    <span class="reception-kpi-title">Occupied Rooms</span>
                    <h2 class="reception-kpi-number">@occupiedRoomsCount</h2>
                </div>
                <div class="reception-kpi-icon">
                    <i class="fa-solid fa-bed"></i>
                </div>
            </div>
        </article>

        <article class="reception-kpi-card reception-kpi-warning">
            <div class="reception-kpi-top">
                <div>
                    <span class="reception-kpi-title">Due Check-out Today</span>
                    <h2 class="reception-kpi-number">@dueTodayCount</h2>
                </div>
                <div class="reception-kpi-icon">
                    <i class="fa-solid fa-calendar-day"></i>
                </div>
            </div>
        </article>

        <article class="reception-kpi-card reception-kpi-danger">
            <div class="reception-kpi-top">
                <div>
                    <span class="reception-kpi-title">Overdue Check-out</span>
                    <h2 class="reception-kpi-number">@overdueCheckOutCount</h2>
                </div>
                <div class="reception-kpi-icon">
                    <i class="fa-solid fa-bell"></i>
                </div>
            </div>
        </article>

        <article class="reception-kpi-card reception-kpi-success">
            <div class="reception-kpi-top">
                <div>
                    <span class="reception-kpi-title">Completed Check-outs</span>
                    <h2 class="reception-kpi-number">@completedCheckOutCount</h2>
                </div>
                <div class="reception-kpi-icon">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
            </div>
        </article>
    </section>

    <!-- Search & Filter Bar -->
    <section class="reception-checkout-filter-card reception-fade-in">
        <form asp-controller="Reception" asp-action="CheckOut" method="get" id="checkOutFilterForm" class="reception-checkout-filter-grid">
            <div class="reception-checkout-field">
                <label for="coSearchGuest"><i class="fa-regular fa-user"></i> ชื่อผู้เข้าพัก</label>
                <input type="text"
                       name="guestName"
                       id="coSearchGuest"
                       value="@Context.Request.Query["guestName"]"
                       class="reception-filter-control"
                       placeholder="ค้นหาชื่อผู้เข้าพัก..."
                       autocomplete="off" />
            </div>

            <div class="reception-checkout-field">
                <label for="coSearchCode"><i class="fa-solid fa-barcode"></i> Booking ID</label>
                <input type="text"
                       name="bookingCode"
                       id="coSearchCode"
                       value="@Context.Request.Query["bookingCode"]"
                       class="reception-filter-control"
                       placeholder="ค้นหา Booking ID..."
                       autocomplete="off" />
            </div>

            <div class="reception-checkout-field">
                <label for="coSearchRoom"><i class="fa-solid fa-door-open"></i> หมายเลขห้อง</label>
                <input type="text"
                       name="roomNumber"
                       id="coSearchRoom"
                       value="@Context.Request.Query["roomNumber"]"
                       class="reception-filter-control"
                       placeholder="ค้นหาหมายเลขห้อง..."
                       autocomplete="off" />
            </div>

            <div class="reception-checkout-field">
                <label for="coFilterStatus"><i class="fa-solid fa-filter"></i> สถานะ</label>
                <select name="statusFilter" id="coFilterStatus" class="reception-filter-control">
                    <option value="all">ทั้งหมด</option>
                    <option value="due_today">ครบกำหนดวันนี้</option>
                    <option value="overdue">เกินกำหนด</option>
                    <option value="staying">กำลังเข้าพัก</option>
                    <option value="completed">Check-out แล้ว</option>
                </select>
            </div>

            <div class="reception-checkout-filter-actions">
                <button type="submit" class="reception-btn reception-btn-primary">
                    <i class="fa-solid fa-magnifying-glass"></i> ค้นหา
                </button>
                <a asp-controller="Reception" asp-action="CheckOut" id="btnResetCheckOutFilters" class="reception-btn reception-btn-ghost">
                    <i class="fa-solid fa-rotate-left"></i> ล้างค่า
                </a>
            </div>
        </form>
    </section>

    <!-- Check-out Tables with Tabs -->
    <section class="reception-panel reception-checkout-main-panel reception-fade-in">
        <div class="reception-checkout-tabs-header">
            <div class="reception-checkout-tabs" role="tablist">
                <button type="button"
                        class="reception-checkout-tab-btn active"
                        data-tab-target="tabPendingCheckOut"
                        role="tab"
                        aria-selected="true">
                    <i class="fa-solid fa-hourglass-half"></i>
                    <span>รอ Check-out</span>
                    <span class="reception-tab-counter" id="badgePendingCount">@activeCheckOuts.Count</span>
                </button>

                <button type="button"
                        class="reception-checkout-tab-btn"
                        data-tab-target="tabHistoryCheckOut"
                        role="tab"
                        aria-selected="false">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                    <span>ประวัติ Check-out</span>
                    <span class="reception-tab-counter is-history" id="badgeHistoryCount">@historyCheckOuts.Count</span>
                </button>
            </div>

            <div class="reception-checkout-policy-hint">
                <i class="fa-solid fa-broom text-warning"></i>
                <span>Check-out แล้วห้องจะเปลี่ยนเป็น <strong>Cleaning</strong> และแจ้งแม่บ้านอัตโนมัติ</span>
            </div>
        </div>

        <!-- Tab 1: Active Stays -->
        <div class="reception-checkout-tab-pane active" id="tabPendingCheckOut" role="tabpanel">
            @if (activeCheckOuts.Any())
            {
                <div class="reception-table-responsive">
                    <table class="reception-table reception-checkout-table">
                        <thead>
                            <tr>
                                <th>Booking ID</th>
                                <th>ชื่อผู้เข้าพัก</th>
                                <th>หมายเลขห้อง</th>
                                <th>ประเภทห้อง</th>
                                <th>วันเข้าพัก</th>
                                <th>วันออก</th>
                                <th>เวลา Check-in</th>
                                <th>สถานะ</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody id="pendingCheckOutBody">
                            @foreach (var stay in activeCheckOuts)
                            {
                                var codeDisplay = string.IsNullOrWhiteSpace(stay.BookingCode) ? $"#{stay.BookingId}" : stay.BookingCode;
                                var checkOutCutoff = stay.CheckOutDate.ToDateTime(new TimeOnly(12, 0));
                                bool canCheckOutNow = now >= checkOutCutoff;

                                bool isDueToday = stay.CheckOutDate == today;
                                bool isOverdue = stay.CheckOutDate < today || (stay.CheckOutDate == today && now > checkOutCutoff);

                                string stayStateKey = isOverdue ? "overdue" : (isDueToday ? "due_today" : "staying");
                                string statusBadgeClass = isOverdue
                                    ? "reception-cobadge-overdue"
                                    : (isDueToday ? "reception-cobadge-duetoday" : "reception-cobadge-staying");

                                string statusBadgeText = isOverdue
                                    ? "Overdue"
                                    : (isDueToday ? "Due Today" : "Checked-in");

                                string checkInTimeText = stay.CheckedInAt.HasValue
                                    ? stay.CheckedInAt.Value.ToString("dd/MM/yyyy HH:mm")
                                    : stay.CheckInDate.ToString("dd/MM/yyyy");

                                <tr class="reception-checkout-row"
                                    data-guest="@stay.GuestName.ToLowerInvariant()"
                                    data-code="@codeDisplay.ToLowerInvariant()"
                                    data-room="@stay.RoomNumber.ToLowerInvariant()"
                                    data-status="@stayStateKey">

                                    <td data-label="Booking ID">
                                        <span class="reception-code-badge">@codeDisplay</span>
                                    </td>
                                    <td data-label="ชื่อผู้เข้าพัก">
                                        <div class="reception-guest-cell">
                                            <strong>@stay.GuestName</strong>
                                            <small><i class="fa-solid fa-phone"></i> @stay.GuestPhone · @(stay.ActualGuests ?? stay.NumGuests) ท่าน</small>
                                        </div>
                                    </td>
                                    <td data-label="หมายเลขห้อง">
                                        <span class="reception-room-chip">
                                            <i class="fa-solid fa-door-open me-1"></i>ห้อง @stay.RoomNumber
                                        </span>
                                    </td>
                                    <td data-label="ประเภทห้อง">
                                        <span>@stay.RoomTypeName</span>
                                    </td>
                                    <td data-label="วันเข้าพัก">
                                        <span class="reception-time-text">@stay.CheckInDate.ToString("dd/MM/yyyy")</span>
                                    </td>
                                    <td data-label="วันออก">
                                        <span class="reception-time-text fw-semibold @(isOverdue ? "text-danger" : (isDueToday ? "text-warning" : ""))">
                                            @stay.CheckOutDate.ToString("dd/MM/yyyy")
                                        </span>
                                    </td>
                                    <td data-label="เวลา Check-in">
                                        <span class="reception-checkin-timestamp">
                                            <i class="fa-regular fa-clock text-info me-1"></i>@checkInTimeText
                                        </span>
                                    </td>
                                    <td data-label="สถานะ">
                                        <span class="reception-status-badge @statusBadgeClass">
                                            @statusBadgeText
                                        </span>
                                    </td>
                                    <td data-label="Action" class="text-end">
                                        <div class="reception-action-group justify-content-end">
                                            <a asp-controller="Reception"
                                               asp-action="Bookings"
                                               asp-route-search="@codeDisplay"
                                               class="reception-btn-sm reception-btn-ghost"
                                               title="ดูรายละเอียด">
                                                <i class="fa-regular fa-eye"></i> รายละเอียด
                                            </a>

                                            @if (canCheckOutNow)
                                            {
                                                <button type="button"
                                                        class="reception-btn-sm reception-btn-checkout-cta js-open-checkout-modal"
                                                        data-booking-id="@stay.BookingId"
                                                        data-stay-id="@stay.StayId"
                                                        data-booking-code="@codeDisplay"
                                                        data-guest-name="@stay.GuestName"
                                                        data-guest-phone="@stay.GuestPhone"
                                                        data-room-number="@stay.RoomNumber"
                                                        data-room-type="@stay.RoomTypeName"
                                                        data-checkin-date="@stay.CheckInDate.ToString("dd/MM/yyyy")"
                                                        data-checkout-date="@stay.CheckOutDate.ToString("dd/MM/yyyy")"
                                                        data-checkin-time="@checkInTimeText"
                                                        data-guests="@(stay.ActualGuests ?? stay.NumGuests)"
                                                        data-status-text="@statusBadgeText">
                                                    <i class="fa-solid fa-arrow-right-from-bracket"></i> Check-out
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="reception-btn-sm reception-btn-ghost"
                                                        disabled
                                                        title="กด Check-out ได้ตั้งแต่ @checkOutCutoff.ToString("dd/MM/yyyy HH:mm") น.">
                                                    <i class="fa-solid fa-clock"></i> รอ @checkOutCutoff.ToString("dd/MM HH:mm")
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="reception-checkin-empty-state">
                    <div class="reception-empty-key-icon">
                        <i class="fa-solid fa-suitcase-rolling"></i>
                    </div>
                    <h4>ไม่มีรายการรอ Check-out</h4>
                </div>
            }
        </div>

        <!-- Tab 2: Completed History -->
        <div class="reception-checkout-tab-pane" id="tabHistoryCheckOut" role="tabpanel">
            @if (historyCheckOuts.Any())
            {
                <div class="reception-table-responsive">
                    <table class="reception-table reception-checkout-table">
                        <thead>
                            <tr>
                                <th>Booking ID</th>
                                <th>ชื่อผู้เข้าพัก</th>
                                <th>หมายเลขห้อง</th>
                                <th>ประเภทห้อง</th>
                                <th>วันเข้าพัก</th>
                                <th>วันออก</th>
                                <th>เวลา Check-in</th>
                                <th>เวลา Check-out</th>
                                <th>สถานะ</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody id="historyCheckOutBody">
                            @foreach (var done in historyCheckOuts)
                            {
                                var codeDisplay = string.IsNullOrWhiteSpace(done.BookingCode) ? $"#{done.BookingId}" : done.BookingCode;
                                string checkInTimeText = done.CheckedInAt.HasValue
                                    ? done.CheckedInAt.Value.ToString("dd/MM/yyyy HH:mm")
                                    : done.CheckInDate.ToString("dd/MM/yyyy");

                                string checkOutDoneText = done.CheckedOutAt.HasValue
                                    ? done.CheckedOutAt.Value.ToString("dd/MM/yyyy HH:mm")
                                    : "-";

                                <tr class="reception-checkout-row"
                                    data-guest="@done.GuestName.ToLowerInvariant()"
                                    data-code="@codeDisplay.ToLowerInvariant()"
                                    data-room="@done.RoomNumber.ToLowerInvariant()"
                                    data-status="completed">

                                    <td data-label="Booking ID">
                                        <span class="reception-code-badge">@codeDisplay</span>
                                    </td>
                                    <td data-label="ชื่อผู้เข้าพัก">
                                        <div class="reception-guest-cell">
                                            <strong>@done.GuestName</strong>
                                            <small>@done.GuestPhone</small>
                                        </div>
                                    </td>
                                    <td data-label="หมายเลขห้อง">
                                        <span class="reception-room-chip">ห้อง @done.RoomNumber</span>
                                    </td>
                                    <td data-label="ประเภทห้อง">
                                        <span>@done.RoomTypeName</span>
                                    </td>
                                    <td data-label="วันเข้าพัก">
                                        <span>@done.CheckInDate.ToString("dd/MM/yyyy")</span>
                                    </td>
                                    <td data-label="วันออก">
                                        <span>@done.CheckOutDate.ToString("dd/MM/yyyy")</span>
                                    </td>
                                    <td data-label="เวลา Check-in">
                                        <span class="reception-time-text">@checkInTimeText</span>
                                    </td>
                                    <td data-label="เวลา Check-out">
                                        <span class="reception-checkout-done-time">
                                            <i class="fa-solid fa-circle-check text-success me-1"></i>@checkOutDoneText
                                        </span>
                                    </td>
                                    <td data-label="สถานะ">
                                        <span class="reception-status-badge reception-cobadge-completed">
                                            Checked-out
                                        </span>
                                    </td>
                                    <td data-label="Action" class="text-end">
                                        <a asp-controller="Reception"
                                           asp-action="Bookings"
                                           asp-route-search="@codeDisplay"
                                           class="reception-btn-sm reception-btn-ghost">
                                            <i class="fa-regular fa-file-lines"></i> รายละเอียด
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="reception-checkin-empty-state">
                    <div class="reception-empty-key-icon">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </div>
                    <h4>ไม่มีประวัติการ Check-out</h4>
                </div>
            }
        </div>
    </section>
</div>

<!-- Check-out Confirmation Modal -->
<div class="reception-modal-overlay" id="checkOutConfirmModal" aria-hidden="true">
    <div class="reception-modal-dialog reception-checkin-modal-md" role="dialog" aria-labelledby="checkOutModalTitle">
        <div class="reception-modal-header">
            <div>
                <span class="reception-modal-kicker">ROOM RETURN &amp; HOUSEKEEPING</span>
                <h3 class="reception-modal-title" id="checkOutModalTitle">
                    <i class="fa-solid fa-arrow-right-from-bracket text-warning"></i> ยืนยันการ Check-out
                </h3>
            </div>
            <button type="button" class="reception-modal-close" id="btnCloseCheckOutModal" aria-label="ปิด">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="reception-modal-body">
            <div class="reception-checkin-summary-box">
                <div class="reception-checkin-summary-item">
                    <span>Booking ID</span>
                    <strong id="modalCoBookingCode" class="text-primary">-</strong>
                </div>
                <div class="reception-checkin-summary-item">
                    <span>ชื่อผู้เข้าพัก</span>
                    <strong id="modalCoGuestName">-</strong>
                </div>
                <div class="reception-checkin-summary-item">
                    <span>ห้องพัก</span>
                    <strong id="modalCoRoomNumber">-</strong>
                </div>
                <div class="reception-checkin-summary-item">
                    <span>เบอร์โทรศัพท์</span>
                    <strong id="modalCoGuestPhone">-</strong>
                </div>
                <div class="reception-checkin-summary-item">
                    <span>วันที่เข้าพัก - วันที่ออก</span>
                    <strong id="modalCoStayDates">-</strong>
                </div>
                <div class="reception-checkin-summary-item">
                    <span>เวลา Check-in</span>
                    <strong id="modalCoCheckInTime">-</strong>
                </div>
                <div class="reception-checkin-summary-item">
                    <span>จำนวนผู้เข้าพัก</span>
                    <strong id="modalCoGuests">-</strong>
                </div>
                <div class="reception-checkin-summary-item">
                    <span>สถานะปัจจุบัน</span>
                    <strong id="modalCoStatusText">-</strong>
                </div>
            </div>
        </div>

        <div class="reception-modal-footer">
            <button type="button" id="btnCancelCheckOutModal" class="reception-btn reception-btn-ghost">
                ยกเลิก
            </button>

            <form asp-controller="Reception"
                  asp-action="ProcessCheckOutFromBooking"
                  method="post"
                  id="confirmCheckOutForm"
                  class="m-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookingId" id="modalCoInputBookingId" value="" />
                <button type="submit" class="reception-btn reception-btn-checkout-cta">
                    <i class="fa-solid fa-check-double"></i> ยืนยัน Check-out
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/reception-checkout.js" asp-append-version="true"></script>
}
