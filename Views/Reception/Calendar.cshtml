@model StayMate_Kavinvee_0576.ViewModels.ReceptionIndexViewModel
@{
    Layout = "~/Views/Shared/_ReceptionLayout.cshtml";
    ViewData["Title"] = "Room Calendar";
    var thaiCulture = new System.Globalization.CultureInfo("th-TH");

    string viewMode = Context.Request.Query["view"].FirstOrDefault()?.ToLowerInvariant() ?? "week";
    int daysCount = viewMode switch
    {
        "day" => 1,
        "month" => 30,
        _ => 7
    };

    DateOnly today = DateOnly.FromDateTime(DateTime.Today);
    DateOnly startDate = today;
    if (DateOnly.TryParse(Context.Request.Query["startDate"].FirstOrDefault(), out var parsedDate))
    {
        startDate = parsedDate;
    }

    DateOnly endDate = startDate.AddDays(daysCount - 1);
    DateOnly prevStartDate = startDate.AddDays(-daysCount);
    DateOnly nextStartDate = startDate.AddDays(daysCount);

    var timelineStays = new List<StayMate_Kavinvee_0576.ViewModels.ReceptionStayViewModel>();
    if (Model?.CheckInList != null)
    {
        timelineStays.AddRange(Model.CheckInList);
    }
    if (Model?.CheckOutList != null)
    {
        foreach (var stay in Model.CheckOutList)
        {
            if (!timelineStays.Any(x => x.BookingId == stay.BookingId && x.RoomNumber == stay.RoomNumber))
            {
                timelineStays.Add(stay);
            }
        }
    }

    var distinctRoomTypes = Model?.Rooms?
        .Where(r => !string.IsNullOrWhiteSpace(r.RoomTypeName))
        .Select(r => r.RoomTypeName)
        .Distinct()
        .OrderBy(t => t)
        .ToList() ?? new List<string>();

    int totalRoomsCount = (Model?.TotalRooms ?? 0) > 0 ? Model!.TotalRooms : (Model?.Rooms?.Count ?? 0);
    int availableCount = (Model?.AvailableRooms ?? 0) > 0 ? Model!.AvailableRooms : (Model?.Rooms?.Count(r => (r.Status ?? "").ToLowerInvariant() == "available") ?? 0);
    int occupiedCount = (Model?.OccupiedRooms ?? 0) > 0 ? Model!.OccupiedRooms : (Model?.Rooms?.Count(r => (r.Status ?? "").ToLowerInvariant() == "occupied") ?? 0);
    int dirtyCount = (Model?.NeedsCleaningRooms ?? 0) > 0 ? Model!.NeedsCleaningRooms : (Model?.Rooms?.Count(r =>
    {
        var s = (r.Status ?? "").ToLowerInvariant();
        return s == "needs_cleaning" || s == "dirty" || s == "cleaning";
    }) ?? 0);
    int maintenanceCount = (Model?.MaintenanceRooms ?? 0) > 0 ? Model!.MaintenanceRooms : (Model?.Rooms?.Count(r => (r.Status ?? "").ToLowerInvariant() == "maintenance") ?? 0);
    int reservedCount = (Model?.ConfirmedBookings ?? 0) > 0 ? Model!.ConfirmedBookings : timelineStays.Count(s => !s.CheckedInAt.HasValue);
}

@section Styles {
    <link rel="stylesheet" href="~/css/reception.css" asp-append-version="true" />
}

<div class="reception-dashboard-wrapper reception-calendar-page" id="receptionCalendarApp">

    <!-- Page Header -->
    <section class="reception-page-header reception-fade-in">
        <div class="reception-header-left">
            <div class="reception-title-badge">
                <span class="reception-live-dot"></span>
                <span>ROOM INVENTORY &amp; TIMELINE</span>
            </div>
            <h1 class="reception-main-title">
                <i class="fa-regular fa-calendar-days reception-title-icon"></i>
                Room Calendar
            </h1>
            <p class="reception-welcome-text">
                ข้อมูลประจำ<strong>@today.ToString("วันddddที่ d MMMM yyyy", thaiCulture)</strong>
            </p>
        </div>

        <div class="reception-header-right">
            <a asp-controller="Reception"
               asp-action="Calendar"
               asp-route-view="@viewMode"
               asp-route-startDate="@today.ToString("yyyy-MM-dd")"
               class="reception-btn reception-btn-outline">
                <i class="fa-solid fa-calendar-day"></i>
                <span>Today</span>
            </a>

            <button type="button" id="btnCalendarRefresh" class="reception-btn reception-btn-outline" title="รีเฟรชข้อมูล">
                <i class="fa-solid fa-rotate"></i>
                <span>Refresh</span>
            </button>

            <a asp-controller="Reception"
               asp-action="Bookings"
               class="reception-btn reception-btn-primary">
                <i class="fa-solid fa-clipboard-list"></i>
                <span>จัดการการจอง</span>
            </a>
        </div>
    </section>

    <!-- Room Summary Cards -->
    <section class="reception-calendar-summary-grid reception-fade-in">
        <article class="reception-calendar-stat-card reception-stat-total">
            <div class="reception-stat-icon"><i class="fa-solid fa-building"></i></div>
            <div class="reception-stat-info">
                <span class="reception-stat-label">Total Rooms</span>
                <strong class="reception-stat-value">@totalRoomsCount</strong>
            </div>
        </article>

        <article class="reception-calendar-stat-card reception-stat-available">
            <div class="reception-stat-icon"><i class="fa-solid fa-door-open"></i></div>
            <div class="reception-stat-info">
                <span class="reception-stat-label">Available</span>
                <strong class="reception-stat-value">@availableCount</strong>
            </div>
        </article>

        <article class="reception-calendar-stat-card reception-stat-reserved">
            <div class="reception-stat-icon"><i class="fa-solid fa-calendar-check"></i></div>
            <div class="reception-stat-info">
                <span class="reception-stat-label">Reserved</span>
                <strong class="reception-stat-value">@reservedCount</strong>
            </div>
        </article>

        <article class="reception-calendar-stat-card reception-stat-occupied">
            <div class="reception-stat-icon"><i class="fa-solid fa-bed"></i></div>
            <div class="reception-stat-info">
                <span class="reception-stat-label">Occupied</span>
                <strong class="reception-stat-value">@occupiedCount</strong>
            </div>
        </article>

        <article class="reception-calendar-stat-card reception-stat-dirty">
            <div class="reception-stat-icon"><i class="fa-solid fa-broom"></i></div>
            <div class="reception-stat-info">
                <span class="reception-stat-label">Cleaning</span>
                <strong class="reception-stat-value">@dirtyCount</strong>
            </div>
        </article>

        <article class="reception-calendar-stat-card reception-stat-maintenance">
            <div class="reception-stat-icon"><i class="fa-solid fa-screwdriver-wrench"></i></div>
            <div class="reception-stat-info">
                <span class="reception-stat-label">Maintenance</span>
                <strong class="reception-stat-value">@maintenanceCount</strong>
            </div>
        </article>
    </section>

    <!-- Calendar Toolbar & Filter Bar -->
    <section class="reception-calendar-toolbar reception-fade-in">
        <div class="reception-calendar-nav-row">
            <div class="reception-calendar-nav-group">
                <a asp-controller="Reception"
                   asp-action="Calendar"
                   asp-route-view="@viewMode"
                   asp-route-startDate="@prevStartDate.ToString("yyyy-MM-dd")"
                   class="reception-calendar-nav-btn"
                   title="ช่วงก่อนหน้า">
                    <i class="fa-solid fa-chevron-left"></i> Previous
                </a>

                <a asp-controller="Reception"
                   asp-action="Calendar"
                   asp-route-view="@viewMode"
                   asp-route-startDate="@today.ToString("yyyy-MM-dd")"
                   class="reception-calendar-nav-btn reception-nav-today">
                    Today
                </a>

                <a asp-controller="Reception"
                   asp-action="Calendar"
                   asp-route-view="@viewMode"
                   asp-route-startDate="@nextStartDate.ToString("yyyy-MM-dd")"
                   class="reception-calendar-nav-btn"
                   title="ช่วงถัดไป">
                    Next <i class="fa-solid fa-chevron-right"></i>
                </a>

                <div class="reception-calendar-period-label">
                    <i class="fa-regular fa-calendar text-primary"></i>
                    <span>
                        @startDate.ToString("d MMM yyyy", thaiCulture) – @endDate.ToString("d MMM yyyy", thaiCulture)
                    </span>
                </div>
            </div>

            <div class="reception-calendar-view-group">
                <form asp-controller="Reception" asp-action="Calendar" method="get" class="reception-datepicker-form" id="calendarDateForm">
                    <input type="hidden" name="view" value="@viewMode" id="hiddenViewMode" />
                    <input type="date"
                           name="startDate"
                           id="calendarDatePicker"
                           value="@startDate.ToString("yyyy-MM-dd")"
                           class="reception-calendar-date-input"
                           aria-label="เลือกวันที่เริ่มต้น" />
                </form>

                <div class="reception-view-switcher" role="group" aria-label="มุมมองปฏิทิน">
                    <a asp-controller="Reception"
                       asp-action="Calendar"
                       asp-route-view="day"
                       asp-route-startDate="@startDate.ToString("yyyy-MM-dd")"
                       class="reception-view-btn @(viewMode == "day" ? "active" : "")">
                        Day
                    </a>
                    <a asp-controller="Reception"
                       asp-action="Calendar"
                       asp-route-view="week"
                       asp-route-startDate="@startDate.ToString("yyyy-MM-dd")"
                       class="reception-view-btn @(viewMode == "week" ? "active" : "")">
                        Week
                    </a>
                    <a asp-controller="Reception"
                       asp-action="Calendar"
                       asp-route-view="month"
                       asp-route-startDate="@startDate.ToString("yyyy-MM-dd")"
                       class="reception-view-btn @(viewMode == "month" ? "active" : "")">
                        Month
                    </a>
                </div>
            </div>
        </div>

        <div class="reception-calendar-filter-row">
            <div class="reception-calendar-search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text"
                       id="calendarSearchInput"
                       placeholder="ค้นหาเลขห้อง, Booking ID, ชื่อผู้เข้าพัก..."
                       autocomplete="off" />
            </div>

            <div class="reception-calendar-select-group">
                <label for="filterRoomType"><i class="fa-solid fa-layer-group"></i> ประเภทห้อง:</label>
                <select id="filterRoomType" class="reception-calendar-select">
                    <option value="all">ทั้งหมด</option>
                    @foreach (var typeName in distinctRoomTypes)
                    {
                        <option value="@typeName.ToLowerInvariant()">@typeName</option>
                    }
                </select>
            </div>

            <div class="reception-calendar-select-group">
                <label for="filterRoomStatus"><i class="fa-solid fa-filter"></i> สถานะ:</label>
                <select id="filterRoomStatus" class="reception-calendar-select">
                    <option value="all">ทั้งหมด</option>
                    <option value="available">Available</option>
                    <option value="reserved">Reserved</option>
                    <option value="occupied">Occupied</option>
                    <option value="dirty">Cleaning</option>
                    <option value="maintenance">Maintenance</option>
                </select>
            </div>

            <button type="button" id="btnResetCalendarFilter" class="reception-calendar-reset-btn">
                <i class="fa-solid fa-rotate-left"></i> ล้างตัวกรอง
            </button>
        </div>
    </section>

    <!-- Status Legend -->
    <section class="reception-calendar-legend reception-fade-in">
        <div class="reception-legend-items">
            <span class="reception-legend-pill">
                <span class="reception-legend-color reception-color-available"></span>
                Available (ห้องว่าง)
            </span>
            <span class="reception-legend-pill">
                <span class="reception-legend-color reception-color-reserved"></span>
                Reserved (จองแล้ว)
            </span>
            <span class="reception-legend-pill">
                <span class="reception-legend-color reception-color-occupied"></span>
                Occupied (เข้าพักอยู่)
            </span>
            <span class="reception-legend-pill">
                <span class="reception-legend-color reception-color-dirty"></span>
                Cleaning (รอทำความสะอาด)
            </span>
            <span class="reception-legend-pill">
                <span class="reception-legend-color reception-color-maintenance"></span>
                Maintenance (ซ่อมบำรุง)
            </span>
        </div>
    </section>

    <!-- Main Room Timeline -->
    <section class="reception-panel reception-calendar-panel reception-fade-in">
        @if (Model?.Rooms != null && Model.Rooms.Any())
        {
            var roomsByFloor = Model.Rooms
                .OrderBy(r => r.FloorNo)
                .ThenBy(r => r.RoomNumber)
                .GroupBy(r => r.FloorNo);

            <div class="reception-timeline-scroll-container" id="timelineScrollContainer">
                <table class="reception-timeline-table" style="--timeline-days: @daysCount;">
                    <thead>
                        <tr>
                            <th class="reception-timeline-room-col-header">
                                <div class="reception-room-col-title">
                                    <span>ห้องพัก / ชั้น</span>
                                </div>
                            </th>
                            @for (int d = 0; d < daysCount; d++)
                            {
                                var colDate = startDate.AddDays(d);
                                bool isTodayCol = colDate == today;
                                bool isWeekend = colDate.DayOfWeek == DayOfWeek.Saturday || colDate.DayOfWeek == DayOfWeek.Sunday;
                                <th class="reception-timeline-date-header @(isTodayCol ? "is-today" : "") @(isWeekend ? "is-weekend" : "")">
                                    <span class="reception-date-dayname">@colDate.ToString("ddd", thaiCulture)</span>
                                    <strong class="reception-date-daynum">@colDate.Day</strong>
                                    <small class="reception-date-month">@colDate.ToString("MMM", thaiCulture)</small>
                                    @if (isTodayCol)
                                    {
                                        <span class="reception-today-marker-badge">วันนี้</span>
                                    }
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var floorGroup in roomsByFloor)
                        {
                            <tr class="reception-timeline-floor-row" data-floor="@floorGroup.Key">
                                <td colspan="@(daysCount + 1)">
                                    <div class="reception-floor-banner">
                                        <i class="fa-solid fa-layer-group"></i>
                                        <strong>ชั้น @floorGroup.Key</strong>
                                        <span>· @floorGroup.Count() ห้อง</span>
                                    </div>
                                </td>
                            </tr>

                            @foreach (var room in floorGroup)
                            {
                                var rawRoomStatus = (room.Status ?? "available").ToLowerInvariant();
                                var roomNormStatus = rawRoomStatus switch
                                {
                                    "available" => "available",
                                    "occupied" => "occupied",
                                    "needs_cleaning" or "dirty" or "cleaning" => "dirty",
                                    "maintenance" => "maintenance",
                                    _ => "available"
                                };

                                var roomBookings = timelineStays
                                    .Where(b => (b.RoomId == room.RoomId || b.RoomNumber == room.RoomNumber) &&
                                                b.CheckOutDate >= startDate &&
                                                b.CheckInDate <= endDate)
                                    .OrderBy(b => b.CheckInDate)
                                    .ToList();

                                bool hasReservationInWindow = roomBookings.Any(b => !b.CheckedInAt.HasValue);
                                string effectiveFilterStatus = hasReservationInWindow && roomNormStatus == "available"
                                    ? "reserved"
                                    : roomNormStatus;

                                string roomStatusBadgeText = roomNormStatus switch
                                {
                                    "available" => "Available",
                                    "occupied" => "Occupied",
                                    "dirty" => "Cleaning",
                                    "maintenance" => "Maintenance",
                                    _ => room.Status ?? "Available"
                                };

                                var searchableBookingText = string.Join(" ", roomBookings.Select(b => $"{b.BookingCode} {b.GuestName}"));

                                <tr class="reception-timeline-room-row"
                                    data-floor="@floorGroup.Key"
                                    data-room-number="@room.RoomNumber.ToLowerInvariant()"
                                    data-room-type="@room.RoomTypeName.ToLowerInvariant()"
                                    data-room-status="@effectiveFilterStatus"
                                    data-search-text="@($"{room.RoomNumber} {room.RoomTypeName} {searchableBookingText}".ToLowerInvariant())">

                                    <td class="reception-timeline-room-cell">
                                        <button type="button"
                                                class="reception-room-select-btn js-open-room-panel"
                                                data-room-id="@room.RoomId"
                                                data-room-number="@room.RoomNumber"
                                                data-room-type="@room.RoomTypeName"
                                                data-room-floor="@room.FloorNo"
                                                data-room-status="@roomStatusBadgeText"
                                                data-booking-id=""
                                                data-booking-code=""
                                                data-guest-name=""
                                                data-checkin=""
                                                data-checkout=""
                                                data-payment-status=""
                                                data-can-checkin="false"
                                                data-can-checkout="false"
                                                data-stay-id="0">
                                            <div class="reception-room-cell-top">
                                                <span class="reception-room-cell-number">Room @room.RoomNumber</span>
                                                <span class="reception-room-mini-dot reception-dot-@roomNormStatus"></span>
                                            </div>
                                            <div class="reception-room-cell-meta">
                                                <span>@room.RoomTypeName</span>
                                                <span class="reception-room-cell-status reception-status-text-@roomNormStatus">
                                                    @roomStatusBadgeText
                                                </span>
                                            </div>
                                        </button>
                                    </td>

                                    @{
                                        int dayIndex = 0;
                                        while (dayIndex < daysCount)
                                        {
                                            var cellDate = startDate.AddDays(dayIndex);
                                            bool isTodayCell = cellDate == today;

                                            var matchingBooking = roomBookings.FirstOrDefault(b =>
                                                b.CheckInDate == cellDate ||
                                                (dayIndex == 0 && b.CheckInDate < startDate && b.CheckOutDate > startDate));

                                            if (matchingBooking != null)
                                            {
                                                var visibleStart = matchingBooking.CheckInDate < startDate ? startDate : matchingBooking.CheckInDate;
                                                var visibleEnd = matchingBooking.CheckOutDate > endDate.AddDays(1) ? endDate.AddDays(1) : matchingBooking.CheckOutDate;
                                                int spanDays = Math.Max(1, visibleEnd.DayNumber - visibleStart.DayNumber);
                                                if (dayIndex + spanDays > daysCount)
                                                {
                                                    spanDays = daysCount - dayIndex;
                                                }

                                                bool isCheckedIn = matchingBooking.CheckedInAt.HasValue && !matchingBooking.CheckedOutAt.HasValue;
                                                string barStateClass = isCheckedIn ? "reception-booking-bar-occupied" : "reception-booking-bar-reserved";
                                                string barStateLabel = isCheckedIn ? "Occupied" : "Reserved";
                                                bool canCheckInNow = !isCheckedIn && roomNormStatus == "available" && matchingBooking.CheckInDate <= today;
                                                string codeDisplay = string.IsNullOrWhiteSpace(matchingBooking.BookingCode) ? $"#{matchingBooking.BookingId}" : matchingBooking.BookingCode;

                                                <td colspan="@spanDays" class="reception-timeline-slot-cell has-booking @(isTodayCell ? "is-today-col" : "")">
                                                    <button type="button"
                                                            class="reception-booking-bar @barStateClass js-open-room-panel"
                                                            data-room-id="@room.RoomId"
                                                            data-room-number="@room.RoomNumber"
                                                            data-room-type="@room.RoomTypeName"
                                                            data-room-floor="@room.FloorNo"
                                                            data-room-status="@barStateLabel"
                                                            data-booking-id="@matchingBooking.BookingId"
                                                            data-booking-code="@codeDisplay"
                                                            data-guest-name="@matchingBooking.GuestName"
                                                            data-checkin="@matchingBooking.CheckInDate.ToString("dd/MM/yyyy")"
                                                            data-checkout="@matchingBooking.CheckOutDate.ToString("dd/MM/yyyy")"
                                                            data-payment-status="@(string.IsNullOrWhiteSpace(matchingBooking.PaymentStatus) ? "Approved" : matchingBooking.PaymentStatus)"
                                                            data-can-checkin="@(canCheckInNow ? "true" : "false")"
                                                            data-can-checkout="@(isCheckedIn ? "true" : "false")"
                                                            data-stay-id="@matchingBooking.StayId">
                                                        <div class="reception-booking-bar-head">
                                                            <span class="reception-booking-bar-code">@codeDisplay</span>
                                                            <span class="reception-booking-bar-tag">@barStateLabel</span>
                                                        </div>
                                                        <div class="reception-booking-bar-guest">
                                                            <i class="fa-solid fa-user"></i> @matchingBooking.GuestName
                                                        </div>
                                                        <div class="reception-booking-bar-dates">
                                                            @matchingBooking.CheckInDate.ToString("dd/MM") – @matchingBooking.CheckOutDate.ToString("dd/MM")
                                                        </div>
                                                    </button>
                                                </td>

                                                dayIndex += spanDays;
                                            }
                                            else
                                            {
                                                <td class="reception-timeline-slot-cell slot-@roomNormStatus @(isTodayCell ? "is-today-col" : "")">
                                                    <button type="button"
                                                            class="reception-empty-slot-btn js-open-room-panel"
                                                            data-room-id="@room.RoomId"
                                                            data-room-number="@room.RoomNumber"
                                                            data-room-type="@room.RoomTypeName"
                                                            data-room-floor="@room.FloorNo"
                                                            data-room-status="@roomStatusBadgeText"
                                                            data-booking-id=""
                                                            data-booking-code=""
                                                            data-guest-name=""
                                                            data-checkin="@cellDate.ToString("dd/MM/yyyy")"
                                                            data-checkout=""
                                                            data-payment-status="-"
                                                            data-can-checkin="false"
                                                            data-can-checkout="false"
                                                            data-stay-id="0"
                                                            title="ห้อง @room.RoomNumber (@roomStatusBadgeText) · @cellDate.ToString("dd/MM/yyyy")">
                                                        @if (roomNormStatus == "maintenance")
                                                        {
                                                            <span class="reception-slot-status-tag tag-maintenance">
                                                                <i class="fa-solid fa-screwdriver-wrench"></i> Maintenance
                                                            </span>
                                                        }
                                                        else if (roomNormStatus == "dirty" && isTodayCell)
                                                        {
                                                            <span class="reception-slot-status-tag tag-dirty">
                                                                <i class="fa-solid fa-broom"></i> Cleaning
                                                            </span>
                                                        }
                                                        else if (roomNormStatus == "occupied" && isTodayCell)
                                                        {
                                                            <span class="reception-slot-status-tag tag-occupied">
                                                                <i class="fa-solid fa-bed"></i> Occupied
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="reception-slot-available-label">Available</span>
                                                        }
                                                    </button>
                                                </td>
                                                dayIndex++;
                                            }
                                        }
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div id="calendarFloorPagination" class="d-flex justify-content-between align-items-center flex-wrap gap-2 p-3 border-top">
                <small id="calendarFloorSummary" class="text-muted"></small>
                <div id="calendarFloorButtons" class="d-flex align-items-center flex-wrap gap-1"></div>
            </div>
        }
        else
        {
            <div class="reception-empty-state">
                <i class="fa-regular fa-calendar-xmark"></i>
                <p>ไม่พบข้อมูลห้องพักในระบบ</p>
            </div>
        }
    </section>
</div>

<!-- Room & Booking Information Drawer -->
<div class="reception-info-backdrop" id="roomInfoBackdrop" aria-hidden="true"></div>
<aside class="reception-info-drawer" id="roomInfoDrawer" aria-labelledby="drawerRoomTitle" aria-hidden="true">
    <div class="reception-drawer-header">
        <div>
            <span class="reception-drawer-subtitle">ROOM &amp; BOOKING DETAILS</span>
            <h3 class="reception-drawer-title" id="drawerRoomTitle">Room -</h3>
        </div>
        <button type="button" class="reception-drawer-close" id="btnCloseDrawer" aria-label="ปิด">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>

    <div class="reception-drawer-body">
        <div class="reception-drawer-section">
            <h4 class="reception-drawer-section-title">
                <i class="fa-solid fa-door-closed text-primary"></i> ข้อมูลห้องพัก
            </h4>
            <div class="reception-drawer-grid">
                <div class="reception-drawer-field">
                    <span>Room Number</span>
                    <strong id="infoRoomNumber">-</strong>
                </div>
                <div class="reception-drawer-field">
                    <span>Floor</span>
                    <strong id="infoRoomFloor">-</strong>
                </div>
                <div class="reception-drawer-field">
                    <span>Room Type</span>
                    <strong id="infoRoomType">-</strong>
                </div>
                <div class="reception-drawer-field">
                    <span>Room Status</span>
                    <strong id="infoRoomStatus">-</strong>
                </div>
            </div>
        </div>

        <div class="reception-drawer-section">
            <h4 class="reception-drawer-section-title">
                <i class="fa-solid fa-file-invoice text-info"></i> ข้อมูลการจอง
            </h4>
            <div class="reception-drawer-grid">
                <div class="reception-drawer-field">
                    <span>Booking ID</span>
                    <strong id="infoBookingCode">-</strong>
                </div>
                <div class="reception-drawer-field">
                    <span>Guest Name</span>
                    <strong id="infoGuestName">-</strong>
                </div>
                <div class="reception-drawer-field">
                    <span>Check-in Date</span>
                    <strong id="infoCheckInDate">-</strong>
                </div>
                <div class="reception-drawer-field">
                    <span>Check-out Date</span>
                    <strong id="infoCheckOutDate">-</strong>
                </div>
                <div class="reception-drawer-field reception-field-full">
                    <span>Payment Status</span>
                    <strong id="infoPaymentStatus">-</strong>
                </div>
            </div>
        </div>
    </div>

    <div class="reception-drawer-footer">
        <a asp-controller="Reception"
           asp-action="Bookings"
           id="btnDrawerViewDetails"
           class="reception-btn reception-btn-primary w-100 justify-content-center">
            <i class="fa-regular fa-eye"></i> ดูรายละเอียดการจอง
        </a>

        <a asp-controller="Reception"
           asp-action="CheckIn"
           id="btnDrawerCheckIn"
           class="reception-btn reception-btn-success w-100 justify-content-center d-none">
            <i class="fa-solid fa-key"></i> ดำเนินการ Check-in
        </a>

        <a asp-controller="Reception"
           asp-action="CheckOut"
           id="btnDrawerCheckOut"
           class="reception-btn reception-btn-danger w-100 justify-content-center d-none">
            <i class="fa-solid fa-arrow-right-from-bracket"></i> ดำเนินการ Check-out
        </a>

        <button type="button" id="btnDrawerCloseFooter" class="reception-btn reception-btn-ghost w-100 justify-content-center">
            ปิด
        </button>
    </div>
</aside>

@section Scripts {
    <script src="~/js/reception-calendar.js" asp-append-version="true"></script>
