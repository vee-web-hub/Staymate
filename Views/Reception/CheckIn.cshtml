@model StayMate_Kavinvee_0576.ViewModels.ReceptionIndexViewModel

@{
    ViewData["Title"] = "Guest Check-in";
    Layout = "~/Views/Shared/_ReceptionLayout.cshtml";

    var thaiCulture = new System.Globalization.CultureInfo("th-TH");
    var now = DateTime.Now;
    var today = DateOnly.FromDateTime(DateTime.Today);
    var currentDateText = now.ToString("วันddddที่ d MMMM yyyy", thaiCulture);

    var checkInList = Model?.CheckInList ?? new List<StayMate_Kavinvee_0576.ViewModels.ReceptionStayViewModel>();
    var availableRoomsList = (Model?.Rooms ?? new List<StayMate_Kavinvee_0576.ViewModels.ReceptionRoomViewModel>())
        .Where(r => (r.Status ?? "").ToLowerInvariant() == "available")
        .OrderBy(r => r.FloorNo)
        .ThenBy(r => r.RoomNumber)
        .ToList();

    int waitingCheckInCount = checkInList.Count(x =>
        (x.BookingStatus ?? "confirmed").ToLowerInvariant() == "confirmed" && !x.CheckedInAt.HasValue);

    int todayCheckInCount = (Model?.TodayCheckIns ?? 0) > 0
        ? Model!.TodayCheckIns
        : checkInList.Count(x => x.CheckInDate == today);

    int completedCheckInCount = (Model?.CompletedCheckInsCount ?? 0) > 0
        ? Model!.CompletedCheckInsCount
        : checkInList.Count(x => (x.BookingStatus ?? "").ToLowerInvariant() == "checked_in" || x.CheckedInAt.HasValue);

    int availableRoomsCount = (Model?.AvailableRooms ?? 0) > 0
        ? Model!.AvailableRooms
        : availableRoomsList.Count;

    var roomTypes = checkInList
        .Where(x => !string.IsNullOrWhiteSpace(x.RoomTypeName))
        .Select(x => x.RoomTypeName)
        .Distinct()
        .OrderBy(x => x)
        .ToList();

    var queryBookingCode = Context.Request.Query["bookingCode"].ToString();
    var queryGuestName = Context.Request.Query["guestName"].ToString();
    var queryRoomNumber = Context.Request.Query["roomNumber"].ToString();
}

@section Styles {
    <link rel="stylesheet" href="~/css/reception.css" asp-append-version="true" />
}

<div class="reception-dashboard-wrapper reception-checkin-page" id="receptionCheckInApp">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="reception-checkin-alert reception-alert-success reception-fade-in" role="alert">
            <div class="reception-alert-icon"><i class="fa-solid fa-circle-check"></i></div>
            <div class="reception-alert-content">
                <strong>ดำเนินการสำเร็จ</strong>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="reception-checkin-alert reception-alert-danger reception-fade-in" role="alert">
            <div class="reception-alert-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
            <div class="reception-alert-content">
                <strong>ไม่สามารถดำเนินการ Check-in ได้</strong>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Page Header -->
    <section class="reception-page-header reception-checkin-header reception-fade-in">
        <div class="reception-header-left">
            <div class="reception-title-badge">
                <span class="reception-live-dot"></span>
                <span>FRONT DESK CHECK-IN</span>
            </div>
            <h1 class="reception-main-title">
                <i class="fa-solid fa-key reception-title-icon"></i>
                Guest Check-in
            </h1>
            <p class="reception-welcome-text">
                ข้อมูลประจำ<strong>@currentDateText</strong>
            </p>
        </div>

        <div class="reception-header-right">
            <div class="reception-checkin-waiting-pill">
                <i class="fa-solid fa-user-clock"></i>
                <span>รอ Check-in: <strong>@waitingCheckInCount</strong> รายการ</span>
            </div>

            <a asp-controller="Reception" asp-action="CheckIn" class="reception-btn reception-btn-outline" title="รีเฟรชข้อมูล">
                <i class="fa-solid fa-rotate"></i>
                <span>Refresh</span>
            </a>
        </div>

        <!-- Quick Search Bar -->
        <div class="reception-checkin-header-search">
            <form asp-controller="Reception" asp-action="CheckIn" method="get" class="reception-checkin-quick-grid" id="headerCheckInSearchForm">
                <div class="reception-checkin-input-box">
                    <i class="fa-solid fa-barcode"></i>
                    <input type="text"
                           name="bookingCode"
                           id="searchBookingCodeInput"
                           value="@queryBookingCode"
                           placeholder="ค้นหา Booking ID..."
                           autocomplete="off" />
                </div>

                <div class="reception-checkin-input-box">
                    <i class="fa-regular fa-user"></i>
                    <input type="text"
                           name="guestName"
                           id="searchGuestNameInput"
                           value="@queryGuestName"
                           placeholder="ค้นหาชื่อผู้เข้าพัก..."
                           autocomplete="off" />
                </div>

                <div class="reception-checkin-input-box">
                    <i class="fa-solid fa-door-closed"></i>
                    <input type="text"
                           name="roomNumber"
                           id="searchRoomNoInput"
                           value="@queryRoomNumber"
                           placeholder="ค้นหาหมายเลขห้อง..."
                           autocomplete="off" />
                </div>

                <div class="reception-checkin-search-btns">
                    <button type="submit" class="reception-btn reception-btn-primary">
                        <i class="fa-solid fa-magnifying-glass"></i> ค้นหา
                    </button>
                    <a asp-controller="Reception" asp-action="CheckIn" class="reception-btn reception-btn-outline" id="btnResetTopSearch">
                        <i class="fa-solid fa-rotate-left"></i> ล้างค่า
                    </a>
                </div>
            </form>
        </div>
    </section>

    <!-- Summary Cards -->
    <section class="reception-kpi-grid reception-checkin-summary-grid reception-fade-in">
        <article class="reception-kpi-card reception-kpi-warning">
            <div class="reception-kpi-top">
                <div>
                    <span class="reception-kpi-title">Waiting for Check-in</span>
                    <h2 class="reception-kpi-number">@waitingCheckInCount</h2>
                </div>
                <div class="reception-kpi-icon">
                    <i class="fa-solid fa-clock"></i>
                </div>
            </div>
        </article>

        <article class="reception-kpi-card reception-kpi-primary">
            <div class="reception-kpi-top">
                <div>
                    <span class="reception-kpi-title">Today's Arrivals</span>
                    <h2 class="reception-kpi-number">@todayCheckInCount</h2>
                </div>
                <div class="reception-kpi-icon">
                    <i class="fa-solid fa-calendar-day"></i>
                </div>
            </div>
        </article>

        <article class="reception-kpi-card reception-kpi-success">
            <div class="reception-kpi-top">
                <div>
                    <span class="reception-kpi-title">Completed Check-ins</span>
                    <h2 class="reception-kpi-number">@completedCheckInCount</h2>
                </div>
                <div class="reception-kpi-icon">
                    <i class="fa-solid fa-user-check"></i>
                </div>
            </div>
        </article>

        <article class="reception-kpi-card reception-kpi-cyan">
            <div class="reception-kpi-top">
                <div>
                    <span class="reception-kpi-title">Ready Rooms</span>
                    <h2 class="reception-kpi-number">@availableRoomsCount</h2>
                </div>
                <div class="reception-kpi-icon">
                    <i class="fa-solid fa-door-open"></i>
                </div>
            </div>
        </article>
    </section>

    <!-- Filter & Sort Bar -->
    <section class="reception-checkin-filter-bar reception-fade-in">
        <div class="reception-checkin-filter-left">
            <span class="reception-filter-bar-title">
                <i class="fa-solid fa-sliders text-primary"></i> ตัวกรอง:
            </span>

            <div class="reception-checkin-select-wrap">
                <label for="filterCheckInRoomType">ประเภทห้อง:</label>
                <select id="filterCheckInRoomType" class="reception-filter-control">
                    <option value="all">ทั้งหมด</option>
                    @foreach (var rType in roomTypes)
                    {
                        <option value="@rType.ToLowerInvariant()">@rType</option>
                    }
                </select>
            </div>

            <div class="reception-checkin-select-wrap">
                <label for="filterCheckInStatus">สถานะการจอง:</label>
                <select id="filterCheckInStatus" class="reception-filter-control">
                    <option value="all">ทั้งหมด</option>
                    <option value="confirmed">Confirmed</option>
                    <option value="pending">Pending</option>
                    <option value="checked_in">Checked-in</option>
                    <option value="cancelled">Cancelled</option>
                </select>
            </div>

            <div class="reception-checkin-select-wrap">
                <label for="sortCheckInDate">เรียงตามวันเข้าพัก:</label>
                <select id="sortCheckInDate" class="reception-filter-control">
                    <option value="asc">เก่าไปใหม่</option>
                    <option value="desc">ใหม่ไปเก่า</option>
                </select>
            </div>
        </div>

        <div class="reception-checkin-filter-right">
            <button type="button" id="btnClearCheckInFilters" class="reception-btn reception-btn-ghost">
                <i class="fa-solid fa-filter-circle-xmark"></i> ล้างตัวกรอง
            </button>
        </div>
    </section>

    <!-- Check-in Queue Table -->
    <section class="reception-panel reception-checkin-table-panel reception-fade-in">
        <div class="reception-panel-header">
            <h3 class="reception-panel-title">
                <i class="fa-solid fa-list-check text-success"></i>
                รายการลงทะเบียนเข้าพัก
            </h3>
            <div class="reception-booking-count-badge">
                แสดงผล <strong id="checkInVisibleCount">@checkInList.Count</strong> รายการ
            </div>
        </div>

        @if (checkInList.Any())
        {
            <div class="reception-table-responsive">
                <table class="reception-table reception-checkin-table" id="checkInQueueTable">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 60px;">ลำดับ</th>
                            <th>Booking ID</th>
                            <th>ชื่อผู้เข้าพัก</th>
                            <th>เบอร์โทรศัพท์</th>
                            <th>ประเภทห้อง</th>
                            <th>หมายเลขห้อง</th>
                            <th>วันเข้าพัก</th>
                            <th>วันออก</th>
                            <th class="text-center">ผู้เข้าพัก</th>
                            <th>Payment Status</th>
                            <th>Booking Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody id="checkInTableBody">
                        @{
                            int rowNo = 1;
                        }
                        @foreach (var item in checkInList)
                        {
                            var codeDisplay = string.IsNullOrWhiteSpace(item.BookingCode) ? $"#{item.BookingId}" : item.BookingCode;

                            var rawBookingStatus = (item.BookingStatus ?? "confirmed").ToLowerInvariant();
                            var normBookingStatus = rawBookingStatus switch
                            {
                                "confirmed" => "confirmed",
                                "checked_in" => "checked_in",
                                "cancelled" => "cancelled",
                                _ => "pending"
                            };

                            var bookingBadgeClass = normBookingStatus switch
                            {
                                "confirmed" => "reception-bstatus-confirmed",
                                "checked_in" => "reception-bstatus-checkedin",
                                "cancelled" => "reception-bstatus-cancelled",
                                _ => "reception-bstatus-pending"
                            };

                            var bookingBadgeText = normBookingStatus switch
                            {
                                "confirmed" => "Confirmed",
                                "checked_in" => "Checked-in",
                                "cancelled" => "Cancelled",
                                _ => "Pending"
                            };

                            var rawPayStatus = (item.PaymentStatus ?? "pending").ToLowerInvariant();
                            bool isPaymentApproved = rawPayStatus is "approved" or "paid" or "verified";
                            var payBadgeClass = isPaymentApproved ? "reception-pay-badge-approved" : "reception-pay-badge-pending";
                            var payBadgeText = isPaymentApproved ? "Approved" : "Pending";

                            bool isConfirmedBooking = normBookingStatus == "confirmed";
                            bool isNotAlreadyCheckedIn = normBookingStatus != "checked_in" && !item.CheckedInAt.HasValue;
                            bool isArrivalDateReached = item.CheckInDate <= today;
                            bool isRoomAssigned = item.RoomId > 0 && !string.IsNullOrWhiteSpace(item.RoomNumber) && item.RoomNumber != "ยังไม่กำหนดห้อง" && item.RoomNumber != "รอกำหนดห้อง";
                            var rawRoomStatus = (item.RoomStatus ?? "available").ToLowerInvariant();
                            bool isRoomAvailable = isRoomAssigned && rawRoomStatus == "available";
                            bool hasAvailableRoomToAssign = !isRoomAssigned &&
                                availableRoomsList.Any(r => string.Equals(r.RoomTypeName, item.RoomTypeName, StringComparison.OrdinalIgnoreCase));

                            bool canProceedCheckIn = isPaymentApproved
                                                     && isConfirmedBooking
                                                     && isNotAlreadyCheckedIn
                                                     && isArrivalDateReached
                                                     && (isRoomAvailable || hasAvailableRoomToAssign);

                            var blockReasons = new List<string>();
                            if (!isPaymentApproved) blockReasons.Add("ยังไม่ได้รับการอนุมัติชำระเงิน");
                            if (!isConfirmedBooking) blockReasons.Add($"สถานะการจองเป็น {bookingBadgeText}");
                            if (!isNotAlreadyCheckedIn) blockReasons.Add("ดำเนินการ Check-in ไปแล้ว");
                            if (!isArrivalDateReached) blockReasons.Add($"ยังไม่ถึงวันเข้าพัก ({item.CheckInDate:dd/MM/yyyy})");
                            if (!isRoomAssigned && !hasAvailableRoomToAssign) blockReasons.Add("ไม่มีห้องว่างพร้อมให้บริการ");
                            else if (isRoomAssigned && !isRoomAvailable) blockReasons.Add($"ห้อง {item.RoomNumber} สถานะ {item.RoomStatus}");

                            string blockReasonText = string.Join(" · ", blockReasons);

                            <tr class="reception-checkin-row"
                                data-booking-code="@codeDisplay.ToLowerInvariant()"
                                data-guest-name="@item.GuestName.ToLowerInvariant()"
                                data-room-number="@((item.RoomNumber ?? "").ToLowerInvariant())"
                                data-room-type="@((item.RoomTypeName ?? "").ToLowerInvariant())"
                                data-booking-status="@normBookingStatus"
                                data-checkin-sort="@item.CheckInDate.ToString("yyyyMMdd")">

                                <td class="text-center fw-semibold text-muted row-index-cell" data-label="ลำดับ">@rowNo</td>
                                <td data-label="Booking ID">
                                    <span class="reception-code-badge">@codeDisplay</span>
                                </td>
                                <td data-label="ชื่อผู้เข้าพัก">
                                    <div class="reception-guest-cell">
                                        <strong>@item.GuestName</strong>
                                    </div>
                                </td>
                                <td data-label="เบอร์โทรศัพท์">
                                    <span class="reception-phone-text">
                                        <i class="fa-solid fa-phone-volume text-muted me-1"></i>@item.GuestPhone
                                    </span>
                                </td>
                                <td data-label="ประเภทห้อง">
                                    <span>@item.RoomTypeName</span>
                                </td>
                                <td data-label="หมายเลขห้อง">
                                    @if (isRoomAssigned)
                                    {
                                        <span class="reception-room-chip">
                                            <i class="fa-solid fa-door-closed me-1"></i>ห้อง @item.RoomNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="reception-status-badge reception-pay-badge-pending">
                                            รอกำหนดห้อง
                                        </span>
                                    }
                                </td>
                                <td data-label="วันเข้าพัก">
                                    <span class="reception-time-text fw-semibold">@item.CheckInDate.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td data-label="วันออก">
                                    <span class="reception-time-text">@item.CheckOutDate.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td class="text-center" data-label="ผู้เข้าพัก">
                                    <span class="reception-guest-count-pill">
                                        <i class="fa-solid fa-users"></i> @item.NumGuests ท่าน
                                    </span>
                                </td>
                                <td data-label="Payment Status">
                                    <span class="reception-status-badge @payBadgeClass">
                                        @payBadgeText
                                    </span>
                                </td>
                                <td data-label="Booking Status">
                                    <span class="reception-status-badge @bookingBadgeClass">
                                        @bookingBadgeText
                                    </span>
                                </td>
                                <td class="text-end" data-label="Action">
                                    <div class="reception-action-group justify-content-end">
                                        <button type="button"
                                                class="reception-btn-sm @(canProceedCheckIn ? "reception-btn-success" : "reception-btn-ghost") js-open-checkin-modal"
                                                data-booking-id="@item.BookingId"
                                                data-booking-code="@codeDisplay"
                                                data-guest-name="@item.GuestName"
                                                data-room-id="@item.RoomId"
                                                data-room-number="@(isRoomAssigned ? item.RoomNumber : "รอกำหนดห้อง")"
                                                data-room-type="@item.RoomTypeName"
                                                data-checkin-date="@item.CheckInDate.ToString("dd/MM/yyyy")"
                                                data-checkout-date="@item.CheckOutDate.ToString("dd/MM/yyyy")"
                                                data-num-guests="@item.NumGuests"
                                                data-can-checkin="@(canProceedCheckIn ? "true" : "false")"
                                                data-needs-room="@(!isRoomAssigned ? "true" : "false")"
                                                data-check-pay="@(isPaymentApproved ? "true" : "false")"
                                                data-check-confirmed="@(isConfirmedBooking ? "true" : "false")"
                                                data-check-notdup="@(isNotAlreadyCheckedIn ? "true" : "false")"
                                                data-check-date="@(isArrivalDateReached ? "true" : "false")"
                                                data-check-roomassigned="@((isRoomAssigned || hasAvailableRoomToAssign) ? "true" : "false")"
                                                data-check-roomavail="@((isRoomAvailable || hasAvailableRoomToAssign) ? "true" : "false")"
                                                data-block-reason="@blockReasonText">
                                            @if (normBookingStatus == "checked_in")
                                            {
                                                <i class="fa-solid fa-circle-check text-info"></i>
                                                <span>Checked-in</span>
                                            }
                                            else if (canProceedCheckIn)
                                            {
                                                <i class="fa-solid fa-key"></i>
                                                <span>Check-in</span>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-shield-halved text-warning"></i>
                                                <span>ตรวจสอบ</span>
                                            }
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            rowNo++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="reception-checkin-empty-state">
                <div class="reception-empty-key-icon">
                    <i class="fa-solid fa-key"></i>
                </div>
                <h4>ไม่มีรายการรอ Check-in</h4>
                <div class="reception-empty-actions">
                    <a asp-controller="Reception" asp-action="Bookings" class="reception-btn reception-btn-primary">
                        <i class="fa-solid fa-clipboard-list"></i> รายการจองทั้งหมด
                    </a>
                    <a asp-controller="Reception" asp-action="Calendar" class="reception-btn reception-btn-ghost">
                        <i class="fa-regular fa-calendar-days"></i> ปฏิทินห้องพัก
                    </a>
                </div>
            </div>
        }
    </section>
</div>

<!-- Check-in Verification Modal -->
<div class="reception-modal-overlay" id="checkInConfirmModal" aria-hidden="true">
    <div class="reception-modal-dialog reception-checkin-modal-md" role="dialog" aria-labelledby="checkInModalTitle">
        <div class="reception-modal-header">
            <div>
                <span class="reception-modal-kicker">CHECK-IN VERIFICATION</span>
                <h3 class="reception-modal-title" id="checkInModalTitle">
                    <i class="fa-solid fa-key text-info"></i> ยืนยันการลงทะเบียนเข้าพัก
                </h3>
            </div>
            <button type="button" class="reception-modal-close" id="btnCloseCheckInModal" aria-label="ปิด">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form asp-controller="Reception"
              asp-action="ProcessCheckInFromBooking"
              method="post"
              id="confirmCheckInForm"
              class="m-0">
            @Html.AntiForgeryToken()
            <input type="hidden" name="bookingId" id="modalInputBookingId" value="" />

            <div class="reception-modal-body">
                <div class="reception-checkin-summary-box">
                    <div class="reception-checkin-summary-item">
                        <span>Booking ID</span>
                        <strong id="modalCiBookingCode" class="text-primary">-</strong>
                    </div>
                    <div class="reception-checkin-summary-item">
                        <span>ชื่อผู้เข้าพัก</span>
                        <strong id="modalCiGuestName">-</strong>
                    </div>
                    <div class="reception-checkin-summary-item">
                        <span>ห้องพัก</span>
                        <strong id="modalCiRoomNumber">-</strong>
                    </div>
                    <div class="reception-checkin-summary-item">
                        <span>จำนวนผู้เข้าพัก</span>
                        <strong id="modalCiNumGuests">-</strong>
                    </div>
                    <div class="reception-checkin-summary-item">
                        <span>วันเข้าพัก</span>
                        <strong id="modalCiCheckInDate">-</strong>
                    </div>
                    <div class="reception-checkin-summary-item">
                        <span>วันออก</span>
                        <strong id="modalCiCheckOutDate">-</strong>
                    </div>
                </div>

                <!-- เลือกห้องว่างกรณีรายการจองยังไม่ได้ระบุห้อง -->
                <div id="modalAssignRoomBox" class="mt-3 p-3 rounded border bg-light d-none">
                    <label for="modalSelectRoomId" class="form-label fw-semibold mb-1">
                        <i class="fa-solid fa-door-open text-primary me-1"></i> เลือกห้องพักที่ว่าง (Available) <span class="text-danger">*</span>
                    </label>
                    <select name="roomId" id="modalSelectRoomId" class="form-select reception-filter-control">
                        <option value="">เลือกหมายเลขห้องว่าง...</option>
                        @foreach (var rm in availableRoomsList)
                        {
                            <option value="@rm.RoomId" data-room-type="@((rm.RoomTypeName ?? "").ToLowerInvariant())">
                                ห้อง @rm.RoomNumber (ชั้น @rm.FloorNo · @rm.RoomTypeName)
                            </option>
                        }
                    </select>
                </div>

                <div class="reception-checkin-checklist-box">
                    <h4 class="reception-checklist-title">
                        <i class="fa-solid fa-shield-check text-primary"></i> เงื่อนไขก่อน Check-in
                    </h4>
                    <ul class="reception-checkin-checklist">
                        <li id="chkItemPayment">
                            <i class="fa-solid fa-circle-check"></i>
                            <span>การชำระเงินได้รับการอนุมัติ (Approved)</span>
                        </li>
                        <li id="chkItemConfirmed">
                            <i class="fa-solid fa-circle-check"></i>
                            <span>สถานะการจองเป็น Confirmed</span>
                        </li>
                        <li id="chkItemNotDup">
                            <i class="fa-solid fa-circle-check"></i>
                            <span>ยังไม่เคยดำเนินการ Check-in ซ้ำ</span>
                        </li>
                        <li id="chkItemDate">
                            <i class="fa-solid fa-circle-check"></i>
                            <span>ถึงกำหนดวันเข้าพักแล้ว</span>
                        </li>
                        <li id="chkItemRoomAssigned">
                            <i class="fa-solid fa-circle-check"></i>
                            <span>กำหนดหมายเลขห้องพักแล้ว</span>
                        </li>
                        <li id="chkItemRoomAvail">
                            <i class="fa-solid fa-circle-check"></i>
                            <span>ห้องพักอยู่ในสถานะ Available</span>
                        </li>
                    </ul>

                    <div id="modalCiWarningBanner" class="reception-checkin-warning-banner d-none">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <span id="modalCiWarningText">ไม่สามารถดำเนินการ Check-in ได้</span>
                    </div>
                </div>
            </div>

            <div class="reception-modal-footer">
                <button type="button" id="btnCancelCheckInModal" class="reception-btn reception-btn-ghost">
                    ยกเลิก
                </button>
                <button type="submit" id="btnSubmitCheckIn" class="reception-btn reception-btn-success">
                    <i class="fa-solid fa-check-double"></i> ยืนยัน Check-in
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/reception-checkin.js" asp-append-version="true"></script>
}
