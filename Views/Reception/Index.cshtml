@model StayMate_Kavinvee_0576.ViewModels.ReceptionIndexViewModel
@{
    Layout = "~/Views/Shared/_ReceptionLayout.cshtml";
    ViewData["Title"] = "Reception Dashboard";

    var thaiCulture = new System.Globalization.CultureInfo("th-TH");
    var currentDateText = DateTime.Now.ToString("วันddddที่ d MMMM yyyy", thaiCulture);
    var staffName = User.Identity?.Name ?? "Front Desk";
}

<div class="reception-dashboard-wrapper" id="receptionDashboard">

    <!-- Page Header -->
    <section class="reception-page-header reception-fade-in">
        <div class="reception-header-left">
            <div class="reception-title-badge">
                <span class="reception-live-dot"></span>
                <span>FRONT DESK OPERATIONS</span>
            </div>
            <h1 class="reception-main-title">
                <i class="fa-solid fa-bell-concierge reception-title-icon"></i>
                Reception Dashboard
            </h1>
            <p class="reception-welcome-text">
                <strong>@staffName</strong> · @currentDateText
            </p>
        </div>

        <div class="reception-header-right">
            <form asp-controller="Reception" asp-action="Bookings" method="get" class="reception-quick-search-form">
                <div class="reception-search-input-group">
                    <i class="fa-solid fa-magnifying-glass reception-search-icon"></i>
                    <input type="text"
                           name="search"
                           value="@Model?.SearchTerm"
                           class="reception-search-input"
                           placeholder="ค้นหา Booking ID, ชื่อผู้เข้าพัก, เบอร์โทร..."
                           aria-label="ค้นหาการจอง" />
                    <button type="submit" class="reception-btn reception-btn-primary">
                        ค้นหา
                    </button>
                </div>
            </form>

            <button type="button" id="btnRefreshDashboard" class="reception-btn reception-btn-outline" title="รีเฟรชข้อมูล">
                <i class="fa-solid fa-rotate"></i>
                <span>Refresh</span>
            </button>
        </div>
    </section>

    <!-- Quick Actions -->
    <section class="reception-quick-actions-bar reception-fade-in">
        <div class="reception-quick-actions-grid">
            <a asp-controller="Reception" asp-action="CheckIn" class="reception-action-tile">
                <span class="reception-action-icon reception-icon-blue">
                    <i class="fa-solid fa-key"></i>
                </span>
                <span class="reception-action-text">
                    <strong>Check-in</strong>
                    <small>วันนี้ @(Model?.TodayCheckIns ?? 0) รายการ</small>
                </span>
            </a>

            <a asp-controller="Reception" asp-action="CheckOut" class="reception-action-tile">
                <span class="reception-action-icon reception-icon-amber">
                    <i class="fa-solid fa-person-walking-arrow-right"></i>
                </span>
                <span class="reception-action-text">
                    <strong>Check-out</strong>
                    <small>วันนี้ @(Model?.TodayCheckOuts ?? 0) รายการ</small>
                </span>
            </a>

            <a asp-controller="Reception" asp-action="Bookings" class="reception-action-tile">
                <span class="reception-action-icon reception-icon-cyan">
                    <i class="fa-solid fa-qrcode"></i>
                </span>
                <span class="reception-action-text">
                    <strong>Bookings &amp; QR</strong>
                    <small>ตรวจสอบการจอง</small>
                </span>
            </a>

            <a asp-controller="Reception" asp-action="Calendar" class="reception-action-tile">
                <span class="reception-action-icon reception-icon-violet">
                    <i class="fa-regular fa-calendar-days"></i>
                </span>
                <span class="reception-action-text">
                    <strong>Room Calendar</strong>
                    <small>ปฏิทินห้องพัก</small>
                </span>
            </a>

            <a asp-controller="Reception" asp-action="HousekeepingRequests" class="reception-action-tile">
                <span class="reception-action-icon reception-icon-navy">
                    <i class="fa-solid fa-broom"></i>
                </span>
                <span class="reception-action-text">
                    <strong>Housekeeping</strong>
                    <small>แจ้งทำความสะอาด</small>
                </span>
            </a>
        </div>
    </section>

    <!-- KPI Summary Cards -->
    <section class="reception-kpi-grid reception-fade-in">
        <article class="reception-kpi-card reception-kpi-navy">
            <div class="reception-kpi-top">
                <div>
                    <span class="reception-kpi-title">Total Rooms</span>
                    <h2 class="reception-kpi-number" data-target="@(Model?.TotalRooms ?? 0)">
                        @(Model?.TotalRooms ?? 0)
                    </h2>
                </div>
                <div class="reception-kpi-icon">
                    <i class="fa-solid fa-hotel"></i>
                </div>
            </div>
            <div class="reception-kpi-footer">
                <span class="reception-kpi-desc">
                    Cleaning @(Model?.NeedsCleaningRooms ?? 0) · Maintenance @(Model?.MaintenanceRooms ?? 0)
                </span>
            </div>
        </article>

        <article class="reception-kpi-card reception-kpi-success">
            <div class="reception-kpi-top">
                <div>
                    <span class="reception-kpi-title">Available Rooms</span>
                    <h2 class="reception-kpi-number" data-target="@(Model?.AvailableRooms ?? 0)">
                        @(Model?.AvailableRooms ?? 0)
                    </h2>
                </div>
                <div class="reception-kpi-icon">
                    <i class="fa-solid fa-door-open"></i>
                </div>
            </div>
            <div class="reception-kpi-footer">
                <span class="reception-kpi-desc">ห้องว่างพร้อมเข้าพัก</span>
            </div>
        </article>

        <article class="reception-kpi-card reception-kpi-primary">
            <div class="reception-kpi-top">
                <div>
                    <span class="reception-kpi-title">Occupied Rooms</span>
                    <h2 class="reception-kpi-number" data-target="@(Model?.OccupiedRooms ?? 0)">
                        @(Model?.OccupiedRooms ?? 0)
                    </h2>
                </div>
                <div class="reception-kpi-icon">
                    <i class="fa-solid fa-bed"></i>
                </div>
            </div>
            <div class="reception-kpi-footer">
                <span class="reception-kpi-desc">กำลังเข้าพัก @(Model?.CompletedCheckInsCount ?? Model?.OccupiedRooms ?? 0) รายการ</span>
            </div>
        </article>

        <article class="reception-kpi-card reception-kpi-violet">
            <div class="reception-kpi-top">
                <div>
                    <span class="reception-kpi-title">Today's Check-in / Check-out</span>
                    <div class="reception-kpi-dual-number">
                        <span class="reception-kpi-in" title="Check-in วันนี้">
                            <i class="fa-solid fa-arrow-right-to-bracket"></i>
                            <strong class="reception-kpi-number" data-target="@(Model?.TodayCheckIns ?? 0)">@(Model?.TodayCheckIns ?? 0)</strong>
                        </span>
                        <span class="reception-kpi-divider">/</span>
                        <span class="reception-kpi-out" title="Check-out วันนี้">
                            <i class="fa-solid fa-arrow-right-from-bracket"></i>
                            <strong class="reception-kpi-number" data-target="@(Model?.TodayCheckOuts ?? 0)">@(Model?.TodayCheckOuts ?? 0)</strong>
                        </span>
                    </div>
                </div>
                <div class="reception-kpi-icon">
                    <i class="fa-solid fa-right-left"></i>
                </div>
            </div>
            <div class="reception-kpi-footer">
                <span class="reception-kpi-desc">
                    Confirmed @(Model?.ConfirmedBookings ?? 0) · Pending @(Model?.PendingBookings ?? 0)
                </span>
            </div>
        </article>
    </section>

    <!-- Today's Check-in & Check-out -->
    <div class="reception-operations-row reception-fade-in">

        <!-- Today's Check-in -->
        <section class="reception-panel">
            <div class="reception-panel-header">
                <h3 class="reception-panel-title">
                    <i class="fa-solid fa-key text-success"></i>
                    Today's Check-in
                </h3>
                <a asp-controller="Reception" asp-action="CheckIn" class="reception-link-more">
                    ทั้งหมด <i class="fa-solid fa-angle-right"></i>
                </a>
            </div>

            <div class="reception-table-responsive">
                <table class="reception-table">
                    <thead>
                        <tr>
                            <th>Booking ID</th>
                            <th>Guest</th>
                            <th>Room</th>
                            <th>Check-in Date</th>
                            <th>Payment</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.CheckInList != null && Model.CheckInList.Any())
                        {
                            foreach (var item in Model.CheckInList)
                            {
                                var codeDisplay = string.IsNullOrWhiteSpace(item.BookingCode) ? $"#{item.BookingId}" : item.BookingCode;
                                var isRoomAssigned = item.RoomId > 0 && !string.IsNullOrWhiteSpace(item.RoomNumber) && item.RoomNumber != "ยังไม่กำหนดห้อง";
                                var isPayApproved = string.Equals(item.PaymentStatus, "approved", StringComparison.OrdinalIgnoreCase)
                                                    || string.Equals(item.PaymentStatus, "paid", StringComparison.OrdinalIgnoreCase);

                                <tr>
                                    <td>
                                        <span class="reception-code-badge">@codeDisplay</span>
                                    </td>
                                    <td>
                                        <div class="reception-guest-cell">
                                            <strong>@item.GuestName</strong>
                                            <small>@item.GuestPhone · @item.NumGuests ท่าน</small>
                                        </div>
                                    </td>
                                    <td>
                                        @if (isRoomAssigned)
                                        {
                                            <span class="reception-room-chip">ห้อง @item.RoomNumber</span>
                                            <small class="d-block text-muted">@item.RoomTypeName</small>
                                        }
                                        else
                                        {
                                            <span class="reception-status-badge reception-badge-warning">รอกำหนดห้อง</span>
                                            <small class="d-block text-muted">@item.RoomTypeName</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="reception-time-text">@item.CheckInDate.ToString("dd/MM/yyyy")</span>
                                    </td>
                                    <td>
                                        @if (isPayApproved)
                                        {
                                            <span class="reception-status-badge reception-badge-success">Approved</span>
                                        }
                                        else
                                        {
                                            <span class="reception-status-badge reception-badge-warning">@(string.IsNullOrWhiteSpace(item.PaymentStatus) ? "Pending" : item.PaymentStatus)</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="reception-action-group">
                                            <a asp-controller="Reception"
                                               asp-action="Bookings"
                                               asp-route-search="@codeDisplay"
                                               class="reception-btn-sm reception-btn-ghost"
                                               title="ดูรายละเอียด">
                                                <i class="fa-regular fa-eye"></i>
                                            </a>

                                            <a asp-controller="Reception"
                                               asp-action="CheckIn"
                                               asp-route-bookingId="@item.BookingId"
                                               class="reception-btn-sm @(isRoomAssigned && isPayApproved ? "reception-btn-success js-confirm-checkin" : "reception-btn-warning")"
                                               data-booking="@codeDisplay"
                                               data-guest="@item.GuestName"
                                               data-room="@(isRoomAssigned ? item.RoomNumber : "-")">
                                                <i class="fa-solid fa-check"></i> Check-in
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="reception-empty-state">
                                    <i class="fa-regular fa-calendar-check"></i>
                                    <p>ไม่มีรายการรอ Check-in</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Today's Check-out -->
        <section class="reception-panel">
            <div class="reception-panel-header">
                <h3 class="reception-panel-title">
                    <i class="fa-solid fa-arrow-right-from-bracket text-danger"></i>
                    Today's Check-out
                </h3>
                <a asp-controller="Reception" asp-action="CheckOut" class="reception-link-more">
                    ทั้งหมด <i class="fa-solid fa-angle-right"></i>
                </a>
            </div>

            <div class="reception-table-responsive">
                <table class="reception-table">
                    <thead>
                        <tr>
                            <th>Booking ID</th>
                            <th>Guest</th>
                            <th>Room</th>
                            <th>Check-out Date</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.CheckOutList != null && Model.CheckOutList.Any())
                        {
                            foreach (var stay in Model.CheckOutList)
                            {
                                var codeDisplay = string.IsNullOrWhiteSpace(stay.BookingCode) ? $"#{stay.BookingId}" : stay.BookingCode;
                                var isAlreadyCheckedOut = stay.CheckedOutAt.HasValue;

                                <tr>
                                    <td>
                                        <span class="reception-code-badge">@codeDisplay</span>
                                    </td>
                                    <td>
                                        <div class="reception-guest-cell">
                                            <strong>@stay.GuestName</strong>
                                            <small>@stay.GuestPhone · @(stay.ActualGuests ?? stay.NumGuests) ท่าน</small>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="reception-room-chip">ห้อง @stay.RoomNumber</span>
                                        <small class="d-block text-muted">@stay.RoomTypeName</small>
                                    </td>
                                    <td>
                                        <span class="reception-time-text">@stay.CheckOutDate.ToString("dd/MM/yyyy")</span>
                                    </td>
                                    <td>
                                        @if (isAlreadyCheckedOut)
                                        {
                                            <span class="reception-status-badge reception-badge-neutral">Checked-out</span>
                                        }
                                        else
                                        {
                                            <span class="reception-status-badge reception-badge-info">Checked-in</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="reception-action-group">
                                            <a asp-controller="Reception"
                                               asp-action="Bookings"
                                               asp-route-search="@codeDisplay"
                                               class="reception-btn-sm reception-btn-ghost"
                                               title="ดูรายละเอียด">
                                                <i class="fa-regular fa-eye"></i>
                                            </a>

                                            @if (!isAlreadyCheckedOut)
                                            {
                                                <a asp-controller="Reception"
                                                   asp-action="CheckOut"
                                                   asp-route-stayId="@stay.StayId"
                                                   class="reception-btn-sm reception-btn-danger js-confirm-checkout"
                                                   data-booking="@codeDisplay"
                                                   data-guest="@stay.GuestName"
                                                   data-room="@stay.RoomNumber">
                                                    <i class="fa-solid fa-arrow-right-from-bracket"></i> Check-out
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="reception-empty-state">
                                    <i class="fa-solid fa-suitcase-rolling"></i>
                                    <p>ไม่มีรายการรอ Check-out</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <!-- Room Status Overview & Recent Bookings -->
    <div class="reception-bottom-grid reception-fade-in">

        <!-- Room Status Overview -->
        <section class="reception-panel">
            <div class="reception-panel-header">
                <h3 class="reception-panel-title">
                    <i class="fa-solid fa-table-cells-large text-primary"></i>
                    Room Status Overview
                </h3>
                <a asp-controller="Reception" asp-action="Calendar" class="reception-link-more">
                    ปฏิทินห้องพัก <i class="fa-solid fa-angle-right"></i>
                </a>
            </div>

            <div class="reception-room-legend-bar">
                <button type="button" class="reception-filter-chip active" data-filter="all">
                    ทั้งหมด (@(Model?.TotalRooms ?? 0))
                </button>
                <button type="button" class="reception-filter-chip reception-legend-available" data-filter="available">
                    <span class="reception-dot reception-dot-green"></span>
                    Available (@(Model?.AvailableRooms ?? 0))
                </button>
                <button type="button" class="reception-filter-chip reception-legend-occupied" data-filter="occupied">
                    <span class="reception-dot reception-dot-blue"></span>
                    Occupied (@(Model?.OccupiedRooms ?? 0))
                </button>
                <button type="button" class="reception-filter-chip reception-legend-dirty" data-filter="cleaning">
                    <span class="reception-dot reception-dot-orange"></span>
                    Cleaning (@(Model?.NeedsCleaningRooms ?? 0))
                </button>
                <button type="button" class="reception-filter-chip reception-legend-maintenance" data-filter="maintenance">
                    <span class="reception-dot reception-dot-red"></span>
                    Maintenance (@(Model?.MaintenanceRooms ?? 0))
                </button>
            </div>

            @if (Model?.Rooms != null && Model.Rooms.Any())
            {
                <div class="reception-room-card-grid" id="receptionRoomGrid">
                    @foreach (var room in Model.Rooms)
                    {
                        var rawStatus = (room.Status ?? "available").ToLowerInvariant();
                        var normalizedStatus = rawStatus switch
                        {
                            "available" => "available",
                            "occupied" => "occupied",
                            "needs_cleaning" or "dirty" or "cleaning" => "cleaning",
                            "maintenance" => "maintenance",
                            _ => "available"
                        };

                        var cardCss = normalizedStatus == "cleaning" ? "dirty" : normalizedStatus;

                        var statusLabel = normalizedStatus switch
                        {
                            "available" => "Available",
                            "occupied" => "Occupied",
                            "cleaning" => "Cleaning",
                            "maintenance" => "Maintenance",
                            _ => room.Status
                        };

                        var statusIcon = normalizedStatus switch
                        {
                            "available" => "fa-circle-check",
                            "occupied" => "fa-user-lock",
                            "cleaning" => "fa-broom",
                            "maintenance" => "fa-screwdriver-wrench",
                            _ => "fa-door-closed"
                        };

                        <div class="reception-room-card reception-room-@cardCss" data-room-status="@normalizedStatus">
                            <div class="reception-room-card-top">
                                <span class="reception-room-no">@room.RoomNumber</span>
                                <span class="reception-room-floor">ชั้น @room.FloorNo</span>
                            </div>
                            <div class="reception-room-type">@room.RoomTypeName</div>
                            <div class="reception-room-status-pill">
                                <i class="fa-solid @statusIcon"></i>
                                <span>@statusLabel</span>
                            </div>
                        </div>
                    }
                </div>

                <div id="roomOverviewPagination" class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 pt-2 border-top">
                    <small id="roomPageSummary" class="text-muted"></small>
                    <div id="roomPageButtons" class="d-flex align-items-center gap-1"></div>
                </div>
            }
            else
            {
                <div class="reception-room-summary-fallback">
                    <div class="reception-room-card reception-room-available">
                        <div class="reception-room-card-top">
                            <span class="reception-room-no">@(Model?.AvailableRooms ?? 0) ห้อง</span>
                        </div>
                        <div class="reception-room-type">Available</div>
                        <div class="reception-room-status-pill">
                            <i class="fa-solid fa-circle-check"></i> ห้องว่างพร้อมขาย
                        </div>
                    </div>

                    <div class="reception-room-card reception-room-occupied">
                        <div class="reception-room-card-top">
                            <span class="reception-room-no">@(Model?.OccupiedRooms ?? 0) ห้อง</span>
                        </div>
                        <div class="reception-room-type">Occupied</div>
                        <div class="reception-room-status-pill">
                            <i class="fa-solid fa-bed"></i> มีลูกค้าเข้าพัก
                        </div>
                    </div>

                    <div class="reception-room-card reception-room-dirty">
                        <div class="reception-room-card-top">
                            <span class="reception-room-no">@(Model?.NeedsCleaningRooms ?? 0) ห้อง</span>
                        </div>
                        <div class="reception-room-type">Cleaning</div>
                        <div class="reception-room-status-pill">
                            <i class="fa-solid fa-broom"></i> รอทำความสะอาด
                        </div>
                    </div>

                    <div class="reception-room-card reception-room-maintenance">
                        <div class="reception-room-card-top">
                            <span class="reception-room-no">@(Model?.MaintenanceRooms ?? 0) ห้อง</span>
                        </div>
                        <div class="reception-room-type">Maintenance</div>
                        <div class="reception-room-status-pill">
                            <i class="fa-solid fa-screwdriver-wrench"></i> กำลังซ่อมบำรุง
                        </div>
                    </div>
                </div>
            }
        </section>

        <!-- Recent Bookings -->
        <section class="reception-panel">
            <div class="reception-panel-header">
                <h3 class="reception-panel-title">
                    <i class="fa-solid fa-clock-rotate-left text-info"></i>
                    Recent Bookings
                </h3>
                <a asp-controller="Reception" asp-action="Bookings" class="reception-link-more">
                    ทั้งหมด <i class="fa-solid fa-angle-right"></i>
                </a>
            </div>

            <div class="reception-activity-list">
                @if (Model?.RecentBookings != null && Model.RecentBookings.Any())
                {
                    foreach (var booking in Model.RecentBookings)
                    {
                        var codeDisplay = string.IsNullOrWhiteSpace(booking.BookingCode) ? $"#{booking.BookingId}" : booking.BookingCode;
                        var statusNormalized = (booking.Status ?? "").ToLowerInvariant();
                        var statusText = statusNormalized switch
                        {
                            "confirmed" => "Confirmed",
                            "checked_in" => "Checked-in",
                            "checked_out" or "completed" => "Checked-out",
                            "pending_approval" or "pending" => "Pending Approval",
                            "cancelled" => "Cancelled",
                            _ => booking.Status
                        };

                        var badgeClass = statusNormalized switch
                        {
                            "confirmed" => "reception-badge-success",
                            "checked_in" => "reception-badge-info",
                            "checked_out" or "completed" => "reception-badge-neutral",
                            "pending_approval" or "pending" => "reception-badge-warning",
                            "cancelled" => "reception-badge-danger",
                            _ => "reception-badge-neutral"
                        };

                        <div class="reception-activity-item">
                            <div class="reception-activity-icon-wrap @badgeClass">
                                <i class="fa-solid fa-clipboard-check"></i>
                            </div>
                            <div class="reception-activity-body">
                                <div class="reception-activity-top">
                                    <span class="reception-activity-name">@booking.ContactName</span>
                                    <span class="reception-code-badge">@codeDisplay</span>
                                </div>
                                <div class="reception-activity-meta">
                                    <span>@statusText · @booking.NumGuests ท่าน (@booking.Nights คืน)</span>
                                    <span>@booking.CheckInDate.ToString("dd/MM/yyyy") - @booking.CheckOutDate.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                            <div class="reception-activity-action">
                                <a asp-controller="Reception"
                                   asp-action="Bookings"
                                   asp-route-search="@codeDisplay"
                                   class="reception-btn-icon"
                                   title="ดูรายละเอียด">
                                    <i class="fa-solid fa-chevron-right"></i>
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="reception-empty-state">
                        <i class="fa-regular fa-folder-open"></i>
                        <p>ไม่มีรายการจองล่าสุด</p>
                    </div>
                }
            </div>
        </section>

    </div>
</div>

@section Scripts {
    <script src="~/js/reception-dashboard.js" asp-append-version="true"></script>
}