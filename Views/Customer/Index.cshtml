                    <p class="customer-home-section-subtitle">
                        ตัวอย่างความประทับใจจากลูกค้าที่เข้าพักในห้องพักแต่ละประเภทของ StayMate Hotel
                    </p>
                </div>
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <a asp-controller="Customer" asp-action="Reviews" class="customer-home-link-arrow">
                        <span>เขียนรีวิว / ดูรีวิวทั้งหมด</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>

            @if (!Model.Reviews.Any())
            {
                <div class="text-center text-muted py-5">ยังไม่มีรีวิวจากผู้เข้าพัก</div>
            }
            else
            {
                <div class="row g-4">
                    @{ var rvDelay = 50; }
                    @foreach (var rv in Model.Reviews)
                    {
                        <div class="col-12 col-lg-4" data-aos="fade-up" data-aos-delay="@rvDelay">
                            <div class="customer-home-review-card h-100">
                                <div class="customer-home-review-top">
                                    <div class="customer-home-reviewer">
                                        <div class="customer-home-avatar">@(string.IsNullOrWhiteSpace(rv.UserName) ? "?" : rv.UserName.Trim()[0].ToString())</div>
                                        <div>
                                            <h5 class="customer-home-reviewer-name">@rv.UserName</h5>
                                            <span class="customer-home-review-room">
                                                <i class="fa-solid fa-bed text-primary me-1"></i> @rv.RoomTypeName
                                            </span>
                                        </div>
                                    </div>
                                    <div class="customer-home-stars" aria-label="คะแนน @rv.Rating ดาว">
                                        @for (var s = 1; s <= 5; s++)
                                        {
                                            <i class="@(s <= rv.Rating ? "fa-solid" : "fa-regular") fa-star"></i>
                                        }
                                    </div>
                                </div>
                                <p class="customer-home-review-comment">"@rv.Comment"</p>
                                <div class="customer-home-review-footer">
                                    <span><i class="fa-solid fa-circle-check text-success me-1"></i> รีวิวจากผู้เข้าพักจริง</span>
                                    <small class="text-muted">คะแนน @rv.Rating.ToString("0.0") / 5</small>
                                </div>
                            </div>
                        </div>
                        rvDelay += 70;
                    }
                </div>
            }
        </div>
    </section>

    <!-- =========================================================
         SECTION 9: CALL TO ACTION (CTA)
         ========================================================= -->
    <section class="customer-home-cta-section" id="callToAction">
        <div class="container">
            <div class="customer-home-cta-card" data-aos="zoom-in">
                <div class="customer-home-cta-glow"></div>
                <div class="row align-items-center g-4 position-relative z-2">
                    <div class="col-lg-8">
                        <span class="customer-home-cta-badge">
                            <i class="fa-solid fa-sparkles me-1"></i> READY FOR YOUR NEXT URBAN ESCAPE?
                        </span>
                        <h2 class="customer-home-cta-title">
                            วางแผนการเข้าพักครั้งต่อไปของคุณที่ StayMate วันนี้
                        </h2>
                        <p class="customer-home-cta-desc mb-0">
                            สัมผัสความหรูหราทันสมัยในสไตล์ Future Urban Hotel พร้อมรับสิทธิ์โปรโมชั่นสุดคุ้มสำหรับสมาชิก
                            เลือกชมห้องพักที่ถูกใจหรือตรวจสอบห้องว่างเพื่อสำรองห้องพักได้ทันที
                        </p>
                    </div>
                    <div class="col-lg-4 text-lg-end">
                        <div class="d-flex flex-wrap justify-content-lg-end gap-3">
                            <a asp-controller="Customer" asp-action="Rooms" class="customer-home-btn-glass">
                                <i class="fa-solid fa-bed text-info"></i>
                                <span>Explore Rooms</span>
                            </a>
                            <a asp-controller="Customer" asp-action="RoomAvailability" class="customer-home-btn-cyan">
                                <i class="fa-solid fa-calendar-check"></i>
                                <span>Book Now</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. ตั้งค่าวัน Check-in (วันนี้) และ Check-out (พรุ่งนี้) อัตโนมัติตามเวลาเครื่องผู้ใช้
            const checkInInput = document.getElementById("chCheckInDate");
            const checkOutInput = document.getElementById("chCheckOutDate");

            const pad = (n) => String(n).padStart(2, "0");
            const formatDate = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;

            if (checkInInput && checkOutInput) {
                const today = new Date();
                const tomorrow = new Date(today);
                tomorrow.setDate(today.getDate() + 1);

                checkInInput.min = formatDate(today);
                checkInInput.value = formatDate(today);
                checkOutInput.min = formatDate(tomorrow);
                checkOutInput.value = formatDate(tomorrow);

                checkInInput.addEventListener("change", function () {
                    if (!this.value) return;
                    const selected = new Date(this.value + "T00:00:00");
                    const nextDay = new Date(selected);
                    nextDay.setDate(selected.getDate() + 1);
                    checkOutInput.min = formatDate(nextDay);
                    if (!checkOutInput.value || new Date(checkOutInput.value + "T00:00:00") <= selected) {
                        checkOutInput.value = formatDate(nextDay);
                    }
                });
            }

            const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

            // 2. GSAP: Hero Image Zoom & Welcome Text Fade-in
            if (typeof gsap !== "undefined" && !prefersReducedMotion) {
                gsap.fromTo("#customerHeroBg",
                    { scale: 1.14 },
                    { scale: 1, duration: 2.6, ease: "power2.out" }
                );
                gsap.fromTo(".gsap-ch-hero",
                    { opacity: 0, y: 28 },
                    { opacity: 1, y: 0, duration: 0.85, stagger: 0.14, ease: "power3.out", delay: 0.1 }
                );
                gsap.fromTo(".gsap-ch-card",
                    { opacity: 0, x: 36 },
                    { opacity: 1, x: 0, duration: 1.05, ease: "power3.out", delay: 0.45 }
                );
            }

            // 3. Swiper: Promotion Carousel (5 โปรโมชั่น)
            const promoSwiperEl = document.querySelector(".customer-home-promo-swiper");
            if (typeof Swiper !== "undefined" && promoSwiperEl) {
                new Swiper(".customer-home-promo-swiper", {
                    slidesPerView: 1,
                    spaceBetween: 24,
                    loop: @(Model.Promotions.Count > 3 ? "true" : "false"),
                    grabCursor: true,
                    speed: prefersReducedMotion ? 0 : 700,
                    autoplay: prefersReducedMotion ? false : {
                        delay: 4200,
                        disableOnInteraction: false,
                        pauseOnMouseEnter: true
                    },
                    pagination: {
                        el: ".customer-home-swiper-pagination",
                        clickable: true
                    },
                    navigation: {
                        nextEl: ".ch-promo-next",
                        prevEl: ".ch-promo-prev"
                    },
                    breakpoints: {
                        640: { slidesPerView: 1.25, spaceBetween: 20 },
                        768: { slidesPerView: 2, spaceBetween: 24 },
                        1200: { slidesPerView: 3, spaceBetween: 28 }
                    }
                });
            }

            // 4. AOS: Section Scroll Reveal
            if (typeof AOS !== "undefined") {
                AOS.init({
                    duration: 750,
                    easing: "ease-out-cubic",
                    once: true,
                    offset: 70,
                    disable: prefersReducedMotion
                });
            }
        });
    </script>
}
