@model StayMate_Kavinvee_0576.Models.ViewModels.CustomerViewModel
@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Customer Home";

    var displayUserName = (User.Identity != null && User.Identity.IsAuthenticated && !string.IsNullOrWhiteSpace(User.Identity.Name))
        ? User.Identity.Name
        : "คุณลูกค้าคนสำคัญ";

    var promoCount = Model.Promotions.Count;
    var roomCount = Model.Rooms.Count;

    var thMonths = new[] { "ม.ค.", "ก.พ.", "มี.ค.", "เม.ย.", "พ.ค.", "มิ.ย.", "ก.ค.", "ส.ค.", "ก.ย.", "ต.ค.", "พ.ย.", "ธ.ค." };
    string ThDate(DateOnly d) => $"{d.Day:00} {thMonths[d.Month - 1]} {d.Year}";

    (string Label, string Css, string Icon) StatusInfo(string s) => s switch
    {
        "pending_payment"  => ("รอชำระเงิน", "customer-home-status-pending", "fa-clock"),
        "pending_approval" => ("รอตรวจสอบการชำระเงิน", "customer-home-status-pending", "fa-hourglass-half"),
        "confirmed"        => ("ยืนยันการจองแล้ว (Upcoming)", "customer-home-status-confirmed", "fa-circle-check"),
        "checked_in"       => ("กำลังเข้าพัก", "customer-home-status-confirmed", "fa-key"),
        "checked_out"      => ("เข้าพักเสร็จสิ้น", "customer-home-status-confirmed", "fa-circle-check"),
        "cancelled"        => ("ยกเลิกแล้ว", "customer-home-status-cancelled", "fa-ban"),
        "rejected"         => ("ถูกปฏิเสธ", "customer-home-status-cancelled", "fa-circle-xmark"),
        _                  => (s, "customer-home-status-pending", "fa-circle-info")
    };
}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<link rel="stylesheet" href="~/css/Customer.css" asp-append-version="true" />

<div class="customer-home-wrapper">

    @* =========================================================
         QUICK DASHBOARD SUB-BAR (ทางลัดสำหรับสมาชิก)
         ========================================================= *@
    <div class="customer-home-subnav d-none d-lg-flex" aria-label="ทางลัดแดชบอร์ดลูกค้า">
        <div class="customer-home-subnav-inner">
            <span class="customer-home-status">
                <span class="customer-home-live-dot"></span>
                MEMBER PORTAL ACTIVE · WELCOME BACK, @displayUserName.ToUpper()
            </span>
            <div class="customer-home-subnav-links">
                <a href="#quickBookingSearch"><i class="fa-solid fa-magnifying-glass"></i> ค้นหาห้องด่วน</a>
                <a href="#myBookingOverview"><i class="fa-solid fa-receipt"></i> สรุปการจองของฉัน</a>
                <a href="#featuredRooms"><i class="fa-solid fa-bed"></i> ห้องพัก @roomCount ประเภท</a>
                <a href="#specialPromotions"><i class="fa-solid fa-bolt"></i> โปรโมชั่นสมาชิก (@promoCount)</a>
                <a href="#hotelFacilities"><i class="fa-solid fa-microchip"></i> สิ่งอำนวยความสะดวก</a>
            </div>
        </div>
    </div>

    @* =========================================================
         SECTION 1: WELCOME HERO SECTION
         ========================================================= *@
    <section class="customer-home-hero" id="welcomeHero">
        <div class="customer-home-hero-bg" id="customerHeroBg"
             style="background-image: url('https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=2000&q=85');">
        </div>
        <div class="customer-home-hero-overlay"></div>
        <div class="customer-home-orb customer-home-orb-cyan"></div>
        <div class="customer-home-orb customer-home-orb-violet"></div>

        <div class="container position-relative z-2">
            <div class="row align-items-center customer-home-hero-row py-5">
                <div class="col-lg-7 col-xl-7">
                    <div class="customer-home-hero-badge gsap-ch-hero">
                        <span class="customer-home-pulse"></span>
                        <span>WELCOME TO STAYMATE · MEMBER DASHBOARD</span>
                    </div>

                    <h1 class="customer-home-hero-title gsap-ch-hero">
                        ยินดีต้อนรับกลับมา,<br />
                        <span class="customer-home-text-gradient">@displayUserName</span>
                    </h1>

                    <p class="customer-home-hero-desc gsap-ch-hero">
                        พร้อมออกเดินทางสู่ประสบการณ์การพักผ่อนเหนือระดับในสไตล์ <strong>Future Urban Hotel</strong> หรือยัง?
                        จัดการรายการจองห้องพัก เช็คห้องว่างแบบเรียลไทม์ และรับสิทธิ์โปรโมชั่นพิเศษสำหรับสมาชิกได้ทันทีจากแดชบอร์ดของคุณ
                    </p>

                    <div class="customer-home-hero-actions gsap-ch-hero">
                        <a asp-controller="Customer" asp-action="Rooms" class="customer-home-btn-primary">
                            <span>Explore Rooms</span>
                            <i class="fa-solid fa-arrow-right-long"></i>
                        </a>
                        <a href="#quickBookingSearch" class="customer-home-btn-glass">
                            <i class="fa-solid fa-compass text-info"></i>
                            <span>Find Your Stay</span>
                        </a>
                    </div>

                    <!-- Member Quick Status Pills -->
                    <div class="customer-home-hero-highlights gsap-ch-hero">
                        <div class="customer-home-highlight-item">
                            <i class="fa-solid fa-shield-check text-info"></i>
                            <div>
                                <strong>Member Privilege</strong>
                                <span>รับสิทธิ์ใช้โปรโมชั่นครบทั้ง @promoCount แคมเปญ</span>
                            </div>
                        </div>
                        <div class="customer-home-highlight-divider"></div>
                        <div class="customer-home-highlight-item">
                            <i class="fa-solid fa-key text-warning"></i>
                            <div>
                                <strong>Smart Check-in Ready</strong>
                                <span>ตรวจสอบสถานะห้องพักและการชำระเงิน 24 ชม.</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Member Concierge Glass Card -->
                <div class="col-lg-5 col-xl-5 d-none d-lg-block">
                    <div class="customer-home-concierge-card gsap-ch-card">
                        <div class="customer-home-concierge-top">
                            <div>
                                <span class="customer-home-concierge-tag">PERSONAL STAY ASSISTANT</span>
                                <h4 class="text-white fw-bold mb-0 mt-1">StayMate Smart Portal</h4>
                            </div>
                            <span class="customer-home-concierge-icon">
                                <i class="fa-solid fa-user-astronaut"></i>
                            </span>
                        </div>

                        <div class="customer-home-concierge-preview">
                            <img src="https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=900&q=80"
                                 alt="StayMate Futuristic Suite" class="img-fluid" />
                            <span class="customer-home-concierge-pill">
                                <i class="fa-solid fa-circle-check text-info me-1"></i> บัญชีสมาชิกพร้อมใช้งาน
                            </span>
                        </div>

                        <div class="customer-home-concierge-shortcuts">
                            <a asp-controller="Customer" asp-action="MyBookings" class="customer-home-shortcut-tile">
                                <i class="fa-solid fa-receipt"></i>
                                <div>
                                    <strong>การจองของฉัน</strong>
                                    <small>ดูประวัติ &amp; สถานะ</small>
                                </div>
                            </a>
                            <a asp-controller="Customer" asp-action="Checkout" class="customer-home-shortcut-tile">
                                <i class="fa-solid fa-credit-card"></i>
                                <div>
                                    <strong>ชำระเงิน</strong>
                                    <small>แจ้งโอน / ตรวจสอบ</small>
                                </div>
                            </a>
                            <a asp-controller="Customer" asp-action="Profile" class="customer-home-shortcut-tile">
                                <i class="fa-solid fa-user-gear"></i>
                                <div>
                                    <strong>โปรไฟล์ส่วนตัว</strong>
                                    <small>จัดการข้อมูลสมาชิก</small>
                                </div>
                            </a>
                            <a asp-controller="Customer" asp-action="Reviews" class="customer-home-shortcut-tile">
                                <i class="fa-solid fa-star"></i>
                                <div>
                                    <strong>รีวิวการเข้าพัก</strong>
                                    <small>แบ่งปันความประทับใจ</small>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- =========================================================
         SECTION 2: QUICK BOOKING SEARCH
         ========================================================= -->
    <section class="customer-home-search-section" id="quickBookingSearch" data-aos="fade-up" data-aos-duration="700">
        <div class="container">
            <div class="customer-home-search-card">
                <div class="customer-home-search-header">
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <span class="customer-home-search-icon-badge"><i class="fa-solid fa-calendar-check"></i></span>
                        <span class="fw-bold">QUICK BOOKING SEARCH</span>
                        <span class="customer-home-search-pill">ค้นหาห้องว่างสำหรับสมาชิก</span>
                    </div>
                    <span class="customer-home-search-hint d-none d-md-inline">
                        <i class="fa-solid fa-bolt text-primary me-1"></i> เลือกวันเข้าพักและจำนวนผู้เข้าพักเพื่อตรวจสอบห้องว่างทันที
                    </span>
                </div>

                @* 
                    [BACKEND INTEGRATION NOTE]:
                    เมื่อระบบค้นหาห้องว่างใน CustomerController -> RoomAvailability พร้อมรับ Query Parameter แล้ว
                    สามารถเปลี่ยนการส่งค่าจาก Form ด้านล่างให้ส่ง checkIn, checkOut, guests, rooms ไปยัง Action RoomAvailability ได้ทันที
                *@
                <form asp-controller="Customer" asp-action="RoomAvailability" method="get" class="customer-home-search-form">
                    <div class="row g-3 align-items-end">
                        <!-- Check-in Date -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <label for="chCheckInDate" class="customer-home-label">
                                <i class="fa-regular fa-calendar-plus text-primary me-1"></i> วันเช็คอิน (Check-in Date)
                            </label>
                            <input type="date" id="chCheckInDate" name="checkIn" class="form-control customer-home-input" required />
                        </div>

                        <!-- Check-out Date -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <label for="chCheckOutDate" class="customer-home-label">
                                <i class="fa-regular fa-calendar-minus text-primary me-1"></i> วันเช็คเอาท์ (Check-out Date)
                            </label>
                            <input type="date" id="chCheckOutDate" name="checkOut" class="form-control customer-home-input" required />
                        </div>

                        <!-- Guests Count -->
                        <div class="col-12 col-sm-6 col-lg-2">
                            <label for="chGuestCount" class="customer-home-label">
                                <i class="fa-solid fa-user-group text-primary me-1"></i> จำนวนผู้เข้าพัก
                            </label>
                            <select id="chGuestCount" name="guests" class="form-select customer-home-input">
                                <option value="1">1 ท่าน</option>
                                <option value="2" selected>2 ท่าน (ยอดนิยม)</option>
                                <option value="3">3 ท่าน (เตียงเสริม)</option>
                                <option value="4">4 ท่าน (Family)</option>
                                <option value="5">5–6 ท่าน (Suite)</option>
                            </select>
                        </div>

                        <!-- Rooms Count -->
                        <div class="col-12 col-sm-6 col-lg-2">
                            <label for="chRoomCount" class="customer-home-label">
                                <i class="fa-solid fa-door-open text-primary me-1"></i> จำนวนห้อง
                            </label>
                            <select id="chRoomCount" name="rooms" class="form-select customer-home-input">
                                <option value="1" selected>1 ห้อง</option>
                                <option value="2">2 ห้อง</option>
                                <option value="3">3 ห้อง (มา 3 จ่าย 2)</option>
                                <option value="4">4 ห้องขึ้นไป</option>
                            </select>
                        </div>

                        <!-- Submit Search Button -->
                        <div class="col-12 col-lg-2">
                            <button type="submit" class="customer-home-btn-search w-100">
                                <i class="fa-solid fa-magnifying-glass"></i>
                                <span>Search Available Rooms</span>
                            </button>
                        </div>
                    </div>

                    <div class="customer-home-search-quickbar">
                        <span class="customer-home-quickbar-label"><i class="fa-solid fa-wand-magic-sparkles text-primary me-1"></i> ทางลัดยอดนิยม:</span>
                        <a asp-controller="Customer" asp-action="RoomAvailability" class="customer-home-quick-tag">🛏️ เช็คห้องว่างวันนี้</a>
                        <a asp-controller="Customer" asp-action="Promotions" class="customer-home-quick-tag">🔥 โปรโมชั่น มา 3 จ่าย 2</a>
                        <a asp-controller="Customer" asp-action="Rooms" class="customer-home-quick-tag">👨‍👩‍👧‍👦 ห้องพักครอบครัว Family</a>
                        <a asp-controller="Customer" asp-action="MyBookings" class="customer-home-quick-tag">📋 ดูการจองของฉัน</a>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <!-- =========================================================
         SECTION 3: MY BOOKING OVERVIEW (สำคัญที่สุดสำหรับหน้าสมาชิก)
         ========================================================= -->
    <section class="customer-home-section" id="myBookingOverview">
        <div class="container">
            <div class="customer-home-section-header" data-aos="fade-up">
                <div>
                    <span class="customer-home-eyebrow">
                        <i class="fa-solid fa-chart-pie me-1"></i> PERSONAL BOOKING DASHBOARD
                    </span>
                    <h2 class="customer-home-section-title">My Booking Overview · สรุปข้อมูลการจองของคุณ</h2>
                    <p class="customer-home-section-subtitle">
                        ติดตามสถานะการจองห้องพัก กำหนดการเช็คอิน และรายการรอตรวจสอบการชำระเงินได้ในที่เดียว
                    </p>
                </div>
                <a asp-controller="Customer" asp-action="MyBookings" class="customer-home-link-arrow">
                    <span>ดูการจองทั้งหมด</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>

            <div class="row g-3 g-md-4 mb-4" data-aos="fade-up" data-aos-delay="50">
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="customer-home-stat-card customer-home-stat-total">
                        <div class="customer-home-stat-icon"><i class="fa-solid fa-layer-group"></i></div>
                        <div class="customer-home-stat-info">
                            <span class="customer-home-stat-label">จำนวนการจองทั้งหมด</span>
                            <div class="d-flex align-items-baseline gap-2">
                                <h3 class="customer-home-stat-value">@Model.TotalBookings</h3>
                                <span class="customer-home-stat-unit">รายการ</span>
                            </div>
                            <small class="customer-home-stat-note">ข้อมูลจากบัญชีของคุณ</small>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="customer-home-stat-card customer-home-stat-upcoming">
                        <div class="customer-home-stat-icon"><i class="fa-solid fa-calendar-day"></i></div>
                        <div class="customer-home-stat-info">
                            <span class="customer-home-stat-label">กำลังจะเข้าพัก (Upcoming)</span>
                            <div class="d-flex align-items-baseline gap-2">
                                <h3 class="customer-home-stat-value">@Model.UpcomingBookings</h3>
                                <span class="customer-home-stat-unit">รายการ</span>
                            </div>
                            <small class="customer-home-stat-note">ยืนยันการจองแล้ว</small>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="customer-home-stat-card customer-home-stat-pending">
                        <div class="customer-home-stat-icon"><i class="fa-solid fa-hourglass-half"></i></div>
                        <div class="customer-home-stat-info">
                            <span class="customer-home-stat-label">รอชำระ / รอตรวจสอบ</span>
                            <div class="d-flex align-items-baseline gap-2">
                                <h3 class="customer-home-stat-value">@Model.PendingBookings</h3>
                                <span class="customer-home-stat-unit">รายการ</span>
                            </div>
                            <small class="customer-home-stat-note">รอชำระเงินหรือรอฝ่ายการเงินอนุมัติ</small>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="customer-home-stat-card customer-home-stat-completed">
                        <div class="customer-home-stat-icon"><i class="fa-solid fa-circle-check"></i></div>
                        <div class="customer-home-stat-info">
                            <span class="customer-home-stat-label">เข้าพักเสร็จสิ้นแล้ว</span>
                            <div class="d-flex align-items-baseline gap-2">
                                <h3 class="customer-home-stat-value">@Model.CompletedBookings</h3>
                                <span class="customer-home-stat-unit">รายการ</span>
                            </div>
                            <small class="customer-home-stat-note">Check-out แล้ว</small>
                        </div>
                    </div>
                </div>
            </div>

            @if (!Model.LatestBookings.Any())
            {
                <div class="customer-home-booking-card text-center py-5" data-aos="fade-up">
                    <i class="fa-solid fa-suitcase-rolling fa-2x text-info mb-3"></i>
                    <h4 class="customer-home-booking-title">ยังไม่มีรายการจอง</h4>
                    <p class="customer-home-booking-sub">เริ่มค้นหาห้องว่างแล้วจองการเข้าพักครั้งแรกของคุณได้เลย</p>
                    <div>
                        <a asp-controller="Customer" asp-action="RoomAvailability" class="customer-home-btn-primary">
                            <span>ค้นหาห้องว่าง</span> <i class="fa-solid fa-arrow-right-long"></i>
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-4" data-aos="fade-up" data-aos-delay="120">
                    @foreach (var b in Model.LatestBookings)
                    {
                        var st = StatusInfo(b.Status);
                        <div class="col-12 col-lg-6">
                            <div class="customer-home-booking-card">
                                <div class="customer-home-booking-top">
                                    <span class="customer-home-booking-id">BOOKING ID: #@b.BookingCode</span>
                                    <span class="customer-home-status-badge @st.Css">
                                        <i class="fa-solid @st.Icon me-1"></i> @st.Label
                                    </span>
                                </div>

                                <div class="customer-home-booking-body">
                                    <div class="customer-home-booking-room-info">
                                        <img src="@b.ImageUrl" alt="@b.RoomTypeName" class="customer-home-booking-thumb" />
                                        <div>
                                            <span class="customer-home-booking-cat">ROOM TYPE</span>
                                            <h4 class="customer-home-booking-title">@b.RoomTypeName</h4>
                                            <p class="customer-home-booking-sub mb-0">
                                                <i class="fa-solid fa-tag text-info me-1"></i>
                                                โปรโมชั่นที่ใช้: @(string.IsNullOrEmpty(b.PromoName) ? "ไม่ได้ใช้โปรโมชั่น" : b.PromoName)
                                            </p>
                                        </div>
                                    </div>

                                    <div class="customer-home-booking-grid">
                                        <div class="customer-home-booking-meta-box">
                                            <small><i class="fa-regular fa-calendar-check text-primary me-1"></i> Check-in / Check-out</small>
                                            <strong>@ThDate(b.CheckIn) – @ThDate(b.CheckOut) (@b.Nights คืน)</strong>
                                        </div>
                                        <div class="customer-home-booking-meta-box">
                                            <small><i class="fa-solid fa-user-group text-primary me-1"></i> จำนวนผู้เข้าพัก</small>
                                            <strong>@b.Guests ท่าน · @b.RoomCount ห้อง</strong>
                                        </div>
                                    </div>
                                </div>

                                <div class="customer-home-booking-footer">
                                    <div class="customer-home-booking-price">
                                        <small>ยอดชำระเงินสุทธิ</small>
                                        <strong>฿@b.TotalAmount.ToString("N0")</strong>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2">
                                        @if (b.Status == "pending_payment")
                                        {
                                            <a asp-controller="Customer" asp-action="Checkout" class="customer-home-btn-pay">
                                                <i class="fa-solid fa-credit-card"></i> ชำระเงิน
                                            </a>
                                        }
                                        <a asp-controller="Customer" asp-action="BookingDetails" asp-route-id="@b.BookingId" class="customer-home-btn-detail">
                                            <span>View Booking Details</span>
                                            <i class="fa-solid fa-arrow-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <!-- =========================================================
         SECTION 4: FEATURED ROOMS (4 ประเภทห้องพัก)
         ========================================================= -->
    <section class="customer-home-section customer-home-bg-alt" id="featuredRooms">
        <div class="container">
            <div class="customer-home-section-header" data-aos="fade-up">
                <div>
                    <span class="customer-home-eyebrow">
                        <i class="fa-solid fa-bed me-1"></i> SMART ACCOMMODATION COLLECTION
                    </span>
                    <h2 class="customer-home-section-title">Featured Rooms · แนะนำห้องพักทั้ง @roomCount ประเภท</h2>
                    <p class="customer-home-section-subtitle">
                        เลือกห้องพักดีไซน์ล้ำสมัยที่ออกแบบมาเพื่อรองรับทุกไลฟ์สไตล์ ตั้งแต่นักเดินทางคนเดียว คู่รัก ครอบครัว ไปจนถึงระดับ Executive Suite
                    </p>
                </div>
                <a asp-controller="Customer" asp-action="Rooms" class="customer-home-link-arrow">
                    <span>เปรียบเทียบห้องพักทั้งหมด</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>

            @* 
                [BACKEND INTEGRATION NOTE - FEATURED ROOMS]:
                เมื่อส่งรายการห้องพักจริงมาจากฐานข้อมูลผ่าน ViewModel หรือ ViewBag แล้ว
                สามารถใช้คำสั่ง C# foreach วนลูปเพื่อแสดงรายละเอียดและราคาเริ่มต้นตามประเภทห้องต่าง ๆ ได้:
                
                foreach (var r in Model.RoomTypes) { ... }
            *@
            <div class="row g-4">
                @if (!Model.Rooms.Any())
                {
                    <div class="col-12 text-center text-muted py-5">ยังไม่มีข้อมูลห้องพักในระบบ</div>
                }

                @{ var roomDelay = 50; }
                @foreach (var r in Model.Rooms)
                {
                    <div class="col-12 col-md-6 col-xl-3" data-aos="fade-up" data-aos-delay="@roomDelay">
                        <article class="customer-home-room-card h-100">
                            <div class="customer-home-room-img-wrap">
                                <img src="@r.ImageUrl" alt="@r.TypeName" class="customer-home-room-img" loading="lazy" />
                                @if (!string.IsNullOrEmpty(r.BadgeText))
                                {
                                    <span class="customer-home-room-badge @r.BadgeClass">@r.BadgeText</span>
                                }
                                <div class="customer-home-room-capacity">
                                    <i class="fa-solid fa-user-group"></i>
                                    @(r.MinGuests == r.MaxGuests ? $"{r.MaxGuests} ท่าน" : $"{r.MinGuests}–{r.MaxGuests} ท่าน")
                                </div>
                            </div>
                            <div class="customer-home-room-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h3 class="customer-home-room-title">@r.TypeName</h3>
                                    @if (!string.IsNullOrEmpty(r.SizeText))
                                    {
                                        <span class="customer-home-room-size">@r.SizeText</span>
                                    }
                                </div>
                                <p class="customer-home-room-desc">@r.Description</p>
                                <ul class="customer-home-room-highlights">
                                    @foreach (var h in r.Highlights)
                                    {
                                        <li><i class="fa-solid fa-check text-info"></i> @h</li>
                                    }
                                </ul>
                                <div class="customer-home-room-footer">
                                    <div class="customer-home-room-price">
                                        <small>ราคาเริ่มต้น</small>
                                        <strong>฿@r.Price.ToString("N0")</strong><span>/คืน</span>
                                        <small class="d-block @(r.AvailableRooms > 0 ? "text-success" : "text-danger")">
                                            @(r.AvailableRooms > 0 ? $"ว่าง {r.AvailableRooms} ห้อง" : "เต็มชั่วคราว")
                                        </small>
                                    </div>
                                    <a asp-controller="Customer" asp-action="RoomDetails" asp-route-id="@r.RoomTypeId" class="customer-home-btn-room">
                                        View Details <i class="fa-solid fa-angle-right"></i>
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                    roomDelay += 70;
                }
            </div>
        </div>
    </section>

    <!-- =========================================================
         SECTION 5: SPECIAL PROMOTIONS (5 โปรโมชั่นหลัก)
         ========================================================= -->
    <section class="customer-home-promo-section" id="specialPromotions">
        <div class="container">
            <div class="customer-home-section-header customer-home-header-light" data-aos="fade-up">
                <div>
                    <span class="customer-home-eyebrow customer-home-eyebrow-cyan">
                        <i class="fa-solid fa-fire-flame-curved me-1"></i> MEMBER EXCLUSIVE CAMPAIGNS
                    </span>
                    <h2 class="customer-home-section-title text-white">Special Promotions · @promoCount โปรโมชั่นพิเศษสำหรับสมาชิก</h2>
                    <p class="customer-home-section-subtitle text-light opacity-75">
                        คัดสรรดีลสุดคุ้มครบทั้ง 5 รูปแบบ เลือกใช้สิทธิ์ในการจองครั้งถัดไปของคุณได้ทันที
                    </p>
                </div>

                <div class="customer-home-swiper-nav">
                    <button type="button" class="customer-home-swiper-btn ch-promo-prev" aria-label="โปรโมชั่นก่อนหน้า">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <button type="button" class="customer-home-swiper-btn ch-promo-next" aria-label="โปรโมชั่นถัดไป">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>
            </div>

            @if (!Model.Promotions.Any())
            {
                <div class="text-center text-light opacity-75 py-5">ขณะนี้ยังไม่มีโปรโมชั่นที่เปิดให้ใช้งาน</div>
            }
            else
            {
                <div class="swiper customer-home-promo-swiper" data-aos="fade-up" data-aos-delay="100">
                    <div class="swiper-wrapper">
                        @{ var pn = 0; }
                        @foreach (var p in Model.Promotions)
                        {
                            pn++;
                            <div class="swiper-slide h-auto">
                                <div class="customer-home-promo-card @p.GradClass h-100">
                                    <div class="customer-home-promo-top">
                                        <span class="customer-home-promo-pill">PROMO @pn.ToString("00") · @p.PromoCode</span>
                                        <span class="customer-home-promo-icon"><i class="fa-solid @p.IconClass"></i></span>
                                    </div>
                                    <h3 class="customer-home-promo-title">@p.PromoName</h3>
                                    <p class="customer-home-promo-desc">@p.Description</p>
                                    <div class="customer-home-promo-details">
                                        <div class="customer-home-promo-detail-item">
                                            <strong><i class="fa-solid fa-gift text-info me-1"></i> สิทธิประโยชน์:</strong>
                                            <span>@p.BenefitText</span>
                                        </div>
                                        <div class="customer-home-promo-detail-item">
                                            <strong><i class="fa-solid fa-circle-exclamation text-warning me-1"></i> เงื่อนไขเบื้องต้น:</strong>
                                            <span>@p.ConditionText</span>
                                        </div>
                                        @if (p.ValidTo.HasValue)
                                        {
                                            <small class="d-block opacity-75">ถึงวันที่ @ThDate(p.ValidTo.Value)</small>
                                        }
                                    </div>
                                    <a asp-controller="Customer" asp-action="Promotions" class="customer-home-promo-btn">
                                        <span>View Promotion</span>
                                        <i class="fa-solid fa-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="swiper-pagination customer-home-swiper-pagination"></div>
                </div>
            }
        </div>
    </section>

