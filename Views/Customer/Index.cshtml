@model StayMate_Kavinvee_0576.Models.User
@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Customer Home";

    // ดึงชื่อผู้ใช้งานจาก Claims (ยืนยันแล้วจาก _CustomerLayout.cshtml)
    var displayUserName = (User.Identity != null && User.Identity.IsAuthenticated && !string.IsNullOrWhiteSpace(User.Identity.Name))
        ? User.Identity.Name
        : "คุณลูกค้าคนสำคัญ";

    // ดึงจำนวนการจองทั้งหมดจาก Navigation Property ที่ยืนยันแล้วใน CustomerController (Include(u => u.Bookings))
    var hasRealBookings = Model?.Bookings != null;
    var realTotalBookings = Model?.Bookings?.Count ?? 0;
}

@* โหลด Google Font (Prompt), AOS, Swiper และ Customer.css โดยไม่ใช้ section Styles เพื่อป้องกัน Error จาก _CustomerLayout.cshtml *@
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<link rel="stylesheet" href="~/css/Customer.css" asp-append-version="true" />

<div class="customer-home-wrapper">

    @* =========================================================
         QUICK DASHBOARD SUB-BAR (ทางลัดสำหรับสมาชิก)
         ========================================================= *@
    <div class="customer-home-subnav d-none d-lg-flex" aria-label="ทางลัดแดชบอร์ดลูกค้า">
        <div class="customer-home-subnav-inner">
            <span class="customer-home-status">
                <span class="customer-home-live-dot"></span>
                MEMBER PORTAL ACTIVE · WELCOME BACK, @displayUserName.ToUpper()
            </span>
            <div class="customer-home-subnav-links">
                <a href="#quickBookingSearch"><i class="fa-solid fa-magnifying-glass"></i> ค้นหาห้องด่วน</a>
                <a href="#myBookingOverview"><i class="fa-solid fa-receipt"></i> สรุปการจองของฉัน</a>
                <a href="#featuredRooms"><i class="fa-solid fa-bed"></i> ห้องพัก 4 ประเภท</a>
                <a href="#specialPromotions"><i class="fa-solid fa-bolt"></i> โปรโมชั่นสมาชิก (5)</a>
                <a href="#hotelFacilities"><i class="fa-solid fa-microchip"></i> สิ่งอำนวยความสะดวก</a>
            </div>
        </div>
    </div>

    @* =========================================================
         SECTION 1: WELCOME HERO SECTION
         ========================================================= *@
    <section class="customer-home-hero" id="welcomeHero">
        <div class="customer-home-hero-bg" id="customerHeroBg"
             style="background-image: url('https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=2000&q=85');">
        </div>
        <div class="customer-home-hero-overlay"></div>
        <div class="customer-home-orb customer-home-orb-cyan"></div>
        <div class="customer-home-orb customer-home-orb-violet"></div>

        <div class="container position-relative z-2">
            <div class="row align-items-center customer-home-hero-row py-5">
                <div class="col-lg-7 col-xl-7">
                    <div class="customer-home-hero-badge gsap-ch-hero">
                        <span class="customer-home-pulse"></span>
                        <span>WELCOME TO STAYMATE · MEMBER DASHBOARD</span>
                    </div>

                    <h1 class="customer-home-hero-title gsap-ch-hero">
                        ยินดีต้อนรับกลับมา,<br />
                        <span class="customer-home-text-gradient">@displayUserName</span>
                    </h1>

                    <p class="customer-home-hero-desc gsap-ch-hero">
                        พร้อมออกเดินทางสู่ประสบการณ์การพักผ่อนเหนือระดับในสไตล์ <strong>Future Urban Hotel</strong> หรือยัง?
                        จัดการรายการจองห้องพัก เช็คห้องว่างแบบเรียลไทม์ และรับสิทธิ์โปรโมชั่นพิเศษสำหรับสมาชิกได้ทันทีจากแดชบอร์ดของคุณ
                    </p>

                    <div class="customer-home-hero-actions gsap-ch-hero">
                        <a asp-controller="Customer" asp-action="Rooms" class="customer-home-btn-primary">
                            <span>Explore Rooms</span>
                            <i class="fa-solid fa-arrow-right-long"></i>
                        </a>
                        <a href="#quickBookingSearch" class="customer-home-btn-glass">
                            <i class="fa-solid fa-compass text-info"></i>
                            <span>Find Your Stay</span>
                        </a>
                    </div>

                    <!-- Member Quick Status Pills -->
                    <div class="customer-home-hero-highlights gsap-ch-hero">
                        <div class="customer-home-highlight-item">
                            <i class="fa-solid fa-shield-check text-info"></i>
                            <div>
                                <strong>Member Privilege</strong>
                                <span>รับสิทธิ์ใช้โปรโมชั่นครบทั้ง 5 แคมเปญ</span>
                            </div>
                        </div>
                        <div class="customer-home-highlight-divider"></div>
                        <div class="customer-home-highlight-item">
                            <i class="fa-solid fa-key text-warning"></i>
                            <div>
                                <strong>Smart Check-in Ready</strong>
                                <span>ตรวจสอบสถานะห้องพักและการชำระเงิน 24 ชม.</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Member Concierge Glass Card -->
                <div class="col-lg-5 col-xl-5 d-none d-lg-block">
                    <div class="customer-home-concierge-card gsap-ch-card">
                        <div class="customer-home-concierge-top">
                            <div>
                                <span class="customer-home-concierge-tag">PERSONAL STAY ASSISTANT</span>
                                <h4 class="text-white fw-bold mb-0 mt-1">StayMate Smart Portal</h4>
                            </div>
                            <span class="customer-home-concierge-icon">
                                <i class="fa-solid fa-user-astronaut"></i>
                            </span>
                        </div>

                        <div class="customer-home-concierge-preview">
                            <img src="https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=900&q=80"
                                 alt="StayMate Futuristic Suite" class="img-fluid" />
                            <span class="customer-home-concierge-pill">
                                <i class="fa-solid fa-circle-check text-info me-1"></i> บัญชีสมาชิกพร้อมใช้งาน
                            </span>
                        </div>

                        <div class="customer-home-concierge-shortcuts">
                            <a asp-controller="Customer" asp-action="MyBookings" class="customer-home-shortcut-tile">
                                <i class="fa-solid fa-receipt"></i>
                                <div>
                                    <strong>การจองของฉัน</strong>
                                    <small>ดูประวัติ &amp; สถานะ</small>
                                </div>
                            </a>
                            <a asp-controller="Customer" asp-action="Checkout" class="customer-home-shortcut-tile">
                                <i class="fa-solid fa-credit-card"></i>
                                <div>
                                    <strong>ชำระเงิน</strong>
                                    <small>แจ้งโอน / ตรวจสอบ</small>
                                </div>
                            </a>
                            <a asp-controller="Customer" asp-action="Profile" class="customer-home-shortcut-tile">
                                <i class="fa-solid fa-user-gear"></i>
                                <div>
                                    <strong>โปรไฟล์ส่วนตัว</strong>
                                    <small>จัดการข้อมูลสมาชิก</small>
                                </div>
                            </a>
                            <a asp-controller="Customer" asp-action="Reviews" class="customer-home-shortcut-tile">
                                <i class="fa-solid fa-star"></i>
                                <div>
                                    <strong>รีวิวการเข้าพัก</strong>
                                    <small>แบ่งปันความประทับใจ</small>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- =========================================================
         SECTION 2: QUICK BOOKING SEARCH
         ========================================================= -->
    <section class="customer-home-search-section" id="quickBookingSearch" data-aos="fade-up" data-aos-duration="700">
        <div class="container">
            <div class="customer-home-search-card">
                <div class="customer-home-search-header">
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <span class="customer-home-search-icon-badge"><i class="fa-solid fa-calendar-check"></i></span>
                        <span class="fw-bold">QUICK BOOKING SEARCH</span>
                        <span class="customer-home-search-pill">ค้นหาห้องว่างสำหรับสมาชิก</span>
                    </div>
                    <span class="customer-home-search-hint d-none d-md-inline">
                        <i class="fa-solid fa-bolt text-primary me-1"></i> เลือกวันเข้าพักและจำนวนผู้เข้าพักเพื่อตรวจสอบห้องว่างทันที
                    </span>
                </div>

                @* 
                    [BACKEND INTEGRATION NOTE]:
                    เมื่อระบบค้นหาห้องว่างใน CustomerController -> RoomAvailability พร้อมรับ Query Parameter แล้ว
                    สามารถเปลี่ยนการส่งค่าจาก Form ด้านล่างให้ส่ง checkIn, checkOut, guests, rooms ไปยัง Action RoomAvailability ได้ทันที
                *@
                <form asp-controller="Customer" asp-action="RoomAvailability" method="get" class="customer-home-search-form">
                    <div class="row g-3 align-items-end">
                        <!-- Check-in Date -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <label for="chCheckInDate" class="customer-home-label">
                                <i class="fa-regular fa-calendar-plus text-primary me-1"></i> วันเช็คอิน (Check-in Date)
                            </label>
                            <input type="date" id="chCheckInDate" name="checkIn" class="form-control customer-home-input" required />
                        </div>

                        <!-- Check-out Date -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <label for="chCheckOutDate" class="customer-home-label">
                                <i class="fa-regular fa-calendar-minus text-primary me-1"></i> วันเช็คเอาท์ (Check-out Date)
                            </label>
                            <input type="date" id="chCheckOutDate" name="checkOut" class="form-control customer-home-input" required />
                        </div>

                        <!-- Guests Count -->
                        <div class="col-12 col-sm-6 col-lg-2">
                            <label for="chGuestCount" class="customer-home-label">
                                <i class="fa-solid fa-user-group text-primary me-1"></i> จำนวนผู้เข้าพัก
                            </label>
                            <select id="chGuestCount" name="guests" class="form-select customer-home-input">
                                <option value="1">1 ท่าน</option>
                                <option value="2" selected>2 ท่าน (ยอดนิยม)</option>
                                <option value="3">3 ท่าน (เตียงเสริม)</option>
                                <option value="4">4 ท่าน (Family)</option>
                                <option value="5">5–6 ท่าน (Suite)</option>
                            </select>
                        </div>

                        <!-- Rooms Count -->
                        <div class="col-12 col-sm-6 col-lg-2">
                            <label for="chRoomCount" class="customer-home-label">
                                <i class="fa-solid fa-door-open text-primary me-1"></i> จำนวนห้อง
                            </label>
                            <select id="chRoomCount" name="rooms" class="form-select customer-home-input">
                                <option value="1" selected>1 ห้อง</option>
                                <option value="2">2 ห้อง</option>
                                <option value="3">3 ห้อง (มา 3 จ่าย 2)</option>
                                <option value="4">4 ห้องขึ้นไป</option>
                            </select>
                        </div>

                        <!-- Submit Search Button -->
                        <div class="col-12 col-lg-2">
                            <button type="submit" class="customer-home-btn-search w-100">
                                <i class="fa-solid fa-magnifying-glass"></i>
                                <span>Search Available Rooms</span>
                            </button>
                        </div>
                    </div>

                    <div class="customer-home-search-quickbar">
                        <span class="customer-home-quickbar-label"><i class="fa-solid fa-wand-magic-sparkles text-primary me-1"></i> ทางลัดยอดนิยม:</span>
                        <a asp-controller="Customer" asp-action="RoomAvailability" class="customer-home-quick-tag">🛏️ เช็คห้องว่างวันนี้</a>
                        <a asp-controller="Customer" asp-action="Promotions" class="customer-home-quick-tag">🔥 โปรโมชั่น มา 3 จ่าย 2</a>
                        <a asp-controller="Customer" asp-action="Rooms" class="customer-home-quick-tag">👨‍👩‍👧‍👦 ห้องพักครอบครัว Family</a>
                        <a asp-controller="Customer" asp-action="MyBookings" class="customer-home-quick-tag">📋 ดูการจองของฉัน</a>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <!-- =========================================================
         SECTION 3: MY BOOKING OVERVIEW (สำคัญที่สุดสำหรับหน้าสมาชิก)
         ========================================================= -->
    <section class="customer-home-section" id="myBookingOverview">
        <div class="container">
            <div class="customer-home-section-header" data-aos="fade-up">
                <div>
                    <span class="customer-home-eyebrow">
                        <i class="fa-solid fa-chart-pie me-1"></i> PERSONAL BOOKING DASHBOARD
                    </span>
                    <h2 class="customer-home-section-title">My Booking Overview · สรุปข้อมูลการจองของคุณ</h2>
                    <p class="customer-home-section-subtitle">
                        ติดตามสถานะการจองห้องพัก กำหนดการเช็คอิน และรายการรอตรวจสอบการชำระเงินได้ในที่เดียว
                    </p>
                </div>
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <span class="customer-home-mock-notice-badge" title="ข้อมูลตัวอย่างสำหรับการออกแบบ UI รอการผูก Property จาก Backend">
                        <i class="fa-solid fa-flask me-1"></i> UI Preview (Mock Data)
                    </span>
                    <a asp-controller="Customer" asp-action="MyBookings" class="customer-home-link-arrow">
                        <span>ดูการจองทั้งหมด</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>

            @* 
                [BACKEND INTEGRATION NOTE - BOOKING SUMMARY COUNTERS]:
                ปัจจุบันดึงจำนวนการจองทั้งหมดจาก Model.Bookings.Count ได้แล้วหากมีข้อมูลใน DB
                เมื่อยืนยันชื่อ Property สถานะในคลาส Booking (เช่น BookingStatus / PaymentStatus) แล้ว
                สามารถแทนค่าตัวเลขด้านล่างด้วย LINQ เช่น:
                - กำลังจะเข้าพัก: Model.Bookings.Count(b => b.Status == "CONFIRMED")
                - รอตรวจสอบการชำระเงิน: Model.Bookings.Count(b => b.Status == "PENDING_PAYMENT")
                - เข้าพักเสร็จสิ้น: Model.Bookings.Count(b => b.Status == "COMPLETED")
            *@
            <div class="row g-3 g-md-4 mb-4" data-aos="fade-up" data-aos-delay="50">
                <!-- Stat 1: จำนวนการจองทั้งหมด -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="customer-home-stat-card customer-home-stat-total">
                        <div class="customer-home-stat-icon">
                            <i class="fa-solid fa-layer-group"></i>
                        </div>
                        <div class="customer-home-stat-info">
                            <span class="customer-home-stat-label">จำนวนการจองทั้งหมด</span>
                            <div class="d-flex align-items-baseline gap-2">
                                <h3 class="customer-home-stat-value">@(hasRealBookings && realTotalBookings > 0 ? realTotalBookings.ToString() : "3")</h3>
                                <span class="customer-home-stat-unit">รายการ</span>
                            </div>
                            <small class="customer-home-stat-note">
                                @(hasRealBookings && realTotalBookings > 0 ? "ข้อมูลจากบัญชีของคุณ" : "ข้อมูลตัวอย่าง (Mock UI)")
                            </small>
                        </div>
                    </div>
                </div>

                <!-- Stat 2: การจองที่กำลังจะเข้าพัก -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="customer-home-stat-card customer-home-stat-upcoming">
                        <div class="customer-home-stat-icon">
                            <i class="fa-solid fa-calendar-day"></i>
                        </div>
                        <div class="customer-home-stat-info">
                            <span class="customer-home-stat-label">กำลังจะเข้าพัก (Upcoming)</span>
                            <div class="d-flex align-items-baseline gap-2">
                                <h3 class="customer-home-stat-value">1</h3>
                                <span class="customer-home-stat-unit">รายการ</span>
                            </div>
                            <small class="customer-home-stat-note">ข้อมูลตัวอย่าง (Mock UI)</small>
                        </div>
                    </div>
                </div>

                <!-- Stat 3: รายการรอตรวจสอบการชำระเงิน -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="customer-home-stat-card customer-home-stat-pending">
                        <div class="customer-home-stat-icon">
                            <i class="fa-solid fa-hourglass-half"></i>
                        </div>
                        <div class="customer-home-stat-info">
                            <span class="customer-home-stat-label">รอตรวจสอบการชำระเงิน</span>
                            <div class="d-flex align-items-baseline gap-2">
                                <h3 class="customer-home-stat-value">1</h3>
                                <span class="customer-home-stat-unit">รายการ</span>
                            </div>
                            <small class="customer-home-stat-note">ข้อมูลตัวอย่าง (Mock UI)</small>
                        </div>
                    </div>
                </div>

                <!-- Stat 4: รายการที่เข้าพักเสร็จสิ้น -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="customer-home-stat-card customer-home-stat-completed">
                        <div class="customer-home-stat-icon">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                        <div class="customer-home-stat-info">
                            <span class="customer-home-stat-label">เข้าพักเสร็จสิ้นแล้ว</span>
                            <div class="d-flex align-items-baseline gap-2">
                                <h3 class="customer-home-stat-value">1</h3>
                                <span class="customer-home-stat-unit">รายการ</span>
                            </div>
                            <small class="customer-home-stat-note">ข้อมูลตัวอย่าง (Mock UI)</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Alert แจ้งเตือนชัดเจนว่าเป็น Mock Data สำหรับโครงสร้าง UI -->
            <div class="customer-home-mock-banner mb-4" data-aos="fade-up" data-aos-delay="80">
                <div class="d-flex align-items-center gap-3">
                    <span class="customer-home-mock-banner-icon"><i class="fa-solid fa-circle-info"></i></span>
                    <div>
                        <strong>หมายเหตุระบบ (UI Mockup Preview):</strong>
                        การ์ดรายการจองด้านล่างแสดงด้วย <strong>ข้อมูลจำลอง (Mock Data)</strong> เพื่อจัดวางโครงสร้าง UI รอการเชื่อมโยงข้อมูลจริงในตารางการจองของระบบ Backend
                    </div>
                </div>
                <a asp-controller="Customer" asp-action="MyBookings" class="customer-home-btn-MockLink">
                    ไปยังหน้าการจองของฉัน <i class="fa-solid fa-angle-right ms-1"></i>
                </a>
            </div>

            @* 
                [BACKEND INTEGRATION NOTE - LATEST BOOKING CARDS]:
                เมื่อ Backend ยืนยันโครงสร้างฐานข้อมูลการจองห้องพักเสร็จสิ้นแล้ว
                สามารถเปิดการใช้งานโดยเปลี่ยนเป็นคำสั่ง C# foreach ดึงประวัติการจอง 2 รายการล่าสุดมาแสดงได้ทันที:
                
                foreach (var b in Model.Bookings.OrderByDescending(x => x.BookingId).Take(2)) { ... }
            *@
            <div class="row g-4" data-aos="fade-up" data-aos-delay="120">
                <!-- Mock Booking Card 1: Upcoming / Confirmed -->
                <div class="col-12 col-lg-6">
                    <div class="customer-home-booking-card">
                        <div class="customer-home-booking-top">
                            <div class="d-flex align-items-center flex-wrap gap-2">
                                <span class="customer-home-booking-id">BOOKING ID: #SM-MOCK-202601</span>
                                <span class="customer-home-mock-pill">MOCK DATA</span>
                            </div>
                            <span class="customer-home-status-badge customer-home-status-confirmed">
                                <i class="fa-solid fa-circle-check me-1"></i> ยืนยันการจองแล้ว (Upcoming)
                            </span>
                        </div>

                        <div class="customer-home-booking-body">
                            <div class="customer-home-booking-room-info">
                                <img src="https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=600&q=80"
                                     alt="Deluxe Room" class="customer-home-booking-thumb" />
                                <div>
                                    <span class="customer-home-booking-cat">ROOM TYPE (ตัวอย่างข้อมูล)</span>
                                    <h4 class="customer-home-booking-title">Deluxe Urban Room</h4>
                                    <p class="customer-home-booking-sub mb-0">
                                        <i class="fa-solid fa-tag text-info me-1"></i> โปรโมชั่นที่ใช้: Stay 3+ Nights Saver
                                    </p>
