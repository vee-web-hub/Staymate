@model StayMate_Kavinvee_0576.Models.User
@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";

    // ดึงค่า id จาก Route (/Customer/BookingDetails/{id}) หรือ Query String
    var routeIdStr = ViewContext.RouteData.Values["id"]?.ToString()
                     ?? Context.Request.Query["id"].ToString();
    uint.TryParse(routeIdStr, out var requestedId);

    // ดึงใบจองที่ตรงกับ ID (หรือใบจองแรกใน Model ที่ Controller กรองมาให้แล้ว)
    var booking = Model?.Bookings?.FirstOrDefault(b => b.BookingId == requestedId)
                  ?? Model?.Bookings?.FirstOrDefault();

    var firstRoom = booking?.BookingRooms?.FirstOrDefault();
    var rt = firstRoom?.RoomType;
    var roomEntity = firstRoom?.Room;
    var latestPayment = booking?.Payments?.OrderByDescending(p => p.CreatedAt).FirstOrDefault();

    string MapBookingStatus(string? dbStatus)
    {
        return (dbStatus ?? "").ToLowerInvariant() switch
        {
            "confirmed" or "approved" or "checked_in" => "Approved",
            "rejected" => "Rejected",
            "checked_out" or "completed" => "Completed",
            "cancelled" or "canceled" => "Cancelled",
            _ => "Pending"
        };
    }

    string MapPaymentStatus(StayMate_Kavinvee_0576.Models.Booking? b, StayMate_Kavinvee_0576.Models.Payment? p)
    {
        if (p == null)
        {
            var bStat = (b?.Status ?? "").ToLowerInvariant();
            if (bStat == "confirmed" || bStat == "checked_out" || bStat == "approved") return "Paid";
            if (bStat == "pending_approval") return "Pending Verification";
            if (bStat == "rejected") return "Rejected";
            return "Unpaid";
        }

        return (p.Status ?? "").ToLowerInvariant() switch
        {
            "approved" or "paid" or "completed" or "verified" => "Paid",
            "pending" or "pending_verification" or "verifying" => "Pending Verification",
            "rejected" or "failed" => "Rejected",
            _ => "Unpaid"
        };
    }

    string GetRoomImage(string? code, string? name)
    {
        var key = ((code ?? "") + " " + (name ?? "")).ToLowerInvariant();
        if (key.Contains("std") || key.Contains("standard"))
            return "https://images.unsplash.com/photo-1631049307264-da0ec9d70304?auto=format&fit=crop&w=1000&q=80";
        if (key.Contains("dlx") || key.Contains("deluxe"))
            return "https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=1000&q=80";
        if (key.Contains("fam") || key.Contains("family"))
            return "https://images.unsplash.com/photo-1566665797739-1674de7a421a?auto=format&fit=crop&w=1000&q=80";
        if (key.Contains("sui") || key.Contains("suite"))
            return "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=1000&q=80";
        return "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1000&q=80";
    }

    string bookingCode = booking?.BookingCode ?? "-";
    string guestName = !string.IsNullOrWhiteSpace(booking?.ContactName)
        ? booking.ContactName
        : (!string.IsNullOrWhiteSpace(Model?.FullName) ? Model.FullName : "สมาชิก StayMate");
    string contactEmail = booking?.ContactEmail ?? Model?.Email ?? "-";
    string contactPhone = booking?.ContactPhone ?? Model?.Phone ?? "-";

    string roomType = rt?.TypeName ?? "Standard Room";
    byte roomTypeId = rt?.RoomTypeId ?? 1;
    string roomName = roomEntity != null ? $"{roomType} · ห้อง #{roomEntity.RoomNumber}" : roomType;
    string roomImage = GetRoomImage(rt?.TypeCode, rt?.TypeName);

    string checkInText = booking != null ? $"{booking.CheckInDate:dd MMM yyyy} (ตั้งแต่ 14:00 น.)" : "-";
    string checkOutText = booking != null ? $"{booking.CheckOutDate:dd MMM yyyy} (ก่อน 12:00 น.)" : "-";
    string bookedDateText = booking != null ? booking.CreatedAt.ToString("dd MMM yyyy · HH:mm น.") : "-";

    int nights = booking != null ? (int)booking.Nights : 1;
    int guests = booking != null ? (int)booking.NumGuests : 2;
    int roomsCount = booking?.BookingRooms != null && booking.BookingRooms.Any() ? booking.BookingRooms.Count : 1;

    string bedType = !string.IsNullOrWhiteSpace(rt?.BedType) ? rt.BedType : "เตียงมาตรฐาน";
    if (firstRoom != null && firstRoom.ExtraBedQty > 0)
    {
        bedType += $" + เตียงเสริม {firstRoom.ExtraBedQty} เตียง";
    }

    decimal roomPrice = booking?.RoomAmount ?? 0m;
    decimal promoDiscount = booking?.DiscountAmount ?? 0m;
    decimal taxAmount = booking?.TaxAmount ?? 0m;
    decimal totalAmount = booking?.TotalAmount ?? 0m;

    string promoName = booking?.BookingPromotions?.Select(bp => bp.Promotion?.PromoName).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n))
                       ?? "ราคาสมาชิกมาตรฐาน";

    string bookingStatus = MapBookingStatus(booking?.Status);
    string paymentStatus = MapPaymentStatus(booking, latestPayment);

    string paymentMethod = latestPayment != null
        ? (latestPayment.Method == "PROMPTPAY" ? "PromptPay QR / โอนเงินผ่านธนาคาร" : latestPayment.Method)
        : "รอข้อมูลการชำระเงิน";

    string paymentRef = latestPayment != null
        ? $"PAY-{latestPayment.PaymentId:D5} ({latestPayment.CreatedAt:dd/MM/yyyy HH:mm})"
        : "-";

    string adminNote = bookingStatus switch
    {
        "Approved" => "ตรวจสอบยอดโอนเงินและยืนยันห้องพักเรียบร้อยแล้ว ลูกค้าสามารถใช้ Digital QR Code เช็คอินที่โรงแรมได้ทันที",
        "Completed" => "ลูกค้าเข้าพักและเช็คเอาท์เสร็จสิ้นเรียบร้อยแล้ว ขอบคุณที่เลือกพักกับ StayMate Hotel",
        "Rejected" => !string.IsNullOrWhiteSpace(latestPayment?.RejectReason)
            ? $"ไม่อนุมัติการจอง เนื่องจาก: {latestPayment.RejectReason}"
            : "ไม่อนุมัติการจอง เนื่องจากหลักฐานการชำระเงินไม่ถูกต้อง กรุณาติดต่อฝ่ายบริการลูกค้า",
        "Cancelled" => "รายการจองนี้ถูกยกเลิกเรียบร้อยแล้ว",
        _ => "ได้รับข้อมูลการจองและหลักฐานการโอนเงินแล้ว ขณะนี้อยู่ระหว่างเจ้าหน้าที่ตรวจสอบและอนุมัติรายการ"
    };

    bool hasQr = bookingStatus == "Approved" || bookingStatus == "Completed" || !string.IsNullOrWhiteSpace(booking?.QrCode);
    string qrData = !string.IsNullOrWhiteSpace(booking?.QrCode)
        ? booking.QrCode
        : $"STAYMATE-{bookingCode}-{bookingStatus.ToUpperInvariant()}";
    string qrUrl = hasQr
        ? $"https://api.qrserver.com/v1/create-qr-code/?size=280x280&data={Uri.EscapeDataString(qrData)}"
        : "";

    string bBadgeClass = bookingStatus switch
    {
        "Approved" => "customer-mb-badge-approved",
        "Rejected" => "customer-mb-badge-rejected",
        "Completed" => "customer-mb-badge-completed",
        "Cancelled" => "customer-mb-badge-cancelled",
        _ => "customer-mb-badge-pending"
    };

    string pBadgeClass = paymentStatus switch
    {
        "Paid" => "customer-mb-pay-paid",
        "Pending Verification" => "customer-mb-pay-verifying",
        "Rejected" => "customer-mb-pay-rejected",
        _ => "customer-mb-pay-unpaid"
    };

    ViewData["Title"] = $"รายละเอียดการจอง #{bookingCode}";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />
    <link rel="stylesheet" href="~/css/Customer.css" asp-append-version="true" />
}

<div class="customer-mb-wrapper">

    <!-- =========================================================
         1. HEADER & BREADCRUMB
         ========================================================= -->
    <section class="customer-mb-header">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <nav aria-label="breadcrumb" class="customer-mb-breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a asp-controller="Customer" asp-action="Index"><i class="fa-solid fa-house me-1"></i> หน้าแรก</a>
                        </li>
                        <li class="breadcrumb-item">
                            <a asp-controller="Customer" asp-action="MyBookings">การจองของฉัน (My Bookings)</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">#@bookingCode</li>
                    </ol>
                </nav>
            </div>

            <div class="d-flex justify-content-between align-items-end flex-wrap gap-3">
                <div>
                    <span class="customer-mb-eyebrow">
                        <i class="fa-solid fa-file-invoice me-1"></i> BOOKING CONFIRMATION &amp; STATUS
                    </span>
                    <h1 class="customer-mb-title mb-1">Booking ID: #@bookingCode</h1>
                    <p class="customer-mb-subtitle mb-0">
                        ทำรายการเมื่อ @bookedDateText · ผู้ติดต่อ: <strong>@guestName</strong> (@contactPhone · @contactEmail)
                    </p>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="customer-mb-btn-outline" onclick="window.print()">
                        <i class="fa-solid fa-print"></i>
                        <span>พิมพ์ใบยืนยันการจอง</span>
                    </button>
                    <a asp-controller="Customer" asp-action="MyBookings" class="customer-mb-btn-primary">
                        <i class="fa-solid fa-arrow-left"></i>
                        <span>กลับไปหน้าการจองของฉัน</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- =========================================================
         2. APPROVAL TIMELINE & MAIN DETAILS
         ========================================================= -->
    <section class="container pb-5">
        <div class="row g-4">

            <!-- คอลัมน์ซ้าย (8 Cols): สถานะอนุมัติ, ข้อมูลห้องพัก, รายละเอียดราคา -->
            <div class="col-lg-8">

                <!-- การ์ดสถานะการอนุมัติ (Approval Status Banner) -->
                <div class="room-details-block p-4 mb-4" data-aos="fade-up">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 pb-3 mb-3 border-bottom">
                        <div>
                            <small class="text-muted d-block">สถานะใบจอง (Booking Status)</small>
                            <span class="customer-mb-status-badge @bBadgeClass fs-6 mt-1">
                                <i class="fa-solid fa-circle-info me-1"></i> @bookingStatus
                            </span>
                        </div>
                        <div class="text-md-end">
                            <small class="text-muted d-block">สถานะการชำระเงิน (Payment Status)</small>
                            <span class="customer-mb-pay-badge @pBadgeClass fs-6 mt-1">
                                @paymentStatus
                            </span>
                        </div>
                    </div>

                    <div class="p-3 rounded-4 bg-light border">
                        <strong class="d-block text-dark mb-1">
                            <i class="fa-solid fa-bullhorn text-primary me-2"></i>สถานะและการตรวจสอบ (Verification Note):
                        </strong>
                        <p class="text-secondary small mb-0">@adminNote</p>
                    </div>
                </div>

                <!-- การ์ดรายละเอียดห้องพักและกำหนดการเข้าพัก -->
                <div class="room-details-block p-4 mb-4" data-aos="fade-up" data-aos-delay="50">
                    <h4 class="fw-bold text-dark mb-3">
                        <i class="fa-solid fa-bed text-primary me-2"></i>รายละเอียดห้องพักและการเข้าพัก
                    </h4>

                    <div class="row g-3 align-items-center mb-4">
                        <div class="col-md-5">
                            <img src="@roomImage" alt="@roomName" class="img-fluid rounded-4 shadow-sm" style="height: 200px; width: 100%; object-fit: cover;" />
                        </div>
                        <div class="col-md-7">
                            <span class="room-details-series-badge mb-2 d-inline-block">@roomType</span>
                            <h3 class="fw-bold text-dark mb-1">@roomName</h3>
                            <p class="text-muted small mb-2"><i class="fa-solid fa-bed text-primary me-1"></i> รูปแบบเตียง: @bedType</p>
                            <p class="text-muted small mb-0"><i class="fa-solid fa-tags text-info me-1"></i> โปรโมชั่นที่ใช้: <strong>@promoName</strong></p>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="customer-mb-meta-item p-3">
                                <small><i class="fa-regular fa-calendar-plus text-primary me-1"></i> วันเช็คอิน (Check-in)</small>
                                <strong class="fs-6">@checkInText</strong>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="customer-mb-meta-item p-3">
                                <small><i class="fa-regular fa-calendar-minus text-primary me-1"></i> วันเช็คเอาท์ (Check-out)</small>
                                <strong class="fs-6">@checkOutText</strong>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="customer-mb-meta-item p-3">
                                <small><i class="fa-solid fa-moon text-primary me-1"></i> ระยะเวลาเข้าพัก</small>
                                <strong class="fs-6">@nights คืน (@roomsCount ห้อง)</strong>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="customer-mb-meta-item p-3">
                                <small><i class="fa-solid fa-user-group text-primary me-1"></i> จำนวนผู้เข้าพัก</small>
                                <strong class="fs-6">ผู้ใหญ่ @guests ท่าน</strong>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(booking?.SpecialRequest))
                    {
                        <div class="mt-3 p-3 rounded-4 bg-light border">
                            <small class="text-muted d-block"><i class="fa-regular fa-comment-dots text-primary me-1"></i> คำขอพิเศษเพิ่มเติม (Special Request)</small>
                            <strong class="text-dark small">@booking.SpecialRequest</strong>
                        </div>
                    }
                </div>

                <!-- การ์ดสรุปยอดชำระเงิน (Payment & Price Breakdown) -->
                <div class="room-details-block p-4 mb-4" data-aos="fade-up" data-aos-delay="100">
                    <h4 class="fw-bold text-dark mb-3">
                        <i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i>รายละเอียดการชำระเงิน (Payment Summary)
                    </h4>

                    <div class="customer-mb-price-box p-3 mb-3">
                        <div class="customer-mb-price-line mb-2">
                            <span>ค่าห้องพัก (@nights คืน × @roomsCount ห้อง)</span>
                            <strong>฿@roomPrice.ToString("N0")</strong>
                        </div>
                        @if (promoDiscount > 0)
                        {
                            <div class="customer-mb-price-line text-success mb-2">
                                <span>ส่วนลดโปรโมชั่น (@promoName)</span>
                                <strong>-฿@promoDiscount.ToString("N0")</strong>
                            </div>
                        }
                        @if (taxAmount > 0)
                        {
                            <div class="customer-mb-price-line text-muted mb-2">
                                <span>ภาษีมูลค่าเพิ่มและค่าบริการ (Tax &amp; Service)</span>
                                <span>฿@taxAmount.ToString("N0")</span>
                            </div>
                        }
                        else
                        {
                            <div class="customer-mb-price-line text-muted mb-2">
                                <span>ภาษีมูลค่าเพิ่มและค่าบริการ (VAT &amp; Service Charge)</span>
                                <span>รวมในราคาห้องพักแล้ว</span>
                            </div>
                        }
                        <div class="customer-mb-price-total pt-3 mt-2">
                            <span class="fs-6">ยอดชำระเงินสุทธิ (Total Amount)</span>
                            <strong class="fs-3 text-primary">฿@totalAmount.ToString("N0")</strong>
                        </div>
                    </div>

                    <div class="row g-3 small text-secondary align-items-center">
                        <div class="col-md-6">
                            <i class="fa-solid fa-credit-card text-primary me-1"></i> ช่องทางการชำระเงิน: <strong>@paymentMethod</strong>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <i class="fa-solid fa-receipt text-primary me-1"></i> เลขอ้างอิงการชำระเงิน: <strong>@paymentRef</strong>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(latestPayment?.SlipImagePath))
                    {
                        <div class="mt-3 pt-3 border-top">
                            <a href="@latestPayment.SlipImagePath" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                <i class="fa-regular fa-image me-1"></i> ดูหลักฐานสลิปการโอนเงินที่แนบไว้
                            </a>
                        </div>
                    }
                </div>

            </div>

            <!-- คอลัมน์ขวา (4 Cols): DIGITAL TRAVEL PASS (QR CODE) & QUICK ACTIONS -->
            <div class="col-lg-4">
                <div class="customer-mb-qr-modal-content bg-white shadow-sm border p-4 text-center mb-4" data-aos="fade-left">
                    <span class="badge bg-dark text-info border border-info px-3 py-2 rounded-pill mb-2">
                        <i class="fa-solid fa-qrcode me-1"></i> STAYMATE DIGITAL PASS
                    </span>
                    <h4 class="fw-bold text-dark mb-1">QR Code สำหรับเช็คอิน</h4>
                    <p class="text-muted small mb-3">Booking ID: <strong>#@bookingCode</strong></p>

                    @if (hasQr)
                    {
                        <div class="p-3 bg-light rounded-4 border d-inline-block mb-3">
                            <img src="@qrUrl" alt="QR Code #@bookingCode" class="img-fluid rounded-3" style="max-width: 220px;" />
                        </div>
                        <p class="text-success small fw-semibold mb-3">
                            <i class="fa-solid fa-circle-check me-1"></i> อนุมัติแล้ว พร้อมสแกนเข้าพักที่ Smart Kiosk
                        </p>
                        <a href="@qrUrl" target="_blank" rel="noopener" class="customer-mb-btn-primary w-100 justify-content-center">
                            <i class="fa-solid fa-download"></i>
                            <span>ดาวน์โหลด QR Code</span>
                        </a>
                    }
                    else
                    {
                        <div class="py-4 px-3 bg-light rounded-4 border mb-3">
                            <div class="customer-mb-qr-unavail-icon">
                                <i class="fa-solid fa-lock"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">QR Code is not available yet.</h6>
                            <p class="text-muted small mb-0">
                                ระบบจะแสดง QR Code ทันทีเมื่อสถานะใบจองของคุณเปลี่ยนเป็น <strong>Approved</strong>
                            </p>
                        </div>
                    }

                    <hr class="my-4" />

                    <div class="d-grid gap-2">
                        @if (bookingStatus == "Completed")
                        {
                            <a asp-controller="Customer" asp-action="Reviews" asp-route-bookingId="@booking?.BookingId" class="customer-mb-btn-primary justify-content-center">
                                <i class="fa-solid fa-star text-warning"></i>
                                <span>เขียนรีวิวการเข้าพักครั้งนี้</span>
                            </a>
                        }
                        <a asp-controller="Customer" asp-action="RoomDetails" asp-route-id="@roomTypeId" class="customer-mb-btn-outline justify-content-center">
                            <i class="fa-solid fa-bed"></i>
                            <span>ดูข้อมูลห้องพัก (@roomType)</span>
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </section>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof AOS !== "undefined") {
                AOS.init({ duration: 650, once: true });
            }
        });
    </script>
}
