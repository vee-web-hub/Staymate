@model List<StayMate_Kavinvee_0576.Models.Review>
@using System.Text.Json
@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "รีวิวจากผู้เข้าพัก";

    var qBookingId = Context.Request.Query["bookingId"].ToString();
    var userBookings = ViewBag.UserBookings as List<StayMate_Kavinvee_0576.Models.Booking>
                       ?? new List<StayMate_Kavinvee_0576.Models.Booking>();

    var reviewsList = Model ?? new List<StayMate_Kavinvee_0576.Models.Review>();
    int totalCount = reviewsList.Count;
    double avgRating = totalCount > 0 ? reviewsList.Average(r => (int)r.Rating) : 0.0;

    int CountStar(int star) => reviewsList.Count(r => r.Rating == star);
    int PctStar(int star) => totalCount > 0 ? (int)Math.Round(CountStar(star) * 100.0 / totalCount) : 0;

    string AvgStarClass(int i) =>
        avgRating >= i ? "fa-solid fa-star"
        : avgRating >= i - 0.5 ? "fa-solid fa-star-half-stroke"
        : "fa-regular fa-star";

    // สถานะภายใน (ใช้ตรวจสิทธิ์ในฝั่ง JS) และข้อความที่แสดงให้ผู้ใช้เห็น
    string MapBookingStatus(string? dbStatus)
    {
        return (dbStatus ?? "").ToLowerInvariant() switch
        {
            "checked_out" or "completed" => "Completed",
            "confirmed" or "approved" or "checked_in" => "Approved",
            "rejected" => "Rejected",
            "cancelled" or "canceled" => "Cancelled",
            _ => "Pending"
        };
    }

    string StatusText(string mapped) => mapped switch
    {
        "Completed" => "เข้าพักเสร็จสิ้น",
        "Approved" => "ยืนยันการจองแล้ว",
        "Rejected" => "ไม่อนุมัติ",
        "Cancelled" => "ยกเลิกแล้ว",
        _ => "รอดำเนินการ"
    };

    // แยกหัวข้อรีวิวออกจาก Comment กรณีบันทึกไว้ในรูปแบบ [หัวข้อ] รายละเอียด
    (string Title, string Body) ParseComment(string? rawComment, string roomType)
    {
        if (string.IsNullOrWhiteSpace(rawComment))
            return ($"ประสบการณ์การเข้าพักห้อง {roomType}", "");

        var text = rawComment.Trim();
        if (text.StartsWith("[") && text.Contains("]"))
        {
            var idx = text.IndexOf(']');
            var title = text.Substring(1, idx - 1).Trim();
            var body = text.Substring(idx + 1).Trim();
            return (string.IsNullOrWhiteSpace(title) ? $"รีวิวห้อง {roomType}" : title,
                    string.IsNullOrWhiteSpace(body) ? title : body);
        }

        return ($"ประสบการณ์การเข้าพักห้อง {roomType}", text);
    }

    var serializedReviews = JsonSerializer.Serialize(reviewsList.Select(r =>
    {
        var rtName = r.Booking?.BookingRooms?.Select(br => br.RoomType?.TypeName).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n))
                     ?? "ห้องพัก";
        var parsed = ParseComment(r.Comment, rtName);
        var reviewerName = !string.IsNullOrWhiteSpace(r.User?.FullName)
            ? r.User!.FullName
            : (!string.IsNullOrWhiteSpace(r.Booking?.ContactName) ? r.Booking!.ContactName : "ผู้เข้าพัก");

        return new
        {
            id = r.ReviewId,
            name = reviewerName,
            roomType = rtName,
            stayDate = r.Booking != null ? r.Booking.CheckInDate.ToString("dd MMM yyyy") : "-",
            reviewDate = r.CreatedAt.ToString("yyyy-MM-dd"),
            reviewDateText = r.CreatedAt.ToString("dd MMM yyyy"),
            rating = (int)r.Rating,
            title = parsed.Title,
            comment = parsed.Body
        };
    }));
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />
    <link rel="stylesheet" href="~/css/Customer.css" asp-append-version="true" />
}

<div class="customer-rv-wrapper">

    <!-- =========================================================
         1. HERO
         ========================================================= -->
    <section class="customer-rv-hero mb-4">
        <div class="customer-rv-hero-bg"
             style="background-image: url('https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=2000&q=85');">
        </div>
        <div class="customer-rv-hero-overlay"></div>

        <div class="container position-relative z-2 py-4">
            <nav aria-label="breadcrumb" class="customer-mb-breadcrumb mb-3">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a asp-controller="Customer" asp-action="Index" class="text-info text-decoration-none">
                            <i class="fa-solid fa-house me-1"></i> หน้าแรก
                        </a>
                    </li>
                    <li class="breadcrumb-item active text-light opacity-75" aria-current="page">รีวิวจากผู้เข้าพัก</li>
                </ol>
            </nav>

            <div class="row align-items-end g-4">
                <div class="col-lg-8">
                    <span class="customer-promo-badge-cyan mb-2 d-inline-block">
                        <i class="fa-solid fa-star text-warning me-1"></i> รีวิวจากผู้เข้าพัก
                    </span>
                    <h1 class="customer-rv-hero-title">ประสบการณ์จากผู้เข้าพัก StayMate</h1>
                    <p class="customer-rv-hero-desc mb-0">
                        อ่านความคิดเห็นจากผู้ที่เข้าพักกับเรา และแบ่งปันประสบการณ์ของคุณเพื่อช่วยให้เราพัฒนาบริการให้ดียิ่งขึ้น
                    </p>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a href="#writeReviewSection" class="customer-promo-btn-cyan">
                        <i class="fa-solid fa-pen-nib"></i>
                        <span>เขียนรีวิว</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <div class="container pb-5">

        <!-- =========================================================
             2. คะแนนเฉลี่ยและสัดส่วนคะแนน
             ========================================================= -->
        <section class="customer-rv-summary-card mb-4" data-aos="fade-up">
            <div class="row align-items-center g-4">
                <div class="col-12 col-md-4 text-center border-md-end">
                    <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-3 py-1 mb-2 fw-bold">
                        คะแนนเฉลี่ยรวม
                    </span>
                    <div class="customer-rv-big-score">
                        <span id="rvAvgScore">@avgRating.ToString("0.0")</span><small>/5.0</small>
                    </div>
                    <div class="customer-rv-stars-lg my-2" id="rvAvgStars" aria-hidden="true">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <i class="@AvgStarClass(i)"></i>
                        }
                    </div>
                    <p class="text-muted small mb-0">
                        จาก <strong id="rvTotalCount">@totalCount</strong> รีวิว
                    </p>
                </div>

                <div class="col-12 col-md-8">
                    <div class="customer-rv-breakdown-list px-md-3">
                        <div class="customer-rv-bar-row">
                            <span class="customer-rv-bar-label">5 ดาว <i class="fa-solid fa-star text-warning"></i></span>
                            <div class="progress customer-rv-progress">
                                <div class="progress-bar bg-warning" id="barPct5" style="width: @PctStar(5)%"></div>
                            </div>
                            <span class="customer-rv-bar-count" id="barCount5">@CountStar(5) รีวิว</span>
                        </div>
                        <div class="customer-rv-bar-row">
                            <span class="customer-rv-bar-label">4 ดาว <i class="fa-solid fa-star text-warning"></i></span>
                            <div class="progress customer-rv-progress">
                                <div class="progress-bar bg-info" id="barPct4" style="width: @PctStar(4)%"></div>
                            </div>
                            <span class="customer-rv-bar-count" id="barCount4">@CountStar(4) รีวิว</span>
                        </div>
                        <div class="customer-rv-bar-row">
                            <span class="customer-rv-bar-label">3 ดาว <i class="fa-solid fa-star text-warning"></i></span>
                            <div class="progress customer-rv-progress">
                                <div class="progress-bar bg-primary" id="barPct3" style="width: @PctStar(3)%"></div>
                            </div>
                            <span class="customer-rv-bar-count" id="barCount3">@CountStar(3) รีวิว</span>
                        </div>
                        <div class="customer-rv-bar-row">
                            <span class="customer-rv-bar-label">2 ดาว <i class="fa-solid fa-star text-warning"></i></span>
                            <div class="progress customer-rv-progress">
                                <div class="progress-bar bg-secondary" id="barPct2" style="width: @PctStar(2)%"></div>
                            </div>
                            <span class="customer-rv-bar-count" id="barCount2">@CountStar(2) รีวิว</span>
                        </div>
                        <div class="customer-rv-bar-row mb-0">
                            <span class="customer-rv-bar-label">1 ดาว <i class="fa-solid fa-star text-warning"></i></span>
                            <div class="progress customer-rv-progress">
                                <div class="progress-bar bg-danger" id="barPct1" style="width: @PctStar(1)%"></div>
                            </div>
                            <span class="customer-rv-bar-count" id="barCount1">@CountStar(1) รีวิว</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- =========================================================
             3. ตัวกรองและการเรียงลำดับ
             ========================================================= -->
        <section class="customer-rv-filter-bar mb-4" data-aos="fade-up">
            <div class="d-flex align-items-center flex-wrap gap-2">
                <span class="fw-bold text-dark small me-1"><i class="fa-solid fa-filter text-primary me-1"></i> กรองตามคะแนน:</span>
                <button type="button" class="customer-promo-filter-btn active js-rv-filter" data-star="ALL">ทั้งหมด</button>
                <button type="button" class="customer-promo-filter-btn js-rv-filter" data-star="5">5 ดาว ★</button>
                <button type="button" class="customer-promo-filter-btn js-rv-filter" data-star="4">4 ดาว ★</button>
                <button type="button" class="customer-promo-filter-btn js-rv-filter" data-star="3">3 ดาว ★</button>
                <button type="button" class="customer-promo-filter-btn js-rv-filter" data-star="2">2 ดาว ★</button>
                <button type="button" class="customer-promo-filter-btn js-rv-filter" data-star="1">1 ดาว ★</button>
            </div>

            <div class="d-flex align-items-center gap-2 ms-auto">
                <label for="rvSortSelect" class="small fw-bold text-secondary mb-0">เรียงตาม:</label>
                <select id="rvSortSelect" class="form-select form-select-sm customer-mb-input" style="width: auto; min-width: 185px; height: 38px;">
                    <option value="latest" selected>รีวิวล่าสุด</option>
                    <option value="highest">คะแนนสูงสุด</option>
                    <option value="lowest">คะแนนต่ำสุด</option>
                </select>
            </div>
        </section>

        <!-- =========================================================
             4. รายการรีวิว
             ========================================================= -->
        <section class="mb-5">
            <div class="row g-4" id="rvCardsGrid"></div>

            <div id="rvEmptyBox" class="customer-mb-empty-card d-none mt-3">
                <div class="customer-mb-empty-icon-wrap">
                    <i class="fa-regular fa-comment-dots"></i>
                </div>
                <h4 class="fw-bold text-dark" id="rvEmptyTitle">ยังไม่มีรีวิว</h4>
                <p class="text-muted small mb-0" id="rvEmptyText">เป็นคนแรกที่แบ่งปันประสบการณ์การเข้าพักของคุณ</p>
            </div>
        </section>

        <!-- =========================================================
             5. เขียนรีวิว + 6. เงื่อนไขการรีวิว
             ========================================================= -->
        <section id="writeReviewSection" class="pt-2" data-aos="fade-up">
            <div class="row g-4">

                <div class="col-lg-8">
                    <div class="customer-pf-card">
                        <div class="customer-pf-card-header">
                            <div>
                                <span class="customer-pf-eyebrow"><i class="fa-solid fa-pen-to-square me-1"></i> แบ่งปันประสบการณ์</span>
                                <h2 class="customer-pf-card-title mb-0">เขียนรีวิวการเข้าพัก</h2>
                            </div>
                            <span class="badge bg-info-subtle text-info-emphasis rounded-pill px-3 py-2">
                                เฉพาะการเข้าพักที่เสร็จสิ้นแล้ว
                            </span>
                        </div>

                        <div id="rvDuplicateWarning" class="alert alert-warning d-none align-items-center gap-2 rounded-4" role="alert">
                            <i class="fa-solid fa-triangle-exclamation fs-5"></i>
                            <div id="rvDuplicateWarningText"></div>
                        </div>

                        <div id="rvErrorBox" class="alert alert-danger d-none align-items-center gap-2 rounded-4" role="alert">
                            <i class="fa-solid fa-circle-exclamation fs-5"></i>
                            <div id="rvErrorText"></div>
                        </div>

                        @if (!userBookings.Any())
                        {
                            <div class="text-center py-4">
                                <p class="text-muted mb-3">คุณยังไม่มีรายการจอง จึงยังไม่สามารถเขียนรีวิวได้</p>
                                <a asp-controller="Customer" asp-action="Checkout" class="customer-pf-btn-primary d-inline-flex">
                                    <i class="fa-solid fa-calendar-check"></i>
                                    <span>จองห้องพัก</span>
                                </a>
                            </div>
                        }
                        else
                        {
                            <form id="rvWriteForm" onsubmit="handleReviewSubmit(event)">
                                @Html.AntiForgeryToken()
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label for="rvBookingSelect" class="customer-pf-label">
                                            รายการจองของคุณ <span class="text-danger">*</span>
                                        </label>
                                        <select id="rvBookingSelect" class="form-select customer-pf-input" required onchange="checkBookingReviewEligibility()">
                                            <option value="" disabled selected="@(string.IsNullOrEmpty(qBookingId))">เลือกรายการจองที่ต้องการรีวิว</option>
                                            @foreach (var b in userBookings)
                                            {
                                                var rType = b.BookingRooms?.Select(br => br.RoomType?.TypeName).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n)) ?? "ห้องพัก";
                                                var mappedStat = MapBookingStatus(b.Status);
                                                var isReviewed = b.Review != null;
                                                var statusTag = isReviewed
                                                    ? "รีวิวแล้ว"
                                                    : (mappedStat == "Completed" ? "พร้อมรีวิว" : StatusText(mappedStat));

                                                <option value="@b.BookingId"
                                                        data-code="@b.BookingCode"
                                                        data-room="@rType"
                                                        data-status="@mappedStat"
                                                        data-status-text="@StatusText(mappedStat)"
                                                        data-reviewed="@(isReviewed ? "true" : "false")"
                                                        selected="@(qBookingId == b.BookingId.ToString())">
                                                    #@b.BookingCode · @rType (@b.CheckInDate.ToString("dd MMM") – @b.CheckOutDate.ToString("dd MMM yyyy")) · @statusTag
                                                </option>
                                            }
                                        </select>
                                    </div>

                                    <div class="col-12">
                                        <label class="customer-pf-label">คะแนนความพึงพอใจ <span class="text-danger">*</span></label>
                                        <div class="customer-rv-star-picker-wrap">
                                            <div class="customer-rv-star-picker" id="rvInteractiveStars">
                                                <button type="button" class="rv-star-btn" data-val="1" aria-label="1 ดาว"><i class="fa-solid fa-star"></i></button>
                                                <button type="button" class="rv-star-btn" data-val="2" aria-label="2 ดาว"><i class="fa-solid fa-star"></i></button>
                                                <button type="button" class="rv-star-btn" data-val="3" aria-label="3 ดาว"><i class="fa-solid fa-star"></i></button>
                                                <button type="button" class="rv-star-btn" data-val="4" aria-label="4 ดาว"><i class="fa-solid fa-star"></i></button>
                                                <button type="button" class="rv-star-btn" data-val="5" aria-label="5 ดาว"><i class="fa-solid fa-star"></i></button>
                                            </div>
                                            <span class="customer-rv-star-text" id="rvStarLabel">กรุณาเลือกคะแนน</span>
                                            <input type="hidden" id="rvSelectedRating" value="0" />
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <label for="rvTitleInput" class="customer-pf-label">หัวข้อรีวิว</label>
                                        <input type="text" id="rvTitleInput" class="form-control customer-pf-input" maxlength="100" placeholder="สรุปประสบการณ์ของคุณสั้น ๆ" />
                                    </div>

                                    <div class="col-12">
                                        <label for="rvCommentInput" class="customer-pf-label">ความคิดเห็น <span class="text-danger">*</span></label>
                                        <textarea id="rvCommentInput" rows="4" maxlength="2000" class="form-control customer-pf-textarea" required placeholder="เล่าประสบการณ์การเข้าพัก เช่น ความสะอาด สิ่งอำนวยความสะดวก และการบริการ"></textarea>
                                    </div>

                                    <div class="col-12 pt-2">
                                        <button type="submit" id="btnSubmitReview" class="customer-pf-btn-primary px-4 py-2">
                                            <i class="fa-solid fa-paper-plane"></i>
                                            <span>ส่งรีวิว</span>
                                        </button>
                                    </div>
                                </div>
                            </form>
                        }
                    </div>
                </div>

                <div class="col-lg-4">
                    <aside class="customer-rv-guidelines-card h-100">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="customer-rv-guide-icon"><i class="fa-solid fa-shield-check"></i></span>
                            <div>
                                <span class="small text-info fw-bold">เงื่อนไข</span>
                                <h4 class="text-white fw-bold mb-0 fs-5">ข้อกำหนดการรีวิว</h4>
                            </div>
                        </div>

                        <p class="text-light opacity-75 small mb-3">
                            เพื่อให้รีวิวน่าเชื่อถือและเป็นประโยชน์ต่อผู้เข้าพักท่านอื่น
                        </p>

                        <ul class="customer-rv-guide-list">
                            <li>
                                <i class="fa-solid fa-circle-check text-info"></i>
                                <div>
                                    <strong>รีวิวได้หลังเข้าพักเสร็จสิ้น</strong>
                                    <span>เขียนรีวิวได้เมื่อเช็คเอาท์แล้วและสถานะการจองเป็น "เข้าพักเสร็จสิ้น"</span>
                                </div>
                            </li>
                            <li>
                                <i class="fa-solid fa-1 text-warning"></i>
                                <div>
                                    <strong>1 การจอง รีวิวได้ 1 ครั้ง</strong>
                                    <span>แต่ละรายการจองส่งรีวิวได้เพียงครั้งเดียว และไม่สามารถแก้ไขภายหลังได้</span>
                                </div>
                            </li>
                            <li>
                                <i class="fa-solid fa-ban text-danger"></i>
                                <div>
                                    <strong>ไม่สามารถส่งซ้ำ</strong>
                                    <span>รายการจองที่รีวิวแล้ว หรือยังไม่เข้าพัก จะไม่สามารถส่งรีวิวได้</span>
                                </div>
                            </li>
                        </ul>

                        <div class="mt-auto pt-3 border-top border-light border-opacity-25 small text-light opacity-75">
                            <i class="fa-solid fa-shield-halved text-info me-1"></i>
                            รีวิวทุกรายการมาจากผู้ที่เข้าพักกับ StayMate Hotel จริง
                        </div>
                    </aside>
                </div>

            </div>
        </section>

    </div>

    <!-- =========================================================
         MODAL ส่งรีวิวสำเร็จ
         ========================================================= -->
    <div class="modal fade" id="rvSuccessModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content text-center p-4 rounded-4 border-0 shadow-lg">
                <div class="customer-co-success-icon-wrap mx-auto mb-3" style="width:64px; height:64px; font-size:2.4rem;">
                    <i class="fa-solid fa-star text-warning"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">ขอบคุณสำหรับรีวิว</h5>
                <p class="text-secondary small mb-3">
                    เราได้รับรีวิวของคุณเรียบร้อยแล้ว
                </p>
                <button type="button" class="customer-pf-btn-primary w-100 justify-content-center" data-bs-dismiss="modal">
                    ปิด
                </button>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script>
        const dbReviewsList = @Html.Raw(serializedReviews);

        let currentStarFilter = "ALL";
        let currentSortMode = "latest";

        const starDescriptions = {
            0: "กรุณาเลือกคะแนน",
            1: "1 ดาว (ควรปรับปรุง)",
            2: "2 ดาว (พอใช้)",
            3: "3 ดาว (ปานกลาง)",
            4: "4 ดาว (ดีมาก)",
            5: "5 ดาว (ยอดเยี่ยม)"
        };

        function escapeHtml(value) {
            return String(value ?? "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }

        function showBox(boxId, textId, message) {
            const box = document.getElementById(boxId);
            if (!box) return;
            document.getElementById(textId).textContent = message;
            box.classList.remove("d-none");
            box.classList.add("d-flex");
        }

        function hideBox(boxId) {
            const box = document.getElementById(boxId);
            if (!box) return;
            box.classList.add("d-none");
            box.classList.remove("d-flex");
        }

        document.addEventListener("DOMContentLoaded", function () {
            if (typeof AOS !== "undefined") {
                AOS.init({ duration: 650, once: true });
            }

            renderReviewCards();
            checkBookingReviewEligibility();

            document.querySelectorAll(".js-rv-filter").forEach(btn => {
                btn.addEventListener("click", function () {
                    document.querySelectorAll(".js-rv-filter").forEach(b => b.classList.remove("active"));
                    this.classList.add("active");
                    currentStarFilter = this.dataset.star;
                    renderReviewCards();
                });
            });

            document.getElementById("rvSortSelect").addEventListener("change", function () {
                currentSortMode = this.value;
                renderReviewCards();
            });

            // ตัวเลือกดาว
            const starBtns = document.querySelectorAll(".rv-star-btn");
            const ratingInput = document.getElementById("rvSelectedRating");
            const starLabel = document.getElementById("rvStarLabel");
            const starPicker = document.getElementById("rvInteractiveStars");
            if (!starPicker) return;

            function paintStars(count) {
                starBtns.forEach(btn => {
                    const val = parseInt(btn.dataset.val, 10);
                    btn.classList.toggle("active", val <= count);
                });
                starLabel.textContent = starDescriptions[count] || "";
            }

            paintStars(0);

            starBtns.forEach(btn => {
                btn.addEventListener("mouseenter", function () {
                    paintStars(parseInt(this.dataset.val, 10));
                });
                btn.addEventListener("click", function () {
                    const chosen = parseInt(this.dataset.val, 10);
                    ratingInput.value = chosen;
                    paintStars(chosen);
                });
            });

            starPicker.addEventListener("mouseleave", function () {
                paintStars(parseInt(ratingInput.value, 10) || 0);
            });
        });

        function updateSummaryStats() {
            const total = dbReviewsList.length;
            document.getElementById("rvTotalCount").textContent = total;
            const avg = total > 0 ? (dbReviewsList.reduce((sum, x) => sum + x.rating, 0) / total) : 0;
            document.getElementById("rvAvgScore").textContent = avg.toFixed(1);

            const starsEl = document.getElementById("rvAvgStars");
            if (starsEl) {
                let html = "";
                for (let i = 1; i <= 5; i++) {
                    const cls = avg >= i ? "fa-solid fa-star"
                        : avg >= i - 0.5 ? "fa-solid fa-star-half-stroke"
                        : "fa-regular fa-star";
                    html += `<i class="${cls}"></i>`;
                }
                starsEl.innerHTML = html;
            }

            for (let star = 1; star <= 5; star++) {
                const c = dbReviewsList.filter(x => x.rating === star).length;
                const pct = total > 0 ? Math.round((c * 100) / total) : 0;
                const barEl = document.getElementById(`barPct${star}`);
                const cntEl = document.getElementById(`barCount${star}`);
                if (barEl) barEl.style.width = `${pct}%`;
                if (cntEl) cntEl.textContent = `${c} รีวิว`;
            }
        }

        function renderReviewCards() {
            const grid = document.getElementById("rvCardsGrid");
            const emptyBox = document.getElementById("rvEmptyBox");

            const filtered = dbReviewsList.filter(item =>
                currentStarFilter === "ALL" || item.rating === parseInt(currentStarFilter, 10));

            filtered.sort((a, b) => {
                if (currentSortMode === "highest") return b.rating - a.rating;
                if (currentSortMode === "lowest") return a.rating - b.rating;
                return new Date(b.reviewDate) - new Date(a.reviewDate);
            });

            updateSummaryStats();

            if (filtered.length === 0) {
                grid.innerHTML = "";
                if (dbReviewsList.length === 0) {
                    document.getElementById("rvEmptyTitle").textContent = "ยังไม่มีรีวิว";
                    document.getElementById("rvEmptyText").textContent = "เป็นคนแรกที่แบ่งปันประสบการณ์การเข้าพักของคุณ";
                } else {
                    document.getElementById("rvEmptyTitle").textContent = "ไม่มีรีวิวในระดับคะแนนที่เลือก";
                    document.getElementById("rvEmptyText").textContent = "ลองเลือก \"ทั้งหมด\" หรือระดับคะแนนอื่น";
                }
                emptyBox.classList.remove("d-none");
                return;
            }

            emptyBox.classList.add("d-none");

            grid.innerHTML = filtered.map(r => {
                let starsHtml = "";
                for (let s = 1; s <= 5; s++) {
                    starsHtml += `<i class="${s <= r.rating ? "fa-solid text-warning" : "fa-regular text-muted"} fa-star"></i>`;
                }

                const initialChar = escapeHtml((r.name || "U").trim().charAt(0));
                const bodyHtml = r.comment
                    ? `<p class="text-secondary small lh-lg mb-0">${escapeHtml(r.comment)}</p>`
                    : "";

                return `
                    <div class="col-12 col-md-6">
                        <article class="customer-rv-card h-100">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="customer-home-avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 46px; height: 46px; flex-shrink: 0;">
                                        ${initialChar}
                                    </div>
                                    <div>
                                        <h5 class="customer-rv-user-name mb-0">${escapeHtml(r.name)}</h5>
                                        <div class="small text-muted">
                                            <span class="text-primary fw-semibold"><i class="fa-solid fa-bed me-1"></i>${escapeHtml(r.roomType)}</span>
                                            · เข้าพัก ${escapeHtml(r.stayDate)}
                                        </div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="customer-rv-stars-sm">${starsHtml}</div>
                                    <small class="text-muted" style="font-size:0.72rem;">${escapeHtml(r.reviewDateText)}</small>
                                </div>
                            </div>

                            <h6 class="fw-bold text-dark mb-2">${escapeHtml(r.title)}</h6>
                            ${bodyHtml}
                        </article>
                    </div>
                `;
            }).join("");
        }

        function checkBookingReviewEligibility() {
            const sel = document.getElementById("rvBookingSelect");
            const submitBtn = document.getElementById("btnSubmitReview");
            if (!sel || !submitBtn || sel.selectedIndex < 0) return false;

            const opt = sel.options[sel.selectedIndex];
            if (!opt || !opt.value) {
                hideBox("rvDuplicateWarning");
                return false;
            }

            const code = opt.getAttribute("data-code") || opt.value;
            const status = opt.getAttribute("data-status");
            const statusText = opt.getAttribute("data-status-text") || "";
            const reviewed = opt.getAttribute("data-reviewed") === "true";

            if (status !== "Completed") {
                showBox("rvDuplicateWarning", "rvDuplicateWarningText",
                    `ยังไม่สามารถรีวิวรายการ #${code} ได้ เนื่องจากสถานะปัจจุบันคือ "${statusText}" (รีวิวได้เมื่อเข้าพักเสร็จสิ้นแล้วเท่านั้น)`);
                submitBtn.disabled = true;
                return false;
            }

            if (reviewed) {
                showBox("rvDuplicateWarning", "rvDuplicateWarningText",
                    `รายการจอง #${code} ได้ส่งรีวิวไปแล้ว (1 รายการจองรีวิวได้ 1 ครั้ง)`);
                submitBtn.disabled = true;
                return false;
            }

            hideBox("rvDuplicateWarning");
            submitBtn.disabled = false;
            return true;
        }

        function resetWriteForm() {
            document.getElementById("rvWriteForm").reset();
            document.getElementById("rvSelectedRating").value = "0";
            document.querySelectorAll(".rv-star-btn").forEach(b => b.classList.remove("active"));
            document.getElementById("rvStarLabel").textContent = starDescriptions[0];
        }

        function handleReviewSubmit(e) {
            e.preventDefault();
            hideBox("rvErrorBox");

            if (!checkBookingReviewEligibility()) return;

            const sel = document.getElementById("rvBookingSelect");
            const opt = sel.options[sel.selectedIndex];
            const bookingId = opt.value;
            const code = opt.getAttribute("data-code") || bookingId;
            const roomType = opt.getAttribute("data-room") || "ห้องพัก";
            const rating = parseInt(document.getElementById("rvSelectedRating").value, 10) || 0;
            const title = document.getElementById("rvTitleInput").value.trim();
            const comment = document.getElementById("rvCommentInput").value.trim();
            const token = document.querySelector('#rvWriteForm input[name="__RequestVerificationToken"]').value;
            const submitBtn = document.getElementById("btnSubmitReview");

            if (rating < 1) {
                showBox("rvErrorBox", "rvErrorText", "กรุณาเลือกคะแนนความพึงพอใจ");
                return;
            }

            const formData = new FormData();
            formData.append("__RequestVerificationToken", token);
            formData.append("bookingId", bookingId);
            formData.append("rating", rating);
            formData.append("title", title);
            formData.append("comment", comment);

            submitBtn.disabled = true;

            fetch("/Customer/SubmitReview", {
                method: "POST",
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success && data.review) {
                    dbReviewsList.unshift(data.review);

                    opt.setAttribute("data-reviewed", "true");
                    opt.textContent = `#${code} · ${roomType} · รีวิวแล้ว`;

                    resetWriteForm();
                    currentStarFilter = "ALL";
                    document.querySelectorAll(".js-rv-filter").forEach((b, i) => b.classList.toggle("active", i === 0));
                    renderReviewCards();

                    bootstrap.Modal.getOrCreateInstance(document.getElementById("rvSuccessModal")).show();
                } else {
                    showBox("rvErrorBox", "rvErrorText", data.message || "ไม่สามารถส่งรีวิวได้ กรุณาลองใหม่อีกครั้ง");
                    submitBtn.disabled = false;
                }
            })
            .catch(() => {
                showBox("rvErrorBox", "rvErrorText", "เชื่อมต่อไม่สำเร็จ กรุณาลองใหม่อีกครั้ง");
                submitBtn.disabled = false;
            });
        }
    </script>
}
