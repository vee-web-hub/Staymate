                name: "คุณธนภัทร วงศ์สวัสดิ์",
                avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=200&q=80",
                roomType: "Deluxe Room",
                stayDate: "18 ต.ค. 2026",
                reviewDate: "2026-10-20",
                reviewDateText: "20 ต.ค. 2026",
                rating: 5,
                title: "โปรมา 3 จ่าย 2 คุ้มสุด ๆ ฟรีเตียงเสริมและวิวเมืองสวยมาก",
                comment: "มากับเพื่อน 3 คน จองห้อง Deluxe ได้เตียงเสริมฟรีตามโปรโมชั่น ห้องน้ำแยกโซนเปียกแห้งและมีอ่างอาบน้ำ Wi-Fi เร็วแรงทำงานไม่มีสะดุดเลยครับ",
                photo: ""
            },
            {
                id: 104,
                name: "คุณณัฐณิชา เกียรติขจร",
                avatar: "https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=200&q=80",
                roomType: "Standard Room",
                stayDate: "10 ต.ค. 2026",
                reviewDate: "2026-10-12",
                reviewDateText: "12 ต.ค. 2026",
                rating: 4,
                title: "ห้องพักกะทัดรัด ทันสมัย เหมาะกับสาย Workation",
                comment: "โต๊ะทำงานนั่งสบาย มีปลั๊ก USB-C ข้างเตียงสะดวกมาก ห้องเก็บเสียงได้ดีเยี่ยม หักนิดเดียวตรงช่วงเช้าคนใช้ลิฟต์ค่อนข้างเยอะ แต่โดยรวมประทับใจมากค่ะ",
                photo: "https://images.unsplash.com/photo-1631049307264-da0ec9d70304?auto=format&fit=crop&w=700&q=80"
            },
            {
                id: 105,
                name: "คุณศุภกร เจริญกิจ",
                avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=200&q=80",
                roomType: "Deluxe Room",
                stayDate: "01 ต.ค. 2026",
                reviewDate: "2026-10-04",
                reviewDateText: "04 ต.ค. 2026",
                rating: 5,
                title: "ระบบเช็คอินด้วย QR Code สะดวกและปลอดภัยมาก",
                comment: "ชอบดีไซน์ Future Urban Hotel ของที่นี่มากครับ ทุกอย่างดูไฮเทคแต่ใช้งานง่าย อาหารเช้าที่ห้องอาหารอร่อยและวัตถุดิบพรีเมียมจริง ๆ ครับ",
                photo: ""
            },
            {
                id: 106,
                name: "คุณอารยา พงศ์พิพัฒน์",
                avatar: "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=200&q=80",
                roomType: "Standard Room",
                stayDate: "20 ก.ย. 2026",
                reviewDate: "2026-09-22",
                reviewDateText: "22 ก.ย. 2026",
                rating: 3,
                title: "ห้องสะอาดและทำเลดีมาก แต่อยากให้เพิ่มหมอนเสริมในห้อง",
                comment: "ทำเลใกล้รถไฟฟ้าเดินทางสะดวกมาก ห้องสะอาดและไฟปรับโหมดได้สวยค่ะ แต่หมอนในห้องนิ่มไปนิด พอแจ้งขอหมอนเพิ่มพนักงานก็นำมาให้รวดเร็วดีค่ะ",
                photo: ""
            }
        ];

        let currentStarFilter = "ALL";
        let currentSortMode = "latest";
        let uploadedPhotoDataUrl = "";

        const starDescriptions = {
            1: "1 ดาว (ต้องปรับปรุง)",
            2: "2 ดาว (พอใช้)",
            3: "3 ดาว (ปานกลาง)",
            4: "4 ดาว (ดีมาก)",
            5: "5 ดาว (ประทับใจดีเยี่ยม)"
        };

        document.addEventListener("DOMContentLoaded", function () {
            if (typeof AOS !== "undefined") {
                AOS.init({ duration: 650, once: true });
            }

            renderReviewCards();

            // Filter Buttons
            document.querySelectorAll(".js-rv-filter").forEach(btn => {
                btn.addEventListener("click", function () {
                    document.querySelectorAll(".js-rv-filter").forEach(b => b.classList.remove("active"));
                    this.classList.add("active");
                    currentStarFilter = this.dataset.star;
                    renderReviewCards();
                });
            });

            // Sort Select
            document.getElementById("rvSortSelect").addEventListener("change", function () {
                currentSortMode = this.value;
                renderReviewCards();
            });

            // Interactive Star Picker (Hover & Click)
            const starBtns = document.querySelectorAll(".rv-star-btn");
            const ratingInput = document.getElementById("rvSelectedRating");
            const starLabel = document.getElementById("rvStarLabel");

            function paintStars(count) {
                starBtns.forEach(btn => {
                    const val = parseInt(btn.dataset.val, 10);
                    btn.classList.toggle("active", val <= count);
                });
                starLabel.textContent = starDescriptions[count] || "";
            }

            starBtns.forEach(btn => {
                btn.addEventListener("mouseenter", function () {
                    paintStars(parseInt(this.dataset.val, 10));
                });
                btn.addEventListener("click", function () {
                    const chosen = parseInt(this.dataset.val, 10);
                    ratingInput.value = chosen;
                    paintStars(chosen);
                });
            });

            document.getElementById("rvInteractiveStars").addEventListener("mouseleave", function () {
                paintStars(parseInt(ratingInput.value, 10));
            });
        });

        function renderReviewCards() {
            const grid = document.getElementById("rvCardsGrid");
            const emptyBox = document.getElementById("rvEmptyFilterBox");

            let filtered = mockReviewsList.filter(item => {
                if (currentStarFilter === "ALL") return true;
                return item.rating === parseInt(currentStarFilter, 10);
            });

            filtered.sort((a, b) => {
                if (currentSortMode === "highest") return b.rating - a.rating;
                if (currentSortMode === "lowest") return a.rating - b.rating;
                return new Date(b.reviewDate) - new Date(a.reviewDate);
            });

            if (filtered.length === 0) {
                grid.innerHTML = "";
                emptyBox.classList.remove("d-none");
                return;
            }

            emptyBox.classList.add("d-none");

            grid.innerHTML = filtered.map(r => {
                let starsHtml = "";
                for (let s = 1; s <= 5; s++) {
                    starsHtml += `<i class="${s <= r.rating ? "fa-solid text-warning" : "fa-regular text-muted"} fa-star"></i>`;
                }

                const photoHtml = r.photo
                    ? `<div class="customer-rv-card-photo mt-3">
                           <img src="${r.photo}" alt="Review attachment" loading="lazy" />
                       </div>`
                    : "";

                return `
                    <div class="col-12 col-md-6">
                        <article class="customer-rv-card h-100">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="${r.avatar}" alt="${r.name}" class="customer-rv-user-avatar" />
                                    <div>
                                        <h5 class="customer-rv-user-name mb-0">${r.name}</h5>
                                        <div class="small text-muted">
                                            <span class="text-primary fw-semibold"><i class="fa-solid fa-bed me-1"></i>${r.roomType}</span>
                                            · เข้าพัก: ${r.stayDate}
                                        </div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="customer-rv-stars-sm">${starsHtml}</div>
                                    <small class="text-muted" style="font-size:0.72rem;">รีวิวเมื่อ ${r.reviewDateText}</small>
                                </div>
                            </div>

                            <h6 class="fw-bold text-dark mb-2">“${r.title}”</h6>
                            <p class="text-secondary small lh-lg mb-0">${r.comment}</p>
                            ${photoHtml}
                        </article>
                    </div>
                `;
            }).join("");

            // อัปเดตตัวเลขรวมด้านบน
            document.getElementById("rvTotalCount").textContent = mockReviewsList.length;
            const avg = mockReviewsList.reduce((sum, x) => sum + x.rating, 0) / mockReviewsList.length;
            document.getElementById("rvAvgScore").textContent = avg.toFixed(1);
        }

        // ตรวจสอบสิทธิ์ของ Booking ที่เลือก (ต้อง Completed และยังไม่เคยรีวิว)
        function checkBookingReviewEligibility() {
            const sel = document.getElementById("rvBookingSelect");
            const opt = sel.options[sel.selectedIndex];
            const warningBox = document.getElementById("rvDuplicateWarning");
            const warningText = document.getElementById("rvDuplicateWarningText");
            const submitBtn = document.getElementById("btnSubmitReview");

            if (!opt || !opt.value) return false;

            const status = opt.getAttribute("data-status");
            const reviewed = opt.getAttribute("data-reviewed") === "true";

            if (status !== "Completed") {
                warningText.textContent = `ไม่สามารถรีวิวรายการ #${opt.value} ได้ เนื่องจากสถานะการจองยังเป็น ${status} (ต้องเป็น Completed เท่านั้น)`;
                warningBox.classList.remove("d-none");
                submitBtn.disabled = true;
                return false;
            }

            if (reviewed) {
                warningText.textContent = `รายการจอง #${opt.value} ได้ส่งรีวิวไปแล้ว (1 รายการจองสามารถรีวิวได้เพียงครั้งเดียว)`;
                warningBox.classList.remove("d-none");
                submitBtn.disabled = true;
                return false;
            }

            warningBox.classList.add("d-none");
            submitBtn.disabled = false;
            return true;
        }

        function previewReviewPhoto(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    uploadedPhotoDataUrl = e.target.result;
                    document.getElementById("rvPhotoPreviewImg").src = uploadedPhotoDataUrl;
                    document.getElementById("rvPhotoPreviewWrap").classList.remove("d-none");
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function clearReviewPhoto() {
            uploadedPhotoDataUrl = "";
            document.getElementById("rvPhotoInput").value = "";
            document.getElementById("rvPhotoPreviewWrap").classList.add("d-none");
        }

        function handleReviewSubmit(e) {
            e.preventDefault();
            if (!checkBookingReviewEligibility()) return;

            const sel = document.getElementById("rvBookingSelect");
            const opt = sel.options[sel.selectedIndex];
            const roomType = opt.getAttribute("data-room") || "Deluxe Room";
            const stayDate = opt.getAttribute("data-stay") || "ต.ค. 2026";
            const rating = parseInt(document.getElementById("rvSelectedRating").value, 10) || 5;
            const title = document.getElementById("rvTitleInput").value.trim();
            const comment = document.getElementById("rvCommentInput").value.trim();

            // สร้างรีวิวใหม่เพิ่มเข้าด้านบนสุดของรายการ
            mockReviewsList.unshift({
                id: Date.now(),
                name: "คุณสมาชิก StayMate (รีวิวของคุณ)",
                avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=200&q=80",
                roomType: roomType,
                stayDate: stayDate,
                reviewDate: "2026-11-17",
                reviewDateText: "วันนี้ (Just now)",
                rating: rating,
                title: title,
                comment: comment,
                photo: uploadedPhotoDataUrl
            });

            // ล็อกไม่ให้ Booking นี้รีวิวซ้ำได้อีก
            opt.setAttribute("data-reviewed", "true");
            opt.textContent = `#${opt.value} · ${roomType} — [ส่งรีวิวเรียบร้อยแล้ว]`;

            // รีเซ็ตฟอร์มและแสดงการ์ดใหม่
            document.getElementById("rvWriteForm").reset();
            clearReviewPhoto();
            currentStarFilter = "ALL";
            document.querySelectorAll(".js-rv-filter").forEach((b, i) => b.classList.toggle("active", i === 0));
            renderReviewCards();

            const modalEl = document.getElementById("rvSuccessModal");
            bootstrap.Modal.getOrCreateInstance(modalEl).show();
        }
    </script>
}
