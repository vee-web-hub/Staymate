@using System.Text.Json
@using StayMate_Kavinvee_0576.Models.ViewModels

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "จองห้องพักและชำระเงิน";

    // พารามิเตอร์ที่ส่งต่อมาจากหน้าก่อนหน้า
    var qRoomTypeId = Context.Request.Query["roomTypeId"].ToString();
    var qCheckIn = Context.Request.Query["checkIn"].ToString();
    var qCheckOut = Context.Request.Query["checkOut"].ToString();
    var qGuests = Context.Request.Query["guests"].ToString();
    var qPromoCode = Context.Request.Query["promoCode"].ToString();

    var roomTypes = ViewBag.RoomTypes as List<StayMate_Kavinvee_0576.Models.RoomType>
                    ?? new List<StayMate_Kavinvee_0576.Models.RoomType>();
    var userProfile = ViewBag.CurrentUser as StayMate_Kavinvee_0576.Models.User;

    var parsedInitId = byte.TryParse(qRoomTypeId, out var tempId) ? tempId : (byte)0;
    var currentRoomType = roomTypes.FirstOrDefault(rt => rt.RoomTypeId == parsedInitId)
                          ?? roomTypes.FirstOrDefault();

    // ดึงรูปภาพห้องพักให้สอดคล้องกันตรงตามหน้าแรกผ่านการอ้างอิงแค็ตตาล็อกมาตรฐาน
    string GetRoomImage(string? code, string? name) =>
        RoomExtrasCatalog.Find(code, name)?.Gallery.FirstOrDefault()
        ?? RoomExtrasCatalog.Fallback(name ?? "");

    var roomTypesJson = JsonSerializer.Serialize(roomTypes.Select(rt => new
    {
        id = rt.RoomTypeId,
        name = rt.TypeName,
        code = rt.TypeCode,
        price = rt.BasePrice,
        minGuests = (int)rt.MinGuests,
        maxGuests = (int)rt.MaxGuests,
        img = GetRoomImage(rt.TypeCode, rt.TypeName)
    }));
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />
    <link rel="stylesheet" href="~/css/Customer.css" asp-append-version="true" />
}

@if (currentRoomType == null)
{
    <div class="container py-5 text-center">
        <h3 class="fw-bold text-dark mb-2">ยังไม่มีห้องพักที่เปิดให้จอง</h3>
        <p class="text-muted mb-3">กรุณาลองใหม่อีกครั้งภายหลัง</p>
        <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">กลับสู่หน้าแรก</a>
    </div>
    return;
}

<div class="customer-co-wrapper" id="checkoutPageRoot"
     data-init-room-type-id="@currentRoomType.RoomTypeId"
     data-init-check-in="@qCheckIn"
     data-init-check-out="@qCheckOut"
     data-init-guests="@(string.IsNullOrEmpty(qGuests) ? "2" : qGuests)"
     data-init-promo-code="@qPromoCode">

    <!-- =========================================================
         1. ขั้นตอนการจอง
         ========================================================= -->
    <div class="container py-4">
        <div class="customer-co-progress-card" data-aos="fade-down">
            <div class="customer-co-progress-steps">
                <div class="customer-co-step active" id="stepIndicator1">
                    <div class="customer-co-step-icon"><i class="fa-solid fa-user-pen"></i></div>
                    <div class="customer-co-step-label">
                        <strong>ขั้นตอนที่ 1</strong>
                        <span>ข้อมูลผู้เข้าพัก</span>
                    </div>
                </div>
                <div class="customer-co-progress-line" id="progressLine1"></div>
                <div class="customer-co-step" id="stepIndicator2">
                    <div class="customer-co-step-icon"><i class="fa-solid fa-credit-card"></i></div>
                    <div class="customer-co-step-label">
                        <strong>ขั้นตอนที่ 2</strong>
                        <span>ชำระเงิน</span>
                    </div>
                </div>
                <div class="customer-co-progress-line" id="progressLine2"></div>
                <div class="customer-co-step" id="stepIndicator3">
                    <div class="customer-co-step-icon"><i class="fa-solid fa-circle-check"></i></div>
                    <div class="customer-co-step-label">
                        <strong>ขั้นตอนที่ 3</strong>
                        <span>ยืนยันการจอง</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container pb-5">
        <form id="checkoutForm" onsubmit="return false;" class="row g-4 position-relative">
            @Html.AntiForgeryToken()

            <!-- ฝั่งซ้าย: ข้อมูลผู้เข้าพัก / ชำระเงิน -->
            <div class="col-lg-8" id="checkoutLeftColumn">

                <div id="coErrorBox" class="alert alert-danger d-none align-items-center gap-2 rounded-4" role="alert">
                    <i class="fa-solid fa-circle-exclamation fs-5"></i>
                    <div id="coErrorText"></div>
                </div>

                <!-- STEP 1 -->
                <div class="room-details-block p-4 mb-4" id="panelGuestInfo" data-aos="fade-up">
                    <div class="customer-co-panel-header">
                        <span class="customer-co-panel-eyebrow"><i class="fa-solid fa-user-check me-1"></i> ขั้นตอนที่ 1 จาก 2</span>
                        <h2 class="customer-co-panel-title">ข้อมูลผู้เข้าพัก</h2>
                        <p class="text-secondary small mb-0">ข้อมูลนี้ใช้สำหรับยืนยันการจองและติดต่อคุณก่อนวันเข้าพัก</p>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="guestFullName" class="customer-co-label">ชื่อ - นามสกุล <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-regular fa-user"></i></span>
                                <input type="text" id="guestFullName" class="form-control customer-co-input" required maxlength="150" value="@(userProfile?.FullName ?? User.Identity?.Name)" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="guestPhone" class="customer-co-label">เบอร์โทรศัพท์ <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-phone"></i></span>
                                <input type="tel" id="guestPhone" class="form-control customer-co-input" required maxlength="20" value="@userProfile?.Phone" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="guestEmail" class="customer-co-label">อีเมล <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-regular fa-envelope"></i></span>
                                <input type="email" id="guestEmail" class="form-control customer-co-input" required maxlength="120" value="@userProfile?.Email" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="guestCapacity" class="customer-co-label">จำนวนผู้เข้าพัก <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-user-group"></i></span>
                                <select id="guestCapacity" class="form-select customer-co-input"></select>
                            </div>
                        </div>

                        <div class="col-12">
                            <label for="specialRequest" class="customer-co-label">คำขอเพิ่มเติม</label>
                            <textarea id="specialRequest" rows="3" maxlength="500" class="form-control customer-co-textarea" placeholder="เช่น ต้องการห้องชั้นสูง หรือหมอนเสริม (ขึ้นอยู่กับความพร้อมของโรงแรม)"></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                        <button type="button" class="customer-co-btn-next" onclick="navigateToStep(2)">
                            <span>ไปขั้นตอนชำระเงิน</span>
                            <i class="fa-solid fa-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>

                <!-- STEP 2 -->
                <div class="room-details-block p-4 mb-4 d-none" id="panelPayment" data-aos="fade-up">
                    <div class="customer-co-panel-header">
                        <span class="customer-co-panel-eyebrow"><i class="fa-solid fa-credit-card me-1"></i> ขั้นตอนที่ 2 จาก 2</span>
                        <h2 class="customer-co-panel-title">ชำระเงินด้วยการโอน</h2>
                        <p class="text-secondary small mb-0">โอนเงินตามยอดที่แสดง แล้วแนบสลิปเพื่อให้เจ้าหน้าที่ตรวจสอบและยืนยันการจอง</p>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-7">
                            <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-university text-primary me-2"></i>บัญชีสำหรับโอนเงิน</h5>

                            <div class="customer-co-bank-card">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong class="text-dark"><i class="fa-solid fa-building-columns text-primary me-1"></i> ธนาคารไทยพาณิชย์ (SCB)</strong>
                                </div>
                                <div class="customer-co-bank-detail mb-1">
                                    <span>เลขที่บัญชี:</span>
                                    <strong class="customer-co-mono-font fs-6">123-456-789-0</strong>
                                </div>
                                <div class="customer-co-bank-detail">
                                    <span>ชื่อบัญชี:</span>
                                    <strong>บริษัท สเตย์เมท โฮเทล จำกัด (สำนักงานใหญ่)</strong>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-5">
                            <div class="p-3 rounded-4 border bg-light h-100 d-flex flex-column justify-content-center text-center">
                                <span class="small text-secondary">ยอดที่ต้องโอน</span>
                                <span class="room-details-net-total fs-3" id="lblPayAmount">฿0</span>
                                <small class="text-muted mt-1">กรุณาโอนตามยอดนี้ให้ตรงกับสลิป</small>
                            </div>
                        </div>
                    </div>

                    <!-- อัปโหลดสลิป -->
                    <div class="p-4 rounded-4 border bg-light mb-4">
                        <h5 class="fw-bold text-dark mb-2"><i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i>แนบสลิปการโอนเงิน <span class="text-danger">*</span></h5>
                        <p class="text-muted small">อัปโหลดรูปสลิปที่เห็นยอดเงิน วันที่ และเวลาโอนอย่างชัดเจน</p>

                        <div class="row g-3 align-items-center">
                            <div class="col-md-6">
                                <div class="customer-co-upload-zone" onclick="document.getElementById('slipUploadInput').click()">
                                    <i class="fa-solid fa-cloud-arrow-up fs-2 text-primary mb-2"></i>
                                    <strong>เลือกรูปสลิป</strong>
                                    <small class="text-muted">JPEG, PNG (ไม่เกิน 5MB)</small>
                                    <input type="file" id="slipUploadInput" name="slipFile" accept="image/jpeg, image/png" class="d-none" onchange="previewPaymentSlip(this)" />
                                </div>
                            </div>

                            <div class="col-md-6 text-center">
                                <div class="customer-co-slip-preview" id="slipPreviewContainer">
                                    <div class="text-muted py-4 small" id="slipPreviewPlaceholder">
                                        <i class="fa-regular fa-image fs-1 d-block mb-1 opacity-50"></i>
                                        ยังไม่ได้เลือกรูปสลิป
                                    </div>
                                    <img id="slipPreviewImg" src="" alt="ตัวอย่างสลิป" class="img-fluid rounded d-none shadow-sm" style="max-height: 180px;" />
                                    <button type="button" class="btn btn-sm btn-danger rounded-pill mt-2 d-none" id="btnRemoveSlip" onclick="removeSelectedSlip()">
                                        <i class="fa-solid fa-trash me-1"></i> ลบรูปสลิป
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                        <button type="button" class="customer-mb-btn-outline btn border rounded-pill px-3" onclick="navigateToStep(1)">
                            <i class="fa-solid fa-arrow-left me-1"></i>
                            <span>ย้อนกลับ</span>
                        </button>
                        <button type="button" id="btnConfirmBooking" class="customer-co-btn-book ms-3" onclick="submitBookingForm()">
                            <i class="fa-solid fa-circle-check"></i>
                            <span>ยืนยันการจองและส่งสลิป</span>
                        </button>
                    </div>
                </div>

            </div>

            <!-- ฝั่งขวา: สรุปการจอง -->
            <div class="col-lg-4" id="checkoutStickyColumn">
                <aside class="room-details-booking-panel customer-co-summary-panel">
                    <div class="room-details-panel-header">
                        <div>
                            <span class="room-details-panel-tag">สรุปการจอง</span>
                            <h3 class="room-details-panel-room" id="lblSummaryRoomType">@currentRoomType.TypeName</h3>
                        </div>
                        <span class="customer-co-icon-box"><i class="fa-solid fa-hotel"></i></span>
                    </div>

                    <div class="customer-co-summary-img-box">
                        <img id="summaryRoomImg" src="@GetRoomImage(currentRoomType.TypeCode, currentRoomType.TypeName)" alt="@currentRoomType.TypeName" onerror="this.style.visibility='hidden'" />
                        <span class="customer-co-summary-badge" id="lblSummaryCode">@currentRoomType.TypeCode</span>
                    </div>

                    <div class="customer-co-summary-body">

                        <div class="customer-co-summary-dates mb-3">
                            <div class="row g-3">
                                <div class="col-6">
                                    <label for="checkInInput" class="customer-co-date-label">
                                        <i class="fa-regular fa-calendar-plus text-primary me-1"></i>
                                        วันเช็คอิน
                                    </label>
                                    <input type="date" id="checkInInput" class="form-control customer-co-date-input" required />
                                    <strong id="summaryCheckIn" class="d-block mt-1">-</strong>
                                </div>

                                <div class="col-6">
                                    <label for="checkOutInput" class="customer-co-date-label">
                                        <i class="fa-regular fa-calendar-minus text-primary me-1"></i>
                                        วันเช็คเอาท์
                                    </label>
                                    <input type="date" id="checkOutInput" class="form-control customer-co-date-input" required />
                                    <strong id="summaryCheckOut" class="d-block mt-1">-</strong>
                                </div>
                            </div>
                        </div>

                        <div class="row g-2 mb-4">
                            <div class="col-6">
                                <div class="customer-co-mini-chip">
                                    <i class="fa-solid fa-moon text-primary"></i>
                                    <span>พัก <strong id="lblSummaryNights">1</strong> คืน</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="customer-co-mini-chip">
                                    <i class="fa-solid fa-user-group text-primary"></i>
                                    <span>ผู้เข้าพัก <strong id="lblSummaryGuests">2</strong> ท่าน</span>
                                </div>
                            </div>
                        </div>

                        <div class="p-3 rounded-4 border bg-light mb-4">
                            <label for="simRoomSelect" class="customer-co-label small fw-bold"><i class="fa-solid fa-bed text-primary me-1"></i> ประเภทห้องพัก</label>
                            <select id="simRoomSelect" class="form-select form-select-sm customer-co-input" style="height:38px; font-size:0.8rem;">
                                @foreach (var rt in roomTypes)
                                {
                                    <option value="@rt.RoomTypeId" selected="@(rt.RoomTypeId == currentRoomType.RoomTypeId)">@rt.TypeName (฿@rt.BasePrice.ToString("N0")/คืน)</option>
                                }
                            </select>
                        </div>

                        <div class="room-details-price-breakdown">
                            <div class="room-details-breakdown-row">
                                <span>ค่าห้องพัก (<span id="lblBaseNights">1</span> คืน)</span>
                                <strong id="lblBasePrice">฿0</strong>
                            </div>
                            <div class="room-details-breakdown-row text-success">
                                <span id="lblPromoLabel">ส่วนลดโปรโมชั่น</span>
                                <strong id="lblPromoDiscount">-฿0</strong>
                            </div>
                            
                            <!-- 1) แทนที่บรรทัดเดิมด้วยช่องสำหรับจัดทำรายการแจกแจงแบบไดนามิก -->
                            <div id="promoBreakdown" class="small mb-2 d-none"></div>
                            
                            <hr class="my-2" />
                            <div class="d-flex justify-content-between align-items-baseline">
                                <span class="fw-bold text-dark">ยอดชำระสุทธิ</span>
                                <span class="room-details-net-total fs-4" id="lblNetTotal">฿0</span>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>

        </form>
    </div>

    <!-- MODAL จองสำเร็จ -->
    <div class="modal fade customer-co-success-modal" id="successBookingModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content customer-co-success-modal-content text-center">
                <div class="modal-body p-5">
                    <div class="customer-co-success-icon-wrap mb-4" style="font-size: 55px; color: #198754;">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>

                    <h2 class="fw-bold text-dark mb-2">ส่งการจองเรียบร้อยแล้ว</h2>
                    <p class="text-secondary mb-3">เจ้าหน้าที่จะตรวจสอบสลิปและยืนยันการจองของคุณ</p>

                    <div class="p-3 bg-light rounded-4 border mb-4 text-start small text-secondary">
                        <div class="d-flex justify-content-between mb-1">
                            <span>รหัสการจอง:</span>
                            <strong class="text-dark" id="lblSuccessCode">-</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>ประเภทห้องพัก:</span>
                            <strong class="text-dark" id="lblSuccessRoom">-</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>วันที่เข้าพัก:</span>
                            <strong class="text-dark" id="lblSuccessDates">-</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>ยอดชำระ:</span>
                            <strong class="text-primary fs-6" id="lblSuccessAmount">฿0</strong>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <a asp-controller="Customer" asp-action="MyBookings" class="customer-co-btn-cyan justify-content-center py-3 text-white">
                            <i class="fa-solid fa-receipt me-1"></i>
                            <span>ดูการจองของฉัน</span>
                        </a>
                        <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-secondary rounded-pill py-2">
                            <span>กลับสู่หน้าแรก</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- LOADING -->
    <div class="customer-co-loading-overlay d-none" id="coLoadingOverlay" aria-hidden="true" style="position: fixed; inset: 0; background: rgba(0,0,0,0.75); z-index: 9999; align-items: center; justify-content: center;">
        <div class="text-center text-white">
            <div class="spinner-border text-info" style="width: 3.5rem; height: 3.5rem;" role="status">
                <span class="visually-hidden">กำลังโหลด</span>
            </div>
            <h4 class="fw-bold mt-3">กำลังส่งการจอง</h4>
            <p class="opacity-75">กรุณาอย่าปิดหรือรีเฟรชหน้านี้</p>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script>
        const dbRooms = @Html.Raw(roomTypesJson);
        const quoteUrl = "@Url.Action("Quote", "Customer")";

        document.addEventListener("DOMContentLoaded", function () {
            const pageRoot = document.getElementById("checkoutPageRoot");
            if (!pageRoot) return;

            if (typeof AOS !== "undefined") {
                AOS.init({ duration: 650, once: true });
            }

            const initRoomTypeId = parseInt(pageRoot.dataset.initRoomTypeId, 10);
            const initCheckIn = pageRoot.dataset.initCheckIn;
            const initCheckOut = pageRoot.dataset.initCheckOut;
            const initGuests = parseInt(pageRoot.dataset.initGuests || "2", 10);
            const initPromoCode = (pageRoot.dataset.initPromoCode || "").trim();

            const roomSelector = document.getElementById("simRoomSelect");
            const guestCapacityEl = document.getElementById("guestCapacity");
            const checkInInput = document.getElementById("checkInInput");
            const checkOutInput = document.getElementById("checkOutInput");
            const confirmBtn = document.getElementById("btnConfirmBooking");

            // ---------- helpers ----------
            const baht = (n) => "฿" + Math.round(n).toLocaleString("en-US");
            const pad = (n) => String(n).padStart(2, "0");
            const toInputDate = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;

            // แก้ไขจุดเกิดเหตุ parts[1] - 1
            const parseLocalDate = (value) => {
                if (!value) return null;
                const parts = value.split("-").map(Number);
                if (parts.length !== 3 || parts.some(Number.isNaN)) return null;
                return new Date(parts[0], parts[1] - 1, parts[2]);
            };

            const addDays = (date, days) => {
                const result = new Date(date);
                result.setDate(result.getDate() + days);
                return result;
            };

            const formatThaiDate = (date) =>
                date.toLocaleDateString("th-TH", { day: "2-digit", month: "short", year: "numeric" });

            function showError(message) {
                const box = document.getElementById("coErrorBox");
                document.getElementById("coErrorText").textContent = message;
                box.classList.remove("d-none");
                box.classList.add("d-flex");
                box.scrollIntoView({ behavior: "smooth", block: "center" });
            }

            function clearError() {
                const box = document.getElementById("coErrorBox");
                box.classList.add("d-none");
                box.classList.remove("d-flex");
            }

            // ---------- ห้องและจำนวนผู้เข้าพัก ----------
            const currentRoom = () => dbRooms.find(r => r.id === parseInt(roomSelector.value, 10));

            function populateGuests(preferred) {
                const room = currentRoom();
                if (!room) return;
                const min = Math.max(room.minGuests || 1, 1);
                const max = Math.max(room.maxGuests || min, min);
                const value = Math.min(Math.max(preferred || 2, min), max);

                guestCapacityEl.innerHTML = "";
                for (let n = min; n <= max; n++) {
                    const opt = document.createElement("option");
                    opt.value = n;
                    opt.textContent = `${n} ท่าน`;
                    guestCapacityEl.appendChild(opt);
                }
                guestCapacityEl.value = value;
            }

            roomSelector.value = initRoomTypeId;
            populateGuests(initGuests);

            // ---------- วันที่ ----------
            const today = new Date();
            today.setHours(0, 0, 0, 0);

            let checkInDate = parseLocalDate(initCheckIn);
            let checkOutDate = parseLocalDate(initCheckOut);

            if (!checkInDate || checkInDate < today) checkInDate = new Date(today);
            if (!checkOutDate || checkOutDate <= checkInDate) checkOutDate = addDays(checkInDate, 1);

            checkInInput.min = toInputDate(today);
            checkOutInput.min = toInputDate(addDays(checkInDate, 1));
            checkInInput.value = toInputDate(checkInDate);
            checkOutInput.value = toInputDate(checkOutDate);

            let nightsCount = Math.max(1, Math.round((checkOutDate - checkInDate) / 86400000));

            function updateDateSummary() {
                document.getElementById("summaryCheckIn").textContent = formatThaiDate(checkInDate);
                document.getElementById("summaryCheckOut").textContent = formatThaiDate(checkOutDate);
                document.getElementById("lblSummaryNights").textContent = nightsCount;
                document.getElementById("lblBaseNights").textContent = nightsCount;
            }

            // ---------- คำนวณราคา ----------
            let activeNetTotal = 0;
            let quoteReady = false;
            let quoteSeq = 0;

            function setPriceLabels(base, discount, total) {
                document.getElementById("lblBasePrice").textContent = base === null ? "-" : baht(base);
                document.getElementById("lblPromoDiscount").textContent = discount === null ? "-" : `-${baht(discount)}`;
                document.getElementById("lblNetTotal").textContent = total === null ? "-" : baht(total);
                document.getElementById("lblPayAmount").textContent = total === null ? "-" : baht(total);
            }

            function renderPromoBreakdown(q) {
                const box = document.getElementById("promoBreakdown");
                box.innerHTML = "";
                const list = q.promos || [];
                if (list.length === 0) { box.classList.add("d-none"); return; }

                list.forEach(p => {
                    const row = document.createElement("div");
                    row.className = "d-flex justify-content-between gap-2 text-success mb-1";
                    
                    const name = document.createElement("span");
                    name.textContent = `${p.role === "base" ? "โปรหลัก" : "On-top"}: ${p.name}`;
                    
                    const val = document.createElement("strong");
                    val.textContent = p.amount > 0 ? `-${baht(p.amount)} (${p.percent}%)` : "รับสิทธิพิเศษ";
                    
                    row.append(name, val);
                    box.appendChild(row);
                });

                if (q.discountCapped) {
                    const cap = document.createElement("div");
                    cap.className = "text-warning-emphasis mt-1";
                    cap.textContent = "ส่วนลดรวมถึงเพดานสูงสุด 20% ของค่าห้องแล้ว";
                    box.appendChild(cap);
                }
                box.classList.remove("d-none");
            }

            async function calculatePrices(keepError = false) {
                const room = currentRoom();
                if (!room) return;
                if (!keepError) clearError();

                const guests = parseInt(guestCapacityEl.value, 10) || 1;
                document.getElementById("lblSummaryGuests").textContent = guests;
                document.getElementById("lblSummaryRoomType").textContent = room.name;
                document.getElementById("lblSummaryCode").textContent = room.code;
                const roomImgEl = document.getElementById("summaryRoomImg");
                roomImgEl.style.visibility = "visible";
                roomImgEl.src = room.img;
                roomImgEl.alt = room.name;

                quoteReady = false;
                confirmBtn.disabled = true;
                setPriceLabels(null, null, null);

                const seq = ++quoteSeq;
                const params = new URLSearchParams({
                    roomTypeId: room.id,
                    checkIn: toInputDate(checkInDate),
                    checkOut: toInputDate(checkOutDate),
                    guests: guests,
                    promoCode: initPromoCode
                });

                try {
                    const res = await fetch(`${quoteUrl}?${params.toString()}`, { headers: { "Accept": "application/json" } });
                    if (seq !== quoteSeq) return;

                    if (!res.ok) {
                        showError(`ไม่สามารถคำนวณราคาได้ (รหัสข้อผิดพลาด ${res.status}) กรุณาลองใหม่อีกครั้ง`);
                        return;
                    }

                    const q = await res.json();
                    if (seq !== quoteSeq) return;

                    if (!q.success) {
                        showError(q.message || "ไม่สามารถคำนวณราคาได้");
                        return;
                    }

                    document.getElementById("lblBaseNights").textContent = q.nights;
                    document.getElementById("lblPromoLabel").textContent =
                        q.discountPercent > 0 ? `ส่วนลดรวม (${q.discountPercent}%)` : "ส่วนลดโปรโมชั่น";
                    renderPromoBreakdown(q);

                    activeNetTotal = q.total;
                    setPriceLabels(q.roomAmount, q.discount, q.total);

                    if (q.available <= 0) {
                        showError("ประเภทห้องนี้เต็มในช่วงวันที่เลือก กรุณาเลือกวันที่หรือประเภทห้องอื่น");
                        return;
                    }

                    quoteReady = true;
                    confirmBtn.disabled = false;
                } catch (e) {
                    if (seq === quoteSeq) showError("ไม่สามารถคำนวณราคาได้ กรุณาลองใหม่อีกครั้ง");
                }
            }

            updateDateSummary();
            calculatePrices();

            // ---------- events ----------
            checkInInput.addEventListener("change", function () {
                clearError();
                const selected = parseLocalDate(this.value);

                if (!selected || selected < today) {
                    showError("กรุณาเลือกวันเช็คอินตั้งแต่วันนี้เป็นต้นไป");
                    this.value = toInputDate(checkInDate);
                    return;
                }

                checkInDate = selected;
                const minimumCheckOut = addDays(checkInDate, 1);
                checkOutInput.min = toInputDate(minimumCheckOut);

                if (checkOutDate <= checkInDate) {
                    checkOutDate = minimumCheckOut;
                    checkOutInput.value = toInputDate(checkOutDate);
                }

                nightsCount = Math.max(1, Math.round((checkOutDate - checkInDate) / 86400000));
                updateDateSummary();
                calculatePrices();
            });

            checkOutInput.addEventListener("change", function () {
                clearError();
                const selected = parseLocalDate(this.value);

                if (!selected || selected < addDays(checkInDate, 1)) {
                    showError("วันเช็คเอาท์ต้องอยู่หลังวันเช็คอินอย่างน้อย 1 วัน");
                    this.value = toInputDate(checkOutDate);
                    return;
                }

                checkOutDate = selected;
                nightsCount = Math.max(1, Math.round((checkOutDate - checkInDate) / 86400000));
                updateDateSummary();
                calculatePrices();
            });

            roomSelector.addEventListener("change", function () {
                populateGuests(parseInt(guestCapacityEl.value, 10));
                calculatePrices();
            });
            guestCapacityEl.addEventListener("change", () => calculatePrices());

            // ---------- ขั้นตอน ----------
            window.navigateToStep = function (stepNum) {
                clearError();

                const step2Idx = document.getElementById("stepIndicator2");
                const line1 = document.getElementById("progressLine1");
                const panelGuest = document.getElementById("panelGuestInfo");
                const panelPay = document.getElementById("panelPayment");

                if (stepNum === 2) {
                    if (!quoteReady) {
                        showError("ยังไม่สามารถไปขั้นตอนชำระเงินได้ กรุณาตรวจสอบวันที่เข้าพักและห้องว่าง");
                        return;
                    }
                    const name = document.getElementById("guestFullName").value.trim();
                    const phone = document.getElementById("guestPhone").value.trim();
                    const emailEl = document.getElementById("guestEmail");
                    const email = emailEl.value.trim();

                    if (!name || !phone || !email) {
                        showError("กรุณากรอกชื่อ เบอร์โทรศัพท์ และอีเมลให้ครบถ้วน");
                        return;
                    }
                    if (!emailEl.checkValidity()) {
                        showError("รูปแบบอีเมลไม่ถูกต้อง");
                        return;
                    }
                    if (!/^[0-9+\-\s]{8,20}$/.test(phone)) {
                        showError("รูปแบบเบอร์โทรศัพท์ไม่ถูกต้อง");
                        return;
                    }

                    panelGuest.classList.add("d-none");
                    panelPay.classList.remove("d-none");
                    step2Idx.classList.add("active");
                    line1.classList.add("active");
                } else {
                    panelPay.classList.add("d-none");
                    panelGuest.classList.remove("d-none");
                    step2Idx.classList.remove("active");
                    line1.classList.remove("active");
                }
                window.scrollTo({ top: 120, behavior: "smooth" });
            };

            // ---------- สลิป ----------
            window.previewPaymentSlip = function (input) {
                clearError();
                const file = input.files && input.files[0];
                if (!file) return;

                if (!["image/jpeg", "image/png"].includes(file.type)) {
                    showError("รองรับเฉพาะไฟล์ JPEG หรือ PNG");
                    input.value = "";
                    return;
                }
                if (file.size > 5 * 1024 * 1024) {
                    showError("ไฟล์สลิปต้องมีขนาดไม่เกิน 5MB");
                    input.value = "";
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (e) {
                    const img = document.getElementById("slipPreviewImg");
                    img.src = e.target.result;
                    img.classList.remove("d-none");
                    document.getElementById("slipPreviewPlaceholder").classList.add("d-none");
                    document.getElementById("btnRemoveSlip").classList.remove("d-none");
                };
                reader.readAsDataURL(file);
            };

            window.removeSelectedSlip = function () {
                document.getElementById("slipUploadInput").value = "";
                const img = document.getElementById("slipPreviewImg");
                img.src = "";
                img.classList.add("d-none");
                document.getElementById("slipPreviewPlaceholder").classList.remove("d-none");
                document.getElementById("btnRemoveSlip").classList.add("d-none");
            };

            // ---------- ส่งการจอง ----------
            window.submitBookingForm = function () {
                clearError();

                if (!quoteReady) {
                    showError("ยังไม่สามารถยืนยันการจองได้ กรุณาตรวจสอบวันที่เข้าพักและห้องว่าง");
                    return;
                }

                const slipInput = document.getElementById("slipUploadInput");
                if (!slipInput.files || slipInput.files.length === 0) {
                    showError("กรุณาแนบสลิปการโอนเงินก่อนยืนยันการจอง");
                    return;
                }

                const overlay = document.getElementById("coLoadingOverlay");
                overlay.classList.remove("d-none");
                overlay.classList.add("d-flex");
                confirmBtn.disabled = true;

                const closeOverlay = () => {
                    overlay.classList.add("d-none");
                    overlay.classList.remove("d-flex");
                };

                const formData = new FormData();
                formData.append("__RequestVerificationToken", document.querySelector('input[name="__RequestVerificationToken"]').value);
                formData.append("roomTypeId", roomSelector.value);
                formData.append("checkIn", toInputDate(checkInDate));
                formData.append("checkOut", toInputDate(checkOutDate));
                formData.append("guests", guestCapacityEl.value);
                formData.append("fullName", document.getElementById("guestFullName").value.trim());
                formData.append("email", document.getElementById("guestEmail").value.trim());
                formData.append("phone", document.getElementById("guestPhone").value.trim());
                formData.append("specialRequest", document.getElementById("specialRequest").value.trim());
                formData.append("promoCode", initPromoCode);
                formData.append("netTotal", activeNetTotal);
                formData.append("slipFile", slipInput.files[0]);

                fetch("/Customer/SubmitBooking", { method: "POST", body: formData })
                    .then(response => response.json())
                    .then(data => {
                        closeOverlay();

                        if (data.success) {
                            document.getElementById("stepIndicator3").classList.add("active");
                            document.getElementById("progressLine2").classList.add("active");

                            document.getElementById("lblSuccessCode").textContent = data.bookingCode;
                            document.getElementById("lblSuccessRoom").textContent = document.getElementById("lblSummaryRoomType").textContent;
                            document.getElementById("lblSuccessDates").textContent =
                                `${document.getElementById("summaryCheckIn").textContent} - ${document.getElementById("summaryCheckOut").textContent}`;
                            document.getElementById("lblSuccessAmount").textContent = baht(Number(data.netTotal) || activeNetTotal);

                            const modalEl = document.getElementById("successBookingModal");
                            if (modalEl && typeof bootstrap !== "undefined") {
                                bootstrap.Modal.getOrCreateInstance(modalEl).show();
                            }
                        } else {
                            confirmBtn.disabled = false;
                            showError(data.message || "ไม่สามารถทำรายการจองได้ กรุณาลองใหม่อีกครั้ง");
                            if (data.refreshQuote) calculatePrices(true);
                        }
                    })
                    .catch(() => {
                        closeOverlay();
                        confirmBtn.disabled = false;
                        showError("เชื่อมต่อไม่สำเร็จ กรุณาลองใหม่อีกครั้ง");
                    });
            };
        });
    </script>
}
