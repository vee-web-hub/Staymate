@using System.Text.Json
@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "สำรองห้องพักและชำระเงิน";

    // รับค่าพารามิเตอร์ส่งต่อมาเพื่อรักษาความต่อเนื่องของ Flow
    var qRoomTypeId = Context.Request.Query["roomTypeId"].ToString();
    var qCheckIn = Context.Request.Query["checkIn"].ToString();
    var qCheckOut = Context.Request.Query["checkOut"].ToString();
    var qGuests = Context.Request.Query["guests"].ToString();
    var qPromoCode = Context.Request.Query["promoCode"].ToString();

    var roomTypes = ViewBag.RoomTypes as List<StayMate_Kavinvee_0576.Models.RoomType> 
                    ?? new List<StayMate_Kavinvee_0576.Models.RoomType>();
    var activePromos = ViewBag.ActivePromotions as List<StayMate_Kavinvee_0576.Models.Promotion>
                       ?? new List<StayMate_Kavinvee_0576.Models.Promotion>();
    var userProfile = ViewBag.CurrentUser as StayMate_Kavinvee_0576.Models.User;

    // หารายละเอียดประเภทห้องเริ่มต้น
    var parsedInitId = byte.TryParse(qRoomTypeId, out var tempId) ? tempId : (byte)2;
    var currentRoomType = roomTypes.FirstOrDefault(rt => rt.RoomTypeId == parsedInitId) 
                          ?? roomTypes.FirstOrDefault() 
                          ?? new StayMate_Kavinvee_0576.Models.RoomType { RoomTypeId = 2, TypeName = "Deluxe Room", TypeCode = "RM-DLX-02", BasePrice = 2600 };

    // ฟังก์ชันหารูปประกอบห้องจริง
    string GetRoomImage(string? code)
    {
        var key = (code ?? "").ToLower();
        if (key.Contains("std")) return "https://images.unsplash.com/photo-1631049307264-da0ec9d70304?auto=format&fit=crop&w=800&q=80";
        if (key.Contains("fam")) return "https://images.unsplash.com/photo-1566665797739-1674de7a421a?auto=format&fit=crop&w=800&q=80";
        if (key.Contains("sui")) return "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80";
        return "https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=800&q=80";
    }

    // แปลงออบเจกต์ประเภทห้องพักจากฐานข้อมูลจริงเป็น JSON
    var roomTypesJson = JsonSerializer.Serialize(roomTypes.Select(rt => new {
        id = rt.RoomTypeId,
        name = rt.TypeName,
        code = rt.TypeCode,
        price = rt.BasePrice,
        img = GetRoomImage(rt.TypeCode)
    }));

    // แปลงรายการโปรโมชั่นจากฐานข้อมูลจริงเป็น JSON
    var promotionsJson = JsonSerializer.Serialize(activePromos.Select(p => new {
        promoId = p.PromotionId,
        promoCode = p.PromoCode,
        promoName = p.PromoName,
        discountType = p.DiscountType,
        discountPercent = p.DiscountPercent,
        minGuests = p.MinGuests ?? 1,
        minNights = p.MinNights ?? 1,
        applicableRoomTypeId = p.ApplicableRoomTypeId
    }));
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />
    <link rel="stylesheet" href="~/css/Customer.css" asp-append-version="true" />
}

<div class="customer-co-wrapper" id="checkoutPageRoot"
     data-init-room-type-id="@currentRoomType.RoomTypeId"
     data-init-check-in="@qCheckIn"
     data-init-check-out="@qCheckOut"
     data-init-guests="@(string.IsNullOrEmpty(qGuests) ? "2" : qGuests)"
     data-init-promo-code="@qPromoCode">

    <!-- =========================================================
         1. BOOKING PROGRESS BAR
         ========================================================= -->
    <div class="container py-4">
        <div class="customer-co-progress-card" data-aos="fade-down">
            <div class="customer-co-progress-steps">
                <div class="customer-co-step active" id="stepIndicator1">
                    <div class="customer-co-step-icon"><i class="fa-solid fa-user-pen"></i></div>
                    <div class="customer-co-step-label">
                        <strong>Step 1</strong>
                        <span>Guest Information</span>
                    </div>
                </div>
                <div class="customer-co-progress-line" id="progressLine1"></div>
                <div class="customer-co-step" id="stepIndicator2">
                    <div class="customer-co-step-icon"><i class="fa-solid fa-credit-card"></i></div>
                    <div class="customer-co-step-label">
                        <strong>Step 2</strong>
                        <span>Secure Payment</span>
                    </div>
                </div>
                <div class="customer-co-progress-line" id="progressLine2"></div>
                <div class="customer-co-step" id="stepIndicator3">
                    <div class="customer-co-step-icon"><i class="fa-solid fa-circle-check"></i></div>
                    <div class="customer-co-step-label">
                        <strong>Step 3</strong>
                        <span>Confirmation</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- =========================================================
         MAIN TWO-COLUMN LAYOUT
         ========================================================= -->
    <div class="container pb-5">
        <form id="checkoutForm" onsubmit="return false;" class="row g-4 position-relative">
            @Html.AntiForgeryToken()

            <!-- COLUMN LEFT: Guest Details & Payment Method (8 Cols) -->
            <div class="col-lg-8" id="checkoutLeftColumn">
                
                <!-- STEP 1: GUEST INFORMATION PANEL -->
                <div class="room-details-block p-4 mb-4" id="panelGuestInfo" data-aos="fade-up">
                    <div class="customer-co-panel-header">
                        <span class="customer-co-panel-eyebrow"><i class="fa-solid fa-user-check me-1"></i> STEP 1 OF 2</span>
                        <h2 class="customer-co-panel-title">Guest Information · ข้อมูลผู้เข้าพัก</h2>
                        <p class="text-secondary small mb-0">กรุณากรอกข้อมูลเพื่อใช้ระบุสิทธิ์ในการจองและตรวจสอบข้อมูลกับฐานข้อมูลโรงแรม</p>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="guestFullName" class="customer-co-label">ชื่อ - นามสกุล (Full Name) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-regular fa-user"></i></span>
                                <input type="text" id="guestFullName" class="form-control customer-co-input" required placeholder="เช่น นายวิวัฒน์ มุ่งมั่น" value="@(userProfile?.FullName ?? User.Identity?.Name)" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="guestPhone" class="customer-co-label">เบอร์โทรศัพท์ (Phone Number) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-phone"></i></span>
                                <input type="tel" id="guestPhone" class="form-control customer-co-input" required placeholder="เช่น 0897654321" value="@userProfile?.Phone" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="guestEmail" class="customer-co-label">อีเมล (Email Address) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-regular fa-envelope"></i></span>
                                <input type="email" id="guestEmail" class="form-control customer-co-input" required placeholder="เช่น wivat.m@staymate.com" value="@userProfile?.Email" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="guestCapacity" class="customer-co-label">จำนวนผู้เข้าพักจริง (Guests) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-user-group"></i></span>
                                <select id="guestCapacity" class="form-select customer-co-input">
                                    <option value="1">1 ท่าน</option>
                                    <option value="2">2 ท่าน (แนะนำ)</option>
                                    <option value="3">3 ท่าน (เสริมเตียง)</option>
                                    <option value="4">4 ท่าน</option>
                                    <option value="5">5 ท่าน</option>
                                    <option value="6">6 ท่าน (ความจุสูงสุด)</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-12">
                            <label for="specialRequest" class="customer-co-label">คำขอพิเศษเพิ่มเติม (Special Request)</label>
                            <textarea id="specialRequest" rows="3" class="form-control customer-co-textarea" placeholder="เช่น ขอห้องพักชั้นสูง, ขอหมอนเสริม..."></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                        <button type="button" class="customer-co-btn-next" onclick="navigateToStep(2)">
                            <span>ดำเนินการต่อขั้นตอนชำระเงิน</span>
                            <i class="fa-solid fa-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>

                <!-- STEP 2: PAYMENT METHOD PANEL -->
                <div class="room-details-block p-4 mb-4 d-none" id="panelPayment" data-aos="fade-up">
                    <div class="customer-co-panel-header">
                        <span class="customer-co-panel-eyebrow"><i class="fa-solid fa-credit-card me-1"></i> STEP 2 OF 2</span>
                        <h2 class="customer-co-panel-title">Secure Payment · ชำระเงินผ่านการสแกน</h2>
                        <p class="text-secondary small mb-0">โอนเงินด้วย PromptPay หรือ บัญชีธนาคาร จากนั้นอัปโหลดภาพหลักฐานสลิปการโอนเงินด้านล่างเพื่อบันทึกลง Database</p>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-5 text-center border-md-end pe-md-4">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill mb-2 px-3 py-1 fw-bold">
                                <i class="fa-solid fa-qrcode me-1"></i> QR PROMPTPAY (MOCK)
                            </span>
                            
                            <div class="customer-co-qr-wrap p-3 border rounded-4 d-inline-block bg-white shadow-sm">
                                <img id="promptPayQrImg" src="https://api.qrserver.com/v1/create-qr-code/?size=240x240&data=STAYMATE-INITIAL" alt="PromptPay QR Code" class="img-fluid" />
                            </div>
                            
                            <small class="text-muted d-block mt-2">
                                <i class="fa-solid fa-circle-info text-info"></i> สแกนจ่ายด้วยโมบายแบงก์กิ้งได้ทุกแอป
                            </small>
                        </div>

                        <div class="col-md-7">
                            <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-university text-primary me-2"></i>ข้อมูลบัญชีธนาคารสำหรับโอนเงิน</h5>
                            
                            <div class="customer-co-bank-card mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong class="text-dark"><i class="fa-solid fa-building-columns text-primary me-1"></i> ธนาคารไทยพาณิชย์ (SCB)</strong>
                                    <span class="badge bg-primary-subtle text-primary rounded">บัญชีหลัก</span>
                                </div>
                                <div class="customer-co-bank-detail mb-1">
                                    <span>เลขที่บัญชี:</span>
                                    <strong class="customer-co-mono-font fs-6">123-456-789-0</strong>
                                </div>
                                <div class="customer-co-bank-detail">
                                    <span>ชื่อบัญชี:</span>
                                    <strong>บริษัท สเตย์เมท โฮเทล จำกัด (สำนักงานใหญ่)</strong>
                                </div>
                            </div>

                            <div class="p-3 rounded-4 bg-light border small text-secondary">
                                <strong><i class="fa-solid fa-shield-halved text-success me-1"></i> Security Notice:</strong>
                                ข้อมูลและหลักฐานการชำระเงินของท่าน จะได้รับการตรวจสอบและบันทึกเข้าสู่ฐานข้อมูลระบบหลักอย่างปลอดภัย
                            </div>
                        </div>
                    </div>

                    <!-- อัปโหลดสลิป -->
                    <div class="p-4 rounded-4 border bg-light mb-4">
                        <h5 class="fw-bold text-dark mb-2"><i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i>อัปโหลดสลิปการโอนเงิน (Upload Payment Slip) <span class="text-danger">*</span></h5>
                        <p class="text-muted small">กรุณาอัปโหลดไฟล์รูปภาพสลิปที่ถูกต้องเพื่อใช้ในการอนุมัติใบจอง</p>

                        <div class="row g-3 align-items-center">
                            <div class="col-md-6">
                                <div class="customer-co-upload-zone" onclick="document.getElementById('slipUploadInput').click()">
                                    <i class="fa-solid fa-cloud-arrow-up fs-2 text-primary mb-2"></i>
                                    <strong>เลือกไฟล์รูปภาพสลิปที่นี่</strong>
                                    <small class="text-muted">JPEG, PNG (ไม่เกิน 5MB)</small>
                                    <input type="file" id="slipUploadInput" name="slipFile" accept="image/jpeg, image/png" class="d-none" onchange="previewPaymentSlip(this)" />
                                </div>
                            </div>
                            <div class="col-md-6 text-center">
                                <div class="customer-co-slip-preview" id="slipPreviewContainer">
                                    <div class="text-muted py-4 small" id="slipPreviewPlaceholder">
                                        <i class="fa-regular fa-image fs-1 d-block mb-1 opacity-50"></i>
                                        ยังไม่ได้เลือกไฟล์ภาพสลิป
                                    </div>
                                    <img id="slipPreviewImg" src="" alt="Slip Preview" class="img-fluid rounded d-none shadow-sm" style="max-height: 180px;" />
                                    <button type="button" class="btn btn-sm btn-danger rounded-pill mt-2 d-none" id="btnRemoveSlip" onclick="removeSelectedSlip()">
                                        <i class="fa-solid fa-trash me-1"></i> ลบรูปภาพสลิป
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <button type="button" class="customer-mb-btn-outline btn border rounded-pill px-3" onclick="navigateToStep(1)">
                            <i class="fa-solid fa-arrow-left me-1"></i>
                            <span>ย้อนกลับ</span>
                        </button>
                        <button type="button" id="btnConfirmBooking" class="customer-co-btn-book" onclick="submitBookingForm()">
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Confirm Booking &amp; Submit Slip</span>
                        </button>
                    </div>
                </div>

            </div>

            <!-- COLUMN RIGHT: BOOKING SUMMARY (STICKY CARD - 4 Cols) -->
            <div class="col-lg-4" id="checkoutStickyColumn">
                <aside class="room-details-booking-panel customer-co-summary-panel">
                    <div class="room-details-panel-header">
                        <div>
                            <span class="room-details-panel-tag">BOOKING SUMMARY</span>
                            <h3 class="room-details-panel-room" id="lblSummaryRoomType">@currentRoomType.TypeName</h3>
                        </div>
                        <span class="customer-co-icon-box"><i class="fa-solid fa-hotel"></i></span>
                    </div>

                    <div class="customer-co-summary-img-box">
                        <img id="summaryRoomImg" src="@GetRoomImage(currentRoomType.TypeCode)" alt="Room Preview" />
                        <span class="customer-co-summary-badge" id="lblSummaryCode">@currentRoomType.TypeCode</span>
                    </div>

                    <div class="customer-co-summary-body">
                        
                        <!-- ปรับแก้ HTML ส่วน Check-in / Check-out พร้อมปฏิทินที่กดเปลี่ยนได้จริง -->
                        <div class="customer-co-summary-dates mb-3">
                            <div class="row g-3">
                                <div class="col-6">
                                    <label for="checkInInput" class="customer-co-date-label">
                                        <i class="fa-regular fa-calendar-plus text-primary me-1"></i>
                                        Check-in Date
                                    </label>
                                    <input type="date"
                                           id="checkInInput"
                                           class="form-control customer-co-date-input"
                                           required />
                                    <strong id="summaryCheckIn" class="d-block mt-1">-</strong>
                                </div>

                                <div class="col-6">
                                    <label for="checkOutInput" class="customer-co-date-label">
                                        <i class="fa-regular fa-calendar-minus text-primary me-1"></i>
                                        Check-out Date
                                    </label>
                                    <input type="date"
                                           id="checkOutInput"
                                           class="form-control customer-co-date-input"
                                           required />
                                    <strong id="summaryCheckOut" class="d-block mt-1">-</strong>
                                </div>
                            </div>
                            <small class="text-primary d-block mt-2">
                                <i class="fa-solid fa-circle-info me-1"></i>
                                สามารถกดเลือกวันเข้าพักและวันออกจากปฏิทินได้
                            </small>
                        </div>

                        <div class="row g-2 mb-4">
                            <div class="col-6">
                                <div class="customer-co-mini-chip">
                                    <i class="fa-solid fa-moon text-primary"></i>
                                    <span>พักต่อเนื่อง <strong id="lblSummaryNights">1</strong> คืน</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="customer-co-mini-chip">
                                    <i class="fa-solid fa-user-group text-primary"></i>
                                    <span>ผู้เข้าพัก <strong id="lblSummaryGuests">2</strong> ท่าน</span>
                                </div>
                            </div>
                        </div>

                        <!-- แถบเลือกเปลี่ยนประเภทห้องเพื่อทดสอบหน้า Checkout -->
                        <div class="p-3 rounded-4 border bg-light mb-4">
                            <label for="simRoomSelect" class="customer-co-label small fw-bold"><i class="fa-solid fa-repeat text-primary me-1"></i> จำลองเปลี่ยนห้องพัก (ทดสอบ UI):</label>
                            <select id="simRoomSelect" class="form-select form-select-sm customer-co-input" style="height:38px; font-size:0.8rem;">
                                @foreach (var rt in roomTypes)
                                {
                                    <option value="@rt.RoomTypeId" selected="@(rt.RoomTypeId == currentRoomType.RoomTypeId)">@rt.TypeName (฿@rt.BasePrice.ToString("N0")/คืน)</option>
                                }
                            </select>
                        </div>

                        <!-- Price Breakdown -->
                        <div class="room-details-price-breakdown">
                            <div class="room-details-breakdown-row">
                                <span>ราคาห้องพัก (<span id="lblBaseNights">1</span> คืน × <span id="lblBaseRooms">1</span> ห้อง)</span>
                                <strong id="lblBasePrice">฿0</strong>
                            </div>
                            <div class="room-details-breakdown-row text-success">
                                <span>ส่วนลดโปรโมชั่นสมาชิก (Promo Code)</span>
                                <strong id="lblPromoDiscount">-฿0</strong>
                            </div>
                            <div class="room-details-breakdown-row text-success">
                                <span>ส่วนลดออนท็อปอื่นๆ</span>
                                <strong id="lblExtraDiscount">-฿0</strong>
                            </div>
                            <hr class="my-2" />
                            <div class="d-flex justify-content-between align-items-baseline">
                                <span class="fw-bold text-dark">ยอดชำระสุทธิ (Net Total)</span>
                                <span class="room-details-net-total fs-4" id="lblNetTotal">฿0</span>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>

        </form>
    </div>

    <!-- SUCCESS BOOKING MODAL -->
    <div class="modal fade customer-co-success-modal" id="successBookingModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content customer-co-success-modal-content text-center">
                <div class="modal-body p-5">
                    <div class="customer-co-success-icon-wrap mb-4" style="font-size: 55px; color: #198754;">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>

                    <h2 class="fw-bold text-dark mb-2">สำรองห้องพักเรียบร้อยแล้ว!</h2>
                    <p class="text-info fw-bold mb-3"><i class="fa-solid fa-shield-halved me-1"></i> Smart Booking Saved in Database Successfully</p>

                    <div class="p-3 bg-light rounded-4 border mb-4 text-start small text-secondary">
                        <div class="mb-2"><strong><i class="fa-solid fa-receipt text-primary me-1"></i> ใบยืนยันรายการจองจริงของคุณสำเร็จแล้ว:</strong></div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>รหัสการจอง:</span>
                            <strong class="text-dark" id="lblSuccessCode">BK-XXXXX</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>ประเภทห้องพัก:</span>
                            <strong class="text-dark" id="lblSuccessRoom">Deluxe Room</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>กำหนดเข้าพัก:</span>
                            <strong class="text-dark" id="lblSuccessDates">-</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>ยอดเงินที่ชำระจริง:</span>
                            <strong class="text-primary fs-6" id="lblSuccessAmount">฿0</strong>
                        </div>
                        <hr class="my-2" />
                        <div class="small text-muted text-center">* สลิปการโอนเงินและรายการจองได้ถูกนำส่งเข้าระบบฐานข้อมูล เรียบร้อยครับ</div>
                    </div>

                    <div class="d-grid gap-2">
                        <a asp-controller="Customer" asp-action="MyBookings" class="customer-co-btn-cyan justify-content-center py-3 text-white">
                            <i class="fa-solid fa-receipt me-1"></i>
                            <span>ไปยังหน้าการจองของฉัน (My Bookings)</span>
                        </a>
                        <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-secondary rounded-pill py-2">
                            <span>กลับสู่หน้าแรกสำหรับสมาชิก</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- LOADING OVERLAY PANEL -->
    <div class="customer-co-loading-overlay d-none" id="coLoadingOverlay" aria-hidden="true" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.75); z-index: 9999; display: flex; align-items: center; justify-content: center;">
        <div class="text-center text-white">
            <div class="spinner-border text-info" style="width: 3.5rem; height: 3.5rem;" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h4 class="fw-bold mt-3">กำลังส่งสลิปและบันทึกสิทธิ์จองลงตารางฐานข้อมูล...</h4>
            <p class="opacity-75">กรุณาอย่าปิดหน้าต่างระบบหรือกดโหลดหน้าใหม่</p>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script>
        // รับ Catalog ข้อมูลห้องพักและโปรโมชั่นทั้งหมดจาก DB มาคำนวณราคาแบบ Dynamic
        const dbRooms = @Html.Raw(roomTypesJson);
        const dbPromotions = @Html.Raw(promotionsJson);

        document.addEventListener("DOMContentLoaded", function () {
            if (typeof AOS !== "undefined") {
                AOS.init({ duration: 650, once: true });
            }

            const pageRoot = document.getElementById("checkoutPageRoot");
            const initRoomTypeId = parseInt(pageRoot.dataset.initRoomTypeId || "2", 10);
            const initCheckIn = pageRoot.dataset.initCheckIn;
            const initCheckOut = pageRoot.dataset.initCheckOut;
            const initGuests = parseInt(pageRoot.dataset.initGuests || "2", 10);
            const initPromoCode = pageRoot.dataset.initPromoCode;

            const roomSelector = document.getElementById("simRoomSelect");
            const guestCapacityEl = document.getElementById("guestCapacity");

            // กำหนดค่าตั้งต้นใน Select และฟอร์ม
            roomSelector.value = initRoomTypeId;
            guestCapacityEl.value = initGuests;

            const checkInInput = document.getElementById("checkInInput");
            const checkOutInput = document.getElementById("checkOutInput");

            const pad = (n) => String(n).padStart(2, "0");

            const toInputDate = (d) =>
                `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;

            const parseLocalDate = (value) => {
                if (!value) return null;

                const parts = value.split("-").map(Number);
                if (parts.length !== 3 || parts.some(Number.isNaN)) return null;

                return new Date(parts[0], parts - 1, parts[2]);
            };

            const addDays = (date, days) => {
                const result = new Date(date);
                result.setDate(result.getDate() + days);
                return result;
            };

            const formatThaiDate = (date) =>
                date.toLocaleDateString("th-TH", {
                    day: "2-digit",
                    month: "short",
                    year: "numeric"
                });

            // วันที่ปัจจุบัน โดยไม่ใช้เวลา UTC
            const today = new Date();
            today.setHours(0, 0, 0, 0);

            const todayText = toInputDate(today);

            // อ่านวันเริ่มต้นจาก URL / Dataset
            let checkInDate = parseLocalDate(initCheckIn);
            let checkOutDate = parseLocalDate(initCheckOut);

            // ถ้าไม่มีวัน หรือวันที่ผ่านไปแล้ว ให้เริ่มจากวันนี้
            if (!checkInDate || checkInDate < today) {
                checkInDate = new Date(today);
            }

            // วันออกต้องหลังวันเข้าอย่างน้อย 1 วัน
            if (!checkOutDate || checkOutDate <= checkInDate) {
                checkOutDate = addDays(checkInDate, 1);
            }

            // ตั้งค่า date picker
            checkInInput.min = todayText;
            checkOutInput.min = toInputDate(addDays(checkInDate, 1));

            checkInInput.value = toInputDate(checkInDate);
            checkOutInput.value = toInputDate(checkOutDate);

            // คำนวณจำนวนคืน
            let nightsCount = Math.round(
                (checkOutDate - checkInDate) / 86400000
            );

            if (nightsCount < 1) nightsCount = 1;

            // แสดงวันที่บน Booking Summary
            function updateDateSummary() {
                document.getElementById("summaryCheckIn").textContent =
                    formatThaiDate(checkInDate);

                document.getElementById("summaryCheckOut").textContent =
                    formatThaiDate(checkOutDate);

                document.getElementById("lblSummaryNights").textContent =
                    nightsCount;

                document.getElementById("lblBaseNights").textContent =
                    nightsCount;
            }

            updateDateSummary();
            document.getElementById("lblSummaryGuests").textContent = initGuests;

            // ตัวเก็บข้อมูลโปรโมชั่นที่ผ่านการตรวจสอบ
            let activePromoId = null;
            let activeNetTotal = 0;

            function calculatePrices() {
                const selectedId = parseInt(roomSelector.value, 10);
                const roomInfo = dbRooms.find(r => r.id === selectedId);
                if (!roomInfo) return;

                const searchGuests = parseInt(guestCapacityEl.value, 10);
                document.getElementById("lblSummaryGuests").textContent = searchGuests;

                // อัปเดตข้อมูลบน Summary Card
                document.getElementById("lblSummaryRoomType").textContent = roomInfo.name;
                document.getElementById("lblSummaryCode").textContent = roomInfo.code;
                document.getElementById("summaryRoomImg").src = roomInfo.img;

                const basePrice = roomInfo.price * nightsCount;
                document.getElementById("lblBasePrice").textContent = `฿${basePrice.toLocaleString("en-US")}`;

                // ค้นหาและจำลองคำนวณโปรโมชั่นที่มีในระบบ Database จริง
                let promoDiscount = 0;
                activePromoId = null;

                if (Array.isArray(dbPromotions) && dbPromotions.length > 0) {
                    dbPromotions.forEach(p => {
                        const matchRoom = !p.applicableRoomTypeId || p.applicableRoomTypeId === selectedId;
                        const matchGuests = searchGuests >= p.minGuests;
                        const matchNights = nightsCount >= p.minNights;

                        if (matchRoom && matchGuests && matchNights) {
                            activePromoId = p.promoId;
                            if (p.discountType === "free_extra_bed") {
                                promoDiscount = 500 * nightsCount; // ค่าเตียงเสริมจำลองเฉลี่ย 500 บาท
                            } else if (p.discountType === "percent_room") {
                                promoDiscount = basePrice * (p.discountPercent / 100);
                            } else if (p.discountType === "percent_extra_nights") {
                                promoDiscount = roomInfo.price * (p.discountPercent / 100);
                            }
                        }
                    });
                }

                // สิทธิ์ลดเพิ่ม E-Voucher หากมีการกรอกส่งมา
                let voucherDiscount = 0;
                if (initPromoCode) {
                    voucherDiscount = 500;
                }

                document.getElementById("lblPromoDiscount").textContent = `-฿${Math.round(promoDiscount).toLocaleString("en-US")}`;
                document.getElementById("lblExtraDiscount").textContent = `-฿${Math.round(voucherDiscount).toLocaleString("en-US")}`;

                activeNetTotal = Math.max(0, basePrice - promoDiscount - voucherDiscount);
                document.getElementById("lblNetTotal").textContent = `฿${activeNetTotal.toLocaleString("en-US")}`;

                // อัปเดต QR Code จำลองตามราคาสุทธิ
                const qrImg = document.getElementById("promptPayQrImg");
                if (qrImg) {
                    qrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=240x240&data=STAYMATE-PAYMENT-AMOUNT-${activeNetTotal}`;
                }
            }

            // เปลี่ยนวัน Check-in
            checkInInput.addEventListener("change", function () {
                const selectedDate = parseLocalDate(this.value);

                if (!selectedDate || selectedDate < today) {
                    alert("กรุณาเลือกวัน Check-in ตั้งแต่วันนี้เป็นต้นไป");
                    this.value = toInputDate(checkInDate);
                    return;
                }

                checkInDate = selectedDate;

                // วัน Check-out ต้องอยู่หลัง Check-in อย่างน้อย 1 วัน
                const minimumCheckOut = addDays(checkInDate, 1);
                checkOutInput.min = toInputDate(minimumCheckOut);

                if (!checkOutDate || checkOutDate <= checkInDate) {
                    checkOutDate = minimumCheckOut;
                    checkOutInput.value = toInputDate(checkOutDate);
                }

                nightsCount = Math.round(
                    (checkOutDate - checkInDate) / 86400000
                );

                updateDateSummary();
                calculatePrices();
            });

            // เปลี่ยนวัน Check-out
            checkOutInput.addEventListener("change", function () {
                const selectedDate = parseLocalDate(this.value);
                const minimumCheckOut = addDays(checkInDate, 1);

                if (!selectedDate || selectedDate < minimumCheckOut) {
                    alert("วัน Check-out ต้องอยู่หลังวัน Check-in อย่างน้อย 1 วัน");
                    this.value = toInputDate(checkOutDate);
                    return;
                }

                checkOutDate = selectedDate;

                nightsCount = Math.round(
                    (checkOutDate - checkInDate) / 86400000
                );

                updateDateSummary();
                calculatePrices();
            });

            // เปลี่ยนห้องหรือจำนวนผู้เข้าพัก
            roomSelector.addEventListener("change", calculatePrices);
            guestCapacityEl.addEventListener("change", calculatePrices);

            // คำนวณราคาเริ่มต้น
            calculatePrices();

            // ส่งข้อมูลไปยัง Step 2 หรือบันทึกจริง
            window.navigateToStep = function (stepNum) {
                const step1Idx = document.getElementById("stepIndicator1");
                const step2Idx = document.getElementById("stepIndicator2");
                const line1 = document.getElementById("progressLine1");

                const panelGuest = document.getElementById("panelGuestInfo");
                const panelPay = document.getElementById("panelPayment");

                if (stepNum === 2) {
                    const name = document.getElementById("guestFullName").value.trim();
                    const phone = document.getElementById("guestPhone").value.trim();
                    const email = document.getElementById("guestEmail").value.trim();

                    if (!name || !phone || !email) {
                        alert("กรุณากรอกข้อมูลผู้เข้าพักที่มีเครื่องหมาย * ให้ครบถ้วนก่อนไปขั้นตอนถัดไปครับ");
                        return;
                    }

                    panelGuest.classList.add("d-none");
                    panelPay.classList.remove("d-none");

                    step1Idx.classList.add("active");
                    step2Idx.classList.add("active");
                    line1.classList.add("active");
                    window.scrollTo({ top: 120, behavior: "smooth" });
                } else {
                    panelPay.classList.add("d-none");
                    panelGuest.classList.remove("d-none");

                    step2Idx.classList.remove("active");
                    line1.classList.remove("active");
                    window.scrollTo({ top: 120, behavior: "smooth" });
                }
            };

            window.previewPaymentSlip = function (input) {
                const placeholder = document.getElementById("slipPreviewPlaceholder");
                const img = document.getElementById("slipPreviewImg");
                const deleteBtn = document.getElementById("btnRemoveSlip");

                if (input.files && input.files[0]) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        img.src = e.target.result;
                        img.classList.remove("d-none");
                        placeholder.classList.add("d-none");
                        deleteBtn.classList.remove("d-none");
                    };
                    reader.readAsDataURL(input.files[0]);
                }
            };

            window.removeSelectedSlip = function () {
                const input = document.getElementById("slipUploadInput");
                const placeholder = document.getElementById("slipPreviewPlaceholder");
                const img = document.getElementById("slipPreviewImg");
                const deleteBtn = document.getElementById("btnRemoveSlip");

                input.value = "";
                img.src = "";
                img.classList.add("d-none");
                placeholder.classList.remove("d-none");
                deleteBtn.classList.add("d-none");
            };

            // บันทึกการจองจริงเข้าตารางผ่าน Ajax
            window.submitBookingForm = function () {
                const slipInput = document.getElementById("slipUploadInput");
                if (!slipInput.files || slipInput.files.length === 0) {
                    alert("กรุณาอัปโหลดหลักฐานการโอนเงิน (สลิป) เพื่อส่งยืนยันให้ระบบบันทึกรายการจองลงตารางใน Database");
                    return;
                }

                const overlay = document.getElementById("coLoadingOverlay");
                overlay.classList.remove("d-none");

                // จัดเตรียม FormData ส่งเข้า Controller แบบ POST จริง
                const formData = new FormData();
                formData.append("__RequestVerificationToken", document.querySelector('input[name="__RequestVerificationToken"]').value);
                formData.append("roomTypeId", roomSelector.value);
                formData.append("checkIn", toInputDate(checkInDate));
                formData.append("checkOut", toInputDate(checkOutDate));
                formData.append("guests", guestCapacityEl.value);
                formData.append("fullName", document.getElementById("guestFullName").value);
                formData.append("email", document.getElementById("guestEmail").value);
                formData.append("phone", document.getElementById("guestPhone").value);
                formData.append("specialRequest", document.getElementById("specialRequest").value);
                formData.append("promoId", activePromoId || "");
                formData.append("netTotal", activeNetTotal);
                formData.append("slipFile", slipInput.files[0]);

                // ส่งคำร้องขอ Ajax POST
                fetch("/Customer/SubmitBooking", {
                    method: "POST",
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    overlay.classList.add("d-none");
                    if (data.success) {
                        document.getElementById("stepIndicator3").classList.add("active");
                        document.getElementById("progressLine2").classList.add("active");

                        document.getElementById("lblSuccessCode").textContent = data.bookingCode;
                        document.getElementById("lblSuccessRoom").textContent = document.getElementById("lblSummaryRoomType").textContent;
                        document.getElementById("lblSuccessDates").textContent = `${document.getElementById("summaryCheckIn").textContent} - ${document.getElementById("summaryCheckOut").textContent}`;
                        document.getElementById("lblSuccessAmount").textContent = "฿" + data.netTotal;

                        const successModalEl = document.getElementById("successBookingModal");
                        if (successModalEl && typeof bootstrap !== "undefined") {
                            bootstrap.Modal.getOrCreateInstance(successModalEl).show();
                        }
                    } else {
                        alert("การสำรองล้มเหลว: " + data.message);
                    }
                })
                .catch(error => {
                    overlay.classList.add("d-none");
                    alert("เกิดข้อผิดพลาดทางเทคนิคในการเชื่อมโยงฐานข้อมูล: " + error);
                });
            };
        });
    </script>
}
