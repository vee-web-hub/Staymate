@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "สำรองห้องพักและชำระเงิน";

    // รับค่าพารามิเตอร์ส่งต่อมาจากปุ่มจองห้องพักในหน้า RoomAvailability และ RoomDetails เพื่อรักษาความต่อเนื่องของ Flow
    var qRoomTypeId = Context.Request.Query["roomTypeId"].ToString();
    var qCheckIn = Context.Request.Query["checkIn"].ToString();
    var qCheckOut = Context.Request.Query["checkOut"].ToString();
    var qGuests = Context.Request.Query["guests"].ToString();
    var qRooms = Context.Request.Query["rooms"].ToString();
    var qPromoCode = Context.Request.Query["promoCode"].ToString();
    var qPromoName = Context.Request.Query["promoName"].ToString();
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />
    <link rel="stylesheet" href="~/css/Customer.css" asp-append-version="true" />
}

<div class="customer-co-wrapper" id="checkoutPageRoot"
     data-init-room-type-id="@(string.IsNullOrEmpty(qRoomTypeId) ? "2" : qRoomTypeId)"
     data-init-check-in="@qCheckIn"
     data-init-check-out="@qCheckOut"
     data-init-guests="@qGuests"
     data-init-rooms="@qRooms"
     data-init-promo-code="@qPromoCode"
     data-init-promo-name="@qPromoName">

    <!-- =========================================================
         1. BOOKING PROGRESS BAR
         ========================================================= -->
    <div class="container py-4">
        <div class="customer-co-progress-card" data-aos="fade-down">
            <div class="customer-co-progress-steps">
                <div class="customer-co-step active" id="stepIndicator1">
                    <div class="customer-co-step-icon"><i class="fa-solid fa-user-pen"></i></div>
                    <div class="customer-co-step-label">
                        <strong>Step 1</strong>
                        <span>Guest Information</span>
                    </div>
                </div>
                <div class="customer-co-progress-line" id="progressLine1"></div>
                <div class="customer-co-step" id="stepIndicator2">
                    <div class="customer-co-step-icon"><i class="fa-solid fa-credit-card"></i></div>
                    <div class="customer-co-step-label">
                        <strong>Step 2</strong>
                        <span>Secure Payment</span>
                    </div>
                </div>
                <div class="customer-co-progress-line" id="progressLine2"></div>
                <div class="customer-co-step" id="stepIndicator3">
                    <div class="customer-co-step-icon"><i class="fa-solid fa-circle-check"></i></div>
                    <div class="customer-co-step-label">
                        <strong>Step 3</strong>
                        <span>Confirmation</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- =========================================================
         MAIN TWO-COLUMN LAYOUT
         ========================================================= -->
    <div class="container pb-5">
        <!-- ฟอร์มหลอกสำหรับจอง โดยใช้ Client-Side Handling ในการรันสลับหน้าจอ (Step 1 -> Step 2 -> Success) -->
        <form id="checkoutForm" onsubmit="return false;" class="row g-4 position-relative">
            
            <!-- COLUMN LEFT: Guest Details & Payment Method (8 Cols) -->
            <div class="col-lg-8" id="checkoutLeftColumn">
                
                <!-- =====================================================
                     STEP 1: GUEST INFORMATION PANEL
                     ===================================================== -->
                <div class="room-details-block p-4 mb-4" id="panelGuestInfo" data-aos="fade-up">
                    <div class="customer-co-panel-header">
                        <span class="customer-co-panel-eyebrow"><i class="fa-solid fa-user-check me-1"></i> STEP 1 OF 2</span>
                        <h2 class="customer-co-panel-title">Guest Information · ข้อมูลผู้เข้าพัก</h2>
                        <p class="text-secondary small mb-0">กรุณากรอกข้อมูลเพื่อใช้ระบุสิทธิ์ในการลงทะเบียนเข้าพักจริงที่เครื่อง Smart Check-in Kiosk ของโรงแรม</p>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="guestFullName" class="customer-co-label">ชื่อ - นามสกุล (Full Name) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-regular fa-user"></i></span>
                                <input type="text" id="guestFullName" class="form-control customer-co-input" required placeholder="เช่น นายวิวัฒน์ มุ่งมั่น" value="@(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "")" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="guestPhone" class="customer-co-label">เบอร์โทรศัพท์ (Phone Number) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-phone"></i></span>
                                <input type="tel" id="guestPhone" class="form-control customer-co-input" required placeholder="เช่น 0897654321" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="guestEmail" class="customer-co-label">อีเมล (Email Address) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-regular fa-envelope"></i></span>
                                <input type="email" id="guestEmail" class="form-control customer-co-input" required placeholder="เช่น wivat.m@staymate.com" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="guestCapacity" class="customer-co-label">จำนวนผู้เข้าพักจริง (Guests) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa-solid fa-user-group"></i></span>
                                <select id="guestCapacity" class="form-select customer-co-input">
                                    <option value="1">1 ท่าน</option>
                                    <option value="2" selected>2 ท่าน</option>
                                    <option value="3">3 ท่าน (เสริมเตียง)</option>
                                    <option value="4">4 ท่าน</option>
                                    <option value="5">5 ท่าน (สวีต)</option>
                                    <option value="6">6 ท่าน (ความจุสูงสุด)</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-12">
                            <label for="specialRequest" class="customer-co-label">คำขอพิเศษเพิ่มเติม (Special Request)</label>
                            <textarea id="specialRequest" rows="3" class="form-control customer-co-textarea" placeholder="เช่น ขอห้องพักชั้นสูง, ขอหมอนเสริม, เตรียมส้อมและจานเสริมในห้องนอน..."></textarea>
                            <small class="text-muted"><i class="fa-solid fa-circle-info text-info me-1"></i> คำขอพิเศษขึ้นอยู่กับความพร้อมของห้องพัก ณ วันเช็คอิน</small>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                        <button type="button" class="customer-co-btn-next" onclick="navigateToStep(2)">
                            <span>ดำเนินการต่อขั้นตอนชำระเงิน</span>
                            <i class="fa-solid fa-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>

                <!-- =====================================================
                     STEP 2: PAYMENT METHOD PANEL (โชว์เมื่อเข้า Step 2)
                     ===================================================== -->
                <div class="room-details-block p-4 mb-4 d-none" id="panelPayment" data-aos="fade-up">
                    <div class="customer-co-panel-header">
                        <span class="customer-co-panel-eyebrow"><i class="fa-solid fa-credit-card me-1"></i> STEP 2 OF 2</span>
                        <h2 class="customer-co-panel-title">Secure Payment · วิธีชำระเงินด่วน</h2>
                        <p class="text-secondary small mb-0">ระบบจัดทำ PromptPay QR Code จำลองให้ชำระเงินตามจำนวนสุทธิ เมื่อโอนเงินแล้วกรุณาอัปโหลดรูปสลิปหลักฐานการโอนเงินด้านล่าง</p>
                    </div>

                    <div class="row g-4 mb-4">
                        <!-- QR Code จำลอง (ซ้าย) -->
                        <div class="col-md-5 text-center border-md-end pe-md-4">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill mb-2 px-3 py-1 fw-bold">
                                <i class="fa-solid fa-qrcode me-1"></i> QR PROMPTPAY (MOCK)
                            </span>
                            
                            <div class="customer-co-qr-wrap p-3 border rounded-4 d-inline-block bg-white shadow-sm">
                                <img id="promptPayQrImg" src="https://api.qrserver.com/v1/create-qr-code/?size=240x240&data=STAYMATE-CHECKOUT-MOCK-PAYMENT" alt="PromptPay QR Code Mock" class="img-fluid" />
                            </div>
                            
                            <small class="text-muted d-block mt-2">
                                <i class="fa-solid fa-circle-info text-info"></i> สแกนจ่ายด้วยโมบายแบงก์กิ้งได้ทุกแอป
                            </small>
                        </div>

                        <!-- รายละเอียดบัญชีตัวอย่าง (ขวา) -->
                        <div class="col-md-7">
                            <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-university text-primary me-2"></i>ข้อมูลบัญชีธนาคารสำหรับโอนเงิน</h5>
                            
                            <div class="customer-co-bank-card mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong class="text-dark"><i class="fa-solid fa-building-columns text-primary me-1"></i> ธนาคารไทยพาณิชย์ (SCB)</strong>
                                    <span class="badge bg-primary-subtle text-primary rounded">บัญชีทางการ</span>
                                </div>
                                <div class="customer-co-bank-detail mb-1">
                                    <span>เลขที่บัญชี:</span>
                                    <strong class="customer-co-mono-font fs-6">123-456-789-0</strong>
                                </div>
                                <div class="customer-co-bank-detail">
                                    <span>ชื่อบัญชีตัวอย่าง:</span>
                                    <strong>บริษัท สเตย์เมท โฮเทล จำกัด (สำนักงานใหญ่)</strong>
                                </div>
                            </div>

                            <div class="p-3 rounded-4 bg-light border small text-secondary">
                                <strong><i class="fa-solid fa-shield-halved text-success me-1"></i> Security Notice:</strong>
                                ระบบเช็คเอาท์จำลองนี้มีมาตรการความปลอดภัยสูงสุด ข้อมูลสลิปจะได้รับการเข้ารหัสและนำส่งไปยังเจ้าหน้าที่การเงินเพื่ออนุมัติสิทธิ์ Digital Pass ทันทีใน 5-15 นาที
                            </div>
                        </div>
                    </div>

                    <!-- แถบอัปโหลดสลิปเงินโอนพร้อมรูปพรีวิว -->
                    <div class="p-4 rounded-4 border bg-light mb-4">
                        <h5 class="fw-bold text-dark mb-2"><i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i>อัปโหลดสลิปการโอนเงิน (Upload Payment Slip) <span class="text-danger">*</span></h5>
                        <p class="text-muted small">ระบบจะจำลองการตรวจสอบสลิปหลังกดยืนยันการจอง</p>

                        <div class="row g-3 align-items-center">
                            <div class="col-md-6">
                                <div class="customer-co-upload-zone" onclick="document.getElementById('slipUploadInput').click()">
                                    <i class="fa-solid fa-cloud-arrow-up fs-2 text-primary mb-2"></i>
                                    <strong>เลือกไฟล์รูปภาพสลิปที่นี่</strong>
                                    <small class="text-muted">รองรับ JPEG, PNG (ไม่เกิน 5MB)</small>
                                    <input type="file" id="slipUploadInput" accept="image/jpeg, image/png" class="d-none" onchange="previewPaymentSlip(this)" />
                                </div>
                            </div>
                            <div class="col-md-6 text-center">
                                <div class="customer-co-slip-preview" id="slipPreviewContainer">
                                    <div class="text-muted py-4 small" id="slipPreviewPlaceholder">
                                        <i class="fa-regular fa-image fs-1 d-block mb-1 opacity-50"></i>
                                        ยังไม่ได้เลือกไฟล์ภาพสลิป
                                    </div>
                                    <img id="slipPreviewImg" src="" alt="Slip Preview" class="img-fluid rounded d-none shadow-sm" style="max-height: 180px;" />
                                    <button type="button" class="btn btn-sm btn-danger rounded-pill mt-2 d-none" id="btnRemoveSlip" onclick="removeSelectedSlip()">
                                        <i class="fa-solid fa-trash me-1"></i> ลบรูปภาพสลิป
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ปุ่มควบคุมของ Step 2 -->
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <button type="button" class="customer-mb-btn-outline" onclick="navigateToStep(1)">
                            <i class="fa-solid fa-arrow-left me-1"></i>
                            <span>ย้อนกลับไปแก้ไขข้อมูลผู้เข้าพัก</span>
                        </button>
                        <button type="button" id="btnConfirmBooking" class="customer-co-btn-book" onclick="submitBookingForm()">
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Confirm Booking &amp; Submit Slip</span>
                        </button>
                    </div>
                </div>

            </div>

            <!-- COLUMN RIGHT: BOOKING SUMMARY (STICKY CARD - 4 Cols) -->
            <div class="col-lg-4" id="checkoutStickyColumn">
                <aside class="room-details-booking-panel customer-co-summary-panel">
                    <div class="room-details-panel-header">
                        <div>
                            <span class="room-details-panel-tag">BOOKING SUMMARY</span>
                            <h3 class="room-details-panel-room" id="lblSummaryRoomType">Deluxe Room</h3>
                        </div>
                        <span class="customer-co-icon-box"><i class="fa-solid fa-hotel"></i></span>
                    </div>

                    <!-- รูปภาพประเภทห้องที่จอง -->
                    <div class="customer-co-summary-img-box">
                        <img id="summaryRoomImg" src="https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=800&q=80" alt="Room Preview" />
                        <span class="customer-co-summary-badge" id="lblSummaryCode">RM-DLX-02</span>
                    </div>

                    <div class="customer-co-summary-body">
                        <!-- กำหนดการเข้าพักที่สอดคล้องจากการสุ่มคำนวณ -->
                        <div class="customer-co-summary-dates mb-3">
                            <div class="row g-2">
                                <div class="col-6">
                                    <small><i class="fa-regular fa-calendar-plus text-primary me-1"></i> Check-in Date</small>
                                    <strong id="summaryCheckIn">17 พ.ย. 2026</strong>
                                </div>
                                <div class="col-6">
                                    <small><i class="fa-regular fa-calendar-minus text-primary me-1"></i> Check-out Date</small>
                                    <strong id="summaryCheckOut">18 พ.ย. 2026</strong>
                                </div>
                            </div>
                        </div>

                        <!-- ข้อมูลสเปกเข้าพักแบบสรุป -->
                        <div class="row g-2 mb-4">
                            <div class="col-6">
                                <div class="customer-co-mini-chip">
                                    <i class="fa-solid fa-moon text-primary"></i>
                                    <span>พักต่อเนื่อง <strong id="lblSummaryNights">1</strong> คืน</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="customer-co-mini-chip">
                                    <i class="fa-solid fa-user-group text-primary"></i>
                                    <span>ผู้เข้าพัก <strong id="lblSummaryGuests">2</strong> ท่าน</span>
                                </div>
                            </div>
                        </div>

                        <!-- แถบเลือกเปลี่ยนประเภทห้องเพื่อทดสอบหน้า Checkout (Simulator) -->
                        <div class="p-3 rounded-4 border bg-light mb-4">
                            <label for="simRoomSelect" class="customer-co-label small fw-bold"><i class="fa-solid fa-repeat text-primary me-1"></i> จำลองเปลี่ยนห้องพัก (ทดสอบ UI):</label>
                            <select id="simRoomSelect" class="form-select form-select-sm customer-co-input" style="height:38px; font-size:0.8rem;">
                                <option value="1">Standard Room (฿1,800/คืน)</option>
                                <option value="2" selected>Deluxe Room (฿2,600/คืน)</option>
                                <option value="3">Family Room (฿3,900/คืน)</option>
                                <option value="4">Suite Room (฿5,800/คืน)</option>
                            </select>
                        </div>

                        <!-- Price Breakdown -->
                        <div class="room-details-price-breakdown">
                            <div class="room-details-breakdown-row">
                                <span>ราคาห้องพัก (<span id="lblBaseNights">1</span> คืน × <span id="lblBaseRooms">1</span> ห้อง)</span>
                                <strong id="lblBasePrice">฿2,600</strong>
                            </div>
                            <div class="room-details-breakdown-row text-success">
                                <span>ส่วนลดโปรโมชั่นสมาชิก (Promo Code)</span>
                                <strong id="lblPromoDiscount">-฿0</strong>
                            </div>
                            <div class="room-details-breakdown-row text-success">
                                <span>ส่วนลดเพิ่มเติม (E-Voucher)</span>
                                <strong id="lblExtraDiscount">-฿0</strong>
                            </div>
                            <div class="room-details-breakdown-row text-muted small">
                                <span>ภาษีและค่าบริการ (Tax &amp; Service)</span>
                                <span>รวมในยอดสุทธิแล้ว</span>
                            </div>
                            <hr class="my-2" />
                            <div class="d-flex justify-content-between align-items-baseline">
                                <span class="fw-bold text-dark">ยอดชำระสุทธิ (Net Total)</span>
                                <span class="room-details-net-total fs-4" id="lblNetTotal">฿2,600</span>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>

        </form>
    </div>

    <!-- =========================================================
         SUCCESS BOOKING MODAL (Success Popup หลังกดยืนยันสำเร็จ)
         ========================================================= -->
    <div class="modal fade customer-co-success-modal" id="successBookingModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content customer-co-success-modal-content text-center">
                <div class="modal-body p-5">
                    <div class="customer-co-success-icon-wrap mb-4">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>

                    <h2 class="fw-bold text-dark mb-2">สำรองห้องพักเรียบร้อยแล้ว!</h2>
                    <p class="text-info fw-bold mb-3"><i class="fa-solid fa-shield-halved me-1"></i> Smart Checkout Completed Successfully</p>

                    <div class="p-3 bg-light rounded-4 border mb-4 text-start small text-secondary">
                        <div class="mb-2"><strong><i class="fa-solid fa-receipt text-primary me-1"></i> รายการจองจำลองของคุณสำเร็จแล้ว:</strong></div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>รหัสการจอง:</span>
                            <strong class="text-dark">BK-MOCK-202699</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>ประเภทห้องพัก:</span>
                            <strong class="text-dark" id="lblSuccessRoom">Deluxe Room</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>กำหนดเข้าพัก:</span>
                            <strong class="text-dark" id="lblSuccessDates">17 พ.ย. 2026 - 18 พ.ย. 2026</strong>
                        </div>
                        <hr class="my-2" />
                        <div class="small text-muted text-center">* หมายเหตุ: ระบบนี้เป็นหน้าเว็บจำลองสำหรับทดสอบ UI/UX (Mockup) เท่านั้น ไม่ใช่การทำธุรกรรมและการจองจริงในระบบหลักของโรงแรม</div>
                    </div>

                    <div class="d-grid gap-2">
                        <!-- ปุ่มไปดูประวัติการจองในหน้า MyBookings.cshtml -->
                        <a asp-controller="Customer" asp-action="MyBookings" class="customer-co-btn-cyan justify-content-center py-3">
                            <i class="fa-solid fa-receipt"></i>
                            <span>ไปยังหน้าการจองของฉัน (My Bookings)</span>
                        </a>
                        <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-secondary rounded-pill py-2">
                            <span>กลับสู่หน้าแรกสำหรับสมาชิก</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- =========================================================
         LOADING OVERLAY PANEL (ระหว่างประมวลผลสลิปเงินโอน)
         ========================================================= -->
    <div class="customer-co-loading-overlay d-none" id="coLoadingOverlay" aria-hidden="true">
        <div class="text-center text-white">
            <div class="spinner-border text-info" style="width: 3.5rem; height: 3.5rem;" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h4 class="fw-bold mt-3">กำลังส่งหลักฐานและสร้างรหัสใบจองอัจฉริยะ...</h4>
            <p class="opacity-75">กรุณาอย่าปิดหน้าต่างระบบหรือกดโหลดหน้าใหม่</p>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // โหลดสคริปต์ AOS ค้นหาและเตรียมลอจิกจำลอง
            if (typeof AOS !== "undefined") {
                AOS.init({ duration: 650, once: true });
            }

            // รับข้อมูลพารามิเตอร์ทั้งหมดจากหน้าเว็บที่ส่งมาเพื่อตั้งค่าเริ่มต้น
            const pageRoot = document.getElementById("checkoutPageRoot");
            const initRoomTypeId = pageRoot.dataset.initRoomTypeId || "2";
            const initCheckIn = pageRoot.dataset.initCheckIn;
            const initCheckOut = pageRoot.dataset.initCheckOut;
            const initGuests = pageRoot.dataset.initGuests || "2";
            const initRooms = pageRoot.dataset.initRooms || "1";
            const initPromoCode = pageRoot.dataset.initPromoCode;
            const initPromoName = pageRoot.dataset.initPromoName;

            const roomSelector = document.getElementById("simRoomSelect");
            const checkInInput = document.getElementById("guestFullName"); // ใช้ตั้งค่าชื่อ

            // Mock ข้อมูลห้องพักทั้ง 4 แบบในระบบ
            const mockRooms = {
                1: { name: "Standard Room", code: "RM-STD-01", price: 1800, img: "https://images.unsplash.com/photo-1631049307264-da0ec9d70304?auto=format&fit=crop&w=800&q=80" },
                2: { name: "Deluxe Room", code: "RM-DLX-02", price: 2600, img: "https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=800&q=80" },
                3: { name: "Family Room", code: "RM-FAM-03", price: 3900, img: "https://images.unsplash.com/photo-1566665797739-1674de7a421a?auto=format&fit=crop&w=800&q=80" },
                4: { name: "Suite Room", code: "RM-SUI-04", price: 5800, img: "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80" }
            };

            // ตั้งค่าค่าเริ่มต้นในฟอร์มจำลอง
            if (initRoomTypeId && mockRooms[initRoomTypeId]) {
                roomSelector.value = initRoomTypeId;
            }

            const pad = (n) => String(n).padStart(2, "0");
            const formatDateInput = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;

            // จัดการข้อมูลกำหนดการเข้าพัก
            let checkInDate = initCheckIn ? new Date(initCheckIn + "T00:00:00") : new Date();
            let checkOutDate = initCheckOut ? new Date(initCheckOut + "T00:00:00") : new Date();
            if (!initCheckOut) {
                checkOutDate.setDate(checkInDate.getDate() + 1);
            }

            // คำนวณจำลองคืน
            let nightsCount = Math.round((checkOutDate - checkInDate) / 86400000);
            if (isNaN(nightsCount) || nightsCount <= 0) nightsCount = 1;

            document.getElementById("summaryCheckIn").textContent = checkInDate.toLocaleDateString("th-TH", { day: "2-digit", month: "short", year: "numeric" });
            document.getElementById("summaryCheckOut").textContent = checkOutDate.toLocaleDateString("th-TH", { day: "2-digit", month: "short", year: "numeric" });
            document.getElementById("lblSummaryNights").textContent = nightsCount;
            document.getElementById("lblBaseNights").textContent = nightsCount;
            document.getElementById("lblSummaryGuests").textContent = initGuests;
            document.getElementById("guestCapacity").value = initGuests;

            // ฟังก์ชันคำนวณราคาทุกชนิด
            function calculatePrices() {
                const roomType = roomSelector.value;
                const roomInfo = mockRooms[roomType];
                if (!roomInfo) return;

                // อัปเดตข้อมูลบน Summary Card
                document.getElementById("lblSummaryRoomType").textContent = roomInfo.name;
                document.getElementById("lblSummaryCode").textContent = roomInfo.code;
                document.getElementById("summaryRoomImg").src = roomInfo.img;

                const basePrice = roomInfo.price * nightsCount;
                document.getElementById("lblBasePrice").textContent = `฿${basePrice.toLocaleString("en-US")}`;

                // ตรรกะโปรโมชั่นจำลอง (คำนวณอัตโนมัติตามประเภทห้องพักและจำนวนคน)
                let promoDiscount = 0;
                let voucherDiscount = 0;

                // 1) มา 3 จ่าย 2
                if (roomType >= 2 && (initGuests >= 3 || nightsCount >= 3)) {
                    promoDiscount = roomInfo.price * Math.floor(nightsCount / 3) * 1;
                }
                // 2) Family & Gang Pack
                else if (roomType >= 3 && initGuests >= 4) {
                    promoDiscount = basePrice * 0.20; // 20%
                }
                // 3) Stay 3+ Nights
                else if (nightsCount >= 3) {
                    promoDiscount = basePrice * 0.15; // 15%
                }

                // 4) หากมีส่งรหัสส่วนลด E-Voucher มาจากหน้าอื่น หรือ Mock เพิ่ม
                if (initPromoCode && initPromoCode !== "") {
                    voucherDiscount = 500;
                }

                document.getElementById("lblPromoDiscount").textContent = `-฿${Math.round(promoDiscount).toLocaleString("en-US")}`;
                document.getElementById("lblExtraDiscount").textContent = `-฿${Math.round(voucherDiscount).toLocaleString("en-US")}`;

                const netTotal = Math.max(0, basePrice - promoDiscount - voucherDiscount);
                document.getElementById("lblNetTotal").textContent = `฿${netTotal.toLocaleString("en-US")}`;

                // อัปเดตค่า QR Code สลิปเงินโอนตามยอดที่คำนวณจริง
                const qrImg = document.getElementById("promptPayQrImg");
                if (qrImg) {
                    qrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=240x240&data=STAYMATE-PAYMENT-AMOUNT-${netTotal}`;
                }
            }

            roomSelector.addEventListener("change", calculatePrices);
            calculatePrices();
        });

        // ฟังก์ชันสลับเปลี่ยนขั้นตอน (Step 1 <-> Step 2)
        function navigateToStep(stepNum) {
            const step1Idx = document.getElementById("stepIndicator1");
            const step2Idx = document.getElementById("stepIndicator2");
            const step3Idx = document.getElementById("stepIndicator3");
            const line1 = document.getElementById("progressLine1");
            const line2 = document.getElementById("progressLine2");

            const panelGuest = document.getElementById("panelGuestInfo");
            const panelPay = document.getElementById("panelPayment");

            if (stepNum === 2) {
                // ตรวจสอบความถูกต้องของข้อมูลฟอร์มด่านที่ 1 เบื้องต้นก่อนไปชำระเงิน
                const name = document.getElementById("guestFullName").value.trim();
                const phone = document.getElementById("guestPhone").value.trim();
                const email = document.getElementById("guestEmail").value.trim();

                if (!name || !phone || !email) {
                    alert("กรุณากรอกข้อมูลผู้เข้าพักที่มีเครื่องหมาย * ให้ครบถ้วนก่อนไปขั้นตอนถัดไปครับ");
                    return;
                }

                panelGuest.classList.add("d-none");
                panelPay.classList.remove("d-none");

                step1Idx.classList.add("active");
                step2Idx.classList.add("active");
                line1.classList.add("active");
                window.scrollTo({ top: 120, behavior: "smooth" });
            } else {
                panelPay.classList.add("d-none");
                panelGuest.classList.remove("d-none");

                step2Idx.classList.remove("active");
                line1.classList.remove("active");
                window.scrollTo({ top: 120, behavior: "smooth" });
            }
        }

        // ฟังก์ชันพรีวิวภาพสลิปการโอนเงินหลังผู้ใช้เลือกไฟล์ภาพ
        function previewPaymentSlip(input) {
            const placeholder = document.getElementById("slipPreviewPlaceholder");
            const img = document.getElementById("slipPreviewImg");
            const deleteBtn = document.getElementById("btnRemoveSlip");

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    img.src = e.target.result;
                    img.classList.remove("d-none");
                    placeholder.classList.add("d-none");
                    deleteBtn.classList.remove("d-none");
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // ฟังก์ชันลบรูปภาพสลิปที่เลือก
        function removeSelectedSlip() {
            const input = document.getElementById("slipUploadInput");
            const placeholder = document.getElementById("slipPreviewPlaceholder");
            const img = document.getElementById("slipPreviewImg");
            const deleteBtn = document.getElementById("btnRemoveSlip");

            input.value = "";
            img.src = "";
            img.classList.add("d-none");
            placeholder.classList.remove("d-none");
            deleteBtn.classList.add("d-none");
        }

        // ฟังก์ชันส่งฟอร์มและโชว์หน้าจอประมวลผลจำลองก่อนอนุมัติสิทธิ์ (Step 2 -> Success)
        function submitBookingForm() {
            const slipInput = document.getElementById("slipUploadInput");
            if (!slipInput.files || slipInput.files.length === 0) {
                alert("กรุณาเลือกหรืออัปโหลดภาพสลิปการโอนเงินเพื่อยืนยันรายการชำระเงินก่อนยืนยันการจองครับ");
                return;
            }

            const overlay = document.getElementById("coLoadingOverlay");
            overlay.classList.remove("d-none");

            // จำลองหน่วงเวลา 2.2 วินาทีเพื่อความพรีเมียมของระบบก่อนส่งผลลัพธ์สำเร็จ
            setTimeout(() => {
                overlay.classList.add("d-none");

                // สลับขั้นตอนสุดท้ายใน Progress Bar
                document.getElementById("stepIndicator3").classList.add("active");
                document.getElementById("progressLine2").classList.add("active");

                // ดึงข้อมูลสรุปไปแสดงผลบน Success Modal
                const finalRoomName = document.getElementById("lblSummaryRoomType").textContent;
                const checkInText = document.getElementById("summaryCheckIn").textContent;
                const checkOutText = document.getElementById("summaryCheckOut").textContent;

                document.getElementById("lblSuccessRoom").textContent = finalRoomName;
                document.getElementById("lblSuccessDates").textContent = `${checkInText} - ${checkOutText}`;

                // สั่งเปิดป๊อปอัปผลลัพธ์ความสำเร็จจำลองขึ้นมาแสดง
                const successModalEl = document.getElementById("successBookingModal");
                if (successModalEl && typeof bootstrap !== "undefined") {
                    bootstrap.Modal.getOrCreateInstance(successModalEl).show();
                }
            }, 2200);
        }
    </script>
}
