@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "ค้นหาห้องพักและห้องว่าง";

    // รับค่า Query String กรณีส่งมาจากหน้า Customer Home (Quick Booking Search)
    var qCheckIn = Context.Request.Query["checkIn"].ToString();
    var qCheckOut = Context.Request.Query["checkOut"].ToString();
    var qGuests = Context.Request.Query["guests"].ToString();
    var qRoomType = Context.Request.Query["roomType"].ToString();
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />
    <link rel="stylesheet" href="~/css/Customer.css" asp-append-version="true" />
}

<div class="customer-ra-wrapper">

    <!-- =========================================================
         1. PAGE HEADER & BREADCRUMB
         ========================================================= -->
    <section class="customer-ra-header">
        <div class="customer-ra-header-bg"
             style="background-image: url('https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=2000&q=80');">
        </div>
        <div class="customer-ra-header-overlay"></div>
        <div class="customer-ra-orb customer-ra-orb-cyan"></div>
        <div class="customer-ra-orb customer-ra-orb-violet"></div>

        <div class="container position-relative z-2">
            <nav aria-label="breadcrumb" class="customer-ra-breadcrumb mb-3">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a asp-controller="Customer" asp-action="Index">
                            <i class="fa-solid fa-house me-1"></i> หน้าแรกสำหรับสมาชิก
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">ค้นหาห้องพัก</li>
                </ol>
            </nav>

            <div class="row align-items-end g-3">
                <div class="col-lg-8">
                    <span class="customer-ra-eyebrow">
                        <span class="customer-ra-live-dot"></span> SMART AVAILABILITY ENGINE
                    </span>
                    <h1 class="customer-ra-title">ค้นหาห้องพัก · StayMate Rooms</h1>
                    <p class="customer-ra-subtitle mb-0">
                        เลือกประเภทห้องพักที่ตรงใจ ตรวจสอบห้องว่าง คำนวณราคาสุทธิตามจำนวนคืน และกดดูรายละเอียดดีไซน์ห้องพักแต่ละประเภทได้ทันที
                    </p>
                </div>
                <div class="col-lg-4 text-lg-end d-none d-lg-block">
                    <div class="customer-ra-header-badge">
                        <i class="fa-solid fa-bolt text-info"></i>
                        <div>
                            <strong>Real-Time Promo Matching</strong>
                            <span>คำนวณสิทธิ์โปรโมชั่นอัตโนมัติตามเงื่อนไขจริง</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- =========================================================
         2. BOOKING SEARCH PANEL
         ========================================================= -->
    <section class="customer-ra-search-section" aria-label="แผงค้นหาห้องพัก">
        <div class="container">
            <div class="customer-ra-search-panel">
                <div class="customer-ra-search-top">
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <span class="customer-ra-console-icon"><i class="fa-solid fa-sliders"></i></span>
                        <span class="fw-bold text-dark">BOOKING SEARCH PANEL</span>
                        <span class="customer-ra-console-pill">Smart Filter &amp; Rate Calculator</span>
                    </div>
                    <span class="customer-ra-console-hint d-none d-md-inline">
                        <i class="fa-solid fa-circle-check text-success me-1"></i> ราคาที่แสดงคำนวณตามจำนวนคืนและตรวจสอบเงื่อนไขโปรโมชั่นให้ทันที
                    </span>
                </div>

                <form id="raSearchForm" class="customer-ra-search-form" method="get" asp-controller="Customer" asp-action="RoomAvailability">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-sm-6 col-lg-3">
                            <label for="raCheckIn" class="customer-ra-label">
                                <i class="fa-regular fa-calendar-plus text-primary me-1"></i> วันเช็คอิน (Check-in Date)
                            </label>
                            <input type="date" id="raCheckIn" name="checkIn" value="@qCheckIn" class="form-control customer-ra-input" required />
                        </div>

                        <div class="col-12 col-sm-6 col-lg-3">
                            <label for="raCheckOut" class="customer-ra-label">
                                <i class="fa-regular fa-calendar-minus text-primary me-1"></i> วันเช็คเอาท์ (Check-out Date)
                            </label>
                            <input type="date" id="raCheckOut" name="checkOut" value="@qCheckOut" class="form-control customer-ra-input" required />
                        </div>

                        <div class="col-12 col-sm-6 col-lg-2">
                            <label for="raGuests" class="customer-ra-label">
                                <i class="fa-solid fa-user-group text-primary me-1"></i> จำนวนผู้เข้าพัก
                            </label>
                            <select id="raGuests" name="guests" class="form-select customer-ra-input">
                                <option value="1" selected="@(qGuests == "1")">1 ท่าน</option>
                                <option value="2" selected="@(string.IsNullOrEmpty(qGuests) || qGuests == "2")">2 ท่าน (ยอดนิยม)</option>
                                <option value="3" selected="@(qGuests == "3")">3 ท่าน (รองรับ 3 Pay 2)</option>
                                <option value="4" selected="@(qGuests == "4")">4 ท่าน (Family / Gang)</option>
                                <option value="5" selected="@(qGuests == "5")">5 ท่าน (Suite)</option>
                                <option value="6" selected="@(qGuests == "6")">6 ท่าน (Suite สูงสุด)</option>
                            </select>
                        </div>

                        <div class="col-12 col-sm-6 col-lg-2">
                            <label for="raRoomType" class="customer-ra-label">
                                <i class="fa-solid fa-bed text-primary me-1"></i> ประเภทห้องพัก
                            </label>
                            <select id="raRoomType" name="roomType" class="form-select customer-ra-input">
                                <option value="ALL" selected="@(string.IsNullOrEmpty(qRoomType) || qRoomType == "ALL")">ทุกประเภทห้องพัก</option>
                                <option value="Standard" selected="@(qRoomType == "Standard")">Standard Room</option>
                                <option value="Deluxe" selected="@(qRoomType == "Deluxe")">Deluxe Room</option>
                                <option value="Family" selected="@(qRoomType == "Family")">Family Room</option>
                                <option value="Suite" selected="@(qRoomType == "Suite")">Suite Room</option>
                            </select>
                        </div>

                        <div class="col-12 col-lg-2">
                            <button type="submit" id="btnRaSearch" class="customer-ra-btn-search w-100">
                                <i class="fa-solid fa-magnifying-glass"></i>
                                <span>Search Rooms</span>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <!-- =========================================================
         3. SEARCH SUMMARY BAR
         ========================================================= -->
    <section class="customer-ra-summary-section" aria-label="สรุปผลการค้นหา">
        <div class="container">
            <div class="customer-ra-summary-bar">
                <div class="customer-ra-summary-items">
                    <div class="customer-ra-summary-chip">
                        <i class="fa-regular fa-calendar-check text-primary"></i>
                        <div>
                            <small>วันที่เข้าพัก – เช็คเอาท์</small>
                            <strong id="summaryDateRange">-</strong>
                        </div>
                    </div>

                    <div class="customer-ra-summary-divider d-none d-md-block"></div>

                    <div class="customer-ra-summary-chip">
                        <i class="fa-solid fa-moon text-primary"></i>
                        <div>
                            <small>ระยะเวลาเข้าพัก</small>
                            <strong><span id="summaryNights">1</span> คืน</strong>
                        </div>
                    </div>

                    <div class="customer-ra-summary-divider d-none d-md-block"></div>

                    <div class="customer-ra-summary-chip">
                        <i class="fa-solid fa-user-group text-primary"></i>
                        <div>
                            <small>จำนวนผู้เข้าพัก</small>
                            <strong>ผู้ใหญ่ <span id="summaryGuests">2</span> ท่าน</strong>
                        </div>
                    </div>

                    <div class="customer-ra-summary-divider d-none d-md-block"></div>

                    <div class="customer-ra-summary-chip customer-ra-summary-highlight">
                        <i class="fa-solid fa-door-open"></i>
                        <div>
                            <small>ห้องพักที่พร้อมให้บริการ</small>
                            <strong>พบ <span id="summaryFoundCount">4</span> ประเภทห้องพัก</strong>
                        </div>
                    </div>
                </div>

                <div class="d-lg-none w-100 mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
                    <button type="button" class="customer-ra-btn-mobile-filter" data-bs-toggle="offcanvas" data-bs-target="#raFilterOffcanvas">
                        <i class="fa-solid fa-filter me-1"></i> ตัวกรองห้องพัก (Filters)
                    </button>
                    <span class="small text-muted">ปรับแต่งเงื่อนไขได้</span>
                </div>
            </div>
        </div>
    </section>

    <!-- =========================================================
         4. MAIN CONTENT
         ========================================================= -->
    <section class="customer-ra-main-section">
        <div class="container">
            <div class="row g-4">

                <!-- 4A. FILTER PANEL -->
                <div class="col-lg-3">
                    <div class="offcanvas-lg offcanvas-start customer-ra-offcanvas" tabindex="-1" id="raFilterOffcanvas">
                        <div class="offcanvas-header border-bottom">
                            <h5 class="offcanvas-title fw-bold">
                                <i class="fa-solid fa-sliders text-primary me-2"></i>ตัวกรองการค้นหา
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#raFilterOffcanvas"></button>
                        </div>

                        <div class="offcanvas-body p-0">
                            <aside class="customer-ra-filter-card w-100">
                                <div class="customer-ra-filter-header">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-filter text-primary"></i>
                                        <h3 class="customer-ra-filter-title mb-0">Filter Rooms</h3>
                                    </div>
                                    <button type="button" id="btnResetFilters" class="customer-ra-btn-reset">
                                        <i class="fa-solid fa-rotate-left me-1"></i> Reset Filter
                                    </button>
                                </div>

                                <div class="customer-ra-filter-group">
                                    <h4 class="customer-ra-filter-subtitle">ประเภทห้องพัก</h4>
                                    <div class="customer-ra-check-list">
                                        <label class="customer-ra-check-item">
                                            <input type="checkbox" class="form-check-input filter-room-type" value="Standard" checked />
                                            <span>Standard Room</span>
                                            <small class="ms-auto text-muted">฿1,800</small>
                                        </label>
                                        <label class="customer-ra-check-item">
                                            <input type="checkbox" class="form-check-input filter-room-type" value="Deluxe" checked />
                                            <span>Deluxe Room</span>
                                            <small class="ms-auto text-muted">฿2,600</small>
                                        </label>
                                        <label class="customer-ra-check-item">
                                            <input type="checkbox" class="form-check-input filter-room-type" value="Family" checked />
                                            <span>Family Room</span>
                                            <small class="ms-auto text-muted">฿3,900</small>
                                        </label>
                                        <label class="customer-ra-check-item">
                                            <input type="checkbox" class="form-check-input filter-room-type" value="Suite" checked />
                                            <span>Suite Room</span>
                                            <small class="ms-auto text-muted">฿5,800</small>
                                        </label>
                                    </div>
                                </div>

                                <div class="customer-ra-filter-group">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h4 class="customer-ra-filter-subtitle mb-0">งบประมาณต่อคืน</h4>
                                        <span class="customer-ra-price-readout" id="priceRangeLabel">สูงสุด ฿6,500</span>
                                    </div>
                                    <input type="range" class="form-range customer-ra-range" id="filterMaxPrice" min="1800" max="6500" step="100" value="6500" />
                                </div>

                                <div class="customer-ra-filter-group">
                                    <h4 class="customer-ra-filter-subtitle">รองรับผู้เข้าพักอย่างน้อย</h4>
                                    <div class="customer-ra-guest-pills">
                                        <button type="button" class="customer-ra-guest-pill active" data-min-cap="1">ทั้งหมด</button>
                                        <button type="button" class="customer-ra-guest-pill" data-min-cap="2">2+ ท่าน</button>
                                        <button type="button" class="customer-ra-guest-pill" data-min-cap="3">3+ ท่าน</button>
                                        <button type="button" class="customer-ra-guest-pill" data-min-cap="4">4+ ท่าน</button>
                                    </div>
                                </div>

                                <div class="customer-ra-filter-group border-bottom-0 pb-0 mb-0">
                                    <h4 class="customer-ra-filter-subtitle">สิ่งอำนวยความสะดวก</h4>
                                    <div class="customer-ra-check-list">
                                        <label class="customer-ra-check-item">
                                            <input type="checkbox" class="form-check-input filter-amenity" value="Wi-Fi" />
                                            <span><i class="fa-solid fa-wifi text-info me-2"></i>Free Wi-Fi 6</span>
                                        </label>
                                        <label class="customer-ra-check-item">
                                            <input type="checkbox" class="form-check-input filter-amenity" value="Breakfast" />
                                            <span><i class="fa-solid fa-mug-saucer text-info me-2"></i>อาหารเช้า (Breakfast)</span>
                                        </label>
                                        <label class="customer-ra-check-item">
                                            <input type="checkbox" class="form-check-input filter-amenity" value="Bathtub" />
                                            <span><i class="fa-solid fa-bath text-info me-2"></i>อ่างอาบน้ำ (Bathtub)</span>
                                        </label>
                                        <label class="customer-ra-check-item">
                                            <input type="checkbox" class="form-check-input filter-amenity" value="City View" />
                                            <span><i class="fa-solid fa-city text-info me-2"></i>วิวเมือง (City View)</span>
                                        </label>
                                    </div>
                                </div>
                            </aside>
                        </div>
                    </div>
                </div>

                <!-- 4B. RESULTS COLUMN -->
                <div class="col-lg-9">
                    <div class="customer-ra-sorting-bar mb-4">
                        <span class="customer-ra-result-badge">
                            <i class="fa-solid fa-sparkles text-info me-1"></i>
                            แสดง <strong id="visibleRoomCount">4</strong> ประเภทห้องพัก
                        </span>

                        <div class="d-flex align-items-center gap-2 ms-auto">
                            <label for="raSortSelect" class="customer-ra-sort-label mb-0">เรียงตาม:</label>
                            <select id="raSortSelect" class="form-select customer-ra-sort-select">
                                <option value="recommended" selected>แนะนำ (Recommended)</option>
                                <option value="price-asc">ราคา: น้อยไปมาก</option>
                                <option value="price-desc">ราคา: มากไปน้อย</option>
                            </select>
                        </div>
                    </div>

                    <!-- SKELETON LOADING -->
                    <div id="raSkeletonContainer" class="customer-ra-skeleton-wrap d-none">
                        <div class="customer-ra-skeleton-card">
                            <div class="customer-ra-sk-img"></div>
                            <div class="customer-ra-sk-body">
                                <div class="customer-ra-sk-line w-25 mb-2"></div>
                                <div class="customer-ra-sk-line w-50 mb-3"></div>
                                <div class="customer-ra-sk-line w-100 mb-2"></div>
                            </div>
                        </div>
                    </div>

                    <!-- ROOM AVAILABILITY CARDS -->
                    <div id="raRoomsContainer" class="customer-ra-cards-list">

                        <!-- ROOM 1: STANDARD -->
                        <article class="customer-ra-room-card"
                                 data-room-id="1"
                                 data-room-type="Standard"
                                 data-price="1800"
                                 data-max-guests="2"
                                 data-recommended-rank="2"
                                 data-amenities="Wi-Fi,Breakfast">
                            <div class="row g-0">
                                <div class="col-md-5 col-xl-4">
                                    <div class="customer-ra-img-wrap">
                                        <img src="https://images.unsplash.com/photo-1631049307264-da0ec9d70304?auto=format&fit=crop&w=900&q=80"
                                             alt="Standard Room" class="customer-ra-img" />
                                        <span class="customer-ra-type-badge customer-ra-badge-cyan">SMART VALUE</span>
                                        <span class="customer-ra-avail-pill"><span class="customer-ra-dot-green"></span> ว่างพร้อมจอง</span>
                                    </div>
                                </div>
                                <div class="col-md-7 col-xl-8">
                                    <div class="customer-ra-card-body">
                                        <div class="customer-ra-card-top">
                                            <div>
                                                <span class="customer-ra-room-code">ROOM 01 · URBAN SMART</span>
                                                <h2 class="customer-ra-room-title">Standard Room</h2>
                                            </div>
                                            <div class="customer-ra-price-box text-md-end">
                                                <small class="customer-ra-price-label">ราคาต่อคืน</small>
                                                <div class="customer-ra-price-night">฿1,800<span>/คืน</span></div>
                                                <div class="customer-ra-price-total">รวม <span class="js-nights-count">1</span> คืน: <strong class="js-total-price">฿1,800</strong></div>
                                            </div>
                                        </div>

                                        <p class="customer-ra-room-desc">
                                            ห้องพัก Minimal Futuristic ขนาด 28 ตร.ม. พร้อมระบบไฟ Ambient Light, Smart TV 55" และโต๊ะทำงาน Ergonomic
                                        </p>

                                        <div class="customer-ra-specs-row">
                                            <div class="customer-ra-spec-pill"><i class="fa-solid fa-user-group text-primary"></i> 1–2 ท่าน</div>
                                            <div class="customer-ra-spec-pill"><i class="fa-solid fa-bed text-primary"></i> 1 Queen Bed</div>
                                            <div class="customer-ra-spec-pill"><i class="fa-solid fa-maximize text-primary"></i> 28 ตร.ม.</div>
                                        </div>

                                        <div class="customer-ra-promo-box">
                                            <span class="customer-ra-promo-label"><i class="fa-solid fa-bolt text-warning me-1"></i> โปรโมชั่นที่ใช้ได้:</span>
                                            <div class="customer-ra-promo-badges js-promo-badges"></div>
                                        </div>

                                        <div class="customer-ra-card-footer">
                                            <div class="customer-ra-policy-note"><i class="fa-solid fa-shield-halved text-success me-1"></i> จองตรงได้ราคาสมาชิก</div>
                                            <div class="customer-ra-card-actions">
                                                <!-- ปุ่มดูรายละเอียด: ส่งย้ายหน้าไปยัง RoomDetails.cshtml พร้อมส่ง Query Params ไปด้วย -->
                                                <a href="#" class="customer-ra-btn-outline js-details-link" data-room-id="1">
                                                    <i class="fa-solid fa-circle-info"></i>
                                                    <span>ดูรายละเอียดห้อง (Room Details)</span>
                                                </a>
                                                <a href="#" class="customer-ra-btn-book js-book-link" data-room-id="1">
                                                    <i class="fa-solid fa-calendar-check"></i>
                                                    <span>จองห้องนี้ (Book Now)</span>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </article>

                        <!-- ROOM 2: DELUXE -->
                        <article class="customer-ra-room-card customer-ra-card-featured"
                                 data-room-id="2"
                                 data-room-type="Deluxe"
                                 data-price="2600"
                                 data-max-guests="3"
                                 data-recommended-rank="1"
                                 data-amenities="Wi-Fi,Breakfast,Bathtub,City View">
                            <div class="row g-0">
                                <div class="col-md-5 col-xl-4">
                                    <div class="customer-ra-img-wrap">
                                        <img src="https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=900&q=80"
                                             alt="Deluxe Room" class="customer-ra-img" />
                                        <span class="customer-ra-type-badge customer-ra-badge-blue">MOST POPULAR</span>
                                        <span class="customer-ra-avail-pill"><span class="customer-ra-dot-green"></span> ว่างพร้อมจอง</span>
                                    </div>
                                </div>
                                <div class="col-md-7 col-xl-8">
                                    <div class="customer-ra-card-body">
                                        <div class="customer-ra-card-top">
                                            <div>
                                                <span class="customer-ra-room-code">ROOM 02 · SKYLINE DELUXE</span>
                                                <h2 class="customer-ra-room-title">Deluxe Room</h2>
                                            </div>
                                            <div class="customer-ra-price-box text-md-end">
                                                <small class="customer-ra-price-label">ราคาต่อคืน</small>
                                                <div class="customer-ra-price-night">฿2,600<span>/คืน</span></div>
                                                <div class="customer-ra-price-total">รวม <span class="js-nights-count">1</span> คืน: <strong class="js-total-price">฿2,600</strong></div>
                                            </div>
                                        </div>

                                        <p class="customer-ra-room-desc">
                                            วิวเมืองมุมสูง 36 ตร.ม. พร้อมอ่างอาบน้ำและโซฟาเลานจ์ รองรับเตียงเสริมและโปรโมชั่น มา 3 จ่าย 2
                                        </p>

                                        <div class="customer-ra-specs-row">
                                            <div class="customer-ra-spec-pill"><i class="fa-solid fa-user-group text-primary"></i> 2–3 ท่าน</div>
                                            <div class="customer-ra-spec-pill"><i class="fa-solid fa-bed text-primary"></i> 1 King Bed</div>
                                            <div class="customer-ra-spec-pill"><i class="fa-solid fa-bath text-primary"></i> มีอ่างอาบน้ำ</div>
                                        </div>

                                        <div class="customer-ra-promo-box">
                                            <span class="customer-ra-promo-label"><i class="fa-solid fa-bolt text-warning me-1"></i> โปรโมชั่นที่ใช้ได้:</span>
                                            <div class="customer-ra-promo-badges js-promo-badges"></div>
                                        </div>

                                        <div class="customer-ra-card-footer">
                                            <div class="customer-ra-policy-note"><i class="fa-solid fa-shield-halved text-success me-1"></i> รองรับ 3 Pay 2 Extra Bed Free</div>
