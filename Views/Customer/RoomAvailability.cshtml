@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const checkInEl = document.getElementById("raCheckIn");
            const checkOutEl = document.getElementById("raCheckOut");
            const guestsEl = document.getElementById("raGuests");
            const roomTypeSelectEl = document.getElementById("raRoomType");
            const searchForm = document.getElementById("raSearchForm");

            const summaryDateRangeEl = document.getElementById("summaryDateRange");
            const summaryNightsEl = document.getElementById("summaryNights");
            const summaryGuestsEl = document.getElementById("summaryGuests");
            const summaryFoundCountEl = document.getElementById("summaryFoundCount");
            const visibleRoomCountEl = document.getElementById("visibleRoomCount");

            const roomTypeCheckboxes = document.querySelectorAll(".filter-room-type");
            const maxPriceInput = document.getElementById("filterMaxPrice");
            const priceRangeLabel = document.getElementById("priceRangeLabel");
            const guestPills = document.querySelectorAll(".customer-ra-guest-pill");
            const amenityCheckboxes = document.querySelectorAll(".filter-amenity");
            const sortSelect = document.getElementById("raSortSelect");
            const btnResetFilters = document.getElementById("btnResetFilters");
            const btnEmptyReset = document.getElementById("btnEmptyReset");

            const skeletonContainer = document.getElementById("raSkeletonContainer");
            const roomsContainer = document.getElementById("raRoomsContainer");
            const emptyState = document.getElementById("raEmptyState");
            const roomCards = Array.from(document.querySelectorAll(".customer-ra-room-card"));

            let selectedMinCapacity = 1;

            const pad = (n) => String(n).padStart(2, "0");
            const toInputDate = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;

            const today = new Date();
            today.setHours(0, 0, 0, 0);
            const tomorrow = new Date(today);
            tomorrow.setDate(today.getDate() + 1);

            checkInEl.min = toInputDate(today);
            if (!checkInEl.value) checkInEl.value = toInputDate(today);
            checkOutEl.min = toInputDate(tomorrow);
            if (!checkOutEl.value || new Date(checkOutEl.value + "T00:00:00") <= new Date(checkInEl.value + "T00:00:00")) {
                const baseIn = new Date(checkInEl.value + "T00:00:00");
                const nextD = new Date(baseIn);
                nextD.setDate(baseIn.getDate() + 1);
                checkOutEl.value = toInputDate(nextD);
            }

            checkInEl.addEventListener("change", function () {
                if (!this.value) return;
                const inDate = new Date(this.value + "T00:00:00");
                const minOut = new Date(inDate);
                minOut.setDate(inDate.getDate() + 1);
                checkOutEl.min = toInputDate(minOut);
                if (!checkOutEl.value || new Date(checkOutEl.value + "T00:00:00") <= inDate) {
                    checkOutEl.value = toInputDate(minOut);
                }
            });

            function getStayNights() {
                const inDate = new Date(checkInEl.value + "T00:00:00");
                const outDate = new Date(checkOutEl.value + "T00:00:00");
                const diffTime = outDate - inDate;
                const nights = Math.round(diffTime / (1000 * 60 * 60 * 24));
                return nights > 0 ? nights : 1;
            }

            function formatThaiDate(dateStr) {
                if (!dateStr) return "-";
                const d = new Date(dateStr + "T00:00:00");
                return d.toLocaleDateString("th-TH", { day: "2-digit", month: "short", year: "numeric" });
            }

            function updateUI(withSkeleton = false) {
                const run = () => {
                    const nights = getStayNights();
                    const searchGuests = parseInt(guestsEl.value || "2", 10);
                    const maxPrice = parseInt(maxPriceInput.value || "6500", 10);
                    const sortMode = sortSelect.value;

                    const checkedTypes = Array.from(roomTypeCheckboxes).filter(cb => cb.checked).map(cb => cb.value);
                    const checkedAmenities = Array.from(amenityCheckboxes).filter(cb => cb.checked).map(cb => cb.value);

                    summaryDateRangeEl.textContent = `${formatThaiDate(checkInEl.value)} – ${formatThaiDate(checkOutEl.value)}`;
                    summaryNightsEl.textContent = nights;
                    summaryGuestsEl.textContent = searchGuests;

                    let visibleCount = 0;

                    roomCards.forEach(card => {
                        const roomType = card.dataset.roomType;
                        const price = parseInt(card.dataset.price, 10);
                        const maxGuests = parseInt(card.dataset.maxGuests, 10);
                        const cardAmenities = (card.dataset.amenities || "").split(",").map(a => a.trim());

                        // อัปเดตราคารวม
                        const total = price * nights;
                        const nightsSpan = card.querySelector(".js-nights-count");
                        const totalStrong = card.querySelector(".js-total-price");
                        if (nightsSpan) nightsSpan.textContent = nights;
                        if (totalStrong) totalStrong.textContent = `฿${total.toLocaleString("en-US")}`;

                        // ลิงก์ปุ่ม Book Now ไปหน้า Checkout
                        const bookLink = card.querySelector(".js-book-link");
                        if (bookLink) {
                            const rid = card.dataset.roomId;
                            bookLink.href = `/Customer/Checkout?roomTypeId=${rid}&checkIn=${checkInEl.value}&checkOut=${checkOutEl.value}&guests=${searchGuests}&nights=${nights}`;
                        }

                        // ลิงก์ปุ่ม View Details ย้ายไปหน้า RoomDetails.cshtml พร้อมส่ง Parameter วันที่และจำนวนคน
                                                const detailsLink = card.querySelector(".js-details-link");
                        if (detailsLink) {
                            const rid = card.dataset.roomId;
                            detailsLink.href = `/Customer/RoomDetails/${rid}?checkIn=${checkInEl.value}&checkOut=${checkOutEl.value}&guests=${searchGuests}`;
                        }

                        // ตรวจสอบสถานะโปรโมชั่น
                        const promoBadgesEl = card.querySelector(".js-promo-badges");
                        if (promoBadgesEl) {
                            let pBadges = [];
                            if ((roomType === "Deluxe" || roomType === "Family" || roomType === "Suite") && (searchGuests >= 3 || nights >= 3)) {
                                pBadges.push(`<span class="customer-ra-promo-badge customer-ra-promo-blue"><i class="fa-solid fa-user-plus"></i> 3 Pay 2 Extra Bed Free</span>`);
                            }
                            if ((roomType === "Family" || roomType === "Suite") && searchGuests >= 4) {
                                pBadges.push(`<span class="customer-ra-promo-badge customer-ra-promo-violet"><i class="fa-solid fa-people-group"></i> Family &amp; Gang Pack (-20%)</span>`);
                            }
                            if (nights >= 3) {
                                pBadges.push(`<span class="customer-ra-promo-badge customer-ra-promo-cyan"><i class="fa-solid fa-moon"></i> Stay 3+ Nights Saver (-15%)</span>`);
                            }
                            if (nights >= 7) {
                                pBadges.push(`<span class="customer-ra-promo-badge customer-ra-promo-indigo"><i class="fa-solid fa-laptop-code"></i> Weekly Escape (-25%)</span>`);
                            }

                            if (pBadges.length > 0) {
                                promoBadgesEl.innerHTML = pBadges.join("");
                            } else {
                                promoBadgesEl.innerHTML = `<span class="customer-ra-promo-none">ราคาสมาชิกมาตรฐาน (พัก 3+ คืน เพื่อรับส่วนลดเพิ่ม)</span>`;
                            }
                        }

                        // ตรรกะการกรอง
                        const passType = checkedTypes.includes(roomType);
                        const passPrice = price <= maxPrice;
                        const passCapacity = maxGuests >= Math.max(searchGuests, selectedMinCapacity);
                        const passAmenities = checkedAmenities.every(a => cardAmenities.includes(a));

                        if (passType && passPrice && passCapacity && passAmenities) {
                            card.classList.remove("d-none");
                            visibleCount++;
                        } else {
                            card.classList.add("d-none");
                        }
                    });

                    // ตรรกะการเรียงลำดับ
                    const sorted = [...roomCards].sort((a, b) => {
                        const pa = parseInt(a.dataset.price, 10);
                        const pb = parseInt(b.dataset.price, 10);
                        const ra = parseInt(a.dataset.recommendedRank, 10);
                        const rb = parseInt(b.dataset.recommendedRank, 10);
                        if (sortMode === "price-asc") return pa - pb;
                        if (sortMode === "price-desc") return pb - pa;
                        return ra - rb;
                    });
                    sorted.forEach(c => roomsContainer.appendChild(c));

                    summaryFoundCountEl.textContent = visibleCount;
                    visibleRoomCountEl.textContent = visibleCount;

                    if (visibleCount === 0) {
                        roomsContainer.classList.add("d-none");
                        emptyState.classList.remove("d-none");
                    } else {
                        roomsContainer.classList.remove("d-none");
                        emptyState.classList.add("d-none");
                    }
                };

                if (withSkeleton) {
                    roomsContainer.classList.add("d-none");
                    emptyState.classList.add("d-none");
                    skeletonContainer.classList.remove("d-none");
                    setTimeout(() => {
                        skeletonContainer.classList.add("d-none");
                        run();
                    }, 300);
                } else {
                    run();
                }
            }

            searchForm.addEventListener("submit", function (e) {
                e.preventDefault();
                const sel = roomTypeSelectEl.value;
                roomTypeCheckboxes.forEach(cb => cb.checked = (sel === "ALL" || cb.value === sel));
                updateUI(true);
            });

            roomTypeCheckboxes.forEach(cb => cb.addEventListener("change", () => updateUI(false)));
            maxPriceInput.addEventListener("input", function () {
                priceRangeLabel.textContent = `สูงสุด ฿${parseInt(this.value, 10).toLocaleString("en-US")}`;
                updateUI(false);
            });
            guestPills.forEach(p => p.addEventListener("click", function () {
                guestPills.forEach(x => x.classList.remove("active"));
                this.classList.add("active");
                selectedMinCapacity = parseInt(this.dataset.minCap, 10);
                updateUI(false);
            }));
            amenityCheckboxes.forEach(cb => cb.addEventListener("change", () => updateUI(false)));
            sortSelect.addEventListener("change", () => updateUI(false));

            function resetFilters() {
                roomTypeSelectEl.value = "ALL";
                guestsEl.value = "2";
                roomTypeCheckboxes.forEach(cb => cb.checked = true);
                amenityCheckboxes.forEach(cb => cb.checked = false);
                maxPriceInput.value = "6500";
                priceRangeLabel.textContent = "สูงสุด ฿6,500";
                selectedMinCapacity = 1;
                guestPills.forEach((p, i) => p.classList.toggle("active", i === 0));
                sortSelect.value = "recommended";
                updateUI(true);
            }

            if (btnResetFilters) btnResetFilters.addEventListener("click", resetFilters);
            if (btnEmptyReset) btnEmptyReset.addEventListener("click", resetFilters);

            updateUI(false);
            if (typeof AOS !== "undefined") AOS.init({ duration: 650, once: true });
        });
    </script>
}
