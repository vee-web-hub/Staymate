                                            </div>
                                            <div class="customer-ra-price-box text-md-end">
                                                <small class="customer-ra-price-label">ราคาต่อคืน</small>
                                                <div class="customer-ra-price-night">฿5,800<span>/คืน</span></div>
                                                <div class="customer-ra-price-total">รวม <span class="js-nights-count">1</span> คืน: <strong class="js-total-price">฿5,800</strong></div>
                                            </div>
