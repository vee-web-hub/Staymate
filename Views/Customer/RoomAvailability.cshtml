                        <!-- ROOM 4: SUITE -->
                        <article class="customer-ra-room-card"
                                 data-room-id="4"
                                 data-room-type="Suite"
                                 data-price="5800"
                                 data-max-guests="6"
                                 data-recommended-rank="4"
                                 data-amenities="Wi-Fi,Breakfast,Bathtub,City View">
                            <div class="row g-0">
                                <div class="col-md-5 col-xl-4">
                                    <div class="customer-ra-img-wrap">
                                        <img src="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=900&q=80"
                                             alt="Suite Room" class="customer-ra-img" />
                                        <span class="customer-ra-type-badge customer-ra-badge-gold">ULTIMATE LUXURY</span>
                                        <span class="customer-ra-avail-pill"><span class="customer-ra-dot-green"></span> ว่างพร้อมจอง</span>
