                                <div class="col-md-7 col-xl-8">
                                    <div class="customer-ra-card-body">
                                        <div class="customer-ra-card-top">
                                            <div>
                                                <span class="customer-ra-room-code">ROOM 04 · HORIZON EXECUTIVE SUITE</span>
