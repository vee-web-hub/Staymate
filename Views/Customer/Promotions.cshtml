                    <div class="customer-promo-evoucher-card h-100">
                        <div class="customer-promo-evoucher-left">
                            <span class="customer-promo-evoucher-type">STAYMATE E-VOUCHER</span>
                            <div class="customer-promo-evoucher-amount">฿500</div>
