            <div class="swiper customer-promo-mini-swiper mb-4">
                <div class="swiper-wrapper">
                    @foreach (var item in mockPromotions)
                    {
                        <div class="swiper-slide h-auto">
                            <div class="customer-promo-mini-slide @item.ThemeClass" onclick="openPromoDetailModal(@item.PromoId)">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-dark bg-opacity-50 text-info border border-info border-opacity-25 rounded-pill">@item.PromoCode</span>
                                    <span class="fw-bold text-warning small">@item.DiscountBadge</span>
                                </div>
                                <h5 class="text-white fw-bold mb-1">@item.PromoName</h5>
                                <p class="text-light opacity-75 small mb-0">@item.Tagline</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Filter Bar -->
            <div class="customer-promo-filter-bar" role="tablist" aria-label="กรองหมวดหมู่โปรโมชั่น">
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <span class="customer-promo-filter-label">
                        <i class="fa-solid fa-tags text-primary me-1"></i> หมวดหมู่โปรโมชั่น:
                    </span>
                    <button type="button" class="customer-promo-filter-btn active" data-filter="all">
                        ทั้งหมด (@totalCount)
                    </button>
                    <button type="button" class="customer-promo-filter-btn" data-filter="popular">
                        ดีลยอดนิยม (@popularCount)
                    </button>
                    <button type="button" class="customer-promo-filter-btn" data-filter="group-pack">
                        ครอบครัว &amp; แก๊งเพื่อน (@groupPackCount)
                    </button>
                    <button type="button" class="customer-promo-filter-btn" data-filter="stay-long">
                        พักระยะยาว (@stayLongCount)
                    </button>
                </div>
                <span class="text-muted small d-none d-lg-inline">
                    <i class="fa-solid fa-shield-halved text-success me-1"></i> ตรวจสอบสถานะวันหมดอายุอัตโนมัติ
                </span>
            </div>
        </div>
    </section>

    <!-- =========================================================
         5. PROMOTION CATEGORIES (5 RESPONSIVE CARDS: 3 COLS DESKTOP, 2 TABLET, 1 MOBILE)
         ========================================================= -->
    <section class="customer-promo-grid-section py-4" id="promotionCardsSection">
        <div class="container">
            @if (totalCount == 0)
            {
                <!-- Empty State กรณีไม่มีข้อมูลโปรโมชั่น -->
                <div class="customer-promo-empty-state text-center py-5" data-aos="fade-up">
                    <div class="customer-promo-empty-icon">
                        <i class="fa-solid fa-ticket-simple"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">ขณะนี้ยังไม่มีโปรโมชั่นที่เปิดใช้งาน</h4>
                    <p class="text-muted mb-4">ทีมงาน StayMate กำลังจัดเตรียมแคมเปญส่วนลดใหม่สำหรับสมาชิก โปรดกลับมาตรวจสอบอีกครั้งเร็ว ๆ นี้</p>
                    <a asp-controller="Customer" asp-action="RoomAvailability" class="customer-promo-btn-primary">
                        <i class="fa-solid fa-magnifying-glass me-1"></i> ค้นหาห้องพักราคาสมาชิก
                    </a>
                </div>
            }
            else
            {
                <div class="row g-4" id="customerPromoGrid">
                    @{ var delay = 0; }
                    @foreach (var p in mockPromotions)
                    {
                        var isExpired = now.Date > p.ValidUntil.Date;
                        var isNotStarted = now.Date < p.ValidFrom.Date;
                        var canBook = !isExpired && !isNotStarted;

                        <!-- Desktop: 3 คอลัมน์ (col-xl-4), Tablet: 2 คอลัมน์ (col-md-6), Mobile: 1 คอลัมน์ (col-12) -->
                        <div class="col-12 col-md-6 col-xl-4 customer-promo-card-col"
                             data-category="@p.Category"
                             data-aos="fade-up"
                             data-aos-delay="@delay">

                            <article class="customer-promo-card @p.ThemeClass h-100 @(isExpired ? "is-expired" : "")">
                                <!-- รูปภาพโปรโมชั่น + Discount Badge -->
                                <div class="customer-promo-card-img-wrap">
                                    <img src="@p.ImageUrl" alt="@p.PromoName" class="customer-promo-card-img" loading="lazy" />
                                    <div class="customer-promo-card-img-overlay"></div>

                                    <span class="customer-promo-top-badge">@p.BadgeText</span>
                                    <span class="customer-promo-discount-badge">@p.DiscountBadge</span>

                                    <!-- Countdown Timer Bar -->
                                    <div class="customer-promo-countdown-pill" data-end="@p.ValidUntil.ToString("yyyy-MM-dd")T23:59:59">
                                        <i class="fa-regular fa-clock me-1"></i>
                                        <span class="countdown-text">กำลังคำนวณเวลา...</span>
                                    </div>
                                </div>

                                <!-- เนื้อหาการ์ด -->
                                <div class="customer-promo-card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="customer-promo-code-chip">
                                            CODE: <strong>@p.PromoCode</strong>
                                            <button type="button" class="customer-promo-copy-btn" data-code="@p.PromoCode" title="คัดลอกโค้ด">
                                                <i class="fa-regular fa-copy"></i>
                                            </button>
                                        </span>
                                        <span class="customer-promo-room-tag">
                                            <i class="fa-solid fa-bed me-1"></i> @p.ApplicableRoomName
                                        </span>
                                    </div>

                                    <h3 class="customer-promo-card-title">@p.PromoName</h3>
                                    <p class="customer-promo-card-tagline">@p.Tagline</p>
                                    <p class="customer-promo-card-desc">@p.Description</p>

                                    <!-- สิทธิประโยชน์ที่ได้รับ -->
                                    <div class="customer-promo-benefits-box">
                                        <strong class="d-block small mb-1 text-white">
                                            <i class="fa-solid fa-gift text-info me-1"></i> สิทธิประโยชน์ที่ได้รับ:
                                        </strong>
                                        <ul class="customer-promo-benefits-list">
                                            @foreach (var b in p.Benefits)
                                            {
                                                <li><i class="fa-solid fa-check text-info"></i> <span>@b</span></li>
                                            }
                                        </ul>
                                    </div>

                                    <!-- เงื่อนไขและระยะเวลา Valid From / Valid Until -->
                                    <div class="customer-promo-meta-box">
                                        <div>
                                            <i class="fa-regular fa-calendar-days text-info me-1"></i>
                                            <strong>Valid:</strong> @p.ValidFrom.ToString("dd MMM yyyy") – @p.ValidUntil.ToString("dd MMM yyyy")
                                        </div>
                                        <div>
                                            <i class="fa-solid fa-circle-exclamation text-warning me-1"></i>
                                            <strong>เงื่อนไข:</strong> @p.Conditions
                                        </div>
                                    </div>

                                    <!-- ปุ่ม View Details & Book Now -->
                                    <div class="customer-promo-card-footer">
                                        <button type="button"
                                                class="customer-promo-btn-detail"
                                                onclick="openPromoDetailModal(@p.PromoId)">
                                            <i class="fa-regular fa-file-lines"></i>
                                            <span>View Details</span>
                                        </button>

                                        @if (canBook)
                                        {
                                            <a asp-controller="Customer"
                                               asp-action="Checkout"
                                               asp-route-promoId="@p.PromoId"
                                               asp-route-promoCode="@p.PromoCode"
                                               asp-route-roomTypeId="@(p.ApplicableRoomId ?? 2)"
                                               class="customer-promo-btn-book">
                                                <span>Book Now</span>
                                                <i class="fa-solid fa-arrow-right"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button" class="customer-promo-btn-disabled" disabled>
                                                <i class="fa-solid fa-ban me-1"></i> โปรโมชั่นหมดอายุ
                                            </button>
                                        }
                                    </div>
                                </div>
                            </article>
                        </div>
                        delay += 70;
                    }
                </div>
            }
        </div>
    </section>

    <!-- =========================================================
         7. E-VOUCHER & FESTIVAL PASS SECTION
         ========================================================= -->
