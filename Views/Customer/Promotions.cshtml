        <div class="container">
            <div class="text-center mb-4" data-aos="fade-up">
                <span class="customer-promo-eyebrow">
                    <i class="fa-solid fa-ticket me-1"></i> DIGITAL VOUCHER &amp; EXCLUSIVE PASS
                </span>
                <h2 class="customer-promo-sec-title">E-Voucher &amp; Digital Festival Pass</h2>
