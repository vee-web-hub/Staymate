    <link rel="stylesheet" href="~/css/Customer.css" asp-append-version="true" />
}

<div class="customer-promo-wrapper">

    <!-- =========================================================
         3. PAGE HEADER / HERO SECTION
         ========================================================= -->
    <section class="customer-promo-hero" id="promoHero">
        <div class="customer-promo-hero-bg" id="promoHeroBg"
             style="background-image: url('https://images.unsplash.com/photo-1540518614846-7ede433c4576?auto=format&fit=crop&w=2000&q=85');">
        </div>
        <div class="customer-promo-hero-overlay"></div>
        <div class="customer-promo-orb customer-promo-orb-cyan"></div>
        <div class="customer-promo-orb customer-promo-orb-violet"></div>

        <div class="container position-relative z-2 py-4">
            <!-- Breadcrumb: Home / Promotions -->
            <nav aria-label="breadcrumb" class="customer-promo-breadcrumb mb-3 gsap-promo-hero">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a asp-controller="Customer" asp-action="Index">
                            <i class="fa-solid fa-house me-1"></i> Home
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Promotions</li>
                </ol>
            </nav>

            <div class="row align-items-end g-4">
                <div class="col-lg-8">
                    <div class="customer-promo-hero-badge gsap-promo-hero">
                        <span class="customer-promo-pulse"></span>
                        <span>STAYMATE MEMBER PRIVILEGE · EXCLUSIVE CAMPAIGNS</span>
                    </div>

                    <h1 class="customer-promo-hero-title gsap-promo-hero">
                        Exclusive Promotions<br />
                        <span class="customer-promo-text-gradient">ดีลสุดพิเศษเพื่อการพักผ่อนเหนือระดับ</span>
                    </h1>

                    <p class="customer-promo-hero-subtitle gsap-promo-hero">
                        Discover exclusive deals and make every stay more rewarding.
                        รับสิทธิ์โปรโมชั่นสุดคุ้มจาก StayMate Hotel ที่คัดสรรมาเพื่อสมาชิกโดยเฉพาะ ทั้งดีลมา 3 จ่าย 2 แพ็กเกจครอบครัว พักระยะยาว และบัตรผ่านเทศกาลสุดพิเศษ
                    </p>
                </div>

                <!-- Discount Counter Stats -->
                <div class="col-lg-4">
                    <div class="customer-promo-counter-card gsap-promo-hero">
                        <div class="customer-promo-counter-item">
                            <span class="customer-promo-counter-num"><span class="js-counter" data-target="33">0</span>%</span>
                            <small>ประหยัดสูงสุด (Stay 3 Pay 2)</small>
                        </div>
                        <div class="customer-promo-counter-divider"></div>
                        <div class="customer-promo-counter-item">
                            <span class="customer-promo-counter-num"><span class="js-counter" data-target="5">0</span></span>
                            <small>แคมเปญพิเศษที่เปิดใช้งาน</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

