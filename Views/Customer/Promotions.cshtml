@model List<StayMate_Kavinvee_0576.Models.Promotion>
@using System.Text.Json
@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "โปรโมชั่นพิเศษสำหรับสมาชิก";

    var now = DateTime.Now;

    // ฟังก์ชันช่วยจัดรูปแบบหัวข้อ/แท็กแกลเลอรีตามประเภทส่วนลด
    string GetPromoBadgeText(string discountType, decimal? discountVal)
    {
        return discountType.ToLower() switch
        {
            "free_extra_bed" => "HOT DEAL · FREE EXTRA BED",
            "percent_room" => $"MEMBER DISCOUNT · SAVE {discountVal:0.##}%",
            "percent_extra_nights" => $"LONG STAY SAVER · EXTRA NIGHTS",
            _ => "SPECIAL OFFERS · CAMPAIGNS"
        };
    }

    string GetPromoDiscountBadge(string discountType, decimal? discountVal)
    {
        return discountType.ToLower() switch
        {
            "free_extra_bed" => "FREE BED",
            "percent_room" => $"-{discountVal:0.##}% ROOM",
            "percent_extra_nights" => $"SAVE {discountVal:0.##}%",
            _ => "SPECIAL DEAL"
        };
    }

    // ฟังก์ชันกำหนดคลาสสี (Theme) และรูปภาพตามรหัสหรือไอดีห้องพักเพื่อรักษาดีไซน์เดิม
    (string ThemeClass, string ImageUrl, string Tagline) GetPromoDesign(string? promoCode, byte? roomTypeId, string? roomName)
    {
        var code = (promoCode ?? "").ToUpper();
        if (code.Contains("STAY3PAY2") || roomTypeId == 2)
        {
            return ("cp-theme-blue", 
                    "https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=1000&q=80",
                    $"มา 3 จ่าย 2 · พัก {roomName ?? "Deluxe Room"} 3 ท่าน จ่ายเพียง 2 คืน");
        }
        if (code.Contains("FAMGANG") || roomTypeId == 3)
        {
            return ("cp-theme-violet", 
                    "https://images.unsplash.com/photo-1566665797739-1674de7a421a?auto=format&fit=crop&w=1000&q=80",
                    "คุ้มค่าสูงสุดสำหรับครอบครัวและแก๊งเพื่อน พักสบายยกแก๊ง");
        }
        if (code.Contains("STAY3PLUS") || code.Contains("SAVER"))
        {
            return ("cp-theme-cyan", 
                    "https://images.unsplash.com/photo-1631049307264-da0ec9d70304?auto=format&fit=crop&w=1000&q=80",
                    "เข้าพักตั้งแต่ 3 คืนขึ้นไป ยิ่งพักนานยิ่งประหยัด");
        }
        if (code.Contains("WEEK") || code.Contains("LONG"))
        {
            return ("cp-theme-blue-violet", 
                    "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=1000&q=80",
                    "เปลี่ยนบรรยากาศมาพักผ่อนหรือ Workation รับส่วนลดพักระยะยาว");
        }
        return ("cp-theme-violet-blue", 
                "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=1000&q=80",
                "ฉลองเทศกาลและวันหยุดยาวอย่างเหนือระดับกับดีลพิเศษ");
    }

    // ฟังก์ชันจัดกลุ่มหมวดหมู่สำหรับตัวกรอง JS
    string GetFilterCategory(string discountType, ushort? minNights, byte? minGuests)
    {
        var cats = new List<string> { "popular" };
        if (discountType == "percent_extra_nights" || (minNights.HasValue && minNights.Value >= 3))
        {
            cats.Add("stay-long");
        }
        if (discountType == "free_extra_bed" || (minGuests.HasValue && minGuests.Value >= 3))
        {
            cats.Add("group-pack");
        }
        return string.Join(" ", cats);
    }

    // แปลงข้อมูล Database โปรโมชั่นเป็นรายการออบเจกต์จำลองสำหรับใช้ในสไลเดอร์และโมดอล
    var promoItemList = Model.Select(p => {
        var roomName = p.ApplicableRoomType != null ? p.ApplicableRoomType.TypeName : "ทุกประเภทห้องพัก";
        var design = GetPromoDesign(p.PromoCode, p.ApplicableRoomTypeId, roomName);
        var filterCats = GetFilterCategory(p.DiscountType, p.MinNights, p.MinGuests);
        
        // สรรค์สร้างสิทธิประโยชน์จากคอลัมน์ระบบฐานข้อมูล
        var benefitsList = new List<string>();
        if (p.DiscountType == "free_extra_bed") {
            benefitsList.Add("ฟรี! เตียงเสริมพิเศษสำหรับผู้เข้าพักเสริมตลอดการเข้าพัก");
        } else if (p.DiscountType == "percent_room") {
            benefitsList.Add($"รับส่วนลดค่าห้องพักทันที {p.DiscountPercent:0.##}% จากราคามาตรฐาน");
        } else if (p.DiscountType == "percent_extra_nights") {
            benefitsList.Add($"พักครบ {p.MinNights} คืนแรก รับส่วนลดเพิ่มทันที {p.DiscountPercent:0.##}% สำหรับคืนถัดไป");
        }
        
        if (p.VoucherMinValue.HasValue && p.VoucherMaxValue.HasValue) {
            benefitsList.Add($"ฟรี! สิทธิ์จับคู่รับคูปองเงินสด E-Voucher สูงสุด ฿{p.VoucherMaxValue:N0}");
        } else {
            benefitsList.Add("ฟรี! บุฟเฟต์อาหารเช้าและสิทธิ์เข้าใช้สระว่ายน้ำส่วนกลาง");
        }
        benefitsList.Add("ฟรี! สิทธิ์การเชื่อมต่อ Wi-Fi ความเร็วสูงภายในพื้นที่ห้องพัก");

        return new {
            PromoId = (int)p.PromotionId,
            PromoCode = p.PromoCode,
            PromoName = p.PromoName,
            Tagline = design.Tagline,
            Category = filterCats,
            BadgeText = GetPromoBadgeText(p.DiscountType, p.DiscountPercent),
            DiscountBadge = GetPromoDiscountBadge(p.DiscountType, p.DiscountPercent),
            ThemeClass = design.ThemeClass,
            ImageUrl = design.ImageUrl,
            Description = string.IsNullOrWhiteSpace(p.Description) ? "โปรโมชั่นพิเศษที่คัดสรรมาเพื่อยกระดับทริปเดินทางและพักผ่อนของท่านผ่านบริการระดับพรีเมียม" : p.Description,
            ValidFromStr = p.ValidFrom.HasValue ? p.ValidFrom.Value.ToString("yyyy-MM-dd") : "2026-01-01",
            ValidUntilStr = p.ValidTo.HasValue
    ? p.ValidTo.Value.ToString("yyyy-MM-dd")
    : "2026-12-31",

ValidUntilStrT235959 = p.ValidTo.HasValue
    ? p.ValidTo.Value.ToString("yyyy-MM-dd") + "T23:59:59"
    : "2026-12-31T23:59:59",
            ApplicableRoomId = p.ApplicableRoomTypeId ?? 2,
            ApplicableRoomName = roomName,
            RequiredGuests = p.MinGuests.HasValue && p.MinGuests > 0 ? $"ผู้เข้าพักตั้งแต่ {p.MinGuests} ท่านขึ้นไป" : "ตามความจุสูงสุดของประเภทห้องพัก",
            MinNights = p.MinNights ?? 1,
            Conditions = $"เข้าพักขั้นต่ำ {(p.MinNights ?? 1)} คืน และเป็นสมาชิก StayMate ในระบบขณะทำการสำรองห้องพัก",
            Benefits = benefitsList.ToArray(),
            HowToUse = $"ระบุรหัสคูปอง {p.PromoCode} หรือกดปุ่ม Book Now เพื่อระบบดำเนินการผูกสิทธิ์เข้าหน้าจองและชำระเงินโดยอัตโนมัติ"
        };
    }).ToList();

    int totalCount = promoItemList.Count;
    int popularCount = promoItemList.Count(p => p.Category.Contains("popular"));
    int stayLongCount = promoItemList.Count(p => p.Category.Contains("stay-long"));
    int groupPackCount = promoItemList.Count(p => p.Category.Contains("group-pack"));

    // หาโปรโมชั่นไฮไลท์รายการแรกเพื่อแสดงใน Banner เด่น (หรือหาตามเงื่อนไขที่ต้องการ)
    var featuredPromo = promoItemList.FirstOrDefault() ?? (promoItemList.Any() ? promoItemList[0] : null);
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/css/Customer.css" asp-append-version="true" />
}

<div class="customer-promo-wrapper">

    <!-- =========================================================
         3. PAGE HEADER / HERO SECTION
         ========================================================= -->
    <section class="customer-promo-hero" id="promoHero">
        <div class="customer-promo-hero-bg" id="promoHeroBg"
             style="background-image: url('https://images.unsplash.com/photo-1540518614846-7ede433c4576?auto=format&fit=crop&w=2000&q=85');">
        </div>
        <div class="customer-promo-hero-overlay"></div>
        <div class="customer-promo-orb customer-promo-orb-cyan"></div>
        <div class="customer-promo-orb customer-promo-orb-violet"></div>

        <div class="container position-relative z-2 py-4">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="customer-promo-breadcrumb mb-3 gsap-promo-hero">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a asp-controller="Customer" asp-action="Index">
                            <i class="fa-solid fa-house me-1"></i> Home
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Promotions</li>
                </ol>
            </nav>

            <div class="row align-items-end g-4">
                <div class="col-lg-8">
                    <div class="customer-promo-hero-badge gsap-promo-hero">
                        <span class="customer-promo-pulse"></span>
                        <span>STAYMATE MEMBER PRIVILEGE · EXCLUSIVE CAMPAIGNS</span>
                    </div>

                    <h1 class="customer-promo-hero-title gsap-promo-hero">
                        Exclusive Promotions<br />
                        <span class="customer-promo-text-gradient">ดีลสุดพิเศษเพื่อการพักผ่อนเหนือระดับ</span>
                    </h1>

                    <p class="customer-promo-hero-subtitle gsap-promo-hero">
                        Discover exclusive deals and make every stay more rewarding.
                        รับสิทธิ์โปรโมชั่นสุดคุ้มจาก StayMate Hotel ที่คัดสรรมาเพื่อสมาชิกโดยเฉพาะผ่านระบบฐานข้อมูลจริง ทั้งแคมเปญพักผ่อนครอบครัว พักระยะยาว และสิทธิประโยชน์อื่น ๆ อีกมากมาย
                    </p>
                </div>

                <!-- Discount Counter Stats -->
                <div class="col-lg-4">
                    <div class="customer-promo-counter-card gsap-promo-hero">
                        <div class="customer-promo-counter-item">
                            <span class="customer-promo-counter-num"><span class="js-counter" data-target="33">0</span>%</span>
                            <small>ประหยัดสูงสุดสำหรับทริป</small>
                        </div>
                        <div class="customer-promo-counter-divider"></div>
                        <div class="customer-promo-counter-item">
                            <span class="customer-promo-counter-num"><span class="js-counter" data-target="@totalCount">0</span></span>
                            <small>แคมเปญพิเศษที่เปิดใช้งาน</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @if (featuredPromo != null)
    {
        <!-- =========================================================
             4. FEATURED PROMOTION BANNER (ดึงข้อมูลแรกใน DB มาเป็นไฮไลท์เด่น)
             ========================================================= -->
        <section class="customer-promo-featured-section" data-aos="fade-up">
            <div class="container">
                <div class="customer-promo-featured-banner">
                    <div class="row g-0 align-items-stretch">
                        <div class="col-lg-6">
                            <div class="customer-promo-featured-img-wrap">
                                <img src="@featuredPromo.ImageUrl" alt="@featuredPromo.PromoName" class="customer-promo-featured-img" />
                                <span class="customer-promo-featured-float-tag">
                                    <i class="fa-solid fa-crown text-warning me-1"></i> HIGHLIGHT CAMPAIGN OF THE MONTH
                                </span>
                                <div class="customer-promo-featured-discount-pill">
                                    <span>STAYMATE</span>
                                    <strong>@featuredPromo.DiscountBadge</strong>
                                    <small>MEMBERS ONLY</small>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="customer-promo-featured-body">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                                    <span class="customer-promo-badge-cyan">
                                        <i class="fa-solid fa-bolt me-1"></i> FEATURED PROMOTION · CODE: @featuredPromo.PromoCode
                                    </span>
                                    <span class="customer-promo-date-pill">
                                        <i class="fa-regular fa-calendar-check me-1"></i> @DateOnly.Parse(featuredPromo.ValidFromStr).ToString("dd MMM yyyy") – @DateOnly.Parse(featuredPromo.ValidUntilStr).ToString("dd MMM yyyy")
                                    </span>
                                </div>

                                <h2 class="customer-promo-featured-title">@featuredPromo.PromoName</h2>
                                <p class="customer-promo-featured-desc">@featuredPromo.Description</p>

                                <div class="customer-promo-featured-perks">
                                    <div class="customer-promo-perk-chip">
                                        <i class="fa-solid fa-bed text-info"></i>
                                        <span>เฉพาะห้อง @featuredPromo.ApplicableRoomName</span>
                                    </div>
                                    <div class="customer-promo-perk-chip">
                                        <i class="fa-solid fa-user-group text-info"></i>
                                        <span>@featuredPromo.RequiredGuests</span>
                                    </div>
                                    <div class="customer-promo-perk-chip">
                                        <i class="fa-solid fa-percent text-info"></i>
                                        <span>@featuredPromo.DiscountBadge</span>
                                    </div>
                                </div>

                                <div class="customer-promo-featured-footer">
                                    <div class="d-flex flex-wrap gap-3 align-items-center">
                                        <a asp-controller="Customer" asp-action="Checkout"
                                           asp-route-promoId="@featuredPromo.PromoId" asp-route-promoCode="@featuredPromo.PromoCode"
                                           asp-route-roomTypeId="@featuredPromo.ApplicableRoomId" asp-route-guests="2"
                                           class="customer-promo-btn-cyan">
                                            <i class="fa-solid fa-calendar-check"></i>
                                            <span>Book Now · จองโปรโมชั่นนี้</span>
                                        </a>
                                        <button type="button" class="customer-promo-btn-glass" onclick="openPromoDetailModal(@featuredPromo.PromoId)">
                                            <i class="fa-solid fa-circle-info text-info"></i>
                                            <span>ดูเงื่อนไขโดยละเอียด</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }

    <!-- =========================================================
         SWIPER QUICK CAROUSEL & CATEGORY FILTER BAR
         ========================================================= -->
    <section class="customer-promo-carousel-section pt-4" data-aos="fade-up">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-3">
                <div>
                    <span class="customer-promo-eyebrow"><i class="fa-solid fa-wand-magic-sparkles me-1"></i> QUICK HIGHLIGHTS SLIDER</span>
                    <h3 class="customer-promo-sec-title mb-0">สรุปสิทธิพิเศษแคมเปญทั้งหมด (เลื่อนชมด่วน)</h3>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="customer-promo-swiper-nav promo-swiper-prev" aria-label="ก่อนหน้า">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <button type="button" class="customer-promo-swiper-nav promo-swiper-next" aria-label="ถัดไป">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>
            </div>

            <!-- Swiper Carousel -->
            <div class="swiper customer-promo-mini-swiper mb-4">
                <div class="swiper-wrapper">
                    @foreach (var item in promoItemList)
                    {
                        <div class="swiper-slide h-auto">
                            <div class="customer-promo-mini-slide @item.ThemeClass" onclick="openPromoDetailModal(@item.PromoId)">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-dark bg-opacity-50 text-info border border-info border-opacity-25 rounded-pill">@item.PromoCode</span>
                                    <span class="fw-bold text-warning small">@item.DiscountBadge</span>
                                </div>
                                <h5 class="text-white fw-bold mb-1">@item.PromoName</h5>
                                <p class="text-light opacity-75 small mb-0">@item.Tagline</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Filter Bar -->
            <div class="customer-promo-filter-bar" role="tablist" aria-label="กรองหมวดหมู่โปรโมชั่น">
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <span class="customer-promo-filter-label">
                        <i class="fa-solid fa-tags text-primary me-1"></i> หมวดหมู่โปรโมชั่น:
                    </span>
                    <button type="button" class="customer-promo-filter-btn active" data-filter="all">
                        ทั้งหมด (@totalCount)
                    </button>
                    <button type="button" class="customer-promo-filter-btn" data-filter="popular">
                        ดีลยอดนิยม (@popularCount)
                    </button>
                    <button type="button" class="customer-promo-filter-btn" data-filter="group-pack">
                        ครอบครัว &amp; แก๊งเพื่อน (@groupPackCount)
                    </button>
                    <button type="button" class="customer-promo-filter-btn" data-filter="stay-long">
                        พักระยะยาว (@stayLongCount)
                    </button>
                </div>
                <span class="text-muted small d-none d-lg-inline">
                    <i class="fa-solid fa-shield-halved text-success me-1"></i> ตรวจสอบสถานะวันหมดอายุอัตโนมัติ
                </span>
            </div>
        </div>
    </section>

    <!-- =========================================================
         5. PROMOTION GRID CARDS
         ========================================================= -->
    <section class="customer-promo-grid-section py-4" id="promotionCardsSection">
        <div class="container">
            @if (totalCount == 0)
            {
                <div class="customer-promo-empty-state text-center py-5" data-aos="fade-up">
                    <div class="customer-promo-empty-icon">
                        <i class="fa-solid fa-ticket-simple"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">ขณะนี้ยังไม่มีโปรโมชั่นที่เปิดใช้งาน</h4>
                    <p class="text-muted mb-4">ทีมงาน StayMate กำลังจัดเตรียมแคมเปญส่วนลดใหม่สำหรับสมาชิก โปรดกลับมาตรวจสอบอีกครั้งเร็ว ๆ นี้</p>
                    <a asp-controller="Customer" asp-action="RoomAvailability" class="customer-promo-btn-primary">
                        <i class="fa-solid fa-magnifying-glass me-1"></i> ค้นหาห้องพักราคาสมาชิก
                    </a>
                </div>
            }
            else
            {
                <div class="row g-4" id="customerPromoGrid">
                    @{ var delay = 0; }
                    @foreach (var p in promoItemList)
                    {
                        var expDate = DateTime.Parse(p.ValidUntilStr);
                        var startDate = DateTime.Parse(p.ValidFromStr);
                        var isExpired = now.Date > expDate.Date;
                        var isNotStarted = now.Date < startDate.Date;
                        var canBook = !isExpired && !isNotStarted;

                        <div class="col-12 col-md-6 col-xl-4 customer-promo-card-col"
                             data-category="@p.Category"
                             data-aos="fade-up"
                             data-aos-delay="@delay">

                            <article class="customer-promo-card @p.ThemeClass h-100 @(isExpired ? "is-expired" : "")">
                                <div class="customer-promo-card-img-wrap">
                                    <img src="@p.ImageUrl" alt="@p.PromoName" class="customer-promo-card-img" loading="lazy" />
                                    <div class="customer-promo-card-img-overlay"></div>

                                    <span class="customer-promo-top-badge">@p.BadgeText</span>
                                    <span class="customer-promo-discount-badge">@p.DiscountBadge</span>

                                    <!-- Countdown Timer Bar -->
                                    <div class="customer-promo-countdown-pill" data-end="@p.ValidUntilStrT235959">
                                        <i class="fa-regular fa-clock me-1"></i>
                                        <span class="countdown-text">กำลังคำนวณเวลา...</span>
                                    </div>
                                </div>

                                <div class="customer-promo-card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="customer-promo-code-chip">
                                            CODE: <strong>@p.PromoCode</strong>
                                            <button type="button" class="customer-promo-copy-btn" data-code="@p.PromoCode" title="คัดลอกโค้ด">
                                                <i class="fa-regular fa-copy"></i>
