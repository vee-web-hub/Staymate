    <!-- =========================================================
         6. PROMOTION DETAIL MODAL (แสดงรายละเอียดครบทุกหัวข้อ)
         ========================================================= -->
    <div class="modal fade customer-promo-modal" id="promoDetailModal" tabindex="-1" aria-labelledby="promoModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content customer-promo-modal-content">
                <div class="modal-header customer-promo-modal-header">
                    <div>
                        <span class="customer-promo-badge-cyan mb-1 d-inline-block" id="mPromoCodeBadge">PROMO CODE</span>
                        <h4 class="modal-title fw-bold text-white mb-0" id="promoModalTitle">ชื่อโปรโมชั่น</h4>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <!-- ภาพโปรโมชั่น + ป้ายส่วนลด -->
                    <div class="customer-promo-modal-img-wrap mb-4">
                        <img id="mPromoImage" src="" alt="Promotion Preview" />
                        <span class="customer-promo-modal-discount" id="mPromoDiscount">SAVE</span>
                    </div>

                    <!-- รายละเอียด -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-dark"><i class="fa-solid fa-circle-info text-primary me-2"></i>รายละเอียดโปรโมชั่น</h6>
                        <p id="mPromoDesc" class="text-secondary mb-0 lh-lg"></p>
                    </div>

                    <!-- ตารางข้อมูลสำคัญ: ระยะเวลา, ห้องที่รองรับ, จำนวนผู้เข้าพัก -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="customer-promo-modal-info-box">
                                <small><i class="fa-regular fa-calendar-check text-primary me-1"></i> ระยะเวลาโปรโมชั่น</small>
                                <strong id="mPromoPeriod">-</strong>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="customer-promo-modal-info-box">
                                <small><i class="fa-solid fa-bed text-primary me-1"></i> ประเภทห้องที่รองรับ</small>
                                <strong id="mPromoRooms">-</strong>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="customer-promo-modal-info-box">
                                <small><i class="fa-solid fa-user-group text-primary me-1"></i> จำนวนผู้เข้าพักที่กำหนด</small>
                                <strong id="mPromoGuests">-</strong>
                            </div>
                        </div>
                    </div>

                    <!-- ส่วนลดและสิทธิพิเศษ -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-dark"><i class="fa-solid fa-gift text-primary me-2"></i>ส่วนลดและสิทธิพิเศษที่ได้รับ</h6>
                        <ul class="customer-promo-modal-list" id="mPromoBenefits"></ul>
                    </div>

                    <!-- เงื่อนไขการใช้สิทธิ์ & วิธีการใช้โปรโมชั่น -->
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 rounded-4 bg-light border h-100">
                                <h6 class="fw-bold text-dark small mb-2">
                                    <i class="fa-solid fa-file-shield text-warning me-1"></i> เงื่อนไขการใช้สิทธิ์
                                </h6>
                                <p id="mPromoConditions" class="text-secondary small mb-0"></p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded-4 bg-light border h-100">
                                <h6 class="fw-bold text-dark small mb-2">
                                    <i class="fa-solid fa-wand-magic-sparkles text-info me-1"></i> วิธีการใช้โปรโมชั่น
                                </h6>
                                <p id="mPromoHowTo" class="text-secondary small mb-0"></p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light border-top d-flex justify-content-between align-items-center">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">ปิดหน้าต่าง</button>
                    <a href="#" id="mPromoBookBtn" class="customer-promo-btn-book px-4 py-2">
                        <i class="fa-solid fa-calendar-check me-1"></i>
                        <span>Book Now · ใช้โปรโมชั่นนี้จองห้องพัก</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>

    <script>
        // ข้อมูลโปรโมชั่นสำหรับแสดงใน Modal (Serialize อย่างปลอดภัย)
        const promoCatalog = @Html.Raw(Json.Serialize(mockPromotions.Select(p => new {
            id = p.PromoId,
            code = p.PromoCode,
            name = p.PromoName,
            discount = p.DiscountBadge,
            image = p.ImageUrl,
            desc = p.Description,
            period = $"{p.ValidFrom:dd MMM yyyy} – {p.ValidUntil:dd MMM yyyy}",
            rooms = p.ApplicableRoomName,
            roomId = p.ApplicableRoomId ?? 2,
            guests = p.RequiredGuests,
            conditions = p.Conditions,
            benefits = p.Benefits,
            howTo = p.HowToUse
        })));

        function openPromoDetailModal(promoId) {
            const item = promoCatalog.find(x => x.id === promoId);
            if (!item) return;

            document.getElementById("mPromoCodeBadge").textContent = `PROMO CODE: ${item.code}`;
            document.getElementById("promoModalTitle").textContent = item.name;
            document.getElementById("mPromoImage").src = item.image;
            document.getElementById("mPromoDiscount").textContent = item.discount;
            document.getElementById("mPromoDesc").textContent = item.desc;
            document.getElementById("mPromoPeriod").textContent = item.period;
            document.getElementById("mPromoRooms").textContent = item.rooms;
            document.getElementById("mPromoGuests").textContent = item.guests;
            document.getElementById("mPromoConditions").textContent = item.conditions;
            document.getElementById("mPromoHowTo").textContent = item.howTo;

            const benefitsUl = document.getElementById("mPromoBenefits");
            benefitsUl.innerHTML = item.benefits.map(b =>
                `<li><i class="fa-solid fa-circle-check text-success me-2"></i><span>${b}</span></li>`
            ).join("");

            const bookBtn = document.getElementById("mPromoBookBtn");
            bookBtn.href = `/Customer/Checkout?promoId=${item.id}&promoCode=${encodeURIComponent(item.code)}&roomTypeId=${item.roomId}`;

            const modalEl = document.getElementById("promoDetailModal");
            if (modalEl && typeof bootstrap !== "undefined") {
                bootstrap.Modal.getOrCreateInstance(modalEl).show();
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

            // 1. AOS Scroll Reveal
            if (typeof AOS !== "undefined") {
                AOS.init({
                    duration: 700,
                    once: true,
                    offset: 60,
                    disable: prefersReducedMotion
                });
            }

            // 2. GSAP Hero Zoom & Text Fade-in
            if (typeof gsap !== "undefined" && !prefersReducedMotion) {
                gsap.fromTo("#promoHeroBg", { scale: 1.14 }, { scale: 1, duration: 2.5, ease: "power2.out" });
                gsap.fromTo(".gsap-promo-hero",
                    { opacity: 0, y: 24 },
                    { opacity: 1, y: 0, duration: 0.8, stagger: 0.12, ease: "power3.out" }
                );
            }

            // 3. Discount Counter Animation
            document.querySelectorAll(".js-counter").forEach(counter => {
                const target = parseInt(counter.dataset.target || "0", 10);
                if (prefersReducedMotion) {
                    counter.textContent = target;
                    return;
                }
                let current = 0;
                const step = Math.max(1, Math.ceil(target / 24));
                const timer = setInterval(() => {
                    current += step;
                    if (current >= target) {
                        counter.textContent = target;
                        clearInterval(timer);
                    } else {
                        counter.textContent = current;
                    }
                }, 35);
            });

            // 4. Swiper Promotion Carousel
            if (typeof Swiper !== "undefined") {
                new Swiper(".customer-promo-mini-swiper", {
                    slidesPerView: 1.15,
                    spaceBetween: 16,
                    grabCursor: true,
                    speed: prefersReducedMotion ? 0 : 600,
                    navigation: {
                        nextEl: ".promo-swiper-next",
                        prevEl: ".promo-swiper-prev"
                    },
                    breakpoints: {
                        576: { slidesPerView: 2, spaceBetween: 18 },
                        992: { slidesPerView: 3, spaceBetween: 20 },
                        1200: { slidesPerView: 4, spaceBetween: 22 }
                    }
                });
            }

            // 5. Category Filtering
            const filterBtns = document.querySelectorAll(".customer-promo-filter-btn");
            const promoCols = document.querySelectorAll(".customer-promo-card-col");

            filterBtns.forEach(btn => {
                btn.addEventListener("click", function () {
                    filterBtns.forEach(b => b.classList.remove("active"));
                    this.classList.add("active");
                    const filterVal = this.dataset.filter;

                    promoCols.forEach(col => {
                        const cats = (col.dataset.category || "").split(" ");
                        const show = (filterVal === "all" || cats.includes(filterVal));
                        col.classList.toggle("d-none", !show);
                    });
                });
            });

            // 6. Real-time Countdown Timer
            const pad = n => String(n).padStart(2, "0");
            document.querySelectorAll(".customer-promo-countdown-pill[data-end]").forEach(pill => {
                const endTime = new Date(pill.dataset.end).getTime();
                const textSpan = pill.querySelector(".countdown-text");

                function updateClock() {
                    const diff = endTime - Date.now();
                    if (diff <= 0) {
                        textSpan.textContent = "โปรโมชั่นสิ้นสุดแล้ว";
                        return false;
                    }
                    const d = Math.floor(diff / 86400000);
                    const h = Math.floor((diff % 86400000) / 3600000);
                    const m = Math.floor((diff % 3600000) / 60000);
                    const s = Math.floor((diff % 60000) / 1000);
                    textSpan.textContent = `เหลือเวลา ${d} วัน ${pad(h)}:${pad(m)}:${pad(s)}`;
                    return true;
                }

                if (updateClock()) {
                    const timerId = setInterval(() => {
                        if (!updateClock()) clearInterval(timerId);
                    }, 1000);
                }
            });

            // 7. Copy Promo Code & E-Voucher Code
            document.querySelectorAll(".customer-promo-copy-btn, .js-copy-voucher").forEach(btn => {
                btn.addEventListener("click", function () {
                    const code = this.dataset.code;
                    if (!code) return;
                    navigator.clipboard.writeText(code).then(() => {
                        const originalHtml = this.innerHTML;
                        this.innerHTML = `<i class="fa-solid fa-check text-success"></i>`;
                        setTimeout(() => {
                            this.innerHTML = originalHtml;
                        }, 1800);
                    });
                });
            });
        });
    </script>
}
