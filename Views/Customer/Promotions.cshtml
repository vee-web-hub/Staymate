                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light border-top d-flex justify-content-between align-items-center">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">ปิดหน้าต่าง</button>
                    <a href="#" id="mPromoBookBtn" class="customer-promo-btn-book px-4 py-2">
                        <i class="fa-solid fa-calendar-check me-1"></i>
                        <span>Book Now</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>

    <script>
        // ข้อมูลโปรโมชั่นจากฐานข้อมูล
        const promoCatalog = @Html.Raw(JsonSerializer.Serialize(promoItemList));

        function openPromoDetailModal(promoId) {
            const item = promoCatalog.find(x => x.PromoId === promoId);
            if (!item) return;

            document.getElementById("promoModalTitle").textContent = item.PromoName;
            document.getElementById("mPromoImage").src = item.ImageUrl;
            document.getElementById("mPromoDiscount").textContent = item.DiscountBadge;

            const hasDesc = item.Description && item.Description.trim() !== "";
            document.getElementById("mPromoDesc").textContent = hasDesc ? item.Description : "";
            document.getElementById("mPromoDescWrap").classList.toggle("d-none", !hasDesc);

            document.getElementById("mPromoPeriod").textContent = item.PeriodText;
            document.getElementById("mPromoRooms").textContent = item.ApplicableRoomName;
            document.getElementById("mPromoConditions").textContent = item.Conditions;
            document.getElementById("mPromoHowTo").textContent = item.HHowToUse;

            const benefitsUl = document.getElementById("mPromoBenefits");
            benefitsUl.innerHTML = "";
            item.Benefits.forEach(b => {
                const li = document.createElement("li");
                const icon = document.createElement("i");
                icon.className = "fa-solid fa-circle-check text-success me-2";
                const span = document.createElement("span");
                span.textContent = b;
                li.append(icon, span);
                benefitsUl.appendChild(li);
            });
            document.getElementById("mPromoBenefitsWrap").classList.toggle("d-none", item.Benefits.length === 0);

            const bookBtn = document.getElementById("mPromoBookBtn");
            if (item.CanBook) {
                const params = new URLSearchParams({ promoId: item.PromoId, promoCode: item.PromoCode });
                if (item.ApplicableRoomId !== null && item.ApplicableRoomId !== undefined) {
                    params.set("roomTypeId", item.ApplicableRoomId);
                }
                bookBtn.href = `/Customer/Checkout?${params.toString()}`;
                bookBtn.classList.remove("d-none");
            } else {
                bookBtn.href = "#";
                bookBtn.classList.add("d-none");
            }

            const modalEl = document.getElementById("promoDetailModal");
            if (modalEl && typeof bootstrap !== "undefined") {
                bootstrap.Modal.getOrCreateInstance(modalEl).show();
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

            // 1. AOS
            if (typeof AOS !== "undefined") {
                AOS.init({ duration: 700, once: true, offset: 60, disable: prefersReducedMotion });
            }

            // 2. GSAP Hero
            if (typeof gsap !== "undefined" && !prefersReducedMotion) {
                gsap.fromTo("#promoHeroBg", { scale: 1.14 }, { scale: 1, duration: 2.5, ease: "power2.out" });
                gsap.fromTo(".gsap-promo-hero",
                    { opacity: 0, y: 24 },
                    { opacity: 1, y: 0, duration: 0.8, stagger: 0.12, ease: "power3.out" }
                );
            }

            // 3. Counter
            document.querySelectorAll(".js-counter").forEach(counter => {
                const target = parseInt(counter.dataset.target || "0", 10);
                const finalText = counter.dataset.final || String(target);
                if (prefersReducedMotion || target <= 0) {
                    counter.textContent = finalText;
                    return;
                }
                let current = 0;
                const step = Math.max(1, Math.ceil(target / 24));
                const timer = setInterval(() => {
                    current += step;
                    if (current >= target) {
                        counter.textContent = finalText;
                        clearInterval(timer);
                    } else {
                        counter.textContent = current;
                    }
                }, 35);
            });

            // 4. Swiper
            if (typeof Swiper !== "undefined" && document.querySelector(".customer-promo-mini-swiper")) {
                new Swiper(".customer-promo-mini-swiper", {
                    slidesPerView: 1.15,
                    spaceBetween: 16,
                    grabCursor: true,
                    speed: prefersReducedMotion ? 0 : 600,
                    navigation: {
                        nextEl: ".promo-swiper-next",
                        prevEl: ".promo-swiper-prev"
                    },
                    breakpoints: {
                        576: { slidesPerView: 2, spaceBetween: 18 },
                        992: { slidesPerView: 3, spaceBetween: 20 },
                        1200: { slidesPerView: 4, spaceBetween: 22 }
                    }
                });
            }

            // 5. Category Filter
            const filterBtns = document.querySelectorAll(".customer-promo-filter-btn");
            const promoCols = document.querySelectorAll(".customer-promo-card-col");

            filterBtns.forEach(btn => {
                btn.addEventListener("click", function () {
                    filterBtns.forEach(b => b.classList.remove("active"));
                    this.classList.add("active");
                    const filterVal = this.dataset.filter;

                    promoCols.forEach(col => {
                        const cats = (col.dataset.category || "").split(" ");
                        const show = (filterVal === "all" || cats.includes(filterVal));
                        col.classList.toggle("d-none", !show);
                    });
                });
            });

            // 6. Countdown (เฉพาะโปรโมชั่นที่ใช้งานได้และมีวันสิ้นสุด)
            const pad = n => String(n).padStart(2, "0");
            document.querySelectorAll(".customer-promo-countdown-pill[data-end]").forEach(pill => {
                const textSpan = pill.querySelector(".countdown-text");
                const endTime = new Date(pill.dataset.end).getTime();
                if (isNaN(endTime)) return;

                function updateClock() {
                    const diff = endTime - Date.now();
                    if (diff <= 0) {
                        textSpan.textContent = "โปรโมชั่นสิ้นสุดแล้ว";
                        return false;
                    }
                    const d = Math.floor(diff / 86400000);
                    const h = Math.floor((diff % 86400000) / 3600000);
                    const m = Math.floor((diff % 3600000) / 60000);
                    const s = Math.floor((diff % 60000) / 1000);
                    textSpan.textContent = `เหลือเวลา ${d} วัน ${pad(h)}:${pad(m)}:${pad(s)}`;
                    return true;
                }

                if (updateClock()) {
                    const timerId = setInterval(() => {
                        if (!updateClock()) clearInterval(timerId);
                    }, 1000);
                }
            });
        });
    </script>
}
