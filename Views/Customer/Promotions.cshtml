@model List<StayMate_Kavinvee_0576.Models.Promotion>
@using System.Text.Json
@using System.Globalization

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "โปรโมชั่น";

    var cult = CultureInfo.InvariantCulture;
    var today = DateOnly.FromDateTime(DateTime.Today);

    // ---------- Helpers ----------
    string Pct(decimal? v) => v.HasValue ? v.Value.ToString("0.##", cult) : "";
    string Fmt(DateOnly? d) => d.HasValue ? d.Value.ToString("dd MMM yyyy", cult) : "";
    decimal? TopPct(decimal? max, decimal? pct) => max ?? pct;

    string PeriodText(DateOnly? from, DateOnly? to)
    {
        if (from.HasValue && to.HasValue) return $"{Fmt(from)} – {Fmt(to)}";
        if (from.HasValue) return $"ตั้งแต่ {Fmt(from)}";
        if (to.HasValue) return $"ถึง {Fmt(to)}";
        return "ไม่จำกัดระยะเวลา";
    }

    string GetTopBadge(string? type, bool hasVoucher)
    {
        return (type ?? "").ToLower() switch
        {
            "free_extra_bed" => "FREE EXTRA BED",
            "percent_room" => "ROOM DISCOUNT",
            "percent_extra_nights" => "EXTRA NIGHTS SAVER",
            _ => hasVoucher ? "E-VOUCHER" : "SPECIAL OFFER"
        };
    }

    string GetDiscountBadge(string? type, decimal? pct, decimal? pctMax, bool hasVoucher)
    {
        var t = (type ?? "").ToLower();
        if (t == "free_extra_bed") return "FREE BED";
        if (t == "percent_room")
            return pctMax.HasValue && pctMax != pct ? $"SAVE UP TO {Pct(pctMax)}%" : $"-{Pct(pct)}% ROOM";
        if (t == "percent_extra_nights") return $"SAVE {Pct(pct)}%";
        return hasVoucher ? "E-VOUCHER" : "SPECIAL DEAL";
    }

    // รูปภาพและธีมสี (ใช้ลิงก์เดิม วนตามลำดับโปรโมชั่น)
    string[] promoImages =
    {
        "https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=1000&q=80",
        "https://images.unsplash.com/photo-1566665797739-1674de7a421a?auto=format&fit=crop&w=1000&q=80",
        "https://images.unsplash.com/photo-1631049307264-da0ec9d70304?auto=format&fit=crop&w=1000&q=80",
        "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=1000&q=80",
        "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=1000&q=80"
    };
    string[] promoThemes =
    {
        "cp-theme-blue", "cp-theme-violet", "cp-theme-cyan", "cp-theme-blue-violet", "cp-theme-violet-blue"
    };

    // ---------- แปลงข้อมูลจาก Database ----------
    var promoItemList = Model.Select((p, i) =>
    {
        var type = (p.DiscountType ?? "").ToLower();
        var hasVoucher = p.VoucherMinValue.HasValue && p.VoucherMaxValue.HasValue;
        var roomName = p.ApplicableRoomType != null ? p.ApplicableRoomType.TypeName : "ทุกประเภทห้องพัก";

        var isExpired = p.ValidTo.HasValue && p.ValidTo.Value < today;
        var notStarted = p.ValidFrom.HasValue && p.ValidFrom.Value > today;
        var canBook = !isExpired && !notStarted;

        // สิทธิประโยชน์ (เฉพาะที่มีในฐานข้อมูล)
        var benefits = new List<string>();
        if (type == "free_extra_bed")
        {
            benefits.Add("ฟรีค่าเตียงเสริม");
        }
        else if (type == "percent_room")
        {
            benefits.Add(p.DiscountPercentMax.HasValue && p.DiscountPercentMax != p.DiscountPercent
                ? $"ลดค่าห้อง {Pct(p.DiscountPercent)}–{Pct(p.DiscountPercentMax)}%"
                : $"ลดค่าห้อง {Pct(p.DiscountPercent)}%");
        }
        else if (type == "percent_extra_nights")
        {
            benefits.Add($"ลด {Pct(p.DiscountPercent)}% ในคืนที่เพิ่ม"
                + (p.MaxDiscountNights is > 0 ? $" (สูงสุด {p.MaxDiscountNights} คืน)" : ""));
        }
        if (hasVoucher)
        {
            benefits.Add($"E-Voucher ฿{p.VoucherMinValue:N0}–฿{p.VoucherMaxValue:N0}");
        }

        // เงื่อนไข
        var conds = new List<string>();
        if (p.MinNights is > 0) conds.Add($"พักขั้นต่ำ {p.MinNights} คืน");
        if (p.MinGuests is > 0) conds.Add($"ผู้เข้าพักตั้งแต่ {p.MinGuests} ท่านขึ้นไป");
        if (p.RequiresHoliday) conds.Add("ช่วงวันหยุด/เทศกาลที่กำหนด");
        if (p.ApplicableRoomType != null) conds.Add($"เฉพาะห้อง {p.ApplicableRoomType.TypeName}");
        var condText = conds.Count > 0 ? string.Join(" · ", conds) : "ไม่มีเงื่อนไขขั้นต่ำ";

        // หมวดหมู่สำหรับตัวกรอง
        var cats = new List<string>();
        if (type == "percent_room") cats.Add("room-discount");
        if (type == "percent_extra_nights" || p.MinNights is >= 3) cats.Add("stay-long");
        if (type == "free_extra_bed" || p.MinGuests is >= 3) cats.Add("group-pack");
        if (hasVoucher) cats.Add("voucher");

        var isPercent = type == "percent_room" || type == "percent_extra_nights";

        // ข้อความสถานะบนรูป
        var statusText = isExpired ? "โปรโมชั่นสิ้นสุดแล้ว"
            : notStarted ? $"เริ่มใช้ได้ {Fmt(p.ValidFrom)}"
            : p.ValidTo.HasValue ? "กำลังคำนวณเวลา..."
            : "ไม่มีวันหมดอายุ";

        return new
        {
            PromoId = (int)p.PromotionId,
            PromoCode = p.PromoCode,
            PromoName = p.PromoName,
            Description = p.Description ?? "",
            Tagline = condText,
            Category = string.Join(" ", cats),
            Categories = cats,
            BadgeText = GetTopBadge(type, hasVoucher),
            DiscountBadge = GetDiscountBadge(type, p.DiscountPercent, p.DiscountPercentMax, hasVoucher),
            TopPercent = isPercent ? TopPct(p.DiscountPercentMax, p.DiscountPercent) : null,
            ThemeClass = promoThemes[i % promoThemes.Length],
            ImageUrl = promoImages[i % promoImages.Length],
            PeriodText = PeriodText(p.ValidFrom, p.ValidTo),
            ValidToText = p.ValidTo.HasValue ? Fmt(p.ValidTo) : "",
            ValidToIso = p.ValidTo.HasValue ? p.ValidTo.Value.ToString("yyyy-MM-dd", cult) + "T23:59:59" : null,
            StatusText = statusText,
            IsExpired = isExpired,
            NotStarted = notStarted,
            CanBook = canBook,
            ApplicableRoomId = p.ApplicableRoomTypeId,
            ApplicableRoomName = roomName,
            Conditions = condText,
            Benefits = benefits.ToArray(),
            HasVoucher = hasVoucher,
            VoucherMin = p.VoucherMinValue,
            VoucherMax = p.VoucherMaxValue,
            HHowToUse = "กดปุ่ม Book Now แล้วเลือกวันเข้าพัก ระบบจะคำนวณโปรโมชั่นที่เข้าเงื่อนไขให้อัตโนมัติ (โปรหลักที่ลดสูงสุด + On-top รายการละ 5% รวมไม่เกิน 20% ของค่าห้อง)"
        };
    }).ToList();

    int totalCount = promoItemList.Count;
    int activeNowCount = promoItemList.Count(p => p.CanBook);
    int roomDiscountCount = promoItemList.Count(p => p.Categories.Contains("room-discount"));
    int stayLongCount = promoItemList.Count(p => p.Categories.Contains("stay-long"));
    int groupPackCount = promoItemList.Count(p => p.Categories.Contains("group-pack"));
    int voucherCount = promoItemList.Count(p => p.Categories.Contains("voucher"));

    // ส่วนลดสูงสุดจริงจากโปรโมชั่นที่ใช้งานได้ตอนนี้
    decimal maxDiscount = promoItemList
        .Where(p => p.CanBook && p.TopPercent.HasValue)
        .Select(p => p.TopPercent!.Value)
        .DefaultIfEmpty(0m)
        .Max();

    // โปรโมชั่นเด่น: ใช้งานได้ตอนนี้และส่วนลดสูงสุด (ถ้าไม่มีให้ใช้รายการแรกที่ใช้งานได้ / รายการแรก)
    var featuredPromo = promoItemList.Where(p => p.CanBook).OrderByDescending(p => p.TopPercent ?? 0m).FirstOrDefault()
                        ?? promoItemList.FirstOrDefault();

    var voucherItems = promoItemList.Where(p => p.HasVoucher).ToList();
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/css/Customer.css" asp-append-version="true" />
}

<div class="customer-promo-wrapper">

    <!-- =========================================================
         PAGE HEADER / HERO
         ========================================================= -->
    <section class="customer-promo-hero" id="promoHero">
        <div class="customer-promo-hero-bg" id="promoHeroBg"
             style="background-image: url('https://images.unsplash.com/photo-1540518614846-7ede433c4576?auto=format&fit=crop&w=2000&q=85');">
        </div>
        <div class="customer-promo-hero-overlay"></div>
        <div class="customer-promo-orb customer-promo-orb-cyan"></div>
        <div class="customer-promo-orb customer-promo-orb-violet"></div>

        <div class="container position-relative z-2 py-4">
            <nav aria-label="breadcrumb" class="customer-promo-breadcrumb mb-3 gsap-promo-hero">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a asp-controller="Customer" asp-action="Index">
                            <i class="fa-solid fa-house me-1"></i> Home
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Promotions</li>
                </ol>
            </nav>

            <div class="row align-items-end g-4">
                <div class="col-lg-8">
                    <div class="customer-promo-hero-badge gsap-promo-hero">
                        <span class="customer-promo-pulse"></span>
                        <span>STAYMATE PROMOTIONS</span>
                    </div>

                    <h1 class="customer-promo-hero-title gsap-promo-hero">
                        Promotions<br />
                        <span class="customer-promo-text-gradient">โปรโมชั่นของ StayMate</span>
                    </h1>

                    <p class="customer-promo-hero-subtitle gsap-promo-hero">
                        ดูโปรโมชั่นที่เปิดให้ใช้งาน พร้อมสิทธิประโยชน์ เงื่อนไข และช่วงเวลาที่ใช้ได้ แล้วเลือกจองได้ทันที
                    </p>
                </div>

                <div class="col-lg-4">
                    <div class="customer-promo-counter-card gsap-promo-hero">
                        @if (maxDiscount > 0)
                        {
                            <div class="customer-promo-counter-item">
                                <span class="customer-promo-counter-num"><span class="js-counter" data-target="@((int)Math.Floor(maxDiscount))" data-final="@maxDiscount.ToString("0.##", cult)">0</span>%</span>
                                <small>ส่วนลดสูงสุดที่ใช้ได้ขณะนี้</small>
                            </div>
                            <div class="customer-promo-counter-divider"></div>
                        }
                        <div class="customer-promo-counter-item">
                            <span class="customer-promo-counter-num"><span class="js-counter" data-target="@activeNowCount" data-final="@activeNowCount">0</span></span>
                            <small>โปรโมชั่นที่ใช้ได้ขณะนี้</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @if (featuredPromo != null)
    {
        <!-- =========================================================
             FEATURED PROMOTION (ส่วนลดสูงสุดที่ใช้งานได้)
             ========================================================= -->
        <section class="customer-promo-featured-section" data-aos="fade-up">
            <div class="container">
                <div class="customer-promo-featured-banner">
                    <div class="row g-0 align-items-stretch">
                        <div class="col-lg-6">
                            <div class="customer-promo-featured-img-wrap">
                                <img src="@featuredPromo.ImageUrl" alt="@featuredPromo.PromoName" class="customer-promo-featured-img" />
                                <span class="customer-promo-featured-float-tag">
                                    <i class="fa-solid fa-crown text-warning me-1"></i> โปรโมชั่นแนะนำ
                                </span>
                                <div class="customer-promo-featured-discount-pill">
                                    <span>STAYMATE</span>
                                    <strong>@featuredPromo.DiscountBadge</strong>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="customer-promo-featured-body">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                                    <span class="customer-promo-badge-cyan">
                                        <i class="fa-solid fa-sparkles me-1"></i> ระบบคำนวณให้อัตโนมัติ
                                    </span>
                                    <span class="customer-promo-date-pill">
                                        <i class="fa-regular fa-calendar-check me-1"></i> @featuredPromo.PeriodText
                                    </span>
                                </div>

                                <h2 class="customer-promo-featured-title">@featuredPromo.PromoName</h2>
                                @if (!string.IsNullOrWhiteSpace(featuredPromo.Description))
                                {
                                    <p class="customer-promo-featured-desc">@featuredPromo.Description</p>
                                }

                                <div class="customer-promo-featured-perks">
                                    <div class="customer-promo-perk-chip">
                                        <i class="fa-solid fa-bed text-info"></i>
                                        <span>@featuredPromo.ApplicableRoomName</span>
                                    </div>
                                    <div class="customer-promo-perk-chip">
                                        <i class="fa-solid fa-circle-exclamation text-info"></i>
                                        <span>@featuredPromo.Conditions</span>
                                    </div>
                                    <div class="customer-promo-perk-chip">
                                        <i class="fa-solid fa-percent text-info"></i>
                                        <span>@featuredPromo.DiscountBadge</span>
                                    </div>
                                </div>

                                <div class="customer-promo-featured-footer">
                                    <div class="d-flex flex-wrap gap-3 align-items-center">
                                        @if (featuredPromo.CanBook)
                                        {
                                            <a asp-controller="Customer" asp-action="Checkout"
                                               asp-route-promoId="@featuredPromo.PromoId"
                                               asp-route-promoCode="@featuredPromo.PromoCode"
                                               asp-route-roomTypeId="@featuredPromo.ApplicableRoomId"
                                               class="customer-promo-btn-cyan">
                                                <i class="fa-solid fa-calendar-check"></i>
                                                <span>Book Now · จองโปรโมชั่นนี้</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button" class="customer-promo-btn-disabled" disabled>
                                                <i class="fa-solid fa-ban me-1"></i> @featuredPromo.StatusText
                                            </button>
                                        }
                                        <button type="button" class="customer-promo-btn-glass" onclick="openPromoDetailModal(@featuredPromo.PromoId)">
                                            <i class="fa-solid fa-circle-info text-info"></i>
                                            <span>ดูเงื่อนไขโดยละเอียด</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }

    @if (totalCount > 0)
    {
        <!-- =========================================================
             SWIPER & FILTER BAR
             ========================================================= -->
        <section class="customer-promo-carousel-section pt-4" data-aos="fade-up">
            <div class="container">
                <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-3">
                    <div>
                        <span class="customer-promo-eyebrow"><i class="fa-solid fa-wand-magic-sparkles me-1"></i> OVERVIEW</span>
                        <h3 class="customer-promo-sec-title mb-0">โปรโมชั่นทั้งหมด</h3>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="customer-promo-swiper-nav promo-swiper-prev" aria-label="ก่อนหน้า">
                            <i class="fa-solid fa-chevron-left"></i>
                        </button>
                        <button type="button" class="customer-promo-swiper-nav promo-swiper-next" aria-label="ถัดไป">
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    </div>
                </div>

                <div class="swiper customer-promo-mini-swiper mb-4">
                    <div class="swiper-wrapper">
                        @foreach (var item in promoItemList)
                        {
                            <div class="swiper-slide h-auto">
                                <div class="customer-promo-mini-slide @item.ThemeClass" onclick="openPromoDetailModal(@item.PromoId)">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge bg-dark bg-opacity-50 text-info border border-info border-opacity-25 rounded-pill">ใช้สิทธิ์อัตโนมัติ</span>
                                        <span class="fw-bold text-warning small">@item.DiscountBadge</span>
                                    </div>
                                    <h5 class="text-white fw-bold mb-1">@item.PromoName</h5>
                                    <p class="text-light opacity-75 small mb-0">@item.Tagline</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="customer-promo-filter-bar" role="tablist" aria-label="กรองหมวดหมู่โปรโมชั่น">
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <span class="customer-promo-filter-label">
                            <i class="fa-solid fa-tags text-primary me-1"></i> หมวดหมู่:
                        </span>
                        <button type="button" class="customer-promo-filter-btn active" data-filter="all">
                            ทั้งหมด (@totalCount)
                        </button>
                        @if (roomDiscountCount > 0)
                        {
                            <button type="button" class="customer-promo-filter-btn" data-filter="room-discount">
                                ส่วนลดค่าห้อง (@roomDiscountCount)
                            </button>
                        }
                        @if (groupPackCount > 0)
                        {
                            <button type="button" class="customer-promo-filter-btn" data-filter="group-pack">
                                หลายท่าน / เตียงเสริม (@groupPackCount)
                            </button>
                        }
                        @if (stayLongCount > 0)
                        {
                            <button type="button" class="customer-promo-filter-btn" data-filter="stay-long">
                                พักหลายคืน (@stayLongCount)
                            </button>
                        }
                        @if (voucherCount > 0)
                        {
                            <button type="button" class="customer-promo-filter-btn" data-filter="voucher">
                                E-Voucher (@voucherCount)
                            </button>
                        }
                    </div>
                </div>
            </div>
        </section>
    }

    <!-- =========================================================
         PROMOTION GRID
         ========================================================= -->
    <section class="customer-promo-grid-section py-4" id="promotionCardsSection">
        <div class="container">
            @if (totalCount == 0)
            {
                <div class="customer-promo-empty-state text-center py-5" data-aos="fade-up">
                    <div class="customer-promo-empty-icon">
                        <i class="fa-solid fa-ticket-simple"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">ขณะนี้ยังไม่มีโปรโมชั่นที่เปิดใช้งาน</h4>
                    <p class="text-muted mb-4">โปรดกลับมาตรวจสอบอีกครั้งในภายหลัง</p>
                    <a asp-controller="Customer" asp-action="RoomAvailability" class="customer-promo-btn-primary">
                        <i class="fa-solid fa-magnifying-glass me-1"></i> ค้นหาห้องพัก
                    </a>
                </div>
            }
            else
            {
                <div class="row g-4" id="customerPromoGrid">
                    @{ var delay = 0; }
                    @foreach (var p in promoItemList)
                    {
                        <div class="col-12 col-md-6 col-xl-4 customer-promo-card-col"
                             data-category="@p.Category"
                             data-aos="fade-up"
                             data-aos-delay="@delay">

                            <article class="customer-promo-card @p.ThemeClass h-100 @(p.IsExpired ? "is-expired" : "")">
                                <div class="customer-promo-card-img-wrap">
                                    <img src="@p.ImageUrl" alt="@p.PromoName" class="customer-promo-card-img" loading="lazy" />
                                    <div class="customer-promo-card-img-overlay"></div>

                                    <span class="customer-promo-top-badge">@p.BadgeText</span>
                                    <span class="customer-promo-discount-badge">@p.DiscountBadge</span>

                                    <div class="customer-promo-countdown-pill" data-end="@(p.CanBook ? p.ValidToIso : null)">
                                        <i class="fa-regular fa-clock me-1"></i>
                                        <span class="countdown-text">@p.StatusText</span>
                                    </div>
                                </div>

                                <div class="customer-promo-card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="customer-promo-code-chip">
                                            <i class="fa-solid fa-wand-magic-sparkles me-1"></i> <strong>ใช้สิทธิ์อัตโนมัติ</strong>
                                        </span>
                                        <span class="customer-promo-room-tag text-truncate" style="max-width: 150px;">
                                            <i class="fa-solid fa-bed me-1"></i> @p.ApplicableRoomName
                                        </span>
                                    </div>

                                    <h3 class="customer-promo-card-title">@p.PromoName</h3>
                                    @if (!string.IsNullOrWhiteSpace(p.Description))
                                    {
                                        <p class="customer-promo-card-desc">@p.Description</p>
                                    }

                                    @if (p.Benefits.Length > 0)
                                    {
                                        <div class="customer-promo-benefits-box">
                                            <strong class="d-block small mb-1 text-white">
                                                <i class="fa-solid fa-gift text-info me-1"></i> สิทธิประโยชน์ที่ได้รับ:
                                            </strong>
                                            <ul class="customer-promo-benefits-list">
                                                @foreach (var b in p.Benefits)
                                                {
                                                    <li><i class="fa-solid fa-check text-info"></i> <span>@b</span></li>
                                                }
                                            </ul>
                                        </div>
                                    }

                                    <div class="customer-promo-meta-box">
                                        <div>
                                            <i class="fa-regular fa-calendar-days text-info me-1"></i>
                                            <strong>ระยะเวลา:</strong> @p.PeriodText
                                        </div>
                                        <div>
                                            <i class="fa-solid fa-circle-exclamation text-warning me-1"></i>
                                            <strong>เงื่อนไข:</strong> @p.Conditions
                                        </div>
                                    </div>

                                    <div class="customer-promo-card-footer">
                                        <button type="button" class="customer-promo-btn-detail" onclick="openPromoDetailModal(@p.PromoId)">
                                            <i class="fa-regular fa-file-lines"></i>
                                            <span>View Details</span>
                                        </button>

                                        @if (p.CanBook)
                                        {
                                            <a asp-controller="Customer"
                                               asp-action="Checkout"
                                               asp-route-promoId="@p.PromoId"
                                               asp-route-promoCode="@p.PromoCode"
                                               asp-route-roomTypeId="@p.ApplicableRoomId"
                                               class="customer-promo-btn-book">
                                                <span>Book Now</span>
                                                <i class="fa-solid fa-arrow-right"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button" class="customer-promo-btn-disabled" disabled>
                                                <i class="fa-solid fa-ban me-1"></i> @(p.IsExpired ? "โปรโมชั่นหมดอายุ" : "ยังไม่เริ่ม")
                                            </button>
                                        }
                                    </div>
                                </div>
                            </article>
                        </div>
                        delay += 70;
                    }
                </div>
            }
        </div>
    </section>

    @if (voucherItems.Count > 0)
    {
        <!-- =========================================================
             E-VOUCHER (เฉพาะโปรโมชั่นที่มี E-Voucher ในฐานข้อมูล)
             ========================================================= -->
        <section class="customer-promo-privileges-section py-5" id="evoucherSection">
            <div class="container">
                <div class="text-center mb-4" data-aos="fade-up">
                    <span class="customer-promo-eyebrow">
                        <i class="fa-solid fa-ticket me-1"></i> E-VOUCHER
                    </span>
                    <h2 class="customer-promo-sec-title">โปรโมชั่นที่แถม E-Voucher</h2>
                </div>

                <div class="row g-4 align-items-stretch">
                    @foreach (var v in voucherItems)
                    {
                        <div class="col-12 col-lg-6" data-aos="fade-up">
                            <div class="customer-promo-evoucher-card h-100">
                                <div class="customer-promo-evoucher-left">
                                    <span class="customer-promo-evoucher-type">STAYMATE E-VOUCHER</span>
                                    <div class="customer-promo-evoucher-amount">฿@(v.VoucherMax?.ToString("N0", cult))</div>
                                    <span class="customer-promo-evoucher-sub">สูงสุด</span>
                                </div>

                                <div class="customer-promo-evoucher-Perf"></div>

                                <div class="customer-promo-evoucher-right">
                                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3">@v.PeriodText</span>
                                        @if (!string.IsNullOrEmpty(v.ValidToText))
                                        {
                                            <small class="text-muted"><i class="fa-regular fa-clock me-1"></i> ใช้ได้ถึง @v.ValidToText</small>
                                        }
                                    </div>

                                    <h4 class="fw-bold text-dark mb-1">@v.PromoName</h4>
                                    <p class="text-secondary small mb-3">
                                        รับ E-Voucher มูลค่า ฿@(v.VoucherMin?.ToString("N0", cult))–฿@(v.VoucherMax?.ToString("N0", cult)) เมื่อจองด้วยโปรโมชั่นนี้
                                    </p>

                                    <div class="customer-promo-evoucher-code-bar">
                                        <div>
                                            <small class="text-muted d-block" style="font-size:0.7rem;">PROMO SYSTEM</small>
                                            <strong class="customer-promo-mono-code text-primary"><i class="fa-solid fa-circle-check"></i> คำนวณอัตโนมัติ</strong>
                                        </div>
                                    </div>

                                    <small class="text-muted d-block mt-2" style="font-size: 0.75rem;">
                                        * เงื่อนไข: @v.Conditions
                                    </small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <!-- =========================================================
         CALL TO ACTION
         ========================================================= -->
    <section class="customer-promo-cta-section pb-5" data-aos="zoom-in">
        <div class="container">
            <div class="customer-promo-cta-box">
                <div class="customer-promo-cta-orb"></div>
                <div class="row align-items-center g-4 position-relative z-2">
                    <div class="col-lg-8">
                        <h2 class="customer-promo-cta-title">พร้อมจองห้องพักแล้วหรือยัง</h2>
                        <p class="customer-promo-cta-desc mb-0">
                            ดูรายละเอียดห้องพัก หรือตรวจสอบห้องว่างเพื่อเลือกใช้โปรโมชั่นที่ต้องการ
                        </p>
                    </div>
                    <div class="col-lg-4 text-lg-end">
                        <div class="d-flex flex-wrap justify-content-lg-end gap-3">
                            <a asp-controller="Customer" asp-action="Rooms" class="customer-promo-btn-glass">
                                <i class="fa-solid fa-bed text-info"></i>
                                <span>Explore Rooms</span>
                            </a>
                            <a asp-controller="Customer" asp-action="RoomAvailability" class="customer-promo-btn-cyan">
                                <i class="fa-solid fa-calendar-check"></i>
                                <span>Book Your Stay</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- =========================================================
         PROMOTION DETAIL MODAL
         ========================================================= -->
    <div class="modal fade customer-promo-modal" id="promoDetailModal" tabindex="-1" aria-labelledby="promoModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content customer-promo-modal-content">
                <div class="modal-body p-4">
                    <div class="customer-promo-modal-img-wrap mb-4">
                        <img id="mPromoImage" src="" alt="Promotion Preview" />
                        <span class="customer-promo-modal-discount" id="mPromoDiscount"></span>
                    </div>

                    <h4 class="fw-bold text-dark mb-3" id="promoModalTitle"></h4>

                    <div class="mb-4" id="mPromoDescWrap">
                        <h6 class="fw-bold text-dark"><i class="fa-solid fa-circle-info text-primary me-2"></i>รายละเอียดโปรโมชั่น</h6>
                        <p id="mPromoDesc" class="text-secondary mb-0 lh-lg"></p>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="customer-promo-modal-info-box">
                                <small><i class="fa-regular fa-calendar-check text-primary me-1"></i> ระยะเวลาโปรโมชั่น</small>
                                <strong id="mPromoPeriod">-</strong>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="customer-promo-modal-info-box">
                                <small><i class="fa-solid fa-bed text-primary me-1"></i> ประเภทห้องที่รองรับ</small>
                                <strong id="mPromoRooms">-</strong>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4" id="mPromoBenefitsWrap">
                        <h6 class="fw-bold text-dark"><i class="fa-solid fa-gift text-primary me-2"></i>ส่วนลดและสิทธิพิเศษที่ได้รับ</h6>
                        <ul class="customer-promo-modal-list" id="mPromoBenefits"></ul>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 rounded-4 bg-light border h-100">
                                <h6 class="fw-bold text-dark small mb-2">
                                    <i class="fa-solid fa-file-shield text-warning me-1"></i> เงื่อนไขการใช้สิทธิ์
                                </h6>
                                <p id="mPromoConditions" class="text-secondary small mb-0"></p>
                            </div>
