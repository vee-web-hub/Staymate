                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="customer-promo-swiper-nav promo-swiper-prev" aria-label="ก่อนหน้า">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <button type="button" class="customer-promo-swiper-nav promo-swiper-next" aria-label="ถัดไป">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>
            </div>

