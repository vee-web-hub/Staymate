                                    <i class="fa-solid fa-bolt me-1"></i> FEATURED PROMOTION · CODE: STAY3PAY2
                                </span>
                                <span class="customer-promo-date-pill">
                                    <i class="fa-regular fa-calendar-check me-1"></i> 1 ม.ค. 2026 – 31 ธ.ค. 2026
                                </span>
                            </div>

