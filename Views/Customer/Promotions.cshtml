                                        <i class="fa-solid fa-circle-info text-info"></i>
                                        <span>ดูเงื่อนไขโดยละเอียด</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

