@model StayMate_Kavinvee_0576.Models.User
@using StayMate_Kavinvee_0576.Models.ViewModels

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "การจองของฉัน";

    // แปลงสถานะการจองจากฐานข้อมูล (ค่าภายในใช้สำหรับกรอง ส่วนข้อความที่แสดงเป็นภาษาไทย)
    string MapBookingStatus(string? dbStatus)
    {
        return (dbStatus ?? "").ToLowerInvariant() switch
        {
            "confirmed" or "approved" or "checked_in" => "Approved",
            "rejected" => "Rejected",
            "checked_out" or "completed" => "Completed",
            "cancelled" or "canceled" => "Cancelled",
            _ => "Pending"
        };
    }

    string BookingStatusText(string s) => s switch
    {
        "Approved" => "ยืนยันแล้ว",
        "Rejected" => "ไม่อนุมัติ",
        "Completed" => "เข้าพักเสร็จสิ้น",
        "Cancelled" => "ยกเลิกแล้ว",
        _ => "รอดำเนินการ"
    };

    string MapPaymentStatus(StayMate_Kavinvee_0576.Models.Booking b)
    {
        var latestPay = b.Payments?.OrderByDescending(p => p.CreatedAt).FirstOrDefault();
        if (latestPay == null)
        {
            var bStat = (b.Status ?? "").ToLowerInvariant();
            if (bStat == "confirmed" || bStat == "checked_in" || bStat == "checked_out" || bStat == "approved") return "Paid";
            if (bStat == "pending_approval") return "Pending Verification";
            if (bStat == "rejected") return "Rejected";
            return "Unpaid";
        }

        return (latestPay.Status ?? "").ToLowerInvariant() switch
        {
            "approved" or "paid" or "completed" or "verified" => "Paid",
            "pending" or "pending_verification" or "verifying" => "Pending Verification",
            "rejected" or "failed" => "Rejected",
            _ => "Unpaid"
        };
    }

    string PaymentStatusText(string s) => s switch
    {
        "Paid" => "ชำระแล้ว",
        "Pending Verification" => "รอตรวจสอบสลิป",
        "Rejected" => "สลิปไม่ผ่าน",
        _ => "ยังไม่ชำระ"
    };
string GetRoomImage(string? code, string? name) =>
    RoomExtrasCatalog.Find(code, name)?.Gallery.FirstOrDefault()
    ?? RoomExtrasCatalog.Fallback(name ?? "");



    var rawBookings = Model?.Bookings?.OrderByDescending(b => b.CreatedAt).ToList()
                      ?? new List<StayMate_Kavinvee_0576.Models.Booking>();

    var bookingsList = rawBookings.Select(b =>
    {
        var firstRoom = b.BookingRooms?.FirstOrDefault();
        var rt = firstRoom?.RoomType;
        var roomEntity = firstRoom?.Room;

        var typeName = rt?.TypeName ?? "ห้องพัก";
        var typeCode = rt?.TypeCode ?? "";
        var roomTitle = roomEntity != null
            ? $"{typeName} · ห้อง {roomEntity.RoomNumber}"
            : typeName;

       var promoName = string.Join(", ", b.BookingPromotions?
    .Select(bp => bp.Promotion?.PromoName).Where(n => !string.IsNullOrWhiteSpace(n)) ?? Enumerable.Empty<string?>());

        var mappedBStatus = MapBookingStatus(b.Status);
        var mappedPStatus = MapPaymentStatus(b);

        // QR Code ใช้สำหรับเช็คอินเท่านั้น จึงแสดงเฉพาะรายการที่ยืนยันแล้ว
        var hasQr = mappedBStatus == "Approved";
        var qrText = hasQr
            ? (!string.IsNullOrWhiteSpace(b.QrCode) ? b.QrCode : b.BookingCode)
            : "";

        var qrReason = mappedBStatus switch
        {
            "Completed" => "เข้าพักเสร็จสิ้นแล้ว ไม่จำเป็นต้องใช้ QR Code",
            "Rejected" => "รายการจองนี้ไม่ได้รับการอนุมัติ จึงไม่มี QR Code สำหรับเช็คอิน",
            "Cancelled" => "รายการจองนี้ถูกยกเลิกแล้ว จึงไม่มี QR Code สำหรับเช็คอิน",
            _ => "รายการจองนี้ยังอยู่ระหว่างตรวจสอบ ระบบจะแสดง QR Code เมื่อได้รับการยืนยัน"
        };

        return new
        {
            BookingId = b.BookingId,
            BookingCode = b.BookingCode,
            RoomName = roomTitle,
            RoomType = typeName,
            RoomImage = GetRoomImage(typeCode, typeName),
            CheckIn = b.CheckInDate,
            CheckOut = b.CheckOutDate,
            CreatedAt = b.CreatedAt,
            Nights = (int)b.Nights,
            Guests = (int)b.NumGuests,
            RoomsCount = b.BookingRooms != null && b.BookingRooms.Any() ? b.BookingRooms.Count : 1,
            RoomPrice = b.RoomAmount,
            PromoDiscount = b.DiscountAmount,
            TotalAmount = b.TotalAmount,
            BookingStatus = mappedBStatus,
            PaymentStatus = mappedPStatus,
            PromoName = promoName,
            QrText = qrText,
            QrReason = qrReason
        };
    }).ToList();

    int totalBookingsCount = bookingsList.Count;
    int upcomingStaysCount = bookingsList.Count(x => x.BookingStatus == "Approved");
    int pendingBookingsCount = bookingsList.Count(x => x.BookingStatus == "Pending");
    int completedStaysCount = bookingsList.Count(x => x.BookingStatus == "Completed");
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Customer.css" asp-append-version="true" />
}

<div class="customer-mb-wrapper">

    <!-- =========================================================
         1. หัวหน้า
         ========================================================= -->
    <section class="customer-mb-header">
        <div class="container">
            <nav aria-label="breadcrumb" class="customer-mb-breadcrumb mb-2">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a asp-controller="Customer" asp-action="Index">
                            <i class="fa-solid fa-house me-1"></i> หน้าแรก
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">การจองของฉัน</li>
                </ol>
            </nav>

            <div class="d-flex justify-content-between align-items-end flex-wrap gap-3">
                <div>
                    <h1 class="customer-mb-title">การจองของฉัน</h1>
                    <p class="customer-mb-subtitle mb-0">
                        ตรวจสอบสถานะการจองและการชำระเงิน ดูรายละเอียดใบจอง และเปิด QR Code สำหรับเช็คอิน
                    </p>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Customer" asp-action="RoomAvailability" class="customer-mb-btn-primary">
                        <i class="fa-solid fa-calendar-plus"></i>
                        <span>จองห้องพักเพิ่ม</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- =========================================================
         2. สรุปภาพรวม
         ========================================================= -->
    <section class="customer-mb-dashboard-section" aria-label="สรุปภาพรวมการจอง">
        <div class="container">
            <div class="row g-3 g-md-4">
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="customer-mb-stat-card customer-mb-stat-navy">
                        <div class="customer-mb-stat-icon"><i class="fa-solid fa-layer-group"></i></div>
                        <div class="customer-mb-stat-content">
                            <span class="customer-mb-stat-label">การจองทั้งหมด</span>
                            <h2 class="customer-mb-stat-value">@totalBookingsCount</h2>
                            <small class="customer-mb-stat-desc">รายการจองทั้งหมดของคุณ</small>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="customer-mb-stat-card customer-mb-stat-emerald">
                        <div class="customer-mb-stat-icon"><i class="fa-solid fa-calendar-check"></i></div>
                        <div class="customer-mb-stat-content">
                            <span class="customer-mb-stat-label">ใกล้เข้าพัก</span>
                            <h2 class="customer-mb-stat-value">@upcomingStaysCount</h2>
                            <small class="customer-mb-stat-desc">ยืนยันแล้วและกำลังจะเข้าพัก</small>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="customer-mb-stat-card customer-mb-stat-amber">
                        <div class="customer-mb-stat-icon"><i class="fa-solid fa-hourglass-half"></i></div>
                        <div class="customer-mb-stat-content">
                            <span class="customer-mb-stat-label">รอดำเนินการ</span>
                            <h2 class="customer-mb-stat-value">@pendingBookingsCount</h2>
                            <small class="customer-mb-stat-desc">รอตรวจสอบการชำระเงินหรืออนุมัติ</small>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="customer-mb-stat-card customer-mb-stat-blue">
                        <div class="customer-mb-stat-icon"><i class="fa-solid fa-award"></i></div>
                        <div class="customer-mb-stat-content">
                            <span class="customer-mb-stat-label">เข้าพักแล้ว</span>
                            <h2 class="customer-mb-stat-value">@completedStaysCount</h2>
                            <small class="customer-mb-stat-desc">เข้าพักเสร็จสิ้นแล้ว</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- =========================================================
         3. ค้นหาและกรอง
         ========================================================= -->
    <section class="customer-mb-filter-section" aria-label="ค้นหาและกรองรายการจอง">
        <div class="container">
            <div class="customer-mb-filter-panel">
                <div class="customer-mb-filter-top">
                    <div class="d-flex align-items-center gap-2">
                        <span class="customer-mb-filter-icon"><i class="fa-solid fa-sliders"></i></span>
                        <h3 class="customer-mb-filter-heading mb-0">ค้นหาและกรองรายการจอง</h3>
                    </div>
                    <button type="button" id="btnResetBookingFilters" class="customer-mb-btn-reset">
                        <i class="fa-solid fa-rotate-left me-1"></i> ล้างตัวกรอง
                    </button>
                </div>

                <form id="mbFilterForm" onsubmit="return false;">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-sm-6 col-lg-2">
                            <label for="mbSearchBookingId" class="customer-mb-label">
                                <i class="fa-solid fa-hashtag text-primary me-1"></i> รหัสการจอง
                            </label>
                            <input type="text" id="mbSearchBookingId" class="form-control customer-mb-input" placeholder="ค้นหารหัสการจอง" />
                        </div>

                        <div class="col-12 col-sm-6 col-lg-2">
                            <label for="mbSearchRoomName" class="customer-mb-label">
                                <i class="fa-solid fa-bed text-primary me-1"></i> ชื่อห้อง
                            </label>
                            <input type="text" id="mbSearchRoomName" class="form-control customer-mb-input" placeholder="เช่น Deluxe" />
                        </div>

                        <div class="col-12 col-sm-6 col-lg-2">
                            <label for="mbFilterBookingStatus" class="customer-mb-label">
                                <i class="fa-solid fa-clipboard-check text-primary me-1"></i> สถานะการจอง
                            </label>
                            <select id="mbFilterBookingStatus" class="form-select customer-mb-input">
                                <option value="ALL" selected>ทุกสถานะ</option>
                                <option value="Pending">รอดำเนินการ</option>
                                <option value="Approved">ยืนยันแล้ว</option>
                                <option value="Rejected">ไม่อนุมัติ</option>
                                <option value="Completed">เข้าพักเสร็จสิ้น</option>
                                <option value="Cancelled">ยกเลิกแล้ว</option>
                            </select>
                        </div>

                        <div class="col-12 col-sm-6 col-lg-2">
                            <label for="mbFilterPaymentStatus" class="customer-mb-label">
                                <i class="fa-solid fa-credit-card text-primary me-1"></i> สถานะการชำระเงิน
                            </label>
                            <select id="mbFilterPaymentStatus" class="form-select customer-mb-input">
                                <option value="ALL" selected>ทุกสถานะ</option>
                                <option value="Unpaid">ยังไม่ชำระ</option>
                                <option value="Pending Verification">รอตรวจสอบสลิป</option>
                                <option value="Paid">ชำระแล้ว</option>
                                <option value="Rejected">สลิปไม่ผ่าน</option>
                            </select>
                        </div>

                        <div class="col-12 col-sm-6 col-lg-2">
                            <label for="mbFilterCheckInDate" class="customer-mb-label">
                                <i class="fa-regular fa-calendar text-primary me-1"></i> วันเช็คอิน
                            </label>
                            <input type="date" id="mbFilterCheckInDate" class="form-control customer-mb-input" />
                        </div>

                        <div class="col-12 col-sm-6 col-lg-2">
                            <label for="mbSortOrder" class="customer-mb-label">
                                <i class="fa-solid fa-arrow-down-wide-short text-primary me-1"></i> เรียงตาม
                            </label>
                            <select id="mbSortOrder" class="form-select customer-mb-input">
                                <option value="newest" selected>ใหม่สุดก่อน</option>
                                <option value="oldest">เก่าสุดก่อน</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <!-- =========================================================
         4. รายการจอง
         ========================================================= -->
    <section class="customer-mb-list-section" aria-label="รายการจองห้องพัก">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <span class="customer-mb-result-counter">
                    แสดง <strong id="mbVisibleCount">@totalBookingsCount</strong> จากทั้งหมด <strong>@totalBookingsCount</strong> รายการ
                </span>
            </div>

            <div id="mbBookingCardsContainer" class="customer-mb-cards-stack">
                @foreach (var item in bookingsList)
                {
                    string bStatus = item.BookingStatus;
                    string pStatus = item.PaymentStatus;

                    string bStatusClass = bStatus switch
                    {
                        "Approved" => "customer-mb-badge-approved",
                        "Rejected" => "customer-mb-badge-rejected",
                        "Completed" => "customer-mb-badge-completed",
                        "Cancelled" => "customer-mb-badge-cancelled",
                        _ => "customer-mb-badge-pending"
                    };

                    string bStatusIcon = bStatus switch
                    {
                        "Approved" => "fa-circle-check",
                        "Rejected" => "fa-circle-xmark",
                        "Completed" => "fa-flag-checkered",
                        "Cancelled" => "fa-ban",
                        _ => "fa-clock"
                    };

                    string pStatusClass = pStatus switch
                    {
                        "Paid" => "customer-mb-pay-paid",
                        "Pending Verification" => "customer-mb-pay-verifying",
                        "Rejected" => "customer-mb-pay-rejected",
                        _ => "customer-mb-pay-unpaid"
                    };

                    <article class="customer-mb-booking-card js-booking-card"
                             data-booking-id="@item.BookingCode.ToLowerInvariant()"
                             data-room-name="@item.RoomName.ToLowerInvariant() @item.RoomType.ToLowerInvariant()"
                             data-booking-status="@bStatus"
                             data-payment-status="@pStatus"
                             data-checkin="@item.CheckIn.ToString("yyyy-MM-dd")"
                             data-timestamp="@item.CreatedAt.Ticks">

                        <div class="row g-0 align-items-stretch">
                            <div class="col-12 col-lg-3">
                                <div class="customer-mb-card-img-wrap">
                                    <img src="@item.RoomImage" alt="@item.RoomName" class="customer-mb-card-img" loading="lazy" />
                                    <span class="customer-mb-roomtype-pill">@item.RoomType</span>
                                    <span class="customer-mb-id-overlay">#@item.BookingCode</span>
                                </div>
                            </div>

                            <div class="col-12 col-lg-5">
                                <div class="customer-mb-card-center">
                                    <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                                        <span class="customer-mb-code-tag">
                                            <i class="fa-solid fa-receipt text-primary me-1"></i> รหัสการจอง: <strong>@item.BookingCode</strong>
                                        </span>
                                        <span class="text-muted small">· จองเมื่อ @item.CreatedAt.ToString("dd MMM yyyy")</span>
                                    </div>

                                    <h3 class="customer-mb-room-title">@item.RoomName</h3>
                                    <p class="customer-mb-room-sub mb-3">
                                        ประเภทห้อง: <strong>@item.RoomType</strong>
                                        @if (!string.IsNullOrWhiteSpace(item.PromoName))
                                        {
                                            <text> · โปรโมชั่น: <span class="text-primary fw-semibold">@item.PromoName</span></text>
                                        }
                                    </p>

                                    <div class="customer-mb-meta-grid">
                                        <div class="customer-mb-meta-item">
                                            <small><i class="fa-regular fa-calendar-plus text-primary me-1"></i> เช็คอิน</small>
                                            <strong>@item.CheckIn.ToString("dd MMM yyyy")</strong>
                                        </div>
                                        <div class="customer-mb-meta-item">
                                            <small><i class="fa-regular fa-calendar-minus text-primary me-1"></i> เช็คเอาท์</small>
                                            <strong>@item.CheckOut.ToString("dd MMM yyyy")</strong>
                                        </div>
                                        <div class="customer-mb-meta-item">
                                            <small><i class="fa-solid fa-moon text-primary me-1"></i> จำนวนคืน</small>
                                            <strong>@item.Nights คืน</strong>
                                        </div>
                                        <div class="customer-mb-meta-item">
                                            <small><i class="fa-solid fa-user-group text-primary me-1"></i> ผู้เข้าพักและจำนวนห้อง</small>
                                            <strong>@item.Guests ท่าน · @item.RoomsCount ห้อง</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-lg-4">
                                <div class="customer-mb-card-right">
                                    <div class="customer-mb-status-row">
                                        <div class="customer-mb-status-group">
                                            <small>สถานะการจอง</small>
                                            <span class="customer-mb-status-badge @bStatusClass">
                                                <i class="fa-solid @bStatusIcon me-1"></i> @BookingStatusText(bStatus)
                                            </span>
                                        </div>
                                        <div class="customer-mb-status-group text-lg-end">
                                            <small>การชำระเงิน</small>
                                            <span class="customer-mb-pay-badge @pStatusClass">
                                                @PaymentStatusText(pStatus)
                                            </span>
                                        </div>
                                    </div>

                                    <div class="customer-mb-price-box">
                                        <div class="customer-mb-price-line">
                                            <span>ค่าห้องพัก (@item.Nights คืน)</span>
                                            <span>฿@item.RoomPrice.ToString("N0")</span>
                                        </div>
                                        @if (item.PromoDiscount > 0)
                                        {
                                            <div class="customer-mb-price-line text-success">
                                                <span>ส่วนลดที่ได้รับ</span>
                                                <span>-฿@item.PromoDiscount.ToString("N0")</span>
                                            </div>
                                        }
                                        <div class="customer-mb-price-total">
                                            <span>ยอดชำระสุทธิ</span>
                                            <strong>฿@item.TotalAmount.ToString("N0")</strong>
                                        </div>
                                    </div>

                                    <div class="customer-mb-actions">
                                        <a asp-controller="Customer"
                                           asp-action="BookingDetails"
                                           asp-route-id="@item.BookingId"
                                           class="customer-mb-btn-detail">
                                            <i class="fa-regular fa-file-lines"></i>
                                            <span>ดูรายละเอียด</span>
                                        </a>

                                        <button type="button"
                                                class="customer-mb-btn-qr js-open-qr-modal"
                                                data-booking-code="@item.BookingCode"
                                                data-room-name="@item.RoomName"
                                                data-checkin="@item.CheckIn.ToString("dd MMM yyyy")"
                                                data-qr-text="@item.QrText"
                                                data-qr-reason="@item.QrReason">
                                            <i class="fa-solid fa-qrcode"></i>
                                            <span>QR Code</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </div>

            <div id="mbFilterEmptyState" class="customer-mb-empty-card @(totalBookingsCount == 0 ? "" : "d-none") mt-3">
                <div class="customer-mb-empty-icon-wrap">
                    <i class="fa-solid fa-suitcase-rolling"></i>
                </div>
                <h3 class="customer-mb-empty-title">@(totalBookingsCount == 0 ? "ยังไม่มีรายการจอง" : "ไม่พบรายการที่ตรงกับเงื่อนไข")</h3>
                <p class="customer-mb-empty-desc">
                    @(totalBookingsCount == 0
                        ? "ค้นหาห้องพักที่ต้องการแล้วเริ่มจองได้ทันที"
                        : "ลองล้างตัวกรองเพื่อแสดงรายการจองทั้งหมด")
                </p>
                @if (totalBookingsCount == 0)
                {
                    <a asp-controller="Customer" asp-action="RoomAvailability" class="customer-mb-btn-primary mt-3">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <span>ค้นหาห้องพัก</span>
                    </a>
                }
                else
                {
                    <button type="button" id="btnEmptyFilterReset" class="customer-mb-btn-primary mt-3">
                        <i class="fa-solid fa-rotate-left"></i>
                        <span>ล้างตัวกรอง</span>
                    </button>
                }
            </div>
        </div>
    </section>

    <!-- =========================================================
         5. คำอธิบายสถานะ
         ========================================================= -->
    <section class="customer-mb-legend-section">
        <div class="container">
            <div class="customer-mb-legend-card">
                <div class="row g-4">
                    <div class="col-12 col-lg-7">
                        <h4 class="customer-mb-legend-title">
                            <i class="fa-solid fa-circle-info text-primary me-2"></i>ความหมายของสถานะการจอง
                        </h4>
                        <div class="customer-mb-legend-grid">
                            <div class="customer-mb-legend-item">
                                <span class="customer-mb-status-badge customer-mb-badge-pending">รอดำเนินการ</span>
                                <p class="mb-0">โรงแรมกำลังตรวจสอบการชำระเงินและการจองของคุณ</p>
                            </div>
                            <div class="customer-mb-legend-item">
                                <span class="customer-mb-status-badge customer-mb-badge-approved">ยืนยันแล้ว</span>
                                <p class="mb-0">การจองได้รับการยืนยัน สามารถใช้ QR Code เช็คอินได้</p>
                            </div>
                            <div class="customer-mb-legend-item">
                                <span class="customer-mb-status-badge customer-mb-badge-rejected">ไม่อนุมัติ</span>
                                <p class="mb-0">การจองไม่ผ่านการอนุมัติ ดูเหตุผลได้ในหน้ารายละเอียด</p>
                            </div>
                            <div class="customer-mb-legend-item">
                                <span class="customer-mb-status-badge customer-mb-badge-completed">เข้าพักเสร็จสิ้น</span>
                                <p class="mb-0">เช็คเอาท์เรียบร้อยแล้ว และสามารถเขียนรีวิวได้</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-5 border-lg-start ps-lg-4">
                        <h4 class="customer-mb-legend-title">
                            <i class="fa-solid fa-wallet text-info me-2"></i>ความหมายของสถานะการชำระเงิน
                        </h4>
                        <div class="customer-mb-legend-grid">
                            <div class="customer-mb-legend-item">
                                <span class="customer-mb-pay-badge customer-mb-pay-unpaid">ยังไม่ชำระ</span>
                                <p class="mb-0">ยังไม่ได้ชำระเงินหรือยังไม่ได้แนบสลิป</p>
                            </div>
                            <div class="customer-mb-legend-item">
                                <span class="customer-mb-pay-badge customer-mb-pay-verifying">รอตรวจสอบสลิป</span>
                                <p class="mb-0">แนบสลิปแล้ว เจ้าหน้าที่กำลังตรวจสอบยอดเงิน</p>
                            </div>
                            <div class="customer-mb-legend-item">
                                <span class="customer-mb-pay-badge customer-mb-pay-paid">ชำระแล้ว</span>
                                <p class="mb-0">ตรวจสอบการชำระเงินเรียบร้อยแล้ว</p>
                            </div>
                            <div class="customer-mb-legend-item">
                                <span class="customer-mb-pay-badge customer-mb-pay-rejected">สลิปไม่ผ่าน</span>
                                <p class="mb-0">หลักฐานการโอนไม่ถูกต้อง กรุณาติดต่อโรงแรม</p>
                            </div>
