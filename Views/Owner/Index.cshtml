
@{
    ViewData["Title"] = "Executive Dashboard";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="fw-bold">Executive Dashboard</h2>
            <p class="text-secondary">
                ภาพรวมผลประกอบการสำหรับเจ้าของโรงแรม
            </p>
        </div>

        <span class="badge bg-secondary">
            Read-only
        </span>
    </div>

    <div class="row g-3">
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-secondary">รายได้รวมเดือนนี้</p>
                    <h3>฿850,000</h3>
                    <small class="text-secondary">
                        Monthly Revenue
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-secondary">ค่าใช้จ่ายเดือนนี้</p>
                    <h3>฿510,000</h3>
                    <small class="text-secondary">
                        Monthly Expenses
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-secondary">กำไรจากการดำเนินงาน</p>
                    <h3 class="text-success">฿340,000</h3>
                    <small class="text-secondary">
                        Operating Profit
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-secondary">อัตราการเข้าพัก</p>
                    <h3>72%</h3>
                    <small class="text-secondary">
                        Occupancy Rate
                    </small>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="fw-bold">Monthly Financial Summary</h5>

                    <div class="table-responsive mt-3">
                        <table class="table">
                            <tbody>
                                <tr>
                                    <th>รายได้จากห้องพัก</th>
                                    <td class="text-end">฿780,000</td>
                                </tr>
                                <tr>
                                    <th>รายได้จากบริการอื่น</th>
                                    <td class="text-end">฿70,000</td>
                                </tr>
                                <tr>
                                    <th>รายได้รวม</th>
                                    <td class="text-end">฿850,000</td>
                                </tr>
                                <tr>
                                    <th>ต้นทุนและค่าใช้จ่าย</th>
                                    <td class="text-end">฿510,000</td>
                                </tr>
                                <tr>
                                    <th>กำไรจากการดำเนินงาน</th>
                                    <td class="text-end fw-bold text-success">
                                        ฿340,000
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="fw-bold">Occupancy Overview</h5>

                    <div class="my-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span>อัตราการเข้าพัก</span>
                            <strong>72%</strong>
                        </div>

                        <div class="progress" style="height: 14px;">
                            <div class="progress-bar"
                                 role="progressbar"
                                 style="width: 72%;"
                                 aria-valuenow="72"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                            </div>
                        </div>
                    </div>

                    <p class="text-secondary">
                        ข้อมูลสรุปสำหรับติดตามผลประกอบการ
                        และประกอบการตัดสินใจทางธุรกิจ
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-light border mt-4">
        <strong>Executive access:</strong>
        หน้านี้ออกแบบให้ดูข้อมูลอย่างเดียว
        การป้องกันการแก้ไขข้อมูลต้องบังคับใช้สิทธิ์ฝั่ง Server ด้วย
    </div>

    <p class="text-secondary small">
        ตัวเลขทั้งหมดในหน้านี้เป็นข้อมูลตัวอย่าง ไม่ใช่ผลประกอบการจริง
    </p>
</div>
