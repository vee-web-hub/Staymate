@model StayMate_Kavinvee_0576.Models.ViewModels.OwnerStaffOverviewViewModel
@using System.Globalization
@using StayMate_Kavinvee_0576.Models.ViewModels
@{
    Layout = "~/Views/Shared/_OwnerLayout.cshtml";
    ViewData["Title"] = "Staff Overview";

    var thCulture = new CultureInfo("th-TH");
    var nowDisplay = DateTime.Now.ToString("dd MMMM yyyy HH:mm น.", thCulture);

    var roleList = Model.StaffByRole ?? new List<StaffRoleRow>();
    var directoryList = Model.StaffDirectory ?? new List<StaffDirectoryRow>();

    int totalEmployees = Model.TotalStaff;
    int activeEmployees = Model.ActiveStaff;
    int inactiveEmployees = Model.InactiveStaff;
    int totalRolesCount = roleList.Count(r => r.Total > 0);

    decimal activePct = totalEmployees > 0
        ? Math.Round(activeEmployees * 100m / totalEmployees, 2)
        : 0m;

    decimal inactivePct = totalEmployees > 0
        ? Math.Round(inactiveEmployees * 100m / totalEmployees, 2)
        : 0m;

    decimal? suspendedPct = (Model.SuspendedStaff.HasValue && totalEmployees > 0)
        ? Math.Round(Model.SuspendedStaff.Value * 100m / totalEmployees, 2)
        : null;

    decimal? resignedPct = (Model.ResignedStaff.HasValue && totalEmployees > 0)
        ? Math.Round(Model.ResignedStaff.Value * 100m / totalEmployees, 2)
        : null;

    string GetRoleIcon(string roleCode)
    {
        return (roleCode ?? "").ToUpperInvariant() switch
        {
            "OWNER" => "fa-crown",
            "MANAGER" => "fa-user-tie",
            "FRONT_ADMIN" or "RECEPTION" or "FRONT_DESK" => "fa-bell-concierge",
            "FINANCE" or "ACCOUNTING" => "fa-calculator",
            "HOUSEKEEPING" => "fa-broom",
            _ => "fa-id-badge"
        };
    }

    string GetRoleAccent(string roleCode)
    {
        return (roleCode ?? "").ToUpperInvariant() switch
        {
            "OWNER" => "owner-staff-role-violet",
            "MANAGER" => "owner-staff-role-blue",
            "FRONT_ADMIN" or "RECEPTION" => "owner-staff-role-cyan",
            "FINANCE" => "owner-staff-role-green",
            "HOUSEKEEPING" => "owner-staff-role-amber",
            _ => "owner-staff-role-cyan"
        };
    }
}

<div class="owner-dashboard-wrapper owner-staff-wrapper"
     data-owner-page="staff"
     data-api-url="@Url.Action("StaffData", "Owner")">

    <!-- ═══════════════════ PAGE HEADER ═══════════════════ -->
    <section class="owner-staff-header">
        <div class="owner-staff-header-left">
            <div class="owner-eyebrow-badge">
                <span class="owner-pulse-dot"></span>
                <span>STAYMATE WORKFORCE OVERVIEW</span>
            </div>
            <div class="owner-staff-title-group">
                <div class="owner-staff-hero-icon">
                    <i class="fa-solid fa-id-card-clip"></i>
                </div>
                <div>
                    <h1 class="owner-staff-title">
                        Staff Overview
                    </h1>
                    <p class="owner-staff-subtitle">
                        ภาพรวมจำนวนบุคลากร โครงสร้างตำแหน่งงาน และสถานะการปฏิบัติงานภายในโรงแรม
                    </p>
                </div>
            </div>
        </div>

        <div class="owner-staff-header-right">
            <div class="owner-staff-meta-card">
                <i class="fa-solid fa-clock-rotate-left owner-icon-cyan"></i>
                <div>
                    <span class="owner-staff-meta-label">อัปเดตล่าสุด</span>
                    <strong class="owner-staff-meta-val">@nowDisplay</strong>
                </div>
            </div>
            <div class="owner-staff-meta-card">
                <i class="fa-solid fa-sitemap owner-icon-violet"></i>
                <div>
                    <span class="owner-staff-meta-label">โครงสร้างองค์กร</span>
                    <strong class="owner-staff-meta-val">@totalRolesCount ตำแหน่ง · @totalEmployees บุคลากร</strong>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════ STAFF KPI CARDS (5 CARDS) ═══════════════════ -->
    <section class="owner-staff-kpi-grid" aria-label="ตัวชี้วัดบุคลากรหลัก">

        <!-- 1. Total Employees -->
        <article class="owner-staff-kpi-card owner-staff-card-blue">
            <div class="owner-staff-kpi-head">
                <div class="owner-staff-kpi-icon owner-icon-bg-blue">
                    <i class="fa-solid fa-users"></i>
                </div>
                <span class="owner-staff-status-pill owner-staff-pill-blue">100%</span>
            </div>
            <div class="owner-staff-kpi-body">
                <h2 class="owner-staff-kpi-title">พนักงานทั้งหมด (Total Staff)</h2>
                <div class="owner-staff-kpi-count"
                     data-bind="totalStaff"
                     data-format="number"
                     data-counter-value="@totalEmployees">
                    @totalEmployees.ToString("N0")
                </div>
            </div>
            <div class="owner-staff-kpi-foot">
                <span class="owner-staff-kpi-pct">บุคลากรทุกตำแหน่งในโรงแรม</span>
            </div>
        </article>

        <!-- 2. Active Employees -->
        <article class="owner-staff-kpi-card owner-staff-card-green">
            <div class="owner-staff-kpi-head">
                <div class="owner-staff-kpi-icon owner-icon-bg-green">
                    <i class="fa-solid fa-user-check"></i>
                </div>
                <span class="owner-staff-status-pill owner-staff-pill-green">
                    @activePct.ToString("N2")%
                </span>
            </div>
            <div class="owner-staff-kpi-body">
                <h2 class="owner-staff-kpi-title">ปฏิบัติงานอยู่ (Active)</h2>
                <div class="owner-staff-kpi-count owner-text-success"
                     data-bind="activeStaff"
                     data-format="number"
                     data-counter-value="@activeEmployees">
                    @activeEmployees.ToString("N0")
                </div>
            </div>
            <div class="owner-staff-kpi-foot">
                <span class="owner-staff-kpi-pct">บัญชีเปิดใช้งานปกติ</span>
            </div>
        </article>

        <!-- 3. Suspended / Inactive Employees -->
        <article class="owner-staff-kpi-card owner-staff-card-amber">
            <div class="owner-staff-kpi-head">
                <div class="owner-staff-kpi-icon owner-icon-bg-amber">
                    <i class="fa-solid fa-user-lock"></i>
                </div>
                <span class="owner-staff-status-pill owner-staff-pill-amber">
                    @(suspendedPct.HasValue ? $"{suspendedPct.Value:N2}%" : $"{inactivePct:N2}%")
                </span>
            </div>
            <div class="owner-staff-kpi-body">
                <h2 class="owner-staff-kpi-title">ถูกระงับสิทธิ์ / ปิดใช้งาน</h2>
                <div class="owner-staff-kpi-count"
                     data-bind="inactiveStaff"
                     data-format="number"
                     data-counter-value="@(Model.SuspendedStaff ?? inactiveEmployees)">
                    @((Model.SuspendedStaff ?? inactiveEmployees).ToString("N0"))
                </div>
            </div>
            <div class="owner-staff-kpi-foot">
                <span class="owner-staff-kpi-pct">Suspended / Inactive</span>
            </div>
        </article>

        <!-- 4. Resigned Employees -->
        <article class="owner-staff-kpi-card owner-staff-card-red">
            <div class="owner-staff-kpi-head">
                <div class="owner-staff-kpi-icon owner-icon-bg-red">
                    <i class="fa-solid fa-user-xmark"></i>
                </div>
                <span class="owner-staff-status-pill owner-staff-pill-red">
                    @(resignedPct.HasValue ? $"{resignedPct.Value:N2}%" : "-")
                </span>
            </div>
            <div class="owner-staff-kpi-body">
                <h2 class="owner-staff-kpi-title">ลาออก (Resigned)</h2>
                <div class="owner-staff-kpi-count"
                     data-bind="resignedStaff"
                     data-format="number"
                     data-null-text="-">
                    @(Model.ResignedStaff.HasValue ? Model.ResignedStaff.Value.ToString("N0") : "-")
                </div>
            </div>
            <div class="owner-staff-kpi-foot">
                <span class="owner-staff-kpi-pct">สถานะลาออก</span>
            </div>
        </article>

        <!-- 5. Total Positions / Roles -->
        <article class="owner-staff-kpi-card owner-staff-card-violet">
            <div class="owner-staff-kpi-head">
                <div class="owner-staff-kpi-icon owner-icon-bg-violet">
                    <i class="fa-solid fa-sitemap"></i>
                </div>
                <span class="owner-staff-status-pill owner-staff-pill-violet">Positions</span>
            </div>
            <div class="owner-staff-kpi-body">
                <h2 class="owner-staff-kpi-title">จำนวนตำแหน่งงาน</h2>
                <div class="owner-staff-kpi-count owner-icon-cyan" data-staff-total-roles>
                    @totalRolesCount.ToString("N0")
                </div>
            </div>
            <div class="owner-staff-kpi-foot">
                <span class="owner-staff-kpi-pct">จากทั้งหมด @roleList.Count ตำแหน่ง</span>
            </div>
        </article>

    </section>

    <!-- ═══════════════════ STAFF STATUS DISTRIBUTION & EMPLOYEE BY POSITION ═══════════════════ -->
    <section class="owner-staff-charts-grid" aria-label="กราฟสัดส่วนสถานะและจำนวนพนักงานตามตำแหน่ง">

        <!-- Staff Status Distribution -->
        <div class="owner-panel owner-staff-chart-panel">
            <div class="owner-panel-header">
                <div>
                    <span class="owner-section-tag">ACCOUNT STATUS</span>
                    <h3 class="owner-panel-title">
                        <i class="fa-solid fa-chart-pie owner-icon-green"></i>
                        สัดส่วนสถานะบุคลากร
                    </h3>
                </div>
            </div>

            <div class="owner-staff-status-layout">
                <div class="owner-staff-donut-wrap">
                    <canvas id="ownerStaffStatusDonutChart"></canvas>
                    <div class="owner-donut-center-label">
                        <span class="owner-donut-percent" data-staff-active-pct>@activePct.ToString("N1")%</span>
                        <span class="owner-donut-caption">Active</span>
                    </div>
                </div>

                <div class="owner-staff-status-breakdown">
                    <!-- Active -->
                    <div class="owner-staff-stat-item">
                        <div class="owner-staff-stat-left">
                            <span class="owner-dot owner-dot-green"></span>
                            <div>
                                <strong>ปฏิบัติงานปกติ (Active)</strong>
                            </div>
                        </div>
                        <div class="owner-staff-stat-right">
                            <strong class="owner-text-success">@activeEmployees.ToString("N0") คน</strong>
                            <span class="owner-staff-pct-chip">@activePct.ToString("N2")%</span>
                        </div>
                    </div>

                    <!-- Suspended / Inactive -->
                    <div class="owner-staff-stat-item">
                        <div class="owner-staff-stat-left">
                            <span class="owner-dot owner-dot-amber"></span>
                            <div>
                                <strong>ระงับสิทธิ์ / ปิดใช้งาน (Inactive)</strong>
                            </div>
                        </div>
                        <div class="owner-staff-stat-right">
                            <strong class="owner-icon-amber">
                                @((Model.SuspendedStaff ?? inactiveEmployees).ToString("N0")) คน
                            </strong>
                            <span class="owner-staff-pct-chip">
                                @(suspendedPct.HasValue ? $"{suspendedPct.Value:N2}%" : $"{inactivePct:N2}%")
                            </span>
                        </div>
                    </div>

                    <!-- Resigned -->
                    <div class="owner-staff-stat-item">
                        <div class="owner-staff-stat-left">
                            <span class="owner-dot" style="background:#EF4444;"></span>
                            <div>
                                <strong>ลาออก (Resigned)</strong>
                            </div>
                        </div>
                        <div class="owner-staff-stat-right">
                            <strong class="owner-text-danger">
                                @(Model.ResignedStaff.HasValue ? $"{Model.ResignedStaff.Value:N0} คน" : "-")
                            </strong>
                            <span class="owner-staff-pct-chip">
                                @(resignedPct.HasValue ? $"{resignedPct.Value:N2}%" : "-")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Employee by Position -->
        <div class="owner-panel owner-staff-chart-panel">
            <div class="owner-panel-header">
                <div>
                    <span class="owner-section-tag">WORKFORCE BY ROLE</span>
                    <h3 class="owner-panel-title">
                        <i class="fa-solid fa-bars-progress owner-icon-cyan"></i>
                        จำนวนพนักงานแยกตามตำแหน่ง
                    </h3>
                </div>
            </div>

            <div class="owner-chart-container owner-staff-bar-wrap">
                <canvas id="ownerStaffPositionBarChart"></canvas>
            </div>
        </div>

    </section>

    <!-- ═══════════════════ EMPLOYEE DISTRIBUTION BY POSITION CARDS ═══════════════════ -->
    <section class="owner-panel owner-staff-dist-section" aria-label="การกระจายตัวของพนักงานในแต่ละตำแหน่ง">
        <div class="owner-panel-header">
            <div>
                <span class="owner-section-tag">DEPARTMENT BREAKDOWN</span>
                <h3 class="owner-panel-title">
                    <i class="fa-solid fa-network-wired owner-icon-violet"></i>
                    จำนวนพนักงานและสถานะในแต่ละตำแหน่ง
                </h3>
            </div>
        </div>

        @if (roleList.Count == 0)
        {
            <div class="owner-fin-empty-box">ยังไม่มีข้อมูลตำแหน่งพนักงาน</div>
        }
        else
        {
            <div class="owner-staff-role-cards-grid">
                @foreach (var role in roleList)
                {
                    decimal roleSharePct = totalEmployees > 0
                        ? Math.Round(role.Total * 100m / totalEmployees, 2)
                        : 0m;

                    <article class="owner-staff-role-card @GetRoleAccent(role.RoleCode)">
                        <div class="owner-staff-rc-top">
                            <div class="owner-staff-rc-icon">
                                <i class="fa-solid @GetRoleIcon(role.RoleCode)"></i>
                            </div>
                            <span class="owner-staff-rc-code">@role.RoleCode</span>
                        </div>

                        <div class="owner-staff-rc-main">
                            <h4 class="owner-staff-rc-name">
                                @(string.IsNullOrWhiteSpace(role.RoleName) ? role.RoleCode : role.RoleName)
                            </h4>
                            <div class="owner-staff-rc-number">
                                <strong>@role.Total.ToString("N0")</strong>
                                <span>คน (@roleSharePct.ToString("N1")%)</span>
                            </div>
                        </div>

                        <div class="owner-staff-rc-bar">
                            <div class="owner-staff-rc-bar-fill"
                                 style="width: @(Math.Clamp(roleSharePct, 0m, 100m).ToString(CultureInfo.InvariantCulture))%"></div>
                        </div>

                        <div class="owner-staff-rc-meta">
                            <span class="owner-text-success">
                                <i class="fa-solid fa-circle-check"></i> Active: @role.Active
                            </span>
                            <span class="owner-icon-amber">
                                <i class="fa-solid fa-circle-pause"></i> Inactive: @role.Inactive
                            </span>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <!-- ═══════════════════ STAFF DIRECTORY TABLE ═══════════════════ -->
    <section class="owner-panel owner-staff-dir-section" aria-label="ตารางรายชื่อพนักงาน">
        <div class="owner-panel-header">
            <div>
                <span class="owner-section-tag">STAFF DIRECTORY</span>
                <h3 class="owner-panel-title">
                    <i class="fa-solid fa-address-book owner-icon-cyan"></i>
                    ทำเนียบรายชื่อบุคลากร
                </h3>
            </div>
            <span class="owner-badge-count" data-staff-dir-count>
                ทั้งหมด @directoryList.Count บัญชี
            </span>
        </div>

        <!-- Search, Role Filter, Status Filter & Sort Controls -->
        <div class="owner-staff-toolbar">
            <div class="owner-staff-search-wrap">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="search"
                       class="owner-staff-search-input"
                       placeholder="ค้นหารหัสพนักงาน, ชื่อ-นามสกุล, Username หรือตำแหน่ง..."
                       data-staff-search />
            </div>

            <div class="owner-staff-filters">
                <select class="owner-staff-select" data-staff-role-filter aria-label="กรองตามตำแหน่ง">
                    <option value="">ทุกตำแหน่ง</option>
                    @foreach (var r in roleList)
                    {
                        <option value="@r.RoleCode">@r.RoleCode (@(string.IsNullOrWhiteSpace(r.RoleName) ? r.RoleCode : r.RoleName))</option>
                    }
                </select>

                <select class="owner-staff-select" data-staff-status-filter aria-label="กรองตามสถานะบัญชี">
                    <option value="">ทุกสถานะ</option>
                    <option value="Active">Active (ปฏิบัติงาน)</option>
                    <option value="Inactive">Inactive (ปิดสิทธิ์)</option>
                </select>

                <select class="owner-staff-select" data-staff-sort aria-label="เรียงลำดับข้อมูล">
                    <option value="id-asc">เรียงตามรหัสพนักงาน (น้อย → มาก)</option>
                    <option value="name-asc">เรียงตามชื่อ (ก → ฮ / A → Z)</option>
                    <option value="name-desc">เรียงตามชื่อ (ฮ → ก / Z → A)</option>
                    <option value="role-asc">เรียงตามตำแหน่ง (A → Z)</option>
                </select>

                <button type="button" class="owner-staff-reset-btn" data-staff-reset>
                    <i class="fa-solid fa-rotate-left"></i> ล้างตัวกรอง
                </button>
            </div>
        </div>

        <div class="owner-table-responsive">
            <table class="owner-table owner-staff-table" id="ownerStaffDirectoryTable">
                <thead>
                    <tr>
                        <th>รหัสพนักงาน</th>
                        <th>ชื่อ-นามสกุล</th>
                        <th>ชื่อผู้ใช้</th>
                        <th>ตำแหน่ง</th>
                        <th class="text-center">สถานะ</th>
                    </tr>
                </thead>
                <tbody data-staff-dir-tbody>
                    @if (directoryList.Count == 0)
                    {
                        <tr data-staff-empty-static>
                            <td colspan="5" class="owner-empty-cell">
                                ไม่มีข้อมูลรายชื่อพนักงาน
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var emp in directoryList)
                        {
                            var statusKey = emp.IsActive == true ? "Active" : "Inactive";
                            var rolesJoined = string.Join(", ", emp.RoleCodes);

                            <tr data-staff-row
                                data-emp-id="@emp.UserId"
                                data-emp-name="@emp.FullName"
                                data-emp-username="@emp.Username"
                                data-emp-roles="@rolesJoined"
                                data-emp-status="@statusKey">
                                <td>
                                    <span class="owner-staff-id-badge">EMP-@emp.UserId.ToString("D4")</span>
                                </td>
                                <td>
                                    <div class="owner-staff-person-cell">
                                        <div class="owner-staff-avatar">
                                            @(!string.IsNullOrWhiteSpace(emp.FullName) ? emp.FullName.Trim()[0].ToString().ToUpperInvariant() : "S")
                                        </div>
                                        <strong>@(string.IsNullOrWhiteSpace(emp.FullName) ? "-" : emp.FullName)</strong>
                                    </div>
                                </td>
                                <td>
                                    <span class="owner-staff-username">@emp.Username</span>
                                </td>
                                <td>
                                    <div class="owner-staff-role-chips">
                                        @for (int i = 0; i < emp.RoleCodes.Count; i++)
                                        {
                                            var code = emp.RoleCodes[i];
                                            var name = i < emp.RoleNames.Count ? emp.RoleNames[i] : code;
                                            <span class="owner-staff-role-chip">
                                                <i class="fa-solid @GetRoleIcon(code)"></i>
                                                @code @(!string.IsNullOrWhiteSpace(name) && name != code ? $"· {name}" : "")
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (emp.IsActive == true)
                                    {
                                        <span class="owner-staff-badge-status owner-staff-status-active">
                                            <i class="fa-solid fa-circle-check"></i> Active
                                        </span>
                                    }
                                    else if (emp.IsActive == false)
                                    {
                                        <span class="owner-staff-badge-status owner-staff-status-suspended">
                                            <i class="fa-solid fa-circle-pause"></i> Inactive
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="owner-staff-badge-status owner-staff-status-unknown">
                                            Unknown
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Bar -->
        <div class="owner-staff-pagination" data-staff-pagination>
            <span class="owner-staff-page-info" data-staff-page-info>แสดงรายชื่อบุคลากร</span>
            <div class="owner-staff-page-btns" data-staff-page-btns></div>
        </div>
    </section>

</div>